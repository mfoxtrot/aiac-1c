&НаКлиенте
Перем СтоимостьСессииВсего;

&НаКлиенте
Перем ТокеныСессииВсего;

&НаКлиенте
Процедура ОтправитьВопрос(Команда)

	ОтправитьВопросАгенту();

КонецПроцедуры

&НаКлиенте
Процедура НовыйЧат(Команда)

	НовыйЧатНаСервере();
	СброситьСтатистикуСессии();
	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();

КонецПроцедуры

&НаКлиенте
Процедура ДемоДлинныйКонтекст(Команда)

	ТекстВопроса = НСтр("ru = 'В историю чата добавятся учебные тексты суммарно около 75 000 токенов (сценарий «длинный диалог»). В ленте каждый фрагмент будет показан сокращённо с указанием веса. Следующий запрос агента уйдёт с таким контекстом — он станет заметно дороже и медленнее (порядка $0,2–0,6). Тексты попадут и в сохранённый документ чата.
		|Продолжить?'");
	ЗапроситьПодтверждениеДемо(ТекстВопроса, "длинный");

КонецПроцедуры

&НаКлиенте
Процедура ДемоПереполнение(Команда)

	ТекстВопроса = СтрШаблон(НСтр("ru = 'В историю чата добавятся учебные тексты суммарно около %1 токенов — заведомо больше контекстного окна модели. Следующий запрос будет честно отклонён API с ошибкой 400 об превышении лимита (отклонённые запросы не тарифицируются).
		|После этого агент не сможет отвечать в этом чате — выход только через «Новый чат». Демо-чат потом можно удалить крестиком в ленте.
		|Продолжить?'"), ФорматЦелого(Окр(ЛимитКонтекста * 1.15, 0)));
	ЗапроситьПодтверждениеДемо(ТекстВопроса, "переполнение");

КонецПроцедуры

// Спрашивает подтверждение перед наполнением истории учебными текстами
// (асинхронный вопрос — модальность запрещена).
//
// Параметры:
//   ТекстВопроса - Строка - текст подтверждения;
//   Вид - Строка - "длинный" или "переполнение" (передаётся в обработчик ответа).
//
&НаКлиенте
Процедура ЗапроситьПодтверждениеДемо(ТекстВопроса, Вид)

	Оповещение = Новый ОписаниеОповещения("ДемоПодтверждено", ЭтотОбъект, Вид);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);

КонецПроцедуры

// Добавляет подтверждённые демо-тексты в историю чата, сохраняет диалог
// (демо-история попадает в документ с токенами) и обновляет панель токенов.
//
// Параметры:
//   Результат - КодВозвратаДиалога - ответ пользователя;
//   Вид - Строка - "длинный" или "переполнение".
//
&НаКлиенте
Процедура ДемоПодтверждено(Результат, Вид) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СообщениеДемо Из СообщенияДемоНаСервере(Вид) Цикл
		НоваяСтрока = История.Добавить();
		НоваяСтрока.Роль = СообщениеДемо.Роль;
		НоваяСтрока.Текст = СообщениеДемо.Текст;
		НоваяСтрока.Отправлено = ТекущаяДата();
		НоваяСтрока.Токены = СообщениеДемо.Токены;
	КонецЦикла;

	ОбновитьЧат();
	СохранитьТекущийЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВопросАгенту()

	ТекстВопроса = СокрЛП(ТекущийВопрос);
	Если Не ЗначениеЗаполнено(ТекстВопроса) Тогда
		Возврат;
	КонецЕсли;

	ДобавитьСообщениеВИсторию("user", ТекстВопроса);
	ТекущийВопрос = "";

	ПоказатьОповещениеПользователя(НСтр("ru = 'Агент Kimi'"), , НСтр("ru = 'Выполняется запрос…'"));

	// Оценка исходящего запроса до отправки (День 8): если история тяжелее окна модели,
	// API отклонит запрос — предупреждаем и даём отступить, либо отправить «в стену» наглядно.
	ОценкаЗапроса = ОценитьИсходящийЗапросНаСервере();

	Если ОценкаЗапроса.Превышен Тогда
		ПодтвердитьОтправкуПриПереполнении(ОценкаЗапроса);
		Возврат;
	КонецЕсли;

	ОтправитьОцененныйВопрос(ОценкаЗапроса);

КонецПроцедуры

// Спрашивает подтверждение отправки заведомо переполненного запроса.
//
// Параметры:
//   ОценкаЗапроса - Структура - см. ОценитьИсходящийЗапросНаСервере.
//
&НаКлиенте
Процедура ПодтвердитьОтправкуПриПереполнении(ОценкаЗапроса)

	ТекстВопроса = СтрШаблон(НСтр("ru = 'Оценка исходящего запроса — %1 ток., это больше контекстного окна модели (%2 ток.). API почти наверняка отклонит запрос с ошибкой 400.
		|Отправить запрос и увидеть реакцию API?
		|
		|«Нет» — убрать вопрос из истории и остаться в чате.'"),
		ФорматЦелого(ОценкаЗапроса.ОценкаЗапроса), ФорматЦелого(ОценкаЗапроса.Лимит));

	Оповещение = Новый ОписаниеОповещения("ОтправкаПриПереполненииПодтверждена", ЭтотОбъект, ОценкаЗапроса);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);

КонецПроцедуры

// Продолжает или отменяет отправку после ответа на вопрос о переполнении.
//
// Параметры:
//   Результат - КодВозвратаДиалога - ответ пользователя;
//   ОценкаЗапроса - Структура - см. ОценитьИсходящийЗапросНаСервере.
//
&НаКлиенте
Процедура ОтправкаПриПереполненииПодтверждена(Результат, ОценкаЗапроса) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		История.Удалить(История.Количество() - 1);
		ОбновитьЧат();
		ОбновитьПанельТокенов();
		Возврат;
	КонецЕсли;

	ОтправитьОцененныйВопрос(ОценкаЗапроса);

КонецПроцедуры

// Выполняет запрос агента и разбирает результат: история, журнал, статус,
// панель токенов и таблица роста диалога (День 8).
//
// Параметры:
//   ОценкаЗапроса - Структура - см. ОценитьИсходящийЗапросНаСервере.
//
&НаКлиенте
Процедура ОтправитьОцененныйВопрос(ОценкаЗапроса)

	Попытка
		РезультатАгента = ВыполнитьЗапросАгентаНаСервере();
	Исключение
		ОбработатьОшибкуОтправки(ОписаниеОшибки(), ОценкаЗапроса);
		Возврат;
	КонецПопытки;

	ДобавитьСообщенияАгентаВИсторию(РезультатАгента.НовыеСообщения);
	СохранитьТекущийЧат();

	СтоимостьСессииВсего = СтоимостьСессииВсего + РезультатАгента.Стоимость;
	ТокеныСессииВсего = ТокеныСессииВсего + РезультатАгента.ТокеныВсего;

	ЗаполнитьЖурнал(РезультатАгента.Журнал);
	ОбновитьСтатус(РезультатАгента);
	ОбновитьПанельТокенов(РезультатАгента, ОценкаЗапроса.ОценкаВопроса);
	ДобавитьСтрокуРоста(РезультатАгента, "");
	ОбновитьСписокЧатовHTML();

КонецПроцедуры

// Разбирает ошибку вызова агента. Переполнение контекста (ошибка 400 с упоминанием
// context) показываем отдельно — это сценарий задания Дня 8: запрос отклонён,
// диалог «сломан», агент не может продолжать.
//
// Параметры:
//   ТекстОшибки - Строка - ОписаниеОшибки() из попытки;
//   ОценкаЗапроса - Структура - см. ОценитьИсходящийЗапросНаСервере.
//
&НаКлиенте
Процедура ОбработатьОшибкуОтправки(ТекстОшибки, ОценкаЗапроса)

	Если ЭтоОшибкаПереполненияКонтекста(ТекстОшибки) Тогда
		ТокеныПанель = СтрШаблон(НСтр("ru = 'Запрос отклонён API: превышен лимит контекста.
			|Оценка запроса: %1 ток. — больше окна модели (%2 ток.).
			|Агент не может продолжить этот диалог: контекст автоматически не обрезается. Выход — «Новый чат».'"),
			ФорматЦелого(ОценкаЗапроса.ОценкаЗапроса), ФорматЦелого(ОценкаЗапроса.Лимит));
		ДобавитьСтрокуРоста(Неопределено, НСтр("ru = 'отклонено API: превышен лимит контекста'"));
	Иначе
		Сообщить(ТекстОшибки, СтатусСообщения.Важное);
	КонецЕсли;

КонецПроцедуры

// Распознаёт ошибку переполнения контекста по тексту исключения: HTTP 400 и упоминание
// context (формулировка тела ответа зависит от провайдера — сверяем по двум признакам).
//
&НаКлиенте
Функция ЭтоОшибкаПереполненияКонтекста(ТекстОшибки)

	НижнийРегистр = НРег(ТекстОшибки);
	Возврат СтрНайти(НижнийРегистр, "400") > 0 И СтрНайти(НижнийРегистр, "context") > 0;

КонецФункции

// Сохраняет текущий диалог в документ; неуспех сохранения не отменяет показ ответа,
// но сообщается пользователю (контекст перезапуска не восстановится).
//
&НаКлиенте
Процедура СохранитьТекущийЧат()

	Попытка
		СохранитьТекущийЧатНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Не удалось сохранить диалог:'") + " " + ОписаниеОшибки(), СтатусСообщения.Важное);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСообщениеВИсторию(Роль, ТекстСообщения)

	НоваяСтрока = История.Добавить();
	НоваяСтрока.Роль = Роль;
	НоваяСтрока.Текст = ТекстСообщения;
	НоваяСтрока.Отправлено = ТекущаяДата();

	ОбновитьЧат();

КонецПроцедуры

// Дописывает в историю сообщения, добавленные циклом агента (ответы ассистента,
// включая промежуточные с вызовами инструментов, и tool-сообщения с результатами).
// Служебные реквизиты (вызовы инструментов, идентификаторы вызовов, токены ответа)
// сохраняются в истории — из них без потерь восстанавливается контекст для API,
// а токены ассистента — факт из usage для колонки ТЧ документа (День 8).
//
// Параметры:
//   НовыеСообщения - Массив из Структура - см. KimiАгентСервер.ВыполнитьЗапросАгента.
//
&НаКлиенте
Процедура ДобавитьСообщенияАгентаВИсторию(НовыеСообщения)

	Для Каждого Сообщение Из НовыеСообщения Цикл
		НоваяСтрока = История.Добавить();
		НоваяСтрока.Роль = Сообщение.Роль;
		НоваяСтрока.Текст = ?(Сообщение.Текст = Неопределено, "", Сообщение.Текст);
		НоваяСтрока.Отправлено = ТекущаяДата();

		ТокеныОтвета = Неопределено;
		Если Сообщение.Свойство("ТокеныОтвета", ТокеныОтвета) Тогда
			НоваяСтрока.Токены = ТокеныОтвета;
		КонецЕсли;

		ВызовыИнструментов = Неопределено;
		Если Сообщение.Свойство("ВызовыИнструментов", ВызовыИнструментов)
			И ВызовыИнструментов.Количество() > 0 Тогда
			НоваяСтрока.ВызовыИнструментов = ВызовыИнструментовВJSON(ВызовыИнструментов);
		КонецЕсли;

		ИдВызова = Неопределено;
		Если Сообщение.Свойство("ИдВызова", ИдВызова) Тогда
			НоваяСтрока.ИдВызова = ИдВызова;
		КонецЕсли;
	КонецЦикла;

	ОбновитьЧат();

КонецПроцедуры

// Сериализует вызовы инструментов сообщения в JSON-строку для хранения в истории.
// Ключи wire-формата (id/name/arguments) — так сериализация не зависит от имён
// полей внутренних структур.
//
&НаКлиенте
Функция ВызовыИнструментовВJSON(ВызовыИнструментов)

	ДанныеВызовов = Новый Массив;
	Для Каждого Вызов Из ВызовыИнструментов Цикл
		ДанныеВызовов.Добавить(Новый Структура("id, name, arguments", Вызов.Ид, Вызов.Имя, Вызов.Аргументы));
	КонецЦикла;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеВызовов);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Пересобирает HTML чата из истории диалога: каждое сообщение — «пузырь» с рамкой
// и скруглением, сообщения пользователя прижаты вправо, модели — влево,
// внизу пузыря мелкая метка с датой и временем. Сообщения выводятся в обратном
// порядке (новые первыми в разметке) — контейнер column-reverse показывает их снизу.
// Служебные сообщения в ленте не показываются: tool, пустые ответы ассистента
// с вызовами инструментов (их след — в журнале работы агента). Демо-фрагменты
// контекста (День 8) показываются усечённо — начало текста с меткой веса фрагмента
// (полные тексты: сотни фрагментов по ~10k символов убьют производительность
// HTML-поля) — сокращение выполняется в БлокСообщенияHTML.
//
&НаКлиенте
Процедура ОбновитьЧат()

	ЧастиHTML = Новый Массив;
	ЧастиHTML.Добавить(ЗаголовокHTMLЧата());

	Индекс = История.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если История[Индекс].Роль <> "tool" И ЗначениеЗаполнено(История[Индекс].Текст) Тогда
			ЧастиHTML.Добавить(БлокСообщенияHTML(История[Индекс]));
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	ЧастиHTML.Добавить("</div></body></html>");

	ЧатHTML = СтрСоединить(ЧастиHTML, Символы.ПС);

КонецПроцедуры

// Возвращает маркер начала демо-фрагментов контекста (День 8): такие сообщения
// выводятся в ленте усечённо с отдельным оформлением, но участвуют в запросах
// API, сохранении и подсчёте токенов полнотекстово.
//
&НаКлиенте
Функция МаркерДемоСообщения()

	Возврат НСтр("ru = 'Учебный фрагмент контекста №'");

КонецФункции

// Возвращает шапку HTML-чата: оформление «пузырей» сообщений и контейнер ленты.
// Автоскролл к последнему сообщению — без JavaScript (сценарии в HTML-поле не выполняются):
// контейнер flex с column-reverse открывается у низа, поэтому сообщения добавляются
// в обратном порядке (новые первыми в разметке — визуально внизу).
//
// Возвращаемое значение:
//   Строка - HTML с открывающими тегами html/head/body, блоком style и контейнером ленты.
//
&НаКлиенте
Функция ЗаголовокHTMLЧата()

	Возврат
	"<html><head><style>
	|html, body { height: 100%; margin: 0; padding: 0; }
	|body { font-family: 'Segoe UI', Tahoma, Arial, sans-serif; font-size: 13px; background: #ffffff; }
	|#chat { height: 100%; overflow-y: auto; display: flex; flex-direction: column-reverse; }
	|.msg { margin: 6px; }
	|.user { text-align: right; }
	|.bot { text-align: left; }
	|.bubble { display: inline-block; text-align: left; max-width: 75%; padding: 6px 10px;
	|	border-radius: 12px; border: 1px solid #999999; word-wrap: break-word; }
	|.user .bubble { background: #e9f5ea; border-color: #2e7d32; }
	|.bot .bubble { background: #e9f0fa; border-color: #1a3a6b; }
	|.author { font-weight: bold; font-size: 11px; margin-bottom: 2px; }
	|.user .author { color: #1b5e20; }
	|.bot .author { color: #123a6d; }
	|.demo { text-align: left; }
	|.demo .bubble { background: #f4f4f4; border: 1px dashed #999999; }
	|.demo .author { color: #666666; }
	|.time { font-size: 10px; color: #888888; margin-top: 3px; text-align: right; }
	|</style></head><body><div id=""chat"">";

КонецФункции

// Формирует HTML-блок одного сообщения чата. Демо-фрагменты контекста (День 8)
// выводятся усечённо (первые строки текста) с меткой веса — полные тексты фрагментов
// слишком велики для ленты, а вес и след важнее содержания.
//
// Параметры:
//   СтрокаИстории - данные таблицы История: Роль, Текст, Отправлено, Токены.
//
// Возвращаемое значение:
//   Строка - HTML-блок сообщения.
//
&НаКлиенте
Функция БлокСообщенияHTML(СтрокаИстории)

	ЭтоДемо = СтрНачинаетсяС(СтрокаИстории.Текст, МаркерДемоСообщения());

	Если ЭтоДемо Тогда
		Класс = "demo";
		Автор = НСтр("ru = 'Демо-контекст'");
		ТекстВывода = НачалоТекста(СтрокаИстории.Текст, 10, 700);
		Момент = СтрШаблон(НСтр("ru = '≈ %1 ток. · фрагмент показан частично'"), ФорматЦелого(СтрокаИстории.Токены));
	Иначе
		Пользователь = (СтрокаИстории.Роль = "user");
		Класс = ?(Пользователь, "user", "bot");
		Автор = ?(Пользователь, "Вы", "Kimi");
		ТекстВывода = СтрокаИстории.Текст;
		Момент = Формат(СтрокаИстории.Отправлено, "ДЛФ=D") + " " + Формат(СтрокаИстории.Отправлено, "ДЛФ=T");
	КонецЕсли;

	Возврат СтрШаблон(
		"<div class=""msg %1""><div class=""bubble""><div class=""author"">%2</div>%3<div class=""time"">%4</div></div></div>",
		Класс, Автор, ЭкранироватьHTML(ТекстВывода), Момент);

КонецФункции

// Возвращает начало текста: первые ЧислоСтрок строк, суммарно не длинее ЛимитСимволов;
// при сокращении добавляет многоточие.
//
// Параметры:
//   Текст - Строка - исходный текст;
//   ЧислоСтрок - Число - сколько первых строк взять;
//   ЛимитСимволов - Число - максимальная длина результата.
//
// Возвращаемое значение:
//   Строка - начало текста.
//
&НаКлиенте
Функция НачалоТекста(Текст, ЧислоСтрок, ЛимитСимволов)

	ВсеСтроки = СтрРазделить(Текст, Символы.ПС);
	ВзятоСтрок = Мин(ЧислоСтрок, ВсеСтроки.Количество());

	Части = Новый Массив;
	Для Индекс = 0 По ВзятоСтрок - 1 Цикл
		Части.Добавить(ВсеСтроки[Индекс]);
	КонецЦикла;
	Результат = СтрСоединить(Части, Символы.ПС);

	Сокращён = ВсеСтроки.Количество() > ЧислоСтрок;
	Если СтрДлина(Результат) > ЛимитСимволов Тогда
		Результат = Лев(Результат, ЛимитСимволов);
		Сокращён = Истина;
	КонецЕсли;
	Если Сокращён Тогда
		Результат = Результат + " " + НСтр("ru = '…'");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Экранирует символы HTML и заменяет переводы строк на <br>.
//
// Параметры:
//   Текст - Строка - исходный текст сообщения.
//
// Возвращаемое значение:
//   Строка - текст, безопасный для подстановки в HTML.
//
&НаКлиенте
Функция ЭкранироватьHTML(Текст)

	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, Символ(13), "");
	Результат = СтрЗаменить(Результат, Символы.ПС, "<br>");

	Возврат Результат;

КонецФункции

// Пересобирает HTML ленты чатов из таблицы Чаты (новые первыми): первым пунктом —
// «Новый чат», далее карточки диалогов; текущий диалог подсвечен. Клик по карточке —
// псевдо-ссылка chat:<ид>, обрабатывается в СписокЧатовПриНажатии.
//
&НаКлиенте
Процедура ОбновитьСписокЧатовHTML()

	ЧастиHTML = Новый Массив;
	ЧастиHTML.Добавить(ЗаголовокHTMLСпискаЧатов());

	Для Каждого СтрокаЧата Из Чаты Цикл
		ЧастиHTML.Добавить(БлокЧатаHTML(СтрокаЧата));
	КонецЦикла;

	ЧастиHTML.Добавить("</div></body></html>");

	СписокЧатовHTML = СтрСоединить(ЧастиHTML, Символы.ПС);

КонецПроцедуры

// Возвращает шапку ленты чатов: оформление карточек и пункт «Новый чат».
//
&НаКлиенте
Функция ЗаголовокHTMLСпискаЧатов()

	Возврат
	"<html><head><style>
	|html, body { height: 100%; margin: 0; padding: 0; }
	|body { font-family: 'Segoe UI', Tahoma, Arial, sans-serif; font-size: 13px; background: #ffffff; }
	|#chats { height: 100%; overflow-y: auto; }
	|a.newchat { display: block; margin: 6px; padding: 6px 10px; border: 1px dashed #2e7d32;
	|	color: #1b5e20; text-decoration: none; border-radius: 8px; text-align: center; }
	|a.chat { display: block; margin: 4px 6px; padding: 6px 22px 6px 10px; border: 1px solid #999999;
	|	border-radius: 10px; text-decoration: none; color: #222222; position: relative; }
	|a.chat .title { font-weight: bold; font-size: 13px; color: #123a6d; word-wrap: break-word; }
	|a.chat .meta { font-size: 10px; color: #888888; margin-top: 3px; }
	|a.chat.active { background: #e9f0fa; border-color: #1a3a6b; }
	|a.chat .del { position: absolute; top: 2px; right: 6px; color: #b71c1c; font-weight: bold;
	|	font-size: 14px; cursor: pointer; }
	|</style></head><body><div id=""chats"">
	|<a class=""newchat"" href=""chat:new"">+ Новый чат</a>";

КонецФункции

// Формирует HTML-карточку одного чата ленты.
//
// Параметры:
//   СтрокаЧата - данные таблицы Чаты: Ссылка, Наименование, Дата, ДатаЗавершения.
//
// Возвращаемое значение:
//   Строка - HTML-блок чата.
//
&НаКлиенте
Функция БлокЧатаHTML(СтрокаЧата)

	ЭтоТекущий = (СтрокаЧата.Ссылка = ТекущийЧат);
	Класс = ?(ЭтоТекущий, "chat active", "chat");

	Заголовок = СтрокаЧата.Наименование;
	Если Не ЗначениеЗаполнено(Заголовок) Тогда
		Заголовок = СтрШаблон(НСтр("ru = 'Диалог от %1'"), Формат(СтрокаЧата.Дата, "ДЛФ=D"));
	КонецЕсли;

	Мета = Формат(СтрокаЧата.Дата, "ДЛФ=D") + " " + Формат(СтрокаЧата.Дата, "ДЛФ=T");
	Если ЗначениеЗаполнено(СтрокаЧата.ДатаЗавершения) Тогда
		Мета = Мета + " " + НСтр("ru = '· завершён'");
	КонецЕсли;

	Возврат СтрШаблон(
		"<a class=""%1"" href=""chat:%2""><div class=""title"" id=""chat:%2"">%3</div>"
		+ "<div class=""meta"" id=""chat:%2"">%4</div><div class=""del"" id=""del:%2"">&#10005;</div></a>",
		Класс, СтрокаЧата.Ид, ЭкранироватьHTML(Заголовок), ЭкранироватьHTML(Мета));

КонецФункции

// Обработчик нажатий в ленте чатов: переход по псевдо-ссылкам карточек.
// Адрес ссылки — "chat:<ид диалога>"; идентификатор "new" означает создание нового чата.
// Адрес читается через DOM-элемент события; чтение обёрнуто в попытку —
// состав свойств DOM зависит от движка HTML-поля.
//
&НаКлиенте
Процедура СписокЧатовПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Адрес = АдресСсылкиСпискаЧатов(ДанныеСобытия);
	АдресНРег = НРег(Адрес);

	ПозицияУдаления = СтрНайти(АдресНРег, "del:");
	Если ПозицияУдаления > 0 Тогда
		ПодтвердитьУдалениеЧата(Сред(Адрес, ПозицияУдаления + 4));
		Возврат;
	КонецЕсли;

	Позиция = СтрНайти(АдресНРег, "chat:");
	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;

	ИдЧата = Сред(Адрес, Позиция + 5);
	Если ИдЧата = "new" Тогда
		НовыйЧат(Неопределено);
	Иначе
		ПереключитьЧат(ИдЧата);
	КонецЕсли;

КонецПроцедуры

// Находит чат в таблице ленты по идентификатору (XML-строка ссылки).
//
// Параметры:
//   ИдЧата - Строка - идентификатор диалога.
//
// Возвращаемое значение:
//   ДокументСсылка.KimiДиалог, Неопределено - найденный диалог.
//
&НаКлиенте
Функция НайтиЧатПоИд(ИдЧата)

	Для Каждого СтрокаЧата Из Чаты Цикл
		Если СтрокаЧата.Ид = ИдЧата Тогда
			Возврат СтрокаЧата.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Запрашивает подтверждение удаления чата (асинхронный вопрос — модальность запрещена)
// и при согласии помечает диалог на удаление.
//
// Параметры:
//   ИдЧата - Строка - идентификатор удаляемого диалога.
//
&НаКлиенте
Процедура ПодтвердитьУдалениеЧата(ИдЧата)

	ВыбранныйЧат = НайтиЧатПоИд(ИдЧата);
	Если ВыбранныйЧат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПодтверждениеУдаленияЧатаЗавершено", ЭтотОбъект, ВыбранныйЧат);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Вы действительно хотите удалить чат?'"),
		РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);

КонецПроцедуры

// Завершает удаление чата после ответа на вопрос подтверждения.
//
// Параметры:
//   Результат - КодВозвратаДиалога - ответ пользователя;
//   ВыбранныйЧат - ДокументСсылка.KimiДиалог - удаляемый диалог.
//
&НаКлиенте
Процедура ПодтверждениеУдаленияЧатаЗавершено(Результат, ВыбранныйЧат) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	УдалитьЧатНаСервере(ВыбранныйЧат);
	СброситьСтатистикуСессии();
	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();

КонецПроцедуры

// Помечает диалог на удаление; если удалён текущий чат — очищает форму для нового диалога.
//
// Параметры:
//   Ссылка - ДокументСсылка.KimiДиалог - удаляемый диалог.
//
&НаСервере
Процедура УдалитьЧатНаСервере(Ссылка)

	УдалёнТекущий = (Ссылка = ТекущийЧат);
	KimiЧатыАгентаСервер.УдалитьДиалог(Ссылка);

	Если УдалёнТекущий Тогда
		ТекущийЧат = Документы.KimiДиалог.ПустаяСсылка();
		ЗаголовокТекущегоЧата = "";
		История.Очистить();
		ЖурналРаботы.Очистить();
		РостДиалога.Очистить();
		СтатусОтвета = "";
	КонецЕсли;

	ОбновитьСписокЧатовНаСервере();

КонецПроцедуры

// Извлекает адрес нажатой карточки чата из данных события HTML-поля.
// Клик приходит на конкретный элемент-мишень: при клике по тексту внутри карточки
// это вложенный div (заголовок/мета), а не ссылка <a>, — поэтому поднимаемся
// по родителям DOM и читаем служебный id ("chat:<ид>" карточки, "del:<ид>" крестика
// удаления) или href, пока адрес не найден. Маркеры id проверяются первыми и на
// самом элементе-мишени — иначе клик по крестику всплыл бы к ссылке карточки.
// Чтение DOM обёрнуто в попытки: состав свойств зависит от движка HTML-поля;
// защитно принимаем и строку вторым параметром события.
//
&НаКлиенте
Функция АдресСсылкиСпискаЧатов(ДанныеСобытия)

	Попытка
		Если ТипЗнч(ДанныеСобытия) = Тип("Строка") Тогда
			Возврат ДанныеСобытия;
		КонецЕсли;

		ЭлементDOM = ДанныеСобытия.Element;
		Пока ЭлементDOM <> Неопределено Цикл
			Попытка
				ИдЭлемента = НРег(ЭлементDOM.id);
				Если СтрНайти(ИдЭлемента, "del:") > 0 Или СтрНайти(ИдЭлемента, "chat:") > 0 Тогда
					Возврат ЭлементDOM.id;
				КонецЕсли;
			Исключение
			КонецПопытки;
			Попытка
				Если ЗначениеЗаполнено(ЭлементDOM.href) Тогда
					Возврат ЭлементDOM.href;
				КонецЕсли;
			Исключение
			КонецПопытки;
			Попытка
				ЭлементDOM = ЭлементDOM.parentElement;
			Исключение
				ЭлементDOM = Неопределено;
			КонецПопытки;
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат "";

КонецФункции

// Переключает форму на выбранный в ленте диалог: загружает его сообщения
// (контекст для API восстанавливается целиком, включая вызовы инструментов).
//
// Параметры:
//   ИдЧата - Строка - XML-строка ссылки на диалог (из псевдо-ссылки карточки).
//
&НаКлиенте
Процедура ПереключитьЧат(ИдЧата)

	ВыбранныйЧат = НайтиЧатПоИд(ИдЧата);

	Если ВыбранныйЧат = Неопределено Или ВыбранныйЧат = ТекущийЧат Тогда
		ОбновитьСписокЧатовHTML();
		Возврат;
	КонецЕсли;

	ЗагрузитьЧатНаСервере(ВыбранныйЧат);
	СброситьСтатистикуСессии();
	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЖурнал(ЖурналАгента)

	ЖурналРаботы.Очистить();
	Для Каждого ЗаписьЖурнала Из ЖурналАгента Цикл
		НоваяСтрока = ЖурналРаботы.Добавить();
		НоваяСтрока.Итерация = ЗаписьЖурнала.Итерация;
		НоваяСтрока.Действие = ЗаписьЖурнала.Действие;
		НоваяСтрока.Инструмент = ЗаписьЖурнала.Инструмент;
		НоваяСтрока.Аргументы = ЗаписьЖурнала.Аргументы;
		НоваяСтрока.Результат = ЗаписьЖурнала.Результат;
		НоваяСтрока.ТокеныЗапроса = ЗаписьЖурнала.ТокеныЗапроса;
		НоваяСтрока.ТокеныОтвета = ЗаписьЖурнала.ТокеныОтвета;
	КонецЦикла;

КонецПроцедуры

// Дополняет таблицу «Рост диалога» строкой обращения (или отказа API):
// токены и время по обращению, стоимость шага и накопленная стоимость сессии.
//
// Параметры:
//   РезультатАгента - Структура, Неопределено - результат KimiАгентСервер.ВыполнитьЗапросАгента
//     (Неопределено для отклонённого запроса — фиксируется только примечание);
//   Примечание - Строка - текст ошибки для отклонённого запроса; пусто для успешного обмена.
//
&НаКлиенте
Процедура ДобавитьСтрокуРоста(РезультатАгента, Примечание)

	НоваяСтрока = РостДиалога.Добавить();
	НоваяСтрока.Шаг = РостДиалога.Количество();
	НоваяСтрока.Примечание = Примечание;

	Если РезультатАгента <> Неопределено Тогда
		НоваяСтрока.ТокеныЗапроса = РезультатАгента.ТокеныЗапросаВсего;
		НоваяСтрока.ТокеныОтвета = РезультатАгента.ТокеныОтветаВсего;
		НоваяСтрока.ВремяСекунд = Окр(РезультатАгента.ВремяМиллисекунд / 1000, 1);
		НоваяСтрока.Стоимость = РезультатАгента.Стоимость;
	КонецЕсли;
	НоваяСтрока.СтоимостьВсего = СтоимостьСессииВсего;

КонецПроцедуры

// Заполняет панель «Токены и стоимость»: разбор последнего обращения (оценка вопроса,
// фактические prompt/completion токены API, заполнение окна, стоимость) либо
// начальное состояние — вес загруженной истории и размер окна модели (День 8).
//
// Параметры:
//   РезультатАгента - Структура, Неопределено - результат KimiАгентСервер.ВыполнитьЗапросАгента;
//   ОценкаВопроса - Число - локальная оценка токенов отправленного вопроса.
//
&НаКлиенте
Процедура ОбновитьПанельТокенов(РезультатАгента = Неопределено, ОценкаВопроса = 0)

	СтрокиПанели = Новый Массив;

	Если РезультатАгента = Неопределено Тогда

		СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Отправьте вопрос — здесь появится разбор токенов (окно модели: %1 ток.).'"),
			ФорматЦелого(ЛимитКонтекста)));

		ВесИстории = ВесИстории();
		Если ВесИстории > 0 Тогда
			СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Вес истории: %1 ток. (%2 окна) — пишется в документ чата.'"),
				ФорматЦелого(ВесИстории), ФорматПроцентаЗаполнения(ВесИстории)));
		КонецЕсли;

	Иначе

		Рассуждение = "";
		Если РезультатАгента.ТокеныРассуждения > 0 Тогда
			Рассуждение = СтрШаблон(НСтр("ru = ' (в т.ч. рассуждение %1)'"), ФорматЦелого(РезультатАгента.ТокеныРассуждения));
		КонецЕсли;

		СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Вопрос: ~%1 ток. (оценка, точность ±20–30%%)'"),
			ФорматЦелого(ОценкаВопроса)));
		СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Запрос целиком: %1 ток. (факт API) · Ответ: %2 ток.%3'"),
			ФорматЦелого(РезультатАгента.ТокеныЗапроса), ФорматЦелого(РезультатАгента.ТокеныОтвета), Рассуждение));

		Если ЛимитКонтекста > 0 Тогда
			СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Окно контекста: %1 (%2 / %3)'"),
				ФорматПроцентаЗаполнения(РезультатАгента.ТокеныЗапроса),
				ФорматЦелого(РезультатАгента.ТокеныЗапроса), ФорматЦелого(ЛимитКонтекста)));
		Иначе
			СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Окно контекста модели не зафиксировано (факт запроса: %1 ток.)'"),
				ФорматЦелого(РезультатАгента.ТокеныЗапроса)));
		КонецЕсли;

		СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Стоимость: шаг $%1 · всего $%2 · расход сессии: %3 ток.'"),
			ФорматСтоимости(РезультатАгента.Стоимость), ФорматСтоимости(СтоимостьСессииВсего),
			ФорматЦелого(ТокеныСессииВсего)));

	КонецЕсли;

	ТокеныПанель = СтрСоединить(СтрокиПанели, Символы.ПС);

КонецПроцедуры

// Возвращает сумму токенов по строкам истории формы (сохранённые значения
// документа + факты ответов текущей сессии + оценки демо-сообщений).
//
&НаКлиенте
Функция ВесИстории()

	Сумма = 0;
	Для Каждого СтрокаИстории Из История Цикл
		Сумма = Сумма + СтрокаИстории.Токены;
	КонецЦикла;

	Возврат Сумма;

КонецФункции

// Возвращает процент заполнения контекстного окна для числа токенов;
// 0 — лимит модели не зафиксирован.
//
&НаКлиенте
Функция ФорматПроцентаЗаполнения(Токены)

	Если ЛимитКонтекста <= 0 Тогда
		Возврат НСтр("ru = '—'");
	КонецЕсли;

	Возврат Формат(Окр(Токены / ЛимитКонтекста * 100, 1), "ЧДЦ=1; ЧН=0") + "%";

КонецФункции

&НаКлиенте
Функция ФорматЦелого(Значение)

	Возврат Формат(Значение, "ЧГ=");

КонецФункции

&НаКлиенте
Функция ФорматСтоимости(Значение)

	Возврат Формат(Значение, "ЧДЦ=4; ЧГ=; ЧН=0");

КонецФункции

// Обнуляет накопленные за сессию просмотра чата счётчики (стоимость и токены)
// и таблицу роста диалога — при новом чате, переключении и удалении.
//
&НаКлиенте
Процедура СброситьСтатистикуСессии()

	СтоимостьСессииВсего = 0;
	ТокеныСессииВсего = 0;
	РостДиалога.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатус(РезультатАгента)

	ВремяСекунд = Окр(РезультатАгента.ВремяМиллисекунд / 1000, 1);
	СтатусОтвета = СтрШаблон(НСтр("ru = 'Итераций: %1 · Вызовов инструментов: %2 · Токены: %3 · Время: %4 с'"),
		РезультатАгента.ЧислоИтераций, РезультатАгента.ЧислоВызововИнструментов,
		РезультатАгента.ТокеныВсего, Формат(ВремяСекунд, "ЧГ="));

	Если РезультатАгента.ЛимитИтерацийИсчерпан Тогда
		СтатусОтвета = СтатусОтвета + " " + НСтр("ru = '(лимит итераций исчерпан)'");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	СтоимостьСессииВсего = 0;
	ТокеныСессииВсего = 0;

	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();

КонецПроцедуры

// Оценивает исходящий запрос до отправки: системный промпт агента + история + вопрос.
// Точных значений до вызова API нет (endpoint подсчёта у Kimi отсутствует) — оценка
// локальная; при превышении окна модели запрос предупреждается и требует подтверждения.
//
// Возвращаемое значение:
//   Структура:
//     * ОценкаЗапроса - Число - оценка токенов исходящего запроса целиком;
//     * ОценкаВопроса - Число - оценка токенов текста вопроса (последняя строка истории);
//     * Лимит - Число - размер контекстного окна модели (0 — не зафиксирован);
//     * Превышен - Булево - Истина, если оценка запроса больше окна.
//
&НаСервере
Функция ОценитьИсходящийЗапросНаСервере()

	ИсторияДиалога = РеквизитФормыВЗначение("История");

	ОценкаЗапроса = Новый Структура;
	ОценкаЗапроса.Вставить("ОценкаЗапроса", KimiАгентСервер.ОценитьИсходящийЗапрос(ИсторияДиалога));
	ОценкаЗапроса.Вставить("ОценкаВопроса", KimiТокеныСервер.ОценитьТокеныТекста(
		ИсторияДиалога[ИсторияДиалога.Количество() - 1].Текст)); // отправленный вопрос
	ОценкаЗапроса.Вставить("Лимит", ЛимитКонтекста);
	ОценкаЗапроса.Вставить("Превышен", ЛимитКонтекста > 0 И ОценкаЗапроса.ОценкаЗапроса > ЛимитКонтекста);

	Возврат ОценкаЗапроса;

КонецФункции

// Генерирует учебные демо-сообщения заданного вида (День 8): «длинный» — около
// 75 000 токенов, «переполнение» — заведомо больше контекстного окна модели.
//
// Параметры:
//   Вид - Строка - "длинный" или "переполнение".
//
// Возвращаемое значение:
//   Массив из Структура - сообщения с реквизитами Роль, Текст, Токены.
//
&НаСервере
Функция СообщенияДемоНаСервере(Вид)

	Если Вид = "переполнение" Тогда
		Лимит = ЛимитКонтекста;
		Если Лимит <= 0 Тогда
			Лимит = 1048576; // лимит модели агента зафиксирован — запасной вариант не понадобится
		КонецЕсли;
		Возврат KimiТокеныСервер.СообщенияДемоПереполнения(Лимит);
	КонецЕсли;

	Возврат KimiТокеныСервер.СообщенияДемоДлинногоКонтекста();

КонецФункции

&НаСервере
Функция ВыполнитьЗапросАгентаНаСервере()

	ИсторияДиалога = РеквизитФормыВЗначение("История");

	Возврат KimiАгентСервер.ВыполнитьЗапросАгента(ИсторияДиалога, Не ИнструментыВключены);

КонецФункции

&НаСервере
Процедура СохранитьТекущийЧатНаСервере()

	ИсторияДиалога = РеквизитФормыВЗначение("История");
	ТекущийЧат = KimiЧатыАгентаСервер.СохранитьДиалог(ТекущийЧат, ИсторияДиалога);
	ЗаголовокТекущегоЧата = ТекущийЧат.Наименование;

	ОбновитьСписокЧатовНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЧатНаСервере(Ссылка)

	ДанныеДиалога = KimiЧатыАгентаСервер.ЗагрузитьДиалог(Ссылка);
	ТекущийЧат = Ссылка;
	ЗаголовокТекущегоЧата = ДанныеДиалога.Наименование;
	ЗначениеВРеквизитФормы(ДанныеДиалога.История, "История");

	ЖурналРаботы.Очистить();
	РостДиалога.Очистить();
	СтатусОтвета = "";

	ОбновитьСписокЧатовНаСервере();

КонецПроцедуры

&НаСервере
Процедура НовыйЧатНаСервере()

	KimiЧатыАгентаСервер.ЗавершитьДиалог(ТекущийЧат);
	ТекущийЧат = Документы.KimiДиалог.ПустаяСсылка();
	ЗаголовокТекущегоЧата = "";
	История.Очистить();
	ЖурналРаботы.Очистить();
	РостДиалога.Очистить();
	СтатусОтвета = "";

	ОбновитьСписокЧатовНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокЧатовНаСервере()

	ЗначениеВРеквизитФормы(KimiЧатыАгентаСервер.СписокДиалогов(), "Чаты");

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИнструментыВключены = Истина;

	ЛимитМодели = KimiТокеныСервер.ЛимитКонтекста(KimiAPIСервер.МодельПоУмолчанию());
	ЛимитКонтекста = ?(ЛимитМодели = Неопределено, 0, ЛимитМодели);

	Активный = KimiЧатыАгентаСервер.АктивныйДиалог();
	Если Активный <> Неопределено Тогда
		ЗагрузитьЧатНаСервере(Активный);
	Иначе
		ОбновитьСписокЧатовНаСервере();
	КонецЕсли;

КонецПроцедуры
