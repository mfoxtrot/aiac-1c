&НаКлиенте
Перем СтоимостьСессииВсего;

&НаКлиенте
Перем ТокеныСессииВсего;

&НаКлиенте
Перем СтоимостьСжатияСессии;

&НаКлиенте
Перем ЧислоСжатийСессии;

// Состояние автоматического прогона (сценарий проверки деталей или контрольные вопросы):
// массив шагов, индекс следующего шага, режим ("сценарий"/"проверка") и флаг остановки.
&НаКлиенте
Перем ШагиАвтоПрогона;

&НаКлиенте
Перем ИндексАвтоШага;

&НаКлиенте
Перем РежимАвтоШага;

&НаКлиенте
Перем АвтоШагОстановлен;

// Счётчики последнего прогона сценария для таблицы сравнения стратегий (День 10):
// суммарные prompt-токены обменов прогона (сценарий + проверка деталей) и вызовы
// модели на поддержку стратегии (обновление фактов / перенос блоков в сводку) со
// стоимостью. Сбрасываются при старте нового прогона, переживают переключение чатов.
&НаКлиенте
Перем ТокеныЗапросаПрогона;

&НаКлиенте
Перем ВызовыПоддержкиПрогона;

&НаКлиенте
Перем СтоимостьПоддержкиПрогона;

// Этап проверки модели памяти (День 11): 0 — все слои заполнены, 1 — рабочая
// память очищена, 2 — новый чат (краткосрочная память сброшена), 3 — долговременная
// память очищена. Определяет колонку таблицы ПроверкаПамяти для фиксации отметок.
&НаКлиенте
Перем ЭтапПроверкиПамяти;

// Состояние повтора при перегрузке провайдера (hotfix при приёмке Дня 11):
// оценка запроса, сохранённая для повтора, и счётчик оставшихся попыток.
// Провайдеры (Kimi, бесплатный Gemini) при 429/5xx просят повторить позже —
// ждём на клиенте через однократный обработчик ожидания.
&НаКлиенте
Перем ОценкаЗапросаПовтора;

&НаКлиенте
Перем ОсталосьПовторовПриПерегрузке;

// Флаг плановой паузы сценария жизненного цикла (День 13): прогон остановился
// на достигнутом этапе, продолжение — кнопкой «Продолжить прогон».
&НаКлиенте
Перем ПаузаСценарияСостояния;

// Рабочий чат прогона «устареваниеДемо» (День 15): изменения фактов идут в нём,
// контрольные вопросы — в новых чатах; по сохранённой ссылке рабочий чат
// возвращается после каждого контроля (заполняется лениво — при первом
// сохранении рабочего чата внутри прогона).
&НаКлиенте
Перем РабочийЧатУстаревания;

// Нарушения инвариантов последнего обмена (День 14): кодовая проверка финального
// ответа до показа. Пустой массив — нарушений нет; непустой — ответ заменён
// служебным отказом (таблицы проверок фиксируют «заблокировано кодом»).
&НаКлиенте
Перем НарушенияПоследнегоОбмена;

&НаКлиенте
Процедура ОтправитьВопрос(Команда)

	ОтправитьВопросАгенту();

КонецПроцедуры

&НаКлиенте
Процедура НовыйЧат(Команда)

	НовыйЧатНаСервере();
	СброситьСтатистикуСессии();
	УстановитьВидимостьСтратегии();
	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();
	ОбновитьПанельСлоев();
	ОбновитьИндикаторСостояния();

КонецПроцедуры

// Создаёт ветку текущего диалога (ветвление, День 10): checkpoint — последнее
// сохранённое состояние чата. Текущий чат сначала сохраняется, затем от него
// отпочковывается новый документ-копия (история, стратегия, сводка, факты);
// исходник не меняется. Форма переключается на ветку — продолжайте диалог в ней;
// вторая ветка от того же места — ещё один клик (до продолжения диалога).
// Ветвление без подтверждения: создание документа обратимо (крестик в ленте).
//
&НаКлиенте
Процедура СоздатьВетку(Команда)

	Если История.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Ветвление диалога'"), ,
			НСтр("ru = 'Чат пуст — ветвить нечего. Сначала отправьте хотя бы одно сообщение.'"));
		Возврат;
	КонецЕсли;

	СохранитьТекущийЧат(); // checkpoint фиксирует сохранённое состояние документа
	Если Не ЗначениеЗаполнено(ТекущийЧат) Тогда
		Возврат; // сохранение не удалось — причина уже показана
	КонецЕсли;

	Ветка = СоздатьВеткуНаСервере();
	СброситьСтатистикуСессии();
	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();
	УстановитьВидимостьСтратегии();
	ОбновитьИндикаторСостояния();

	ПоказатьОповещениеПользователя(НСтр("ru = 'Ветвление диалога'"), ,
		НСтр("ru = 'Ветка создана от текущего места. Исходный чат не изменился — продолжайте диалог в ветке; вторая ветка — ещё один клик «Создать ветку».'"));

КонецПроцедуры

&НаСервере
Функция СоздатьВеткуНаСервере()

	Ветка = KimiЧатыАгентаСервер.СоздатьВетку(ТекущийЧат);
	ЗагрузитьЧатНаСервере(Ветка); // форма переключается на новую ветку
	ОбновитьСписокЧатовНаСервере();

	Возврат Ветка;

КонецФункции

&НаКлиенте
Процедура ДемоДлинныйКонтекст(Команда)

	ТекстВопроса = НСтр("ru = 'В историю чата добавятся учебные тексты суммарно около 75 000 токенов (сценарий «длинный диалог»). В ленте каждый фрагмент будет показан сокращённо с указанием веса. Следующий запрос агента уйдёт с таким контекстом — он станет заметно дороже и медленнее (порядка $0,2–0,6). Тексты попадут и в сохранённый документ чата.
		|Продолжить?'");
	ЗапроситьПодтверждениеДемо(ТекстВопроса, "длинный");

КонецПроцедуры

&НаКлиенте
Процедура ДемоПереполнение(Команда)

	ТекстВопроса = СтрШаблон(НСтр("ru = 'В историю чата добавятся учебные тексты суммарно около %1 токенов — заведомо больше контекстного окна модели. Следующий запрос будет честно отклонён API с ошибкой 400 об превышении лимита (отклонённые запросы не тарифицируются).
		|После этого агент не сможет отвечать в этом чате — выход только через «Новый чат». Демо-чат потом можно удалить крестиком в ленте.
		|Продолжить?'"), ФорматЦелого(Окр(ЛимитКонтекста * 1.15, 0)));
	ЗапроситьПодтверждениеДемо(ТекстВопроса, "переполнение");

КонецПроцедуры

// Спрашивает подтверждение перед наполнением истории учебными текстами
// (асинхронный вопрос — модальность запрещена).
//
// Параметры:
//   ТекстВопроса - Строка - текст подтверждения;
//   Вид - Строка - "длинный" или "переполнение" (передаётся в обработчик ответа).
//
&НаКлиенте
Процедура ЗапроситьПодтверждениеДемо(ТекстВопроса, Вид)

	Оповещение = Новый ОписаниеОповещения("ДемоПодтверждено", ЭтотОбъект, Вид);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);

КонецПроцедуры

// Добавляет подтверждённые демо-тексты в историю чата, сохраняет диалог
// (демо-история попадает в документ с токенами) и обновляет панель токенов.
//
// Параметры:
//   Результат - КодВозвратаДиалога - ответ пользователя;
//   Вид - Строка - "длинный" или "переполнение".
//
&НаКлиенте
Процедура ДемоПодтверждено(Результат, Вид) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СообщениеДемо Из СообщенияДемоНаСервере(Вид) Цикл
		НоваяСтрока = История.Добавить();
		НоваяСтрока.Роль = СообщениеДемо.Роль;
		НоваяСтрока.Текст = СообщениеДемо.Текст;
		НоваяСтрока.Отправлено = ТекущаяДата();
		НоваяСтрока.Токены = СообщениеДемо.Токены;
	КонецЦикла;

	ОбновитьЧат();
	ОбработатьРезультатСохранения(СохранитьТекущийЧат(), Ложь);
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();

КонецПроцедуры

// Принудительно сжимает историю текущего чата до заданного хвоста (кнопка
// «Сжать сейчас»): переносит в сводку все блоки, пока не-сжатая зона не уместится
// в хвост. Работает независимо от флажка автосжатия — для ручной демонстрации.
//
&НаКлиенте
Процедура СжатьСейчас(Команда)

	Если Не ЗначениеЗаполнено(ТекущийЧат) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Сжатие истории'"), ,
			НСтр("ru = 'Нет открытого чата — сжимать нечего.'"));
		Возврат;
	КонецЕсли;

	Попытка
		РезультатСохранения = СжатьСейчасНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Не удалось сжать историю:'") + " " + ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	Если РезультатСохранения <> Неопределено И Не РезультатСохранения.СжатиеПрименено
		И Не ЗначениеЗаполнено(РезультатСохранения.ОшибкаСжатия) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Сжатие истории'"), ,
			СтрШаблон(НСтр("ru = 'Не требуется: история уже умещается в хвост %1 сообщ.'"),
				ФорматЦелого(ХвостСообщений)));
	КонецЕсли;

	ОбработатьРезультатСохранения(РезультатСохранения, Истина);
	ОбновитьЧат();
	ОбновитьПанельТокенов();

КонецПроцедуры

// Запускает прогон учебного сценария на выбранной стратегии (День 10): сначала
// создаётся новый чат с этой стратегией — каждый прогон идёт в чистом диалоге,
// чтобы стратегии сравнивались честно (без наследия чужих сообщений). По ходу
// прогона стратегия поддерживается автоматически (окно — без вызовов модели,
// факты — обновление блока после каждого обмена, сводка — перенос блоков на пороге).
// После прогона — «Проверить детали», отметки «Помнит» и «Зафиксировать результат».
//
&НаКлиенте
Процедура ПрогнатьСценарий(Команда)

	ТекстВопроса = СтрШаблон(НСтр("ru = 'Будет создан новый чат со стратегией «%1» и прогнан учебный бриф проекта (около 14 обменов). По ходу брифа называются конкретные детали: имя, название, бюджет, срок, ограничение, ставка, решение по СУБД, условия оплаты. Стратегия будет поддерживаться автоматически; расход за прогон накапливается в счётчики сравнения. После прогона задайте контрольные вопросы кнопкой «Проверить детали».
		|Продолжить?'"), СтратегияПрогона);

	Оповещение = Новый ОписаниеОповещения("ПрогонСценарияПодтверждён", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);

КонецПроцедуры

// Создаёт чат прогона со стратегией сравнения и запускает автопрогон брифа
// после подтверждения.
//
&НаКлиенте
Процедура ПрогонСценарияПодтверждён(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	НовыйЧатНаСервере(); // завершает текущий диалог и очищает форму
	СтратегияКонтекста = СтратегияПрогона; // чат прогона живёт на выбранной стратегии
	УстановитьВидимостьСтратегии();

	ТокеныЗапросаПрогона = 0;
	ВызовыПоддержкиПрогона = 0;
	СтоимостьПоддержкиПрогона = 0;

	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();

	ШагиАвтоПрогона = СценарийПроверкиДеталейНаСервере();
	ИндексАвтоШага = 0;
	РежимАвтоШага = "сценарий";
	АвтоШагОстановлен = Ложь;
	ПодключитьОбработчикОжидания("ШагАвтоПрогона", 0.1, Истина);

КонецПроцедуры

// Переносит результат последнего прогона в строку сравнения текущей стратегии
// (кнопка «Зафиксировать результат», День 10): сколько контрольных деталей помнит
// (сумма ручных отметок «Помнит»), суммарные prompt-токены прогона и вызовы модели
// на поддержку стратегии со стоимостью. Счётчики прогона сбрасываются при старте
// следующего прогона — фиксировать нужно до него.
//
&НаКлиенте
Процедура ЗафиксироватьРезультат(Команда)

	СтрокаСравнения = Неопределено;
	Для Каждого СтрокаТаблицы Из СравнениеСтратегий Цикл
		Если СтрокаТаблицы.Стратегия = СтратегияКонтекста Тогда
			СтрокаСравнения = СтрокаТаблицы;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если СтрокаСравнения = Неопределено Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Сравнение стратегий'"), ,
			НСтр("ru = 'Текущая стратегия не найдена в таблице сравнения.'"));
		Возврат;
	КонецЕсли;

	ПомнитДеталей = 0;
	Для Каждого СтрокаПроверки Из ПроверкаДеталей Цикл
		Если СтрокаПроверки.Помнит Тогда
			ПомнитДеталей = ПомнитДеталей + 1;
		КонецЕсли;
	КонецЦикла;

	СтрокаСравнения.ДеталейПомнит = ПомнитДеталей;
	СтрокаСравнения.ВсегоДеталей = ПроверкаДеталей.Количество();
	СтрокаСравнения.ТокеныЗапроса = ТокеныЗапросаПрогона;
	СтрокаСравнения.ВызововПоддержки = ВызовыПоддержкиПрогона;
	СтрокаСравнения.СтоимостьПоддержки = СтоимостьПоддержкиПрогона;

	Если ПроверкаДеталей.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Сравнение стратегий'"), ,
			СтрШаблон(НСтр("ru = 'Зафиксировано для «%1» — но проверка деталей не выполнялась, отметок нет.'"),
				СтратегияКонтекста));
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Сравнение стратегий'"), ,
			СтрШаблон(НСтр("ru = 'Зафиксировано для «%1»: помнит %2 из %3 деталей.'"),
				СтратегияКонтекста, ФорматЦелого(ПомнитДеталей), ФорматЦелого(ПроверкаДеталей.Количество())));
	КонецЕсли;

КонецПроцедуры

// Запрашивает выводы по сравнению стратегий моделью-аналитиком (кнопка «Выводы
// аналитика», День 10): зафиксированные строки сравнения + последняя проверка
// деталей → рекомендации «какая стратегия для какого сценария» (по образцу
// аналитика Дней 4–5). Вывод заменяет предыдущий; ошибка вызова показывается
// в окне сообщений и не трогает старый текст.
//
&НаКлиенте
Процедура ВыводыАналитика(Команда)

	Если СравнениеСтратегий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ВыводыАналитика = ВыводыАналитикаНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Не удалось получить выводы аналитика:'") + " " + ОписаниеОшибки(),
			СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ВыводыАналитика) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Сравнение стратегий'"), ,
			НСтр("ru = 'Модель вернула пустой текст выводов.'"));
	Иначе
		ПоказатьВыводыАналитика(Неопределено); // полный текст сразу в окне — на форме видна строка
	КонецЕсли;

КонецПроцедуры

// Показывает полный текст выводов аналитика отдельным окном (кнопка «Показать
// выводы»): поле на форме вмещает одну строку, читать удобнее в диалоге.
// Модальность запрещена настройкой конфигурации — используем асинхронный
// ПоказатьПредупреждение (визуально то же окно с кнопкой «ОК»).
//
&НаКлиенте
Процедура ПоказатьВыводыАналитика(Команда)

	Если Не ЗначениеЗаполнено(ВыводыАналитика) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Сравнение стратегий'"), ,
			НСтр("ru = 'Выводов пока нет — сформируйте их кнопкой «Выводы аналитика».'"));
		Возврат;
	КонецЕсли;

	ПоказатьПредупреждение(Неопределено, ВыводыАналитика, , НСтр("ru = 'Выводы аналитика'"));

КонецПроцедуры

// Заполняет реестр контрольных деталей (если ещё пуст) и последовательно задаёт
// каждый контрольный вопрос агенту в текущем чате; ответы фиксируются в таблице,
// отметки «Помнит» проставляются вручную (сравнение «до/после» — флажком сжатия).
//
&НаКлиенте
Процедура ПроверитьДетали(Команда)

	Если История.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Проверка деталей'"), ,
			НСтр("ru = 'История пуста — сначала прогоните сценарий.'"));
		Возврат;
	КонецЕсли;

	ЗаполнитьРеестрДеталейНаСервере();

	ШагиАвтоПрогона = Новый Массив;
	Для Каждого СтрокаПроверки Из ПроверкаДеталей Цикл
		ШагиАвтоПрогона.Добавить(СтрокаПроверки);
	КонецЦикла;

	ИндексАвтоШага = 0;
	РежимАвтоШага = "проверка";
	АвтоШагОстановлен = Ложь;
	ПодключитьОбработчикОжидания("ШагАвтоПрогона", 0.1, Истина);

КонецПроцедуры

// Останавливает автоматический прогон между шагами (кнопка «Остановить»).
//
&НаКлиенте
Процедура ОстановитьПрогон(Команда)

	АвтоШагОстановлен = Истина;

КонецПроцедуры

// Выполняет один шаг автоматического прогона (сценарий или контрольные вопросы)
// и подключает следующий шаг через однократный обработчик ожидания: управление
// возвращается в цикл обработки событий, интерфейс обновляет прогресс, «Остановить»
// успевает отработать между шагами (по образцу прогонов Дней 3–5). Если обмен
// прерван ожиданием повтора при перегрузке провайдера, шаг не завершается:
// его продолжит ПовторитьОтправкуПослеПаузы (фиксация ответа и следующий шаг).
//
&НаКлиенте
Процедура ШагАвтоПрогона()

	Если АвтоШагОстановлен Тогда
		ЗавершитьАвтоПрогон(Ложь);
		Возврат;
	КонецЕсли;

	Если ИндексАвтоШага >= ШагиАвтоПрогона.Количество() Тогда
		ЗавершитьАвтоПрогон(Истина);
		Возврат;
	КонецЕсли;

	ТекущийШаг = ШагиАвтоПрогона[ИндексАвтоШага];
	ИндексАвтоШага = ИндексАвтоШага + 1;

	Если РежимАвтоШага = "памятьСценарий" Тогда
		ТекущийВопрос = ТекущийШаг.Текст; // шаг структуры сценария заполнения слоёв (День 11)
	ИначеЕсли РежимАвтоШага = "памятьВопросы" Тогда
		ТекущийВопрос = ТекущийШаг.Вопрос; // строка реестра контрольных вопросов памяти
	ИначеЕсли РежимАвтоШага = "персонализацияСравнение" Тогда
		// День 12: новый чат под профилем шага + строка таблицы сравнения;
		// вопрос — общий (ВопросСравнения), его подстановка ниже.
		ПодготовитьЧатСравненияПрофилей(ТекущийШаг);
		ТекущийВопрос = ВопросСравнения;
	ИначеЕсли РежимАвтоШага = "персонализацияУстойчивость" Тогда
		ТекущийВопрос = ТекущийШаг; // строка реестра 10 вопросов устойчивости
	ИначеЕсли РежимАвтоШага = "состояниеСценарий" Тогда
		ТекущийВопрос = ТекущийШаг; // строка сценария жизненного цикла задачи (День 13)
	ИначеЕсли РежимАвтоШага = "состояниеПроверка" Тогда
		ТекущийШаг.ЭтапДо = ЭтапЗадачи; // формальный этап до попытки — для автоотметки блокировки
		ТекущийВопрос = ТекущийШаг.Запрос;
	ИначеЕсли РежимАвтоШага = "инвариантыКонфликт" Или РежимАвтоШага = "инвариантыОбход" Тогда
		ТекущийВопрос = ТекущийШаг.Запрос; // строка реестра проверок инвариантов (День 14)
	ИначеЕсли РежимАвтоШага = "устареваниеДемо" Тогда
		Если ТекущийШаг.ТипШага = "контроль" Тогда
			// Контрольный вопрос — в НОВОМ чате: агент знает факт только из инъекции
			// памяти (решение заказчика, прецедент этапа 2 проверки Дня 11).
			ПодготовитьКонтрольныйЧатУстаревания();
			ТекущийВопрос = ТекущийШаг.Вопрос;
		Иначе
			ПодготовитьРабочийЧатУстаревания();
			ТекущийВопрос = ТекущийШаг.Текст;
		КонецЕсли;
	Иначе
		ТекущийВопрос = ?(РежимАвтоШага = "проверка", ТекущийШаг.Вопрос, ТекущийШаг);
	КонецЕсли;

	Если РежимАвтоШага = "проверка" Или РежимАвтоШага = "памятьВопросы" Тогда
		ИмяПрогона = НСтр("ru = 'Проверка деталей'");
	ИначеЕсли РежимАвтоШага = "состояниеСценарий" Тогда
		ИмяПрогона = НСтр("ru = 'Жизненный цикл'");
	ИначеЕсли РежимАвтоШага = "состояниеПроверка" Тогда
		ИмяПрогона = НСтр("ru = 'Проверка запрещённых переходов'");
	ИначеЕсли РежимАвтоШага = "инвариантыКонфликт" Тогда
		ИмяПрогона = НСтр("ru = 'Проверка: конфликт с инвариантом'");
	ИначеЕсли РежимАвтоШага = "инвариантыОбход" Тогда
		ИмяПрогона = НСтр("ru = 'Проверка: обход инварианта'");
	ИначеЕсли РежимАвтоШага = "устареваниеДемо" Тогда
		ИмяПрогона = НСтр("ru = 'Изменение фактов'");
	Иначе
		ИмяПрогона = НСтр("ru = 'Сценарий'");
	КонецЕсли;
	СтатусОтвета = СтрШаблон(НСтр("ru = '%1: шаг %2 из %3…'"),
		ИмяПрогона, ФорматЦелого(ИндексАвтоШага), ФорматЦелого(ШагиАвтоПрогона.Количество()));

	ОтправкаЗавершена = ОтправитьВопросАгенту();

	Если Не ОтправкаЗавершена Тогда
		Возврат; // обмен повторится после паузы при перегрузке — шаг продолжит ПовторитьОтправкуПослеПаузы
	КонецЕсли;

	Если РежимАвтоШага = "проверка" И Не АвтоШагОстановлен Тогда
		ТекущийШаг.Ответ = ПоследнийОтветАссистента();
	ИначеЕсли РежимАвтоШага = "памятьВопросы" И Не АвтоШагОстановлен Тогда
		ТекущийШаг.Ответ = ПоследнийОтветАссистента();
	ИначеЕсли РежимАвтоШага = "памятьСценарий" И Не АвтоШагОстановлен Тогда
		СохранитьОбменВСлой(ТекущийШаг); // явное наполнение заявленного шагом слоя памяти
	ИначеЕсли РежимАвтоШага = "персонализацияСравнение" И Не АвтоШагОстановлен Тогда
		ТекущийШаг.Ответ = ПоследнийОтветАссистента(); // пойдёт в строку сравнения при завершении
	ИначеЕсли РежимАвтоШага = "персонализацияУстойчивость" И Не АвтоШагОстановлен Тогда
		ЗафиксироватьОтветУстойчивости(ТекущийШаг);
	ИначеЕсли РежимАвтоШага = "состояниеСценарий" И Не АвтоШагОстановлен Тогда
		// Плановая пауза посередине сценария (День 13): прогон останавливается
		// на достигнутом этапе, следующий шаг не подключается — продолжение
		// кнопкой «Продолжить прогон»: состояние живёт в system и документе,
		// модель продолжает с того же шага без повторного объяснения контекста.
		Если ИндексАвтоШага = ПозицияПаузыСценарияСостояния() Тогда
			ПаузаСценарияСостояния = Истина;
			ДобавитьЗаписьСостоянияВЖурнал(СтрШаблон(НСтр("ru = 'пауза прогона: этап «%1», шаг «%2» — продолжите кнопкой «Продолжить прогон»'"),
				ПредставлениеЭтапаЗадачи(), ШагЗадачи));
			Возврат;
		КонецЕсли;
	ИначеЕсли РежимАвтоШага = "состояниеПроверка" И Не АвтоШагОстановлен Тогда
		ЗафиксироватьПопыткуПерехода(ТекущийШаг);
	ИначеЕсли РежимАвтоШага = "инвариантыКонфликт" И Не АвтоШагОстановлен Тогда
		ЗафиксироватьКонфликтИнварианта(ТекущийШаг);
	ИначеЕсли РежимАвтоШага = "инвариантыОбход" И Не АвтоШагОстановлен Тогда
		ЗафиксироватьПопыткуОбхода(ТекущийШаг);
		// Каждая попытка обхода — в чистом чате (решение заказчика, прецедент
		// Дней 10 и 12): следующий шаг начинается с нового чата. Ответ шага
		// зафиксирован выше — в Истории он уже не нужен.
		Если ИндексАвтоШага < ШагиАвтоПрогона.Количество() Тогда
			ПодготовитьНовыйЧатПроверкиИнвариантов();
		КонецЕсли;
	ИначеЕсли РежимАвтоШага = "устареваниеДемо" И Не АвтоШагОстановлен Тогда
		ЗафиксироватьШагУстаревания(ТекущийШаг);
	КонецЕсли;

	ПодключитьОбработчикОжидания("ШагАвтоПрогона", 0.1, Истина);

КонецПроцедуры

// Завершает автоматический прогон: уведомляет о завершении или об остановке.
// После проверки деталей (День 9) и контрольных вопросов памяти (День 11)
// автоматически запускается сверка ответов с эталонами простой моделью.
//
// Параметры:
//   ЗавершенПолностью - Булево - Истина, если все шаги выполнены.
//
&НаКлиенте
Процедура ЗавершитьАвтоПрогон(ЗавершенПолностью)

	Если Не ЗавершенПолностью Тогда
		ШагиАвтоПрогона = Неопределено;
		РежимАвтоШага = "";
		Возврат;
	КонецЕсли;

	ЗавершившийсяРежим = РежимАвтоШага;

	// Состояние прогона обнуляем ДО ветки продолжения: «памятьСценарий» вооружает
	// следующий прогон (ЗадатьВопросыПамяти) — свежее состояние не должно быть
	// затёрто (hotfix при приёмке Дня 11: падение ШагАвтоПрогона на Неопределено).
	// Ответы завершившегося прогона захватываем в локальную до очистки: режим
	// «персонализацияСравнение» переносит их в таблицу сравнения после обнуления.
	ЗавершившиесяШаги = ШагиАвтоПрогона;
	ШагиАвтоПрогона = Неопределено;
	РежимАвтоШага = "";

	Если ЗавершившийсяРежим = "проверка" Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Проверка деталей'"), ,
			НСтр("ru = 'Контрольные вопросы заданы — сверяем ответы с эталонами простой моделью…'"));
		ОценитьОтветы(Неопределено); // автоматическая сверка с эталонами и отметки «Помнит»
	ИначеЕсли ЗавершившийсяРежим = "памятьСценарий" Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Модель памяти'"), ,
			НСтр("ru = 'Слои заполнены — задаём контрольные вопросы (этап «все слои заполнены»)…'"));
		СохранитьТекущийЧат(); // заметки рабочей памяти последнего шага — в документ
		ЗадатьВопросыПамяти(Неопределено);
	ИначеЕсли ЗавершившийсяРежим = "памятьВопросы" Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Модель памяти'"), ,
			НСтр("ru = 'Ответы зафиксированы — сверяем с эталонами простой моделью…'"));
		ОценитьОтветыПамяти(Неопределено);
	ИначеЕсли ЗавершившийсяРежим = "персонализацияСравнение" Тогда
		ПеренестиОтветыСравненияВТаблицу(ЗавершившиесяШаги);
		ПоказатьОповещениеПользователя(НСтр("ru = 'Персонализация'"), ,
			НСтр("ru = 'Вопрос задан всем профилям — сверяем ответы с предпочтениями простой моделью…'"));
		ОценитьСоответствиеПрофилю(Неопределено);
	ИначеЕсли ЗавершившийсяРежим = "персонализацияУстойчивость" Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Персонализация'"), ,
			НСтр("ru = '10 вопросов заданы — сверяем ответы с предпочтениями профиля простой моделью…'"));
		ОценитьСоответствиеПрофилю(Неопределено);
	ИначеЕсли ЗавершившийсяРежим = "состояниеСценарий" Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Состояние задачи'"), ,
			СтрШаблон(НСтр("ru = 'Сценарий завершён: этап «%1», шаг «%2». Переходы и шаги — в журнале (вызовы task_set_stage/task_set_step в трассировке). Проверку запрещённых переходов запускайте кнопкой ниже.'"),
				ПредставлениеЭтапаЗадачи(), ШагЗадачи));
		ДобавитьЗаписьСостоянияВЖурнал(СтрШаблон(НСтр("ru = 'сценарий жизненного цикла завершён: этап «%1», шаг «%2»'"),
			ПредставлениеЭтапаЗадачи(), ШагЗадачи));
	ИначеЕсли ЗавершившийсяРежим = "состояниеПроверка" Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Состояние задачи'"), ,
			НСтр("ru = 'Попытки переходов зафиксированы — сверяем реакции ассистента простой моделью…'"));
		ОценитьОтветыСостояния(Неопределено);
	ИначеЕсли ЗавершившийсяРежим = "инвариантыКонфликт" Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Инварианты'"), ,
			НСтр("ru = 'Конфликтные запросы заданы. Объяснения отказов — в ленте чата, блокировки кода — в таблице проверки и журнале.'"));
	ИначеЕсли ЗавершившийсяРежим = "инвариантыОбход" Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Инварианты'"), ,
			НСтр("ru = 'Попытки обхода зафиксированы — сверяем реакции ассистента простой моделью (судья не видит сигналов кода)…'"));
		ОценитьОтветыИнвариантов(Неопределено);
	ИначеЕсли ЗавершившийсяРежим = "устареваниеДемо" Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Устаревание памяти'"), ,
			НСтр("ru = 'Сценарий завершён — сверяем ответы с эталонами простой моделью…'"));
		ОценитьОтветыУстаревания(Неопределено);
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Агент Kimi'"), ,
			НСтр("ru = 'Сценарий завершён — можно проверять детали.'"));
	КонецЕсли;

КонецПроцедуры

// Возвращает текст последнего непустого ответа ассистента в истории формы.
//
&НаКлиенте
Функция ПоследнийОтветАссистента()

	Индекс = История.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если История[Индекс].Роль = "assistant" И ЗначениеЗаполнено(История[Индекс].Текст) Тогда
			Возврат История[Индекс].Текст;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат "";

КонецФункции

&НаКлиенте
Функция ОтправитьВопросАгенту()

	ТекстВопроса = СокрЛП(ТекущийВопрос);
	Если Не ЗначениеЗаполнено(ТекстВопроса) Тогда
		Возврат Истина;
	КонецЕсли;

	ДобавитьСообщениеВИсторию("user", ТекстВопроса);
	ТекущийВопрос = "";

	ПоказатьОповещениеПользователя(НСтр("ru = 'Агент Kimi'"), , НСтр("ru = 'Выполняется запрос…'"));

	ОсталосьПовторовПриПерегрузке = ЛимитПовторовПриПерегрузке(); // свежий обмен — полный запас повторов

	// Оценка исходящего запроса до отправки (День 8): при активном сжатии оценивается
	// фактический контекст (сводка + хвост). Если контекст тяжелее окна модели,
	// API отклонит запрос — предупреждаем и даём отступить, либо отправить «в стену» наглядно.
	ОценкаЗапроса = ОценитьИсходящийЗапросНаСервере();

	Если ОценкаЗапроса.Превышен Тогда
		ПодтвердитьОтправкуПриПереполнении(ОценкаЗапроса);
		Возврат Истина; // дальше либо подтверждение, либо отказ — обмен завершён
	КонецЕсли;

	Возврат ОтправитьОцененныйВопрос(ОценкаЗапроса);

КонецФункции

// Спрашивает подтверждение отправки заведомо переполненного запроса.
//
// Параметры:
//   ОценкаЗапроса - Структура - см. ОценитьИсходящийЗапросНаСервере.
//
&НаКлиенте
Процедура ПодтвердитьОтправкуПриПереполнении(ОценкаЗапроса)

	ТекстВопроса = СтрШаблон(НСтр("ru = 'Оценка исходящего запроса — %1 ток., это больше контекстного окна модели (%2 ток.). API почти наверняка отклонит запрос с ошибкой 400.
		|Отправить запрос и увидеть реакцию API?
		|
		|«Нет» — убрать вопрос из истории и остаться в чате.'"),
		ФорматЦелого(ОценкаЗапроса.ОценкаЗапроса), ФорматЦелого(ОценкаЗапроса.Лимит));

	Оповещение = Новый ОписаниеОповещения("ОтправкаПриПереполненииПодтверждена", ЭтотОбъект, ОценкаЗапроса);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);

КонецПроцедуры

// Продолжает или отменяет отправку после ответа на вопрос о переполнении.
//
// Параметры:
//   Результат - КодВозвратаДиалога - ответ пользователя;
//   ОценкаЗапроса - Структура - см. ОценитьИсходящийЗапросНаСервере.
//
&НаКлиенте
Процедура ОтправкаПриПереполненииПодтверждена(Результат, ОценкаЗапроса) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		История.Удалить(История.Количество() - 1);
		ОбновитьЧат();
		ОбновитьПанельТокенов();
		Возврат;
	КонецЕсли;

	ОтправитьОцененныйВопрос(ОценкаЗапроса);

КонецПроцедуры

// Выполняет запрос агента и разбирает результат: история, журнал, статус,
// панель токенов и таблица роста диалога (День 8), сжатие истории (День 9):
// сохранение возвращает информацию о переносе блока в сводку — она фиксируется
// в журнале, реквизитах формы и сессионной статистике сжатия.
// Возвращает Истина, если обмен завершён (успех или терминальная ошибка);
// Ложь — запланирован повтор после паузы при перегрузке провайдера (hotfix
// при приёмке Дня 11): шаг автопрогона продолжит ПовторитьОтправкуПослеПаузы.
//
// Параметры:
//   ОценкаЗапроса - Структура - см. ОценитьИсходящийЗапросНаСервере.
//
&НаКлиенте
Функция ОтправитьОцененныйВопрос(ОценкаЗапроса)

	ОценкаЗапросаПовтора = ОценкаЗапроса; // материал для повтора при перегрузке провайдера

	Попытка
		РезультатАгента = ВыполнитьЗапросАгентаНаСервере();
	Исключение
		Возврат Не ОбработатьОшибкуОтправки(ОписаниеОшибки(), ОценкаЗапроса);
	КонецПопытки;

	ЗавершитьОтправку(РезультатАгента, ОценкаЗапроса.ОценкаВопроса);

	Возврат Истина;

КонецФункции

// Завершает обмен после успешного вызова агента: история, журнал, статус,
// панель токенов, таблица роста диалога и события слоёв памяти (День 11).
// Общий хвост ручной отправки и повтора при перегрузке провайдера.
//
// Параметры:
//   РезультатАгента - Структура - результат KimiАгентСервер.ВыполнитьЗапросАгента;
//   ОценкаВопроса - Число - локальная оценка токенов отправленного вопроса.
//
&НаКлиенте
Процедура ЗавершитьОтправку(РезультатАгента, ОценкаВопроса)

	ДобавитьСообщенияАгентаВИсторию(РезультатАгента.НовыеСообщения);
	РезультатСохранения = СохранитьТекущийЧат();

	СтоимостьСессииВсего = СтоимостьСессииВсего + РезультатАгента.Стоимость;
	ТокеныСессииВсего = ТокеныСессииВсего + РезультатАгента.ТокеныВсего;
	Если РежимАвтоШага = "сценарий" Или РежимАвтоШага = "проверка" Тогда
		// обмен автопрогона сравнения стратегий: prompt-токены идут в счётчики прогона
		ТокеныЗапросаПрогона = ТокеныЗапросаПрогона + РезультатАгента.ТокеныЗапросаВсего;
	КонецЕсли;

	ЗаполнитьЖурнал(РезультатАгента.Журнал);
	ОбработатьРезультатСохранения(РезультатСохранения, Истина);
	ОбновитьСтатус(РезультатАгента);
	ОбновитьПанельТокенов(РезультатАгента, ОценкаВопроса);
	ДобавитьСтрокуРоста(РезультатАгента, "");
	ДобавитьЗаписьПамятиВЖурнал(ТекстПамятиЗапроса(РезультатАгента)); // слои памяти в запросе (День 11)
	Если ЗначениеЗаполнено(РезультатАгента.Профиль) Тогда
		// Персонализация (День 12): профиль добавлен к запросу — вес блока в журнале.
		ДобавитьЗаписьПерсонализацииВЖурнал(СтрШаблон(НСтр("ru = 'профиль «%1» добавлен в запрос (~%2 ток.)'"),
			РезультатАгента.Профиль, ФорматЦелого(РезультатАгента.ТокеныПрофиль)));
	КонецЕсли;

	// Инварианты (День 14): итог кодовой проверки финального ответа — в клиентское
	// состояние (таблицы проверок фиксируют «заблокировано кодом») и в журнал.
	НарушенияПоследнегоОбмена = Новый Массив;
	НарушенияОбмена = Неопределено;
	Если РезультатАгента.Свойство("НарушенияИнвариантов", НарушенияОбмена) И НарушенияОбмена <> Неопределено Тогда
		НарушенияПоследнегоОбмена = НарушенияОбмена;
	КонецЕсли;
	Если НарушенияПоследнегоОбмена.Количество() > 0 Тогда
		ДобавитьЗаписьИнвариантовВЖурнал(СтрШаблон(НСтр("ru = 'ответ заблокирован кодом до показа: %1'"),
			ПредставлениеНарушенийОбмена(НарушенияПоследнегоОбмена)));
	КонецЕсли;

	// Состояние задачи (День 13): итог обмена от цикла агента — инструменты
	// task_set_stage/task_set_step мутировали структуру состояния, переходы
	// проверены кодом. Реквизиты формы, индикатор и журнал (смена этапа —
	// отдельным событием, смена шага видна в вызовах инструментов трассировки).
	СостояниеПослеОбмена = Неопределено;
	Если РезультатАгента.Свойство("СостояниеЗадачи", СостояниеПослеОбмена)
		И СостояниеПослеОбмена <> Неопределено Тогда
		ПрежнийЭтап = ЭтапЗадачи;
		ЭтапЗадачи = СостояниеПослеОбмена.Этап;
		ШагЗадачи = СостояниеПослеОбмена.Шаг;
		ОжидаемоеДействиеЗадачи = СостояниеПослеОбмена.ОжидаемоеДействие;
		Если ПрежнийЭтап <> ЭтапЗадачи Тогда
			ДобавитьЗаписьСостоянияВЖурнал(СтрШаблон(НСтр("ru = 'этап: %1 → %2 · шаг «%3»'"),
				ПредставлениеЭтапаЗадачиПоИд(ПрежнийЭтап), ПредставлениеЭтапаЗадачи(), ШагЗадачи));
		КонецЕсли;
		ОбновитьИндикаторСостояния();
	КонецЕсли;
	Если РезультатАгента.РезервныйПровайдер Тогда
		// Честная фиксация подмены провайдера (hotfix при приёмке): иначе ответы
		// резервной модели неотличимы от основной — демо должно показывать правду.
		ДобавитьЗаписьПамятиВЖурнал(СтрШаблон(НСтр("ru = 'Kimi перегружен — обмен выполнен резервной моделью %1'"),
			РезультатАгента.РезервнаяМодель));
	КонецЕсли;
	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();

КонецПроцедуры

// Повторяет обмен после паузы при перегрузке провайдера (429/5xx): запрос
// уходит с тем же контекстом (вопрос уже в истории, оценка сохранена).
// После успеха продолжает прерванный шаг автопрогона — фиксацию ответа и
// подключение следующего шага выполняет ПродолжитьШагАвтоПрогонаПослеПовтора.
//
&НаКлиенте
Процедура ПовторитьОтправкуПослеПаузы()

	СтатусОтвета = НСтр("ru = 'Повторяем запрос после паузы…'");

	Попытка
		РезультатАгента = ВыполнитьЗапросАгентаНаСервере();
	Исключение
		ОбработатьОшибкуОтправки(ОписаниеОшибки(), ОценкаЗапросаПовтора);
		Возврат;
	КонецПопытки;

	ЗавершитьОтправку(РезультатАгента, ОценкаЗапросаПовтора.ОценкаВопроса);
	ПродолжитьШагАвтоПрогонаПослеПовтора();

КонецПроцедуры

// Продолжает шаг автопрогона, прерванный ожиданием повтора при перегрузке
// провайдера: фиксирует ответ шага (как делал бы ШагАвтоПрогона) и подключает
// следующий шаг. При ручной отправке и остановленном прогоне — ничего не делает.
//
&НаКлиенте
Процедура ПродолжитьШагАвтоПрогонаПослеПовтора()

	Если РежимАвтоШага = "" Или АвтоШагОстановлен Тогда
		Возврат;
	КонецЕсли;

	ТекущийШаг = ШагиАвтоПрогона[ИндексАвтоШага - 1];
	Если РежимАвтоШага = "проверка" Или РежимАвтоШага = "памятьВопросы" Тогда
		ТекущийШаг.Ответ = ПоследнийОтветАссистента();
	ИначеЕсли РежимАвтоШага = "памятьСценарий" Тогда
		СохранитьОбменВСлой(ТекущийШаг);
	ИначеЕсли РежимАвтоШага = "персонализацияСравнение" Тогда
		ТекущийШаг.Ответ = ПоследнийОтветАссистента();
	ИначеЕсли РежимАвтоШага = "персонализацияУстойчивость" Тогда
		ЗафиксироватьОтветУстойчивости(ТекущийШаг);
	ИначеЕсли РежимАвтоШага = "состояниеПроверка" Тогда
		ЗафиксироватьПопыткуПерехода(ТекущийШаг);
	ИначеЕсли РежимАвтоШага = "инвариантыКонфликт" Тогда
		ЗафиксироватьКонфликтИнварианта(ТекущийШаг);
	ИначеЕсли РежимАвтоШага = "инвариантыОбход" Тогда
		ЗафиксироватьПопыткуОбхода(ТекущийШаг);
		Если ИндексАвтоШага < ШагиАвтоПрогона.Количество() Тогда
			ПодготовитьНовыйЧатПроверкиИнвариантов();
		КонецЕсли;
	КонецЕсли;

	ПодключитьОбработчикОжидания("ШагАвтоПрогона", 0.1, Истина);

КонецПроцедуры

// Разбирает ошибку вызова агента. Перегрузка провайдера (HTTP 429/5xx — провайдер
// просит повторить позже) не рвёт обмен: ждём паузу на клиенте через однократный
// обработчик ожидания и повторяем запрос, счётчик попыток ограничен (hotfix
// при приёмке Дня 11). Переполнение контекста (ошибка 400 с упоминанием context)
// показываем отдельно — это сценарий задания Дня 8: запрос отклонён, диалог
// «сломан», агент не может продолжать. Прочая ошибка после исчерпания попыток
// останавливает автоматический прогон.
// Возвращает Истина, если запланирован повтор после паузы.
//
// Параметры:
//   ТекстОшибки - Строка - ОписаниеОшибки() из попытки;
//   ОценкаЗапроса - Структура - см. ОценитьИсходящийЗапросНаСервере.
//
&НаКлиенте
Функция ОбработатьОшибкуОтправки(ТекстОшибки, ОценкаЗапроса)

	Если ОсталосьПовторовПриПерегрузке > 0 И ЭтоОшибкаПерегрузкиПровайдера(ТекстОшибки) Тогда
		ОсталосьПовторовПриПерегрузке = ОсталосьПовторовПриПерегрузке - 1;
		СтатусОтвета = СтрШаблон(НСтр("ru = 'Провайдер API перегружен (ошибка 429/5xx). Повторим через %1 с (осталось попыток: %2)…'"),
			ФорматЦелого(ПаузаПовтораПриПерегрузке()), ФорматЦелого(ОсталосьПовторовПриПерегрузке));
		ПодключитьОбработчикОжидания("ПовторитьОтправкуПослеПаузы", ПаузаПовтораПриПерегрузке(), Истина);
		Возврат Истина;
	КонецЕсли;

	АвтоШагОстановлен = Истина;

	Если ЭтоОшибкаПереполненияКонтекста(ТекстОшибки) Тогда
		ТокеныПанель = СтрШаблон(НСтр("ru = 'Запрос отклонён API: превышен лимит контекста.
			|Оценка запроса: %1 ток. — больше окна модели (%2 ток.).
			|Агент не может продолжить этот диалог: контекст автоматически не обрезается. Выход — «Новый чат».'"),
			ФорматЦелого(ОценкаЗапроса.ОценкаЗапроса), ФорматЦелого(ОценкаЗапроса.Лимит));
		ДобавитьСтрокуРоста(Неопределено, НСтр("ru = 'отклонено API: превышен лимит контекста'"));
	Иначе
		Сообщить(ТекстОшибки, СтатусСообщения.Важное);
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Распознаёт временную перегрузку провайдера по тексту исключения: HTTP 429
// («engine is currently overloaded», лимиты бесплатных тарифов) или 5xx.
// Ошибки 4xx иные (в частности 400 о превышении контекста) повтору не подлежат.
//
&НаКлиенте
Функция ЭтоОшибкаПерегрузкиПровайдера(ТекстОшибки)

	НижнийРегистр = НРег(ТекстОшибки);

	Возврат СтрНайти(НижнийРегистр, "код состояния 429") > 0
		Или СтрНайти(НижнийРегистр, "status 429") > 0
		Или СтрНайти(НижнийРегистр, "код состояния 5") > 0
		Или СтрНайти(НижнийРегистр, "overloaded") > 0
		Или СтрНайти(НижнийРегистр, "try again later") > 0
		Или СтрНайти(НижнийРегистр, "too many requests") > 0;

КонецФункции

// Возвращает паузу перед повтором при перегрузке провайдера, секунд.
//
&НаКлиенте
Функция ПаузаПовтораПриПерегрузке()

	Возврат 20;

КонецФункции

// Возвращает число повторов обмена при перегрузке провайдера (первый вызов
// плюс повторы) до показа ошибки и остановки прогона.
//
&НаКлиенте
Функция ЛимитПовторовПриПерегрузке()

	Возврат 3;

КонецФункции

// Распознаёт ошибку переполнения контекста по тексту исключения: HTTP 400 и упоминание
// context (формулировка тела ответа зависит от провайдера — сверяем по двум признакам).
//
&НаКлиенте
Функция ЭтоОшибкаПереполненияКонтекста(ТекстОшибки)

	НижнийРегистр = НРег(ТекстОшибки);
	Возврат СтрНайти(НижнийРегистр, "400") > 0 И СтрНайти(НижнийРегистр, "context") > 0;

КонецФункции

// Сохраняет текущий диалог в документ; неуспех сохранения не отменяет показ ответа,
// но сообщается пользователю (контекст перезапуска не восстановится).
// Возвращает результат сохранения (День 9: в т.ч. информацию о сжатии истории).
//
&НаКлиенте
Функция СохранитьТекущийЧат()

	Попытка
		Возврат СохранитьТекущийЧатНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Не удалось сохранить диалог:'") + " " + ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Разбирает результат сохранения диалога: обновляет сводку, границу сжатой зоны
// и блок фактов на форме, накапливает статистику поддержки стратегии сессии,
// дописывает события в журнал работы (после ЗаполнитьЖурнал — чтобы записи не были
// затёрты), сообщает об ошибках поддержки (сохранение при этом выполнено — диалог
// просто остался в прежнем состоянии). Счётчики прогона сравнения стратегий (День 10)
// пополняются только обменами автопрогона (режимы «сценарий»/«проверка»).
//
// Параметры:
//   РезультатСохранения - Структура, Неопределено - см. KimiЧатыАгентаСервер.СохранитьДиалог;
//   ДописатьВЖурнал - Булево - Истина: события поддержки дописываются в журнал работы.
//
&НаКлиенте
Процедура ОбработатьРезультатСохранения(РезультатСохранения, ДописатьВЖурнал)

	Если РезультатСохранения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СводкаТекст = РезультатСохранения.Сводка;
	СжатоДо = РезультатСохранения.СжатоДо;

	ЭтоШагПрогона = (РежимАвтоШага = "сценарий" Или РежимАвтоШага = "проверка");

	Если РезультатСохранения.СжатиеПрименено Тогда
		ИнфоСжатие = РезультатСохранения.ИнфоСжатие;
		СтоимостьСжатияСессии = СтоимостьСжатияСессии + ИнфоСжатие.Стоимость;
		ЧислоСжатийСессии = ЧислоСжатийСессии + 1;
		Если ЭтоШагПрогона Тогда
			ВызовыПоддержкиПрогона = ВызовыПоддержкиПрогона + 1;
			СтоимостьПоддержкиПрогона = СтоимостьПоддержкиПрогона + ИнфоСжатие.Стоимость;
		КонецЕсли;
		Если ДописатьВЖурнал Тогда
			ДобавитьЗаписьСжатияВЖурнал(ИнфоСжатие);
		КонецЕсли;
	КонецЕсли;

	Если РезультатСохранения.ФактыОбновлены Тогда
		ИнфоФакты = РезультатСохранения.ИнфоФакты;
		Если ЭтоШагПрогона Тогда
			ВызовыПоддержкиПрогона = ВызовыПоддержкиПрогона + 1;
			СтоимостьПоддержкиПрогона = СтоимостьПоддержкиПрогона + ИнфоФакты.Стоимость;
		КонецЕсли;
		Если ДописатьВЖурнал Тогда
			ДобавитьЗаписьФактовВЖурнал(РезультатСохранения.ЧислоФактов, ИнфоФакты);
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(РезультатСохранения.ОшибкаСжатия) Тогда
		Сообщить(СтрШаблон(НСтр("ru = 'Сжатие истории не выполнено: %1'"), РезультатСохранения.ОшибкаСжатия),
			СтатусСообщения.Важное);
	КонецЕсли;

	Если ЗначениеЗаполнено(РезультатСохранения.ОшибкаФактов) Тогда
		Сообщить(СтрШаблон(НСтр("ru = 'Обновление фактов не выполнено: %1'"), РезультатСохранения.ОшибкаФактов),
			СтатусСообщения.Важное);
	КонецЕсли;

КонецПроцедуры

// Дописывает в журнал работы агента событие переноса блока истории в сводку.
//
// Параметры:
//   ИнфоСжатие - Структура - см. ИнфоСжатие в возвращаемом значении KimiЧатыАгентаСервер.СохранитьДиалог.
//
&НаКлиенте
Процедура ДобавитьЗаписьСжатияВЖурнал(ИнфоСжатие)

	НоваяСтрока = ЖурналРаботы.Добавить();
	НоваяСтрока.Итерация = 0;
	НоваяСтрока.Действие = НСтр("ru = 'Сжатие'");
	НоваяСтрока.Результат = СтрШаблон(НСтр("ru = 'в сводку перенесено %1 сообщ. · вызов модели: %2 → %3 ток. · $%4'"),
		ФорматЦелого(ИнфоСжатие.СжатоСообщений), ФорматЦелого(ИнфоСжатие.ТокеныЗапроса),
		ФорматЦелого(ИнфоСжатие.ТокеныОтвета), ФорматСтоимости(ИнфоСжатие.Стоимость));

КонецПроцедуры

// Дописывает в журнал работы агента событие обновления блока фактов
// (поддержка стратегии «Факты», День 10).
//
// Параметры:
//   ЧислоФактов - Число - размер обновлённого блока;
//   ИнфоФакты - Структура - см. ИнфоФакты в возвращаемом значении KimiЧатыАгентаСервер.СохранитьДиалог.
//
&НаКлиенте
Процедура ДобавитьЗаписьФактовВЖурнал(ЧислоФактов, ИнфоФакты)

	НоваяСтрока = ЖурналРаботы.Добавить();
	НоваяСтрока.Итерация = 0;
	НоваяСтрока.Действие = НСтр("ru = 'Факты'");
	НоваяСтрока.Результат = СтрШаблон(НСтр("ru = 'обновлён блок фактов: %1 шт. · вызов модели: %2 → %3 ток. · $%4'"),
		ФорматЦелого(ЧислоФактов), ФорматЦелого(ИнфоФакты.ТокеныЗапроса),
		ФорматЦелого(ИнфоФакты.ТокеныОтвета), ФорматСтоимости(ИнфоФакты.Стоимость));

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСообщениеВИсторию(Роль, ТекстСообщения)

	НоваяСтрока = История.Добавить();
	НоваяСтрока.Роль = Роль;
	НоваяСтрока.Текст = ТекстСообщения;
	НоваяСтрока.Отправлено = ТекущаяДата();

	ОбновитьЧат();

КонецПроцедуры

// Дописывает в историю сообщения, добавленные циклом агента (ответы ассистента,
// включая промежуточные с вызовами инструментов, и tool-сообщения с результатами).
// Служебные реквизиты (вызовы инструментов, идентификаторы вызовов, токены ответа)
// сохраняются в истории — из них без потерь восстанавливается контекст для API,
// а токены ассистента — факт из usage для колонки ТЧ документа (День 8).
//
// Параметры:
//   НовыеСообщения - Массив из Структура - см. KimiАгентСервер.ВыполнитьЗапросАгента.
//
&НаКлиенте
Процедура ДобавитьСообщенияАгентаВИсторию(НовыеСообщения)

	Для Каждого Сообщение Из НовыеСообщения Цикл
		НоваяСтрока = История.Добавить();
		НоваяСтрока.Роль = Сообщение.Роль;
		НоваяСтрока.Текст = ?(Сообщение.Текст = Неопределено, "", Сообщение.Текст);
		НоваяСтрока.Отправлено = ТекущаяДата();

		ТокеныОтвета = Неопределено;
		Если Сообщение.Свойство("ТокеныОтвета", ТокеныОтвета) Тогда
			НоваяСтрока.Токены = ТокеныОтвета;
		КонецЕсли;

		ВызовыИнструментов = Неопределено;
		Если Сообщение.Свойство("ВызовыИнструментов", ВызовыИнструментов)
			И ВызовыИнструментов.Количество() > 0 Тогда
			НоваяСтрока.ВызовыИнструментов = ВызовыИнструментовВJSON(ВызовыИнструментов);
		КонецЕсли;

		ИдВызова = Неопределено;
		Если Сообщение.Свойство("ИдВызова", ИдВызова) Тогда
			НоваяСтрока.ИдВызова = ИдВызова;
		КонецЕсли;
	КонецЦикла;

	ОбновитьЧат();

КонецПроцедуры

// Сериализует вызовы инструментов сообщения в JSON-строку для хранения в истории.
// Ключи wire-формата (id/name/arguments) — так сериализация не зависит от имён
// полей внутренних структур.
//
&НаКлиенте
Функция ВызовыИнструментовВJSON(ВызовыИнструментов)

	ДанныеВызовов = Новый Массив;
	Для Каждого Вызов Из ВызовыИнструментов Цикл
		ДанныеВызовов.Добавить(Новый Структура("id, name, arguments", Вызов.Ид, Вызов.Имя, Вызов.Аргументы));
	КонецЦикла;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеВызовов);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Пересобирает HTML чата из истории диалога: каждое сообщение — «пузырь» с рамкой
// и скруглением, сообщения пользователя прижаты вправо, модели — влево,
// внизу пузыря мелкая метка с датой и временем. Сообщения выводятся в обратном
// порядке (новые первыми в разметке) — контейнер column-reverse показывает их снизу.
// Служебные сообщения в ленте не показываются: tool, пустые ответы ассистента
// с вызовами инструментов (их след — в журнале работы агента). Демо-фрагменты
// контекста (День 8) показываются усечённо — начало текста с меткой веса фрагмента
// (полные тексты: сотни фрагментов по ~10k символов убьют производительность
// HTML-поля) — сокращение выполняется в БлокСообщенияHTML. При активной сводке
// (стратегия «Сводка», День 9) между сжатой и не-сжатой зонами выводится
// разделитель-индикатор: в запрос уходит сводка, а не показанные выше сообщения
// целиком. При стратегии «Окно» (День 10) — разделитель на границе окна: выше
// линии в запрос не попадает ничего. Отображённая история всегда полная —
// старое отбрасывает только проекция в API, а не лента.
//
&НаКлиенте
Процедура ОбновитьЧат()

	ЧастиHTML = Новый Массив;
	ЧастиHTML.Добавить(ЗаголовокHTMLЧата());

	ГраницаИндикатора = ГраницаИндикатораКонтекста();

	РазделительДобавлен = Ложь;
	Индекс = История.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если Не РазделительДобавлен И ГраницаИндикатора >= 0 И Индекс < ГраницаИндикатора Тогда
			ЧастиHTML.Добавить(РазделительКонтекстаHTML());
			РазделительДобавлен = Истина;
		КонецЕсли;
		Если История[Индекс].Роль <> "tool" И ЗначениеЗаполнено(История[Индекс].Текст) Тогда
			ЧастиHTML.Добавить(БлокСообщенияHTML(История[Индекс]));
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	ЧастиHTML.Добавить("</div></body></html>");

	ЧатHTML = СтрСоединить(ЧастиHTML, Символы.ПС);

КонецПроцедуры

// Возвращает индекс границы индикатора контекста в истории: для сводки — граница
// сжатой зоны, для окна — граница последних N сообщений (визуальный ориентир:
// выше линии сообщения в запрос не уходят). -1 — индикатор не нужен.
//
&НаКлиенте
Функция ГраницаИндикатораКонтекста()

	Если СтратегияКонтекста = ИдСтратегииСводка() И СжатоДо > 0 Тогда
		Возврат СжатоДо;
	КонецЕсли;

	Если СтратегияКонтекста = ИдСтратегииОкно() Тогда
		Возврат История.Количество() - ХвостСообщений; // отрицательное — линия не потребуется
	КонецЕсли;

	Возврат -1;

КонецФункции

// Возвращает HTML разделителя проекции контекста (Дни 9–10): для сводки — между
// сжатой и не-сжатой зонами, для окна — на границе окна.
//
&НаКлиенте
Функция РазделительКонтекстаHTML()

	Если СтратегияКонтекста = ИдСтратегииОкно() Тогда
		ТекстРазделителя = СтрШаблон(НСтр("ru = '— выше: за пределами окна — в запрос уходят только последние %1 сообщ. —'"),
			ФорматЦелого(ХвостСообщений));
	Иначе
		ТекстРазделителя = СтрШаблон(НСтр("ru = '— выше: сводка · %1 сообщ. заменены резюме (в запрос уходит сводка + последние %2 как есть) —'"),
			ФорматЦелого(СжатоДо), ФорматЦелого(ХвостСообщений));
	КонецЕсли;

	Возврат СтрШаблон(
		"<div class=""cut"">%1</div>",
		ЭкранироватьHTML(ТекстРазделителя));

КонецФункции

// Возвращает маркер начала демо-фрагментов контекста (День 8): такие сообщения
// выводятся в ленте усечённо с отдельным оформлением, но участвуют в запросах
// API, сохранении и подсчёте токенов полнотекстово.
//
&НаКлиенте
Функция МаркерДемоСообщения()

	Возврат НСтр("ru = 'Учебный фрагмент контекста №'");

КонецФункции

// Возвращает шапку HTML-чата: оформление «пузырей» сообщений и контейнер ленты.
// Автоскролл к последнему сообщению — без JavaScript (сценарии в HTML-поле не выполняются):
// контейнер flex с column-reverse открывается у низа, поэтому сообщения добавляются
// в обратном порядке (новые первыми в разметке — визуально внизу).
//
// Возвращаемое значение:
//   Строка - HTML с открывающими тегами html/head/body, блоком style и контейнером ленты.
//
&НаКлиенте
Функция ЗаголовокHTMLЧата()

	Возврат
	"<html><head><style>
	|html, body { height: 100%; margin: 0; padding: 0; }
	|body { font-family: 'Segoe UI', Tahoma, Arial, sans-serif; font-size: 13px; background: #ffffff; }
	|#chat { height: 100%; overflow-y: auto; display: flex; flex-direction: column-reverse; }
	|.msg { margin: 6px; }
	|.user { text-align: right; }
	|.bot { text-align: left; }
	|.bubble { display: inline-block; text-align: left; max-width: 75%; padding: 6px 10px;
	|	border-radius: 12px; border: 1px solid #999999; word-wrap: break-word; }
	|.user .bubble { background: #e9f5ea; border-color: #2e7d32; }
	|.bot .bubble { background: #e9f0fa; border-color: #1a3a6b; }
	|.author { font-weight: bold; font-size: 11px; margin-bottom: 2px; }
	|.user .author { color: #1b5e20; }
	|.bot .author { color: #123a6d; }
	|.demo { text-align: left; }
	|.demo .bubble { background: #f4f4f4; border: 1px dashed #999999; }
	|.demo .author { color: #666666; }
	|.cut { margin: 6px; padding-top: 4px; border-top: 1px dashed #999999;
	|	text-align: center; font-size: 11px; color: #888888; }
	|.time { font-size: 10px; color: #888888; margin-top: 3px; text-align: right; }
	|</style></head><body><div id=""chat"">";

КонецФункции

// Формирует HTML-блок одного сообщения чата. Демо-фрагменты контекста (День 8)
// выводятся усечённо (первые строки текста) с меткой веса — полные тексты фрагментов
// слишком велики для ленты, а вес и след важнее содержания.
//
// Параметры:
//   СтрокаИстории - данные таблицы История: Роль, Текст, Отправлено, Токены.
//
// Возвращаемое значение:
//   Строка - HTML-блок сообщения.
//
&НаКлиенте
Функция БлокСообщенияHTML(СтрокаИстории)

	ЭтоДемо = СтрНачинаетсяС(СтрокаИстории.Текст, МаркерДемоСообщения());

	Если ЭтоДемо Тогда
		Класс = "demo";
		Автор = НСтр("ru = 'Демо-контекст'");
		ТекстВывода = НачалоТекста(СтрокаИстории.Текст, 10, 700);
		Момент = СтрШаблон(НСтр("ru = '≈ %1 ток. · фрагмент показан частично'"), ФорматЦелого(СтрокаИстории.Токены));
	Иначе
		Пользователь = (СтрокаИстории.Роль = "user");
		Класс = ?(Пользователь, "user", "bot");
		Автор = ?(Пользователь, "Вы", "Kimi");
		ТекстВывода = СтрокаИстории.Текст;
		Момент = Формат(СтрокаИстории.Отправлено, "ДЛФ=D") + " " + Формат(СтрокаИстории.Отправлено, "ДЛФ=T");
	КонецЕсли;

	Возврат СтрШаблон(
		"<div class=""msg %1""><div class=""bubble""><div class=""author"">%2</div>%3<div class=""time"">%4</div></div></div>",
		Класс, Автор, ЭкранироватьHTML(ТекстВывода), Момент);

КонецФункции

// Возвращает начало текста: первые ЧислоСтрок строк, суммарно не длинее ЛимитСимволов;
// при сокращении добавляет многоточие.
//
// Параметры:
//   Текст - Строка - исходный текст;
//   ЧислоСтрок - Число - сколько первых строк взять;
//   ЛимитСимволов - Число - максимальная длина результата.
//
// Возвращаемое значение:
//   Строка - начало текста.
//
&НаКлиенте
Функция НачалоТекста(Текст, ЧислоСтрок, ЛимитСимволов)

	ВсеСтроки = СтрРазделить(Текст, Символы.ПС);
	ВзятоСтрок = Мин(ЧислоСтрок, ВсеСтроки.Количество());

	Части = Новый Массив;
	Для Индекс = 0 По ВзятоСтрок - 1 Цикл
		Части.Добавить(ВсеСтроки[Индекс]);
	КонецЦикла;
	Результат = СтрСоединить(Части, Символы.ПС);

	Сокращён = ВсеСтроки.Количество() > ЧислоСтрок;
	Если СтрДлина(Результат) > ЛимитСимволов Тогда
		Результат = Лев(Результат, ЛимитСимволов);
		Сокращён = Истина;
	КонецЕсли;
	Если Сокращён Тогда
		Результат = Результат + " " + НСтр("ru = '…'");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Экранирует символы HTML и заменяет переводы строк на <br>.
//
// Параметры:
//   Текст - Строка - исходный текст сообщения.
//
// Возвращаемое значение:
//   Строка - текст, безопасный для подстановки в HTML.
//
&НаКлиенте
Функция ЭкранироватьHTML(Текст)

	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, Символ(13), "");
	Результат = СтрЗаменить(Результат, Символы.ПС, "<br>");

	Возврат Результат;

КонецФункции

// Пересобирает HTML ленты чатов из таблицы Чаты (новые первыми): первым пунктом —
// «Новый чат», далее карточки диалогов; текущий диалог подсвечен. Клик по карточке —
// псевдо-ссылка chat:<ид>, обрабатывается в СписокЧатовПриНажатии.
//
&НаКлиенте
Процедура ОбновитьСписокЧатовHTML()

	ЧастиHTML = Новый Массив;
	ЧастиHTML.Добавить(ЗаголовокHTMLСпискаЧатов());

	Для Каждого СтрокаЧата Из Чаты Цикл
		ЧастиHTML.Добавить(БлокЧатаHTML(СтрокаЧата));
	КонецЦикла;

	ЧастиHTML.Добавить("</div></body></html>");

	СписокЧатовHTML = СтрСоединить(ЧастиHTML, Символы.ПС);

КонецПроцедуры

// Возвращает шапку ленты чатов: оформление карточек и пункт «Новый чат».
//
&НаКлиенте
Функция ЗаголовокHTMLСпискаЧатов()

	Возврат
	"<html><head><style>
	|html, body { height: 100%; margin: 0; padding: 0; }
	|body { font-family: 'Segoe UI', Tahoma, Arial, sans-serif; font-size: 13px; background: #ffffff; }
	|#chats { height: 100%; overflow-y: auto; }
	|a.newchat { display: block; margin: 6px; padding: 6px 10px; border: 1px dashed #2e7d32;
	|	color: #1b5e20; text-decoration: none; border-radius: 8px; text-align: center; }
	|a.chat { display: block; margin: 4px 6px; padding: 6px 22px 6px 10px; border: 1px solid #999999;
	|	border-radius: 10px; text-decoration: none; color: #222222; position: relative; }
	|a.chat .title { font-weight: bold; font-size: 13px; color: #123a6d; word-wrap: break-word; }
	|a.chat .meta { font-size: 10px; color: #888888; margin-top: 3px; }
	|a.chat.active { background: #e9f0fa; border-color: #1a3a6b; }
	|a.chat .del { position: absolute; top: 2px; right: 6px; color: #b71c1c; font-weight: bold;
	|	font-size: 14px; cursor: pointer; }
	|</style></head><body><div id=""chats"">
	|<a class=""newchat"" href=""chat:new"">+ Новый чат</a>";

КонецФункции

// Формирует HTML-карточку одного чата ленты.
//
// Параметры:
//   СтрокаЧата - данные таблицы Чаты: Ссылка, Наименование, Дата, ДатаЗавершения.
//
// Возвращаемое значение:
//   Строка - HTML-блок чата.
//
&НаКлиенте
Функция БлокЧатаHTML(СтрокаЧата)

	ЭтоТекущий = (СтрокаЧата.Ссылка = ТекущийЧат);
	Класс = ?(ЭтоТекущий, "chat active", "chat");

	Заголовок = СтрокаЧата.Наименование;
	Если Не ЗначениеЗаполнено(Заголовок) Тогда
		Заголовок = СтрШаблон(НСтр("ru = 'Диалог от %1'"), Формат(СтрокаЧата.Дата, "ДЛФ=D"));
	КонецЕсли;

	Мета = Формат(СтрокаЧата.Дата, "ДЛФ=D") + " " + Формат(СтрокаЧата.Дата, "ДЛФ=T");
	Если ЗначениеЗаполнено(СтрокаЧата.ДатаЗавершения) Тогда
		Мета = Мета + " " + НСтр("ru = '· завершён'");
	КонецЕсли;

	Возврат СтрШаблон(
		"<a class=""%1"" href=""chat:%2""><div class=""title"" id=""chat:%2"">%3</div>"
		+ "<div class=""meta"" id=""chat:%2"">%4</div><div class=""del"" id=""del:%2"">&#10005;</div></a>",
		Класс, СтрокаЧата.Ид, ЭкранироватьHTML(Заголовок), ЭкранироватьHTML(Мета));

КонецФункции

// Обработчик нажатий в ленте чатов: переход по псевдо-ссылкам карточек.
// Адрес ссылки — "chat:<ид диалога>"; идентификатор "new" означает создание нового чата.
// Адрес читается через DOM-элемент события; чтение обёрнуто в попытку —
// состав свойств DOM зависит от движка HTML-поля.
//
&НаКлиенте
Процедура СписокЧатовПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Адрес = АдресСсылкиСпискаЧатов(ДанныеСобытия);
	АдресНРег = НРег(Адрес);

	ПозицияУдаления = СтрНайти(АдресНРег, "del:");
	Если ПозицияУдаления > 0 Тогда
		ПодтвердитьУдалениеЧата(Сред(Адрес, ПозицияУдаления + 4));
		Возврат;
	КонецЕсли;

	Позиция = СтрНайти(АдресНРег, "chat:");
	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;

	ИдЧата = Сред(Адрес, Позиция + 5);
	Если ИдЧата = "new" Тогда
		НовыйЧат(Неопределено);
	Иначе
		ПереключитьЧат(ИдЧата);
	КонецЕсли;

КонецПроцедуры

// Находит чат в таблице ленты по идентификатору (XML-строка ссылки).
//
// Параметры:
//   ИдЧата - Строка - идентификатор диалога.
//
// Возвращаемое значение:
//   ДокументСсылка.KimiДиалог, Неопределено - найденный диалог.
//
&НаКлиенте
Функция НайтиЧатПоИд(ИдЧата)

	Для Каждого СтрокаЧата Из Чаты Цикл
		Если СтрокаЧата.Ид = ИдЧата Тогда
			Возврат СтрокаЧата.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Запрашивает подтверждение удаления чата (асинхронный вопрос — модальность запрещена)
// и при согласии помечает диалог на удаление.
//
// Параметры:
//   ИдЧата - Строка - идентификатор удаляемого диалога.
//
&НаКлиенте
Процедура ПодтвердитьУдалениеЧата(ИдЧата)

	ВыбранныйЧат = НайтиЧатПоИд(ИдЧата);
	Если ВыбранныйЧат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПодтверждениеУдаленияЧатаЗавершено", ЭтотОбъект, ВыбранныйЧат);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Вы действительно хотите удалить чат?'"),
		РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);

КонецПроцедуры

// Завершает удаление чата после ответа на вопрос подтверждения.
//
// Параметры:
//   Результат - КодВозвратаДиалога - ответ пользователя;
//   ВыбранныйЧат - ДокументСсылка.KimiДиалог - удаляемый диалог.
//
&НаКлиенте
Процедура ПодтверждениеУдаленияЧатаЗавершено(Результат, ВыбранныйЧат) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	УдалитьЧатНаСервере(ВыбранныйЧат);
	СброситьСтатистикуСессии();
	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();
	ОбновитьИндикаторСостояния();

КонецПроцедуры

// Помечает диалог на удаление; если удалён текущий чат — очищает форму для нового диалога.
//
// Параметры:
//   Ссылка - ДокументСсылка.KimiДиалог - удаляемый диалог.
//
&НаСервере
Процедура УдалитьЧатНаСервере(Ссылка)

	УдалёнТекущий = (Ссылка = ТекущийЧат);
	KimiЧатыАгентаСервер.УдалитьДиалог(Ссылка);

	Если УдалёнТекущий Тогда
		ТекущийЧат = Документы.KimiДиалог.ПустаяСсылка();
		ЗаголовокТекущегоЧата = "";
		История.Очистить();
		ЖурналРаботы.Очистить();
		РостДиалога.Очистить();
		СтатусОтвета = "";
		СводкаТекст = "";
		СжатоДо = 0;
		Факты.Очистить();
		РабочаяПамять.Очистить();
		СтратегияКонтекста = KimiКонтекстСервер.СтратегияСводка();
		ОчиститьСостояниеЗадачиНаСервере();
		Если КонтрольСостоянияЗадачи Тогда
			УстановитьНачальноеСостояниеЗадачиНаСервере();
		КонецЕсли;
	КонецЕсли;

	ОбновитьСписокЧатовНаСервере();

КонецПроцедуры

// Извлекает адрес нажатой карточки чата из данных события HTML-поля.
// Клик приходит на конкретный элемент-мишень: при клике по тексту внутри карточки
// это вложенный div (заголовок/мета), а не ссылка <a>, — поэтому поднимаемся
// по родителям DOM и читаем служебный id ("chat:<ид>" карточки, "del:<ид>" крестика
// удаления) или href, пока адрес не найден. Маркеры id проверяются первыми и на
// самом элементе-мишени — иначе клик по крестику всплыл бы к ссылке карточки.
// Чтение DOM обёрнуто в попытки: состав свойств зависит от движка HTML-поля;
// защитно принимаем и строку вторым параметром события.
//
&НаКлиенте
Функция АдресСсылкиСпискаЧатов(ДанныеСобытия)

	Попытка
		Если ТипЗнч(ДанныеСобытия) = Тип("Строка") Тогда
			Возврат ДанныеСобытия;
		КонецЕсли;

		ЭлементDOM = ДанныеСобытия.Element;
		Пока ЭлементDOM <> Неопределено Цикл
			Попытка
				ИдЭлемента = НРег(ЭлементDOM.id);
				Если СтрНайти(ИдЭлемента, "del:") > 0 Или СтрНайти(ИдЭлемента, "chat:") > 0 Тогда
					Возврат ЭлементDOM.id;
				КонецЕсли;
			Исключение
			КонецПопытки;
			Попытка
				Если ЗначениеЗаполнено(ЭлементDOM.href) Тогда
					Возврат ЭлементDOM.href;
				КонецЕсли;
			Исключение
			КонецПопытки;
			Попытка
				ЭлементDOM = ЭлементDOM.parentElement;
			Исключение
				ЭлементDOM = Неопределено;
			КонецПопытки;
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат "";

КонецФункции

// Переключает форму на выбранный в ленте диалог: загружает его сообщения
// (контекст для API восстанавливается целиком, включая вызовы инструментов)
// и состояние сжатия истории (День 9).
//
// Параметры:
//   ИдЧата - Строка - XML-строка ссылки на диалог (из псевдо-ссылки карточки).
//
&НаКлиенте
Процедура ПереключитьЧат(ИдЧата)

	ВыбранныйЧат = НайтиЧатПоИд(ИдЧата);

	Если ВыбранныйЧат = Неопределено Или ВыбранныйЧат = ТекущийЧат Тогда
		ОбновитьСписокЧатовHTML();
		Возврат;
	КонецЕсли;

	ЗагрузитьЧатНаСервере(ВыбранныйЧат);
	СброситьСтатистикуСессии();
	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();
	ОбновитьПанельСлоев();
	ОбновитьИндикаторСостояния();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЖурнал(ЖурналАгента)

	ЖурналРаботы.Очистить();
	Для Каждого ЗаписьЖурнала Из ЖурналАгента Цикл
		НоваяСтрока = ЖурналРаботы.Добавить();
		НоваяСтрока.Итерация = ЗаписьЖурнала.Итерация;
		НоваяСтрока.Действие = ЗаписьЖурнала.Действие;
		НоваяСтрока.Инструмент = ЗаписьЖурнала.Инструмент;
		НоваяСтрока.Аргументы = ЗаписьЖурнала.Аргументы;
		НоваяСтрока.Результат = ЗаписьЖурнала.Результат;
		НоваяСтрока.ТокеныЗапроса = ЗаписьЖурнала.ТокеныЗапроса;
		НоваяСтрока.ТокеныОтвета = ЗаписьЖурнала.ТокеныОтвета;
	КонецЦикла;

КонецПроцедуры

// Дополняет таблицу «Рост диалога» строкой обращения (или отказа API):
// токены и время по обращению, стоимость шага и накопленная стоимость сессии.
//
// Параметры:
//   РезультатАгента - Структура, Неопределено - результат KimiАгентСервер.ВыполнитьЗапросАгента
//     (Неопределено для отклонённого запроса — фиксируется только примечание);
//   Примечание - Строка - текст ошибки для отклонённого запроса; пусто для успешного обмена.
//
&НаКлиенте
Процедура ДобавитьСтрокуРоста(РезультатАгента, Примечание)

	НоваяСтрока = РостДиалога.Добавить();
	НоваяСтрока.Шаг = РостДиалога.Количество();
	НоваяСтрока.Примечание = Примечание;

	Если РезультатАгента <> Неопределено Тогда
		НоваяСтрока.ТокеныЗапроса = РезультатАгента.ТокеныЗапросаВсего;
		НоваяСтрока.ТокеныОтвета = РезультатАгента.ТокеныОтветаВсего;
		НоваяСтрока.ВремяСекунд = Окр(РезультатАгента.ВремяМиллисекунд / 1000, 1);
		НоваяСтрока.Стоимость = РезультатАгента.Стоимость;
	КонецЕсли;
	НоваяСтрока.СтоимостьВсего = СтоимостьСессииВсего;

КонецПроцедуры

// Заполняет панель «Токены и стоимость»: разбор последнего обращения (оценка вопроса,
// фактические prompt/completion токены API, заполнение окна, стоимость) либо
// начальное состояние — вес загруженной истории и размер окна модели (День 8).
// При активном сжатии (День 9) дополнительно показывает оценку контекста полного
// и фактического (сводка + хвост) и расход на сжатие — для сравнения «до/после».
//
// Параметры:
//   РезультатАгента - Структура, Неопределено - результат KimiАгентСервер.ВыполнитьЗапросАгента;
//   ОценкаВопроса - Число - локальная оценка токенов отправленного вопроса.
//
&НаКлиенте
Процедура ОбновитьПанельТокенов(РезультатАгента = Неопределено, ОценкаВопроса = 0)

	СтрокиПанели = Новый Массив;

	Если РезультатАгента = Неопределено Тогда

		СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Отправьте вопрос — здесь появится разбор токенов (окно модели: %1 ток.).'"),
			ФорматЦелого(ЛимитКонтекста)));

		ВесИстории = ВесИстории();
		Если ВесИстории > 0 Тогда
			СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Вес истории: %1 ток. (%2 окна) — пишется в документ чата.'"),
				ФорматЦелого(ВесИстории), ФорматПроцентаЗаполнения(ВесИстории)));
		КонецЕсли;

		Если СтратегияКонтекста = ИдСтратегииСводка() И СжатоДо > 0 Тогда
			СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Сжатие: %1 сообщ. заменены сводкой — в запрос уходит сводка + последние %2 как есть.'"),
				ФорматЦелого(СжатоДо), ФорматЦелого(ХвостСообщений)));
		КонецЕсли;

		Если СтратегияКонтекста = ИдСтратегииФакты() Тогда
			СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Факты: %1 шт. — блок уходит в запрос вместе с последними %2 сообщ.'"),
				ФорматЦелого(Факты.Количество()), ФорматЦелого(ХвостСообщений)));
		КонецЕсли;

	Иначе

		Рассуждение = "";
		Если РезультатАгента.ТокеныРассуждения > 0 Тогда
			Рассуждение = СтрШаблон(НСтр("ru = ' (в т.ч. рассуждение %1)'"), ФорматЦелого(РезультатАгента.ТокеныРассуждения));
		КонецЕсли;

		СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Вопрос: ~%1 ток. (оценка, точность ±20–30%%)'"),
			ФорматЦелого(ОценкаВопроса)));
		СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Запрос целиком: %1 ток. (факт API) · Ответ: %2 ток.%3'"),
			ФорматЦелого(РезультатАгента.ТокеныЗапроса), ФорматЦелого(РезультатАгента.ТокеныОтвета), Рассуждение));

		Если ЛимитКонтекста > 0 Тогда
			СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Окно контекста: %1 (%2 / %3)'"),
				ФорматПроцентаЗаполнения(РезультатАгента.ТокеныЗапроса),
				ФорматЦелого(РезультатАгента.ТокеныЗапроса), ФорматЦелого(ЛимитКонтекста)));
		Иначе
			СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Окно контекста модели не зафиксировано (факт запроса: %1 ток.)'"),
				ФорматЦелого(РезультатАгента.ТокеныЗапроса)));
		КонецЕсли;

		СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Стоимость: шаг $%1 · всего $%2 · расход сессии: %3 ток.'"),
			ФорматСтоимости(РезультатАгента.Стоимость), ФорматСтоимости(СтоимостьСессииВсего),
			ФорматЦелого(ТокеныСессииВсего)));

		Если РезультатАгента.СжатоСообщений > 0 Тогда
			Экономия = Макс(0, РезультатАгента.КонтекстПолныйОценка - РезультатАгента.КонтекстФактОценка);
			СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Контекст (оценка): полный ~%1 → со сжатием ~%2 · экономия ~%3 ток. (%4)'"),
				ФорматЦелого(РезультатАгента.КонтекстПолныйОценка), ФорматЦелого(РезультатАгента.КонтекстФактОценка),
				ФорматЦелого(Экономия), ФорматПроцентаЭкономии(Экономия, РезультатАгента.КонтекстПолныйОценка)));
			СтрокиПанели.Добавить(СтрШаблон(НСтр("ru = 'Сжатие: %1 сообщ. в сводке · сжатий за сессию: %2 · стоимость сжатия $%3'"),
				ФорматЦелого(РезультатАгента.СжатоСообщений), ФорматЦелого(ЧислоСжатийСессии),
				ФорматСтоимости(СтоимостьСжатияСессии)));
		КонецЕсли;

	КонецЕсли;

	ТокеныПанель = СтрСоединить(СтрокиПанели, Символы.ПС);

	ОбновитьПанельСлоев(); // слои памяти (День 11): сколько токенов добавляет каждый слой

КонецПроцедуры

// Возвращает сумму токенов по строкам истории формы (сохранённые значения
// документа + факты ответов текущей сессии + оценки демо-сообщений).
//
&НаКлиенте
Функция ВесИстории()

	Сумма = 0;
	Для Каждого СтрокаИстории Из История Цикл
		Сумма = Сумма + СтрокаИстории.Токены;
	КонецЦикла;

	Возврат Сумма;

КонецФункции

// Возвращает процент заполнения контекстного окна для числа токенов;
// 0 — лимит модели не зафиксирован.
//
&НаКлиенте
Функция ФорматПроцентаЗаполнения(Токены)

	Если ЛимитКонтекста <= 0 Тогда
		Возврат НСтр("ru = '—'");
	КонецЕсли;

	Возврат Формат(Окр(Токены / ЛимитКонтекста * 100, 1), "ЧДЦ=1; ЧН=0") + "%";

КонецФункции

// Возвращает процент экономии контекста от сжатия: экономия / полный контекст.
//
// Параметры:
//   Экономия - Число - разность оценок полного и фактического контекста;
//   ПолныйКонтекст - Число - оценка токенов запроса с полной историей.
//
&НаКлиенте
Функция ФорматПроцентаЭкономии(Экономия, ПолныйКонтекст)

	Если ПолныйКонтекст <= 0 Тогда
		Возврат НСтр("ru = '—'");
	КонецЕсли;

	Возврат Формат(Окр(Экономия / ПолныйКонтекст * 100, 0), "ЧН=0") + "%";

КонецФункции

&НаКлиенте
Функция ФорматЦелого(Значение)

	Возврат Формат(Значение, "ЧГ=");

КонецФункции

&НаКлиенте
Функция ФорматСтоимости(Значение)

	Возврат Формат(Значение, "ЧДЦ=4; ЧГ=; ЧН=0");

КонецФункции

// Обнуляет накопленные за сессию просмотра чата счётчики (стоимость и токены
// обращений, расход на сжатие) и таблицу роста диалога — при новом чате,
// переключении и удалении.
//
&НаКлиенте
Процедура СброситьСтатистикуСессии()

	СтоимостьСессииВсего = 0;
	ТокеныСессииВсего = 0;
	СтоимостьСжатияСессии = 0;
	ЧислоСжатийСессии = 0;
	РостДиалога.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатус(РезультатАгента)

	ВремяСекунд = Окр(РезультатАгента.ВремяМиллисекунд / 1000, 1);
	СтатусОтвета = СтрШаблон(НСтр("ru = 'Итераций: %1 · Вызовов инструментов: %2 · Токены: %3 · Время: %4 с · Стратегия: %5'"),
		РезультатАгента.ЧислоИтераций, РезультатАгента.ЧислоВызововИнструментов,
		РезультатАгента.ТокеныВсего, Формат(ВремяСекунд, "ЧГ="), ПредставлениеСтратегии());

	Если РезультатАгента.РезервныйПровайдер Тогда
		// Подмена провайдера при перегрузке видна в статусе, а не только в журнале.
		СтатусОтвета = СтатусОтвета + " " + СтрШаблон(НСтр("ru = '(резерв: %1)'"), РезультатАгента.РезервнаяМодель);
	ИначеЕсли ТолькоЛегкаяМодель Тогда
		// Режим Google-only: модель дня отличается от основной — видно в статусе.
		СтатусОтвета = СтатусОтвета + " " + НСтр("ru = '(Google-only)'");
	КонецЕсли;

	Если ЗначениеЗаполнено(РезультатАгента.Профиль) Тогда
		// Персонализация (День 12): в статусе видно, что запрос ушёл с профилем.
		СтатусОтвета = СтатусОтвета + " " + СтрШаблон(НСтр("ru = '(профиль: %1)'"), РезультатАгента.Профиль);
	КонецЕсли;

	Если КонтрольСостоянияЗадачи И ЗначениеЗаполнено(ЭтапЗадачи) Тогда
		// Состояние задачи (День 13): текущий этап виден в статусе обмена.
		СтатусОтвета = СтатусОтвета + " " + СтрШаблон(НСтр("ru = '(этап: %1)'"), ПредставлениеЭтапаЗадачи());
	КонецЕсли;

	Если ИнвариантыВключены И РезультатАгента.ИнвариантыАктивных > 0 Тогда
		// Инварианты (День 14): запрос ушёл с блоком инвариантов — видно в статусе;
		// блокировки ответа кодом фиксируются журналом отдельно.
		СтатусОтвета = СтатусОтвета + " " + СтрШаблон(НСтр("ru = '(инварианты: %1)'"),
			ФорматЦелого(РезультатАгента.ИнвариантыАктивных));
	КонецЕсли;

	Если РезультатАгента.ЛимитИтерацийИсчерпан Тогда
		СтатусОтвета = СтатусОтвета + " " + НСтр("ru = '(лимит итераций исчерпан)'");
	КонецЕсли;

КонецПроцедуры

// Возвращает краткое представление текущей стратегии контекста для статуса
// и подписей: у управляемых стратегий показывает параметры (N, K, число фактов).
//
&НаКлиенте
Функция ПредставлениеСтратегии()

	Если СтратегияКонтекста = ИдСтратегииОкно() Тогда
		Возврат СтрШаблон(НСтр("ru = 'Окно (N=%1)'"), ФорматЦелого(ХвостСообщений));
	ИначеЕсли СтратегияКонтекста = ИдСтратегииФакты() Тогда
		Возврат СтрШаблон(НСтр("ru = 'Факты (N=%1, фактов: %2)'"),
			ФорматЦелого(ХвостСообщений), ФорматЦелого(Факты.Количество()));
	ИначеЕсли СтратегияКонтекста = ИдСтратегииСводка() Тогда
		Возврат СтрШаблон(НСтр("ru = 'Сводка (N=%1, K=%2)'"),
			ФорматЦелого(ХвостСообщений), ФорматЦелого(БлокСжатия));
	КонецЕсли;

	Возврат НСтр("ru = 'полная история'");

КонецФункции

// Клиентские копии идентификаторов стратегий: модуль KimiКонтекстСервер серверный
// (без «вызова сервера») и с клиента недоступен, поэтому идентификаторы для
// клиентских процедур отрисовки продублированы здесь. Точка синхронизации значений —
// функции KimiКонтекстСервер.СтратегияОкно/Факты/Сводка/ПолнаяИстория.
//
&НаКлиенте
Функция ИдСтратегииОкно()

	Возврат "Окно";

КонецФункции

&НаКлиенте
Функция ИдСтратегииФакты()

	Возврат "Факты";

КонецФункции

&НаКлиенте
Функция ИдСтратегииСводка()

	Возврат "Сводка";

КонецФункции

// Переключатель стратегии текущего чата (День 10): применяется к следующим
// запросам и пишется в документ при сохранении. При выборе «Факты» группа
// управления контекстом разворачивается — в таблице видно, как блок фактов
// наполняется после каждого обмена.
//
&НаКлиенте
Процедура СтратегияКонтекстаПриИзменении(Элемент)

	Если СтратегияКонтекста = ИдСтратегииФакты() Тогда
		Элементы.ГруппаСжатие.Свернутость = Ложь;
	КонецЕсли;

	УстановитьВидимостьСтратегии();
	ОбновитьЧат();
	ОбновитьПанельТокенов();

КонецПроцедуры

// Настраивает видимость элементов группы управления контекстом по текущей
// стратегии: блок сжатия и «Сжать сейчас» — только для сводки, таблица фактов —
// только для стратегии «Факты».
//
&НаКлиенте
Процедура УстановитьВидимостьСтратегии()

	ЭтоСводка = (СтратегияКонтекста = ИдСтратегииСводка());
	ЭтоФакты = (СтратегияКонтекста = ИдСтратегииФакты());

	Элементы.БлокСжатия.Видимость = ЭтоСводка;
	Элементы.СжатьСейчас.Видимость = ЭтоСводка;
	Элементы.Факты.Видимость = ЭтоФакты;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	СтоимостьСессииВсего = 0;
	ТокеныСессииВсего = 0;
	СтоимостьСжатияСессии = 0;
	ЧислоСжатийСессии = 0;
	ТокеныЗапросаПрогона = 0;
	ВызовыПоддержкиПрогона = 0;
	СтоимостьПоддержкиПрогона = 0;
	ШагиАвтоПрогона = Неопределено;
	ИндексАвтоШага = 0;
	РежимАвтоШага = "";
	АвтоШагОстановлен = Ложь;
	ЭтапПроверкиПамяти = 0; // этапы очистки слоёв проверки памяти (День 11)
	ОценкаЗапросаПовтора = Неопределено; // повтор при перегрузке провайдера (hotfix при приёмке)
	ОсталосьПовторовПриПерегрузке = ЛимитПовторовПриПерегрузке();
	ПаузаСценарияСостояния = Ложь; // плановая пауза сценария жизненного цикла (День 13)

	УстановитьВидимостьСтратегии();

	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();
	ОбновитьИндикаторСостояния();

КонецПроцедуры

// Оценивает исходящий запрос до отправки: системный промпт агента + фактический
// контекст (при включённом сжатии — сводка и хвост, иначе вся история) + вопрос.
// Точных значений до вызова API нет (endpoint подсчёта у Kimi отсутствует) — оценка
// локальная; при превышении окна модели запрос предупреждается и требует подтверждения.
//
// Возвращаемое значение:
//   Структура:
//     * ОценкаЗапроса - Число - оценка токенов исходящего запроса целиком;
//     * ОценкаВопроса - Число - оценка токенов текста вопроса (последняя строка истории);
//     * Лимит - Число - размер контекстного окна модели (0 — не зафиксирован);
//     * Превышен - Булево - Истина, если оценка запроса больше окна.
//
&НаСервере
Функция ОценитьИсходящийЗапросНаСервере()

	ИсторияДиалога = РеквизитФормыВЗначение("История");

	ОценкаЗапроса = Новый Структура;
	ОценкаЗапроса.Вставить("ОценкаЗапроса", KimiАгентСервер.ОценитьИсходящийЗапрос(ИсторияДиалога, ПараметрыКонтекстаНаСервере()));
	ОценкаЗапроса.Вставить("ОценкаВопроса", KimiТокеныСервер.ОценитьТокеныТекста(
		ИсторияДиалога[ИсторияДиалога.Количество() - 1].Текст)); // отправленный вопрос
	ОценкаЗапроса.Вставить("Лимит", ЛимитКонтекста);
	ОценкаЗапроса.Вставить("Превышен", ЛимитКонтекста > 0 И ОценкаЗапроса.ОценкаЗапроса > ЛимитКонтекста);

	Возврат ОценкаЗапроса;

КонецФункции

// Генерирует учебные демо-сообщения заданного вида (День 8): «длинный» — около
// 75 000 токенов, «переполнение» — заведомо больше контекстного окна модели.
//
// Параметры:
//   Вид - Строка - "длинный" или "переполнение".
//
// Возвращаемое значение:
//   Массив из Структура - сообщения с реквизитами Роль, Текст, Токены.
//
&НаСервере
Функция СообщенияДемоНаСервере(Вид)

	Если Вид = "переполнение" Тогда
		Лимит = ЛимитКонтекста;
		Если Лимит <= 0 Тогда
			Лимит = 1048576; // лимит модели агента зафиксирован — запасной вариант не понадобится
		КонецЕсли;
		Возврат KimiТокеныСервер.СообщенияДемоПереполнения(Лимит);
	КонецЕсли;

	Возврат KimiТокеныСервер.СообщенияДемоДлинногоКонтекста();

КонецФункции

// Возвращает учебный сценарий проверки деталей (День 9) — тексты сообщений брифа.
//
&НаСервере
Функция СценарийПроверкиДеталейНаСервере()

	Возврат KimiКонтекстСервер.СценарийПроверкиДеталей();

КонецФункции

// Заполняет таблицу формы реестром контрольных деталей (Деталь + Вопрос);
// ответы и отметки «Помнит» не трогаем — они за заказчиком.
//
&НаСервере
Процедура ЗаполнитьРеестрДеталейНаСервере()

	Реестр = KimiКонтекстСервер.РеестрДеталей();
	ПроверкаДеталей.Очистить();
	Для Каждого СтрокаРеестра Из Реестр Цикл
		НоваяСтрока = ПроверкаДеталей.Добавить();
		НоваяСтрока.Деталь = СтрокаРеестра.Деталь;
		НоваяСтрока.Вопрос = СтрокаРеестра.Вопрос;
		НоваяСтрока.Эталон = СтрокаРеестра.Эталон;
	КонецЦикла;

КонецПроцедуры

// Сверяет ответы агента с эталонами простой моделью и проставляет отметки
// «Помнит» (кнопка «Оценить ответы» и автозапуск после прогона контрольных
// вопросов, День 10 — решение заказчика). Модель — лёгкая линейка Google AI Studio
// (как генератор заголовков, бесплатный тариф). Отметки остаются редактируемыми:
// автоматика предлагает, заказчик при необходимости правит вручную перед
// «Зафиксировать результат».
//
&НаКлиенте
Процедура ОценитьОтветы(Команда)

	Если ПроверкаДеталей.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Проверка деталей'"), ,
			НСтр("ru = 'Реестр пуст — сначала прогоните сценарий и задайте контрольные вопросы кнопкой «Проверить детали».'"));
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(НСтр("ru = 'Проверка деталей'"), ,
		НСтр("ru = 'Сверяем ответы с эталонами простой моделью…'"));

	Попытка
		ИтогОценки = ОценитьОтветыНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Автоматическая оценка не выполнена:'") + " " + ОписаниеОшибки()
			+ Символы.ПС + НСтр("ru = 'Отметки «Помнит» проставьте вручную.'"), СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	ПоказатьОповещениеПользователя(НСтр("ru = 'Проверка деталей'"), ,
		СтрШаблон(НСтр("ru = 'Оценено %1 из %2, пропущено %3 (пустой ответ или ошибка вызова).
			|Отметки «Помнит» проставлены автоматически — при необходимости поправьте вручную.'"),
			ФорматЦелого(ИтогОценки.Оценено), ФорматЦелого(ПроверкаДеталей.Количество()),
			ФорматЦелого(ИтогОценки.Пропущено)));

КонецПроцедуры

&НаСервере
Функция ОценитьОтветыНаСервере()

	Реестр = РеквизитФормыВЗначение("ПроверкаДеталей");

	Результат = KimiКонтекстСервер.ОценитьОтветыДеталей(Реестр);

	ЗначениеВРеквизитФормы(Реестр, "ПроверкаДеталей"); // обновлённые отметки «Помнит»

	Возврат Результат;

КонецФункции

// Создаёт строки таблицы сравнения стратегий (День 10): по строке на стратегию,
// включая контрольную «полную историю». Метрики (детали, токены, вызовы поддержки)
// заполняются кнопкой «Зафиксировать результат» после прогона и проверки;
// «строки кода механизма» — статический показатель сложности реализации,
// подсчитанный по коду проекта при разработке дня (без комментариев).
//
&НаСервере
Процедура ИнициализироватьСравнениеСтратегий()

	СравнениеСтратегий.Очистить();
	Для Каждого СтратегияСписка Из KimiКонтекстСервер.Стратегии() Цикл
		НоваяСтрока = СравнениеСтратегий.Добавить();
		НоваяСтрока.Стратегия = СтратегияСписка;
		НоваяСтрока.СтрокКода = СтрокКодаМеханизмаСтратегии(СтратегияСписка);
	КонецЦикла;

КонецПроцедуры

// Возвращает статический показатель сложности реализации стратегии — число строк
// кода её механизма (без комментариев и пустых строк), подсчитанное по коду
// проекта при разработке Дня 10: 0 — отдельного механизма нет (полная история —
// базовое поведение; окно — проекция без инъекции поверх общей ветки хвоста).
//
&НаСервере
Функция СтрокКодаМеханизмаСтратегии(Стратегия)

	Если Стратегия = KimiКонтекстСервер.СтратегияФакты() Тогда
		Возврат 155; // экстрактор + инъекция + обновление в сохранении (подсчитано 2026-11-15)
	ИначеЕсли Стратегия = KimiКонтекстСервер.СтратегияСводка() Тогда
		Возврат 148; // пороги, границы, сводка блоками, автосжатие (подсчитано 2026-11-15)
	ИначеЕсли Стратегия = KimiКонтекстСервер.СтратегияОкно() Тогда
		Возврат 0; // отдельного механизма нет — общая ветка проекции хвоста
	КонецЕсли;

	Возврат 0; // полная история — базовое поведение без механизма

КонецФункции

// Запрашивает выводы аналитика по зафиксированному сравнению стратегий
// (День 10): строки сравнения + последняя проверка деталей. Ошибки вызова
// пробрасываются вызывающей стороне (команда показывает их в окне сообщений).
//
&НаСервере
Функция ВыводыАналитикаНаСервере()

	Возврат KimiКонтекстСервер.ВыводыАналитика(
		РеквизитФормыВЗначение("СравнениеСтратегий"), РеквизитФормыВЗначение("ПроверкаДеталей"));

КонецФункции

&НаСервере
Функция ВыполнитьЗапросАгентаНаСервере()

	ИсторияДиалога = РеквизитФормыВЗначение("История");

	Возврат KimiАгентСервер.ВыполнитьЗапросАгента(ИсторияДиалога, Не ИнструментыВключены, ПараметрыКонтекстаНаСервере());

КонецФункции

// Собирает структуру управления контекстом из реквизитов формы для серверных
// вызовов (проекция запроса и сохранение диалога). Ключи «Память» (слои
// памяти, День 11) и «РабочаяПамять» (заметки задачи для документа) читаются
// вызываемыми модулями через Свойство — в полном режиме память выключена.
//
&НаСервере
Функция ПараметрыКонтекстаНаСервере()

	Память = Новый Структура;
	Память.Вставить("ДолговременнаяВключена", ПамятьВключена);
	Память.Вставить("Категории", ВыбранныеКатегорииНаСервере());
	Память.Вставить("РабочаяВключена", Истина);
	Память.Вставить("Рабочая", РеквизитФормыВЗначение("РабочаяПамять"));

	// Локальная переменная названа не «Параметры»: в модуле формы это имя
	// перекрывается read-only свойством глобального контекста (параметры формы)
	// и присваивание падает «Поле объекта недоступно для записи» (hotfix при
	// приёмке Дня 13 — урок про перекрытие глобального контекста в модулях форм).
	ПараметрыКонтекста = Новый Структура("Стратегия, Хвост, Сводка, СжатоДо, Факты, Память, РабочаяПамять, ЗапаснаяМодельПриПерегрузке, ТолькоЛегкаяМодель, Профиль",
		СтратегияКонтекста, ХвостСообщений, СводкаТекст, СжатоДо, РеквизитФормыВЗначение("Факты"),
		Память, РеквизитФормыВЗначение("РабочаяПамять"), ЗапаснойПровайдерВключен, ТолькоЛегкаяМодель, АктивныйПрофиль);

	// Состояние задачи (День 13): при включённом контроле в запрос и сохранение
	// уходит структура состояния (этап/шаг/ожидаемое действие); ключа нет —
	// поведение Дней 6–12 не меняется. В режиме Google-only ключ не добавляем:
	// инструменты отключены (День 11), блок состояния и инструменты не передаются.
	Если КонтрольСостоянияЗадачи И Не ТолькоЛегкаяМодель И ЗначениеЗаполнено(ЭтапЗадачи) Тогда
		ПараметрыКонтекста.Вставить("СостояниеЗадачи", Новый Структура("Этап, Шаг, ОжидаемоеДействие",
			ЭтапЗадачи, ШагЗадачи, ОжидаемоеДействиеЗадачи));
	КонецЕсли;

	// Инварианты (День 14): при включённом флажке в запрос уходит таблица активных
	// инвариантов (блок в system-промпт + кодовая проверка ответа до показа);
	// ключа нет — поведение Дней 6–13 не меняется. Обычный текст: работает и в
	// режиме Google-only, инструменты не нужны (в отличие от состояния Дня 13).
	Если ИнвариантыВключены И ИнвариантыТаблица.Количество() > 0 Тогда
		ПараметрыКонтекста.Вставить("Инварианты", РеквизитФормыВЗначение("ИнвариантыТаблица"));
	КонецЕсли;

	Возврат ПараметрыКонтекста;

КонецФункции

&НаСервере
Функция СохранитьТекущийЧатНаСервере()

	ИсторияДиалога = РеквизитФормыВЗначение("История");

	ПараметрыКонтекстаСохранение = ПараметрыКонтекстаНаСервере();
	ПараметрыКонтекстаСохранение.Вставить("Блок", БлокСжатия);

	Результат = KimiЧатыАгентаСервер.СохранитьДиалог(ТекущийЧат, ИсторияДиалога, ПараметрыКонтекстаСохранение);
	ТекущийЧат = Результат.Диалог;
	ЗаголовокТекущегоЧата = ТекущийЧат.Наименование;
	ЗначениеВРеквизитФормы(Результат.Факты, "Факты"); // блок, обновлённый моделью при сохранении
	Результат.Удалить("Факты"); // таблица значений не сериализуется: на клиент уходит только счётчик

	ОбновитьСписокЧатовНаСервере();

	Возврат Результат;

КонецФункции

// Принудительное сжатие текущего диалога до заданного хвоста (кнопка «Сжать сейчас»).
//
&НаСервере
Функция СжатьСейчасНаСервере()

	ИсторияДиалога = РеквизитФормыВЗначение("История");

	Возврат KimiЧатыАгентаСервер.СжатьДиалог(ТекущийЧат, ИсторияДиалога, ХвостСообщений, БлокСжатия, ТолькоЛегкаяМодель);

КонецФункции

&НаСервере
Процедура ЗагрузитьЧатНаСервере(Ссылка)

	ДанныеДиалога = KimiЧатыАгентаСервер.ЗагрузитьДиалог(Ссылка);
	ТекущийЧат = Ссылка;
	ЗаголовокТекущегоЧата = ДанныеДиалога.Наименование;
	ЗначениеВРеквизитФормы(ДанныеДиалога.История, "История");
	ЗначениеВРеквизитФормы(ДанныеДиалога.Факты, "Факты");
	ЗначениеВРеквизитФормы(ДанныеДиалога.РабочаяПамять, "РабочаяПамять"); // рабочая память задачи (День 11)

	// Диалоги Дней 7–9 стратегии не имели: сжатые (есть граница сводки) продолжаем
	// со сводкой, прочие — с полной историей (безопасное умолчание, ничего не отбрасывает).
	Если ЗначениеЗаполнено(ДанныеДиалога.СтратегияКонтекста) Тогда
		СтратегияКонтекста = ДанныеДиалога.СтратегияКонтекста;
	ИначеЕсли ДанныеДиалога.СжатоДо > 0 Тогда
		СтратегияКонтекста = KimiКонтекстСервер.СтратегияСводка();
	Иначе
		СтратегияКонтекста = KimiКонтекстСервер.СтратегияПолнаяИстория();
	КонецЕсли;

	СводкаТекст = ДанныеДиалога.Сводка;
	СжатоДо = ДанныеДиалога.СжатоДо;
	Если ДанныеДиалога.ХвостСообщений > 0 Тогда
		ХвостСообщений = ДанныеДиалога.ХвостСообщений;
	КонецЕсли;

	// Персонализация (День 12): чат открывается со своим профилем (может быть пустым).
	// Список выбора селектора платформа формирует сама из типа реквизита
	// (CatalogRef + «Быстрый выбор» справочника) — программно не заполняем.
	АктивныйПрофиль = ДанныеДиалога.Профиль;
	ОбновитьПредпочтенияПрофиляНаСервере();

	// Состояние задачи (День 13): восстанавливаем из документа; при включённом
	// контроле и пустом этапе (диалог до Дня 13) — начальное состояние.
	ЭтапЗадачи = ДанныеДиалога.СостояниеЗадачи.Этап;
	ШагЗадачи = ДанныеДиалога.СостояниеЗадачи.Шаг;
	ОжидаемоеДействиеЗадачи = ДанныеДиалога.СостояниеЗадачи.ОжидаемоеДействие;
	Если КонтрольСостоянияЗадачи И Не ЗначениеЗаполнено(ЭтапЗадачи) Тогда
		УстановитьНачальноеСостояниеЗадачиНаСервере();
	КонецЕсли;

	ЖурналРаботы.Очистить();
	РостДиалога.Очистить();
	СтатусОтвета = "";

	ОбновитьСписокЧатовНаСервере();

КонецПроцедуры

&НаСервере
Процедура НовыйЧатНаСервере()

	KimiЧатыАгентаСервер.ЗавершитьДиалог(ТекущийЧат);
	ТекущийЧат = Документы.KimiДиалог.ПустаяСсылка();
	ЗаголовокТекущегоЧата = "";
	История.Очистить();
	ЖурналРаботы.Очистить();
	РостДиалога.Очистить();
	СтатусОтвета = "";
	СводкаТекст = "";
	СжатоДо = 0;
	Факты.Очистить();
	РабочаяПамять.Очистить(); // новый чат — новая задача, рабочая память не наследуется (День 11)
	ОчиститьСостояниеЗадачиНаСервере();
	Если КонтрольСостоянияЗадачи Тогда
		// Новый чат — новая задача: жизненный цикл начинается с планирования (День 13).
		УстановитьНачальноеСостояниеЗадачиНаСервере();
	КонецЕсли;
	// Стратегия контекста не сбрасывается: новый чат наследует выбор пользователя
	// (команда «Прогнать сценарий» переопределяет её стратегией прогона).

	ОбновитьСписокЧатовНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокЧатовНаСервере()

	ЗначениеВРеквизитФормы(KimiЧатыАгентаСервер.СписокДиалогов(), "Чаты");

КонецПроцедуры

&НаКлиенте
Функция ИдСлояКраткосрочная()

	Возврат "Краткосрочная"; // точка синхронизации — KimiПамятьСервер.СлойКраткосрочная

КонецФункции

&НаКлиенте
Функция ИдСлояРабочая()

	Возврат "Рабочая"; // точка синхронизации — KimiПамятьСервер.СлойРабочая

КонецФункции

&НаКлиенте
Функция ИдСлояДолговременная()

	Возврат "Долговременная"; // точка синхронизации — KimiПамятьСервер.СлойДолговременная

КонецФункции

// Обновляет панель «Токены по слоям»: оценка, сколько токенов добавляет каждый
// слой памяти к запросу (День 11). Краткосрочная — проекция истории по стратегии
// (оценка KimiАгентСервер.ОценитьИсходящийЗапрос без слоёв памяти), рабочая —
// весь блок заметок, долговременная — факты, отобранные правилом дня. Точных
// значений до вызова API нет (±20–30 %, честно показано в подписи).
//
&НаКлиенте
Процедура ОбновитьПанельСлоев()

	Если Не РежимMemoryAndState Тогда
		Возврат;
	КонецЕсли;

	Оценка = ОценкаСлоевНаСервере();

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Краткосрочная (диалог · %1): ~%2 ток.'"),
		ПредставлениеСтратегии(), ФорматЦелого(Оценка.ТокеныКраткосрочная)));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Рабочая (%1 заметок): ~%2 ток. — блок целиком'"),
		ФорматЦелого(Оценка.Заметок), ФорматЦелого(Оценка.ТокеныРабочая)));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Долговременная (%1 фактов в запросе): ~%2 ток. — профиль всегда + релевантные словам вопроса'"),
		ФорматЦелого(Оценка.Фактов), ФорматЦелого(Оценка.ТокеныДолгосрочная)));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Профиль пользователя (%1): ~%2 ток. — предпочтения в каждый запрос'"),
		?(ЗначениеЗаполнено(Оценка.ИмяПрофиль), Оценка.ИмяПрофиль, НСтр("ru = 'не выбран'")),
		ФорматЦелого(Оценка.ТокеныПрофиль)));

	ВсегоПамяти = Оценка.ТокеныРабочая + Оценка.ТокеныДолгосрочная + Оценка.ТокеныПрофиль;
	Если КонтрольСостоянияЗадачи И ЗначениеЗаполнено(ЭтапЗадачи) Тогда
		// Состояние задачи (День 13): блок этапа/шага/ожидаемого действия идёт
		// в системный промпт каждого запроса — вес виден рядом со слоями памяти.
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Состояние задачи (этап «%1»): ~%2 ток. — блок в системный промпт'"),
			ПредставлениеЭтапаЗадачи(), ФорматЦелого(Оценка.ТокеныСостояние)));
		ВсегоПамяти = ВсегоПамяти + Оценка.ТокеныСостояние;
	КонецЕсли;
	Если ИнвариантыВключены И Оценка.ИнвариантыАктивных > 0 Тогда
		// Инварианты (День 14): блок жёстких ограничений идёт в системный промпт
		// каждого запроса — вес виден рядом со слоями памяти.
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Инварианты (%1 шт.): ~%2 ток. — блок в системный промпт, ответ проверяется кодом'"),
			ФорматЦелого(Оценка.ИнвариантыАктивных), ФорматЦелого(Оценка.ТокеныИнварианты)));
		ВсегоПамяти = ВсегоПамяти + Оценка.ТокеныИнварианты;
	КонецЕсли;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Итого память добавляет к запросу ~%1 ток. (оценка ±20–30%%)'"),
		ФорматЦелого(ВсегоПамяти)));

	СлоиПанель = СтрСоединить(Строки, Символы.ПС);

КонецПроцедуры

// Возвращает строку журнала о слоях памяти, добавленных в последний запрос.
//
// Параметры:
//   РезультатАгента - Структура - см. KimiАгентСервер.ВыполнитьЗапросАгента
//     (ключи ПамятьФактов, ПамятьТокеныДолгосрочная, ПамятьЗаметок, ПамятьТокеныРабочая).
//
&НаКлиенте
Функция ТекстПамятиЗапроса(РезультатАгента)

	Части = Новый Массив;
	Если РезультатАгента.ПамятьФактов > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'долговр. %1 фактов (~%2 ток.)'"),
			ФорматЦелого(РезультатАгента.ПамятьФактов), ФорматЦелого(РезультатАгента.ПамятьТокеныДолгосрочная)));
	КонецЕсли;
	Если РезультатАгента.ПамятьЗаметок > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'рабочая %1 заметок (~%2 ток.)'"),
			ФорматЦелого(РезультатАгента.ПамятьЗаметок), ФорматЦелого(РезультатАгента.ПамятьТокеныРабочая)));
	КонецЕсли;

	Если Части.Количество() = 0 Тогда
		Возврат НСтр("ru = 'слои памяти в запрос не добавлялись'");
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'память в запросе: %1'"), СтрСоединить(Части, ", "));

КонецФункции

// Дописывает в журнал работы агента событие слоёв памяти (День 11).
//
// Параметры:
//   ТекстСобытия - Строка - описание события (состав запроса или сохранение в слой).
//
&НаКлиенте
Процедура ДобавитьЗаписьПамятиВЖурнал(ТекстСобытия)

	НоваяСтрока = ЖурналРаботы.Добавить();
	НоваяСтрока.Итерация = 0;
	НоваяСтрока.Действие = НСтр("ru = 'Память'");
	НоваяСтрока.Результат = ТекстСобытия;

КонецПроцедуры

// Дописывает в журнал работы агента событие персонализации (День 12): профиль
// в запросе, сохранение профиля, пополнение из диалога, результаты проверок.
//
// Параметры:
//   ТекстСобытия - Строка - описание события.
//
&НаКлиенте
Процедура ДобавитьЗаписьПерсонализацииВЖурнал(ТекстСобытия)

	НоваяСтрока = ЖурналРаботы.Добавить();
	НоваяСтрока.Итерация = 0;
	НоваяСтрока.Действие = НСтр("ru = 'Персонализация'");
	НоваяСтрока.Результат = ТекстСобытия;

КонецПроцедуры

// Переключает активный профиль чата (селектор группы «Персонализация»): профиль
// пишется в документ чата при сохранении, предпочтения перечитываются из
// справочника, смена фиксируется в журнале. Новый чат наследует выбранный профиль.
//
&НаКлиенте
Процедура АктивныйПрофильПриИзменении(Элемент)

	ОбновитьПредпочтенияПрофиляНаСервере();
	Если ЗначениеЗаполнено(ТекущийЧат) И История.Количество() > 0 Тогда
		СохранитьТекущийЧат(); // профиль — в документ диалога
	КонецЕсли;

	ДобавитьЗаписьПерсонализацииВЖурнал(СтрШаблон(НСтр("ru = 'активный профиль: %1'"),
		ПредставлениеПрофиля()));
	ОбновитьПанельТокенов();
	ОбновитьПанельСлоев();

КонецПроцедуры

// Создаёт новый пустой профиль (кнопка «Новый»): он сразу становится активным,
// имя и предпочтения правятся в таблице формы.
//
&НаКлиенте
Процедура НовыйПрофиль(Команда)

	ИмяНового = СоздатьПрофильНаСервере();
	ДобавитьЗаписьПерсонализацииВЖурнал(СтрШаблон(НСтр("ru = 'создан профиль «%1» — задайте предпочтения в таблице и сохраните'"),
		ИмяНового));
	ОбновитьПанельСлоев();

КонецПроцедуры

// Восстанавливает три демо-профиля с противоположными предпочтениями (проверка
// задания: кратко/подробно, с кодом/без, формально/неформально).
//
&НаКлиенте
Процедура ДемоПрофили(Команда)

	Попытка
		Результат = ВосстановитьДемоПрофилиНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Не удалось восстановить демо-профили:'") + " " + ОписаниеОшибки(),
			СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	ДобавитьЗаписьПерсонализацииВЖурнал(СтрШаблон(НСтр("ru = 'демо-профили восстановлены: создано %1, обновлено %2'"),
		ФорматЦелого(Результат.Создано), ФорматЦелого(Результат.Обновлено)));
	ОбновитьПанельСлоев();

КонецПроцедуры

// Сохраняет имя и предпочтения профиля из таблицы формы в справочник (ручное
// задание профиля — пункт задания «не только вручную»: см. пополнение из диалога).
//
&НаКлиенте
Процедура СохранитьПрофиль(Команда)

	Если Не ЗначениеЗаполнено(АктивныйПрофиль) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Персонализация'"), ,
			НСтр("ru = 'Профиль не выбран — создайте кнопкой «Новый» или выберите из списка.'"));
		Возврат;
	КонецЕсли;

	Попытка
		Сохранено = СохранитьПрофильНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Не удалось сохранить профиль:'") + " " + ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	ДобавитьЗаписьПерсонализацииВЖурнал(СтрШаблон(НСтр("ru = 'профиль «%1» сохранён: предпочтений %2'"),
		ИмяПрофиля, ФорматЦелого(Сохранено)));
	ОбновитьПанельСлоев();

КонецПроцедуры

// Извлекает моделью предлагаемые предпочтения из последнего обмена (кнопка
// «Пополнить из диалога»): предложения попадают в таблицу предпросмотра,
// пользователь отмечает и явно сохраняет в профиль кнопкой «В профиль».
//
&НаКлиенте
Процедура ПополнитьПрофильИзОбмена(Команда)

	Если Не ЗначениеЗаполнено(АктивныйПрофиль) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Персонализация'"), ,
			НСтр("ru = 'Профиль не выбран — создайте кнопкой «Новый» или выберите из списка.'"));
		Возврат;
	КонецЕсли;

	Если История.Количество() < 2 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Персонализация'"), ,
			НСтр("ru = 'История пуста — сначала отправьте вопрос и получите ответ.'"));
		Возврат;
	КонецЕсли;

	Попытка
		Результат = ПополнитьПрофильИзОбменаНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Не удалось извлечь предпочтения из обмена:'") + " " + ОписаниеОшибки(),
			СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		Сообщить(СтрШаблон(НСтр("ru = 'Модель-экстрактор не справилась: %1'"), Результат.Ошибка),
			СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(НСтр("ru = 'Персонализация'"), ,
		СтрШаблон(НСтр("ru = 'Предложено предпочтений: %1. Отметьте нужные и сохраните кнопкой «В профиль».'"),
			ФорматЦелого(Результат.Предложено)));

КонецПроцедуры

// Дополняет активный профиль отмеченными предложенными предпочтениями (кнопка
// «В профиль»): запись с совпавшим аспектом обновляет текст, новый — дописывается.
//
&НаКлиенте
Процедура СохранитьВПрофиль(Команда)

	Если КоличествоОтмеченныхПредпочтений() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Персонализация'"), ,
			НСтр("ru = 'Нет отмеченных предпочтений — сначала извлеките предложения кнопкой «Пополнить из диалога».'"));
		Возврат;
	КонецЕсли;

	Попытка
		Сохранено = СохранитьВПрофильНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Не удалось дополнить профиль:'") + " " + ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	ДобавитьЗаписьПерсонализацииВЖурнал(СтрШаблон(НСтр("ru = 'в профиль «%1» добавлено/обновлено предпочтений: %2'"),
		ИмяПрофиля, ФорматЦелого(Сохранено)));
	ОбновитьПанельСлоев();

КонецПроцедуры

// Запускает проверку «один вопрос — всем профилям» (День 12): для каждого профиля
// создаётся НОВЫЙ чат (чистый диалог, контексты не смешиваются — прецедент Дня 10),
// в него уходит общий вопрос; после прогона ответы автоматически сверяются с
// предпочтениями простой моделью. Стартует с нового чата, текущий профиль по
// завершении восстанавливается.
//
&НаКлиенте
Процедура ЗадатьВсемПрофилям(Команда)

	Если Не ЗначениеЗаполнено(СокрЛП(ВопросСравнения)) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Персонализация'"), ,
			НСтр("ru = 'Введите вопрос для сравнения — один и тот же уйдёт всем профилям.'"));
		Возврат;
	КонецЕсли;

	Профили = СписокПрофилейДляПрогонаНаСервере();
	Если Профили.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Персонализация'"), ,
			НСтр("ru = 'Нет профилей — создайте свои кнопкой «Новый» или восстановите демо-профили.'"));
		Возврат;
	КонецЕсли;

	СохранитьТекущийЧат(); // чат с открытым вопросом сохраняется как завершённый
	НовыйЧат(Неопределено); // прогон всегда с нового чата (прецедент Дня 10)

	ШагиАвтоПрогона = Профили;
	ИндексАвтоШага = 0;
	АвтоШагОстановлен = Ложь;
	РежимАвтоШага = "персонализацияСравнение";

	ДобавитьЗаписьПерсонализацииВЖурнал(СтрШаблон(НСтр("ru = 'проверка «один вопрос — всем профилям»: %1 профилей, новый чат на каждый'"),
		ФорматЦелого(Профили.Количество())));
	ПодключитьОбработчикОжидания("ШагАвтоПрогона", 0.1, Истина);

КонецПроцедуры

// Подготавливает чат шага прогона сравнения: новый чат (кроме самого первого шага —
// он уже создан запуском прогона), активный профиль шага, строка таблицы сравнения.
//
// Параметры:
//   ТекущийШаг - Структура - Ид/Профиль шага (см. СписокПрофилейДляПрогонаНаСервере).
//
&НаКлиенте
Процедура ПодготовитьЧатСравненияПрофилей(ТекущийШаг)

	Если ИндексАвтоШага > 1 Тогда
		НовыйЧат(Неопределено); // каждый профиль — в чистом диалоге
	КонецЕсли;

	АктивныйПрофиль = НайтиПрофильПоИд(ТекущийШаг.Ид);
	ОбновитьПредпочтенияПрофиляНаСервере();

	НоваяСтрока = СравнениеПрофилей.Добавить();
	НоваяСтрока.ИдПрофиля = ТекущийШаг.Ид;
	НоваяСтрока.Профиль = ТекущийШаг.Профиль;
	НоваяСтрока.Соблюдено = Ложь;

КонецПроцедуры

// Завершает прогон сравнения: ответы, собранные в шагах, переносятся в строки
// таблицы сравнения (порядок шагов = порядку строк). Шаги передаются параметром:
// состояние прогона к этому моменту уже обнулено (см. ЗавершитьАвтоПрогон).
//
// Параметры:
//   ЗавершившиесяШаги - Массив из Структура - шаги прогона с заполненным Ответ.
//
&НаКлиенте
Процедура ПеренестиОтветыСравненияВТаблицу(ЗавершившиесяШаги)

	Если ЗавершившиесяШаги = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Индекс = 0 По СравнениеПрофилей.Количество() - 1 Цикл
		СравнениеПрофилей[Индекс].Ответ = ЗавершившиесяШаги[Индекс].Ответ;
	КонецЦикла;

КонецПроцедуры

// Запускает проверку устойчивости (День 12): 10 вопросов реестра подряд в одном
// чате с активным профилем; после прогона простая модель фиксирует, на каком по
// счёту ответе ассистент начал игнорировать предпочтения. Стартует с нового чата.
//
&НаКлиенте
Процедура ПрогнатьУстойчивость(Команда)

	Если Не ЗначениеЗаполнено(АктивныйПрофиль) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Персонализация'"), ,
			НСтр("ru = 'Профиль не выбран — устойчивость проверяется для активного профиля.'"));
		Возврат;
	КонецЕсли;
	Если ПредпочтенияПрофиля.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Персонализация'"), ,
			НСтр("ru = 'У активного профиля нет предпочтений — оценивать нечего. Задайте предпочтения или восстановите демо-профили.'"));
		Возврат;
	КонецЕсли;

	СохранитьТекущийЧат();
	НовыйЧат(Неопределено);
	ПроверкаУстойчивости.Очистить();

	ШагиАвтоПрогона = РеестрУстойчивостиНаСервере();
	ИндексАвтоШага = 0;
	АвтоШагОстановлен = Ложь;
	РежимАвтоШага = "персонализацияУстойчивость";

	ДобавитьЗаписьПерсонализацииВЖурнал(СтрШаблон(НСтр("ru = 'проверка устойчивости: 10 вопросов подряд в профиле «%1» (новый чат)'"),
		ИмяПрофиля));
	ПодключитьОбработчикОжидания("ШагАвтоПрогона", 0.1, Истина);

КонецПроцедуры

// Фиксирует ответ шага устойчивости строкой таблицы проверки.
//
// Параметры:
//   ТекущийШаг - Строка - вопрос шага (реестра устойчивости).
//
&НаКлиенте
Процедура ЗафиксироватьОтветУстойчивости(ТекущийШаг)

	НоваяСтрока = ПроверкаУстойчивости.Добавить();
	НоваяСтрока.Вопрос = ТекущийШаг;
	НоваяСтрока.Ответ = ПоследнийОтветАссистента();
	НоваяСтрока.Соблюдено = Ложь;

КонецПроцедуры

// Возвращает номер первого ответа, в котором предпочтения перестали соблюдаться;
// 0 — на всех оценённых ответах предпочтения соблюдены.
//
&НаКлиенте
Функция ТочкаОтказаУстойчивости()

	Для Индекс = 0 По ПроверкаУстойчивости.Количество() - 1 Цикл
		Если ЗначениеЗаполнено(ПроверкаУстойчивости[Индекс].Ответ)
			И Не ПроверкаУстойчивости[Индекс].Соблюдено Тогда
			Возврат Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

// Сверяет ответы обеих таблиц проверки с предпочтениями профилей простой моделью
// (кнопка «Оценить ответы» и автозапуск после прогонов): «в скольких ответах
// предпочтение реально соблюдено» и «на каком ответе начато игнорирование».
// Ошибки вызова не рвут сверку — строка пропускается (ручная правка сохранена).
//
&НаКлиенте
Процедура ОценитьСоответствиеПрофилю(Команда)

	Попытка
		ИтогСравнения = ОценитьСравнениеПрофилейНаСервере();
		ИтогУстойчивости = ОценитьУстойчивостьНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Не удалось оценить соответствие профилям:'") + " " + ОписаниеОшибки(),
			СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	ЧастьСравнения = "";
	Если СравнениеПрофилей.Количество() > 0 Тогда
		Соблюдено = 0;
		Для Каждого СтрокаСравнения Из СравнениеПрофилей Цикл
			Если СтрокаСравнения.Соблюдено Тогда
				Соблюдено = Соблюдено + 1;
			КонецЕсли;
		КонецЦикла;
		ЧастьСравнения = СтрШаблон(НСтр("ru = 'сравнение профилей: соблюдено %1 из %2 (пропущено %3)'"),
			ФорматЦелого(Соблюдено), ФорматЦелого(СравнениеПрофилей.Количество()),
			ФорматЦелого(ИтогСравнения.Пропущено));
	КонецЕсли;

	ЧастьУстойчивости = "";
	Если ПроверкаУстойчивости.Количество() > 0 Тогда
		ТочкаОтказа = ТочкаОтказаУстойчивости();
		ЧастьУстойчивости = ?(ТочкаОтказа = 0,
			СтрШаблон(НСтр("ru = 'устойчивость: все %1 ответов соответствуют профилю (точка отказа не достигнута)'"),
				ФорматЦелого(ПроверкаУстойчивости.Количество())),
			СтрШаблон(НСтр("ru = 'устойчивость: предпочтения перестали соблюдаться с ответа №%1'"),
				ФорматЦелого(ТочкаОтказа)));
	КонецЕсли;

	Части = Новый Массив;
	Если ЗначениеЗаполнено(ЧастьСравнения) Тогда
		Части.Добавить(ЧастьСравнения);
	КонецЕсли;
	Если ЗначениеЗаполнено(ЧастьУстойчивости) Тогда
		Части.Добавить(ЧастьУстойчивости);
	КонецЕсли;

	Если Части.Количество() > 0 Тогда
		ДобавитьЗаписьПерсонализацииВЖурнал(СтрСоединить(Части, "; "));
	КонецЕсли;

КонецПроцедуры

// Возвращает число отмеченных строк таблицы предлагаемых предпочтений.
//
&НаКлиенте
Функция КоличествоОтмеченныхПредпочтений()

	Отмечено = 0;
	Для Каждого СтрокаПредложения Из ПредлагаемыеПредпочтения Цикл
		Если СтрокаПредложения.Брать Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Отмечено;

КонецФункции

// Возвращает число отмеченных строк таблицы предлагаемых фактов.
//
&НаКлиенте
Функция КоличествоОтмеченныхПредлагаемых()

	Отмечено = 0;
	Для Каждого СтрокаПредложения Из ПредлагаемыеФакты Цикл
		Если СтрокаПредложения.Брать Тогда
			Отмечено = Отмечено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Отмечено;

КонецФункции

// Возвращает представление этапа проверки памяти для уведомлений.
//
&НаКлиенте
Функция ИмяЭтапаПамяти(Этап)

	Если Этап <= 0 Тогда
		Возврат НСтр("ru = 'все слои заполнены'");
	ИначеЕсли Этап = 1 Тогда
		Возврат НСтр("ru = 'рабочая память очищена'");
	ИначеЕсли Этап = 2 Тогда
		Возврат НСтр("ru = 'новый чат'");
	КонецЕсли;

	Возврат НСтр("ru = 'долговременная память очищена'");

КонецФункции

// Извлекает моделью предлагаемые записи «ключ-значение» из последнего обмена
// и показывает их в таблице предпросмотра: пользователь отмечает нужное и явно
// сохраняет в долговременную память (с категорией) или в рабочую (День 11).
//
&НаКлиенте
Процедура ВПамятьИзОбмена(Команда)

	Если История.Количество() < 2 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Память агента'"), ,
			НСтр("ru = 'История пуста — сначала отправьте вопрос и получите ответ.'"));
		Возврат;
	КонецЕсли;

	Попытка
		Результат = ВПамятьИзОбменаНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Не удалось извлечь записи из обмена:'") + " " + ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		Сообщить(СтрШаблон(НСтр("ru = 'Модель-экстрактор не справилась: %1'"), Результат.Ошибка),
			СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(НСтр("ru = 'Память агента'"), ,
		СтрШаблон(НСтр("ru = 'Предложено записей: %1. Отметьте нужные и явно сохраните в слой: в долговременную (с категорией) или в рабочую.'"),
			ФорматЦелого(Результат.Предложено)));

КонецПроцедуры

// Сохраняет отмеченные предлагаемые факты в долговременную память (справочник)
// с выбранной категорией и типом жизненного цикла (День 15) — явный перенос
// фактов диалога в долговременный слой (основа долговременной памяти — факты
// Дня 10). Конфликты разрешаются сервером: замены фиксируются в журнале.
//
&НаКлиенте
Процедура СохранитьВДолговременную(Команда)

	Если КоличествоОтмеченныхПредлагаемых() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Память агента'"), ,
			НСтр("ru = 'Нет отмеченных записей — сначала извлеките предложения кнопкой «В память из обмена».'"));
		Возврат;
	КонецЕсли;

	Попытка
		РезультатСохранения = СохранитьВДолговременнуюНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Не удалось сохранить в долговременную память:'") + " " + ОписаниеОшибки(),
			СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	ЧастиИтога = Новый Массив;
	Если РезультатСохранения.Создано > 0 Тогда
		ЧастиИтога.Добавить(СтрШаблон(НСтр("ru = 'создано %1'"), ФорматЦелого(РезультатСохранения.Создано)));
	КонецЕсли;
	Если РезультатСохранения.Заменено > 0 Тогда
		ЧастиИтога.Добавить(СтрШаблон(НСтр("ru = 'заменено %1'"), ФорматЦелого(РезультатСохранения.Заменено)));
	КонецЕсли;
	Если РезультатСохранения.Дополнено > 0 Тогда
		ЧастиИтога.Добавить(СтрШаблон(НСтр("ru = 'дополнено %1'"), ФорматЦелого(РезультатСохранения.Дополнено)));
	КонецЕсли;
	Если РезультатСохранения.Пропущено > 0 Тогда
		ЧастиИтога.Добавить(СтрШаблон(НСтр("ru = 'без изменений %1'"), ФорматЦелого(РезультатСохранения.Пропущено)));
	КонецЕсли;
	Если ЧастиИтога.Количество() = 0 Тогда
		ЧастиИтога.Добавить(НСтр("ru = 'без изменений'"));
	КонецЕсли;
	ДобавитьЗаписьПамятиВЖурнал(СтрШаблон(НСтр("ru = 'в долговременную память (%1 записей, категория «%2»): %3'"),
		ФорматЦелого(РезультатСохранения.Всего), КатегорияВыбора, СтрСоединить(ЧастиИтога, ", ")));
	Для Каждого Замена Из РезультатСохранения.Замены Цикл
		Если Замена.Действие = "замена" Тогда
			ДобавитьЗаписьПамятиВЖурнал(СтрШаблон(НСтр("ru = 'факт «%1»: замена — было «%2» → стало «%3»'"),
				Замена.Ключ, Замена.Было, Замена.Стало));
		Иначе
			ДобавитьЗаписьПамятиВЖурнал(СтрШаблон(НСтр("ru = 'факт «%1»: входящее значение «%2» отклонено — в памяти свежее (приоритет даты записи)'"),
				Замена.Ключ, Замена.Стало));
		КонецЕсли;
	КонецЦикла;
	ОбновитьПанельТокенов();

КонецПроцедуры

// Дописывает отмеченные предлагаемые факты в рабочую память (заметки задачи);
// записи с совпавшим ключом обновляются. Персистентность — при сохранении чата.
//
&НаКлиенте
Процедура СохранитьВРабочую(Команда)

	Сохранено = 0;
	Для Каждого СтрокаПредложения Из ПредлагаемыеФакты Цикл
		Если Не СтрокаПредложения.Брать Тогда
			Продолжить;
		КонецЕсли;

		Найденная = Неопределено;
		Для Каждого СтрокаЗаметки Из РабочаяПамять Цикл
			Если СтрокаЗаметки.Ключ = СтрокаПредложения.Ключ Тогда
				Найденная = СтрокаЗаметки;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Найденная = Неопределено Тогда
			Найденная = РабочаяПамять.Добавить();
			Найденная.Ключ = СтрокаПредложения.Ключ;
		КонецЕсли;
		Найденная.Значение = СтрокаПредложения.Значение;
		Сохранено = Сохранено + 1;
	КонецЦикла;

	Если Сохранено = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Память агента'"), ,
			НСтр("ru = 'Нет отмеченных записей — сначала извлеките предложения кнопкой «В память из обмена».'"));
		Возврат;
	КонецЕсли;

	ДобавитьЗаписьПамятиВЖурнал(СтрШаблон(НСтр("ru = 'в рабочую память добавлено заметок: %1'"), ФорматЦелого(Сохранено)));
	ОбновитьПанельТокенов();

КонецПроцедуры

// Очищает рабочую память текущего чата (с подтверждением); очистка пишется
// в документ, чтобы пережить переключение чатов и перезапуск.
//
&НаКлиенте
