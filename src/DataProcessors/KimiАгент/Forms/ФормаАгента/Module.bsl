// Сверяет ответы попыток обхода с инвариантом простой моделью (Google AI
// Studio — прецедент Дней 10–13). Строки без ответа и удержанные кодом
// пропускаются; ошибки вызова не меняют отметку (ручная правка сохранена).
//
// Возвращаемое значение:
//   Структура:
//     * Оценено - Число - сколько ответов сверено;
//     * Пропущено - Число - сколько строк пропущено.
//
&НаСервере
Функция ОценитьОтветыИнвариантовНаСервере()

	Результат = Новый Структура("Оценено, Пропущено", 0, 0);

	ТекстИнварианта = KimiИнвариантыСервер.ТекстИнвариантаОбхода();
	Если Не ЗначениеЗаполнено(ТекстИнварианта) Тогда
		Результат.Пропущено = ПроверкаОбходаИнвариантов.Количество();
		Возврат Результат;
	КонецЕсли;

	Для Каждого СтрокаПроверки Из ПроверкаОбходаИнвариантов Цикл
		Если Не ЗначениеЗаполнено(СтрокаПроверки.Ответ) Или СтрокаПроверки.ЗаблокированоКодом Тогда
			Продолжить; // код уже удержал — судья не нужен
		КонецЕсли;

		Оценка = KimiИнвариантыСервер.ОценитьОтказ(ТекстИнварианта, СтрокаПроверки.Запрос, СтрокаПроверки.Ответ);
		Если Оценка.Отказался = Неопределено Тогда
			Результат.Пропущено = Результат.Пропущено + 1; // ошибка вызова — отметку не трогаем
		Иначе
			СтрокаПроверки.ОтказалМоделью = Оценка.Отказался;
			Результат.Оценено = Результат.Оценено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

// Отключает контроль состояния задачи (День 13) перед прогонами проверок Дня 14:
// машина состояний добавляет инструменты и блок этапа в запрос — в проверках
// инвариантов они лишние (сценарии не про жизненный цикл). Память и профиль
// не трогаем (прецедент прогонов Дня 12).
//
&НаКлиенте
Процедура ОтключитьСостояниеДляПрогонаИнвариантов()

	Если Не КонтрольСостоянияЗадачи Тогда
		Возврат;
	КонецЕсли;

	КонтрольСостоянияЗадачи = Ложь;
	ОчиститьСостояниеЗадачиНаСервере();
	ОбновитьИндикаторСостояния();
	ДобавитьЗаписьИнвариантовВЖурнал(НСтр("ru = 'контроль состояния задачи отключён для прогона проверки инвариантов'"));

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИнструментыВключены = Истина;
	СтратегияКонтекста = KimiКонтекстСервер.СтратегияСводка(); // умолчание чата — как День 9 (сжатие включено)
	СтратегияПрогона = KimiКонтекстСервер.СтратегияОкно(); // прогоны сравнения начинаем с новой стратегии
	ХвостСообщений = KimiКонтекстСервер.ХвостПоУмолчанию();
	БлокСжатия = KimiКонтекстСервер.БлокСжатияПоУмолчанию();

	// Режим «Memory & State» (неделя 3, День 11): форма открыта из раздела —
	// группы экспериментов прошлых недель скрыты (в интерфейсе — ядро агента
	// и «Модель памяти»); без параметра форма показывает все группы (приёмка
	// Дней 6–10, отладка). Память по умолчанию включена в режиме недели 3,
	// в полном режиме выключена — чтобы сравнение стратегий Дня 10 оставалось
	// воспроизводимым (без подмешивания фактов памяти в прогоны).
	РежимОткрытия = "";
	Попытка
		Параметры.Свойство("РежимОткрытия", РежимОткрытия);
	Исключение
		РежимОткрытия = "";
	КонецПопытки;
	РежимMemoryAndState = (РежимОткрытия = "MemoryAndState");
	Если РежимMemoryAndState Тогда
		Элементы.ГруппаДемо.Видимость = Ложь; // демо длинного контекста (День 8)
		Элементы.ГруппаСравнение.Видимость = Ложь; // сравнение стратегий (День 10)
	КонецЕсли;

	ПамятьВключена = РежимMemoryAndState;
	ЗапаснойПровайдерВключен = РежимMemoryAndState; // резерв при перегрузке Kimi (hotfix при приёмке)
	ТолькоЛегкаяМодель = РежимMemoryAndState; // режим Google-only: приёмка дня без обращений к Kimi
	Элементы.ЗапаснойПровайдерВключен.Доступность = Не ТолькоЛегкаяМодель; // резерв бессмысленен в Google-only

	// Состояние задачи (День 13): контроль по умолчанию включён в режиме недели 3,
	// выключен в полном — прогоны Дней 6–12 не меняются (прецедент памяти Дня 11).
	// В режиме Google-only флажок недоступен: инструменты отключены (День 11),
	// без них контроль состояния работать не может.
	КонтрольСостоянияЗадачи = РежимMemoryAndState;
	Элементы.КонтрольСостоянияЗадачи.Доступность = Не ТолькоЛегкаяМодель;
	Если КонтрольСостоянияЗадачи Тогда
		УстановитьНачальноеСостояниеЗадачиНаСервере();
	КонецЕсли;
	ПамятьПрофиль = Истина;
	ПамятьРешения = Истина;
	ПамятьЗнания = Истина;
	КатегорияВыбора = "Профиль";
	Для Каждого ИмяКатегории Из KimiПамятьСервер.ИменаКатегорий() Цикл
		Элементы.КатегорияВыбора.СписокВыбора.Добавить(ИмяКатегории);
	КонецЦикла;
	ОбновитьФактыПамятиНаСервере();

	// Персонализация (День 12): селектор профиля — список выбора платформа формирует
	// сама из типа реквизита (CatalogRef + «Быстрый выбор» справочника), программное
	// заполнение нужно только строковым реквизитам (аспекты ниже). Профиль по
	// умолчанию пуст — без персонализации (прогоны Дней 6–11 не меняются).
	ВопросСравнения = KimiПерсонализацияСервер.ВопросДляСравненияПрофилей();
	Для Каждого АспектСписка Из KimiПерсонализацияСервер.Аспекты() Цикл
		Элементы.ПредпочтенияПрофиляАспект.СписокВыбора.Добавить(АспектСписка);
		Элементы.ПредлагаемыеАспект.СписокВыбора.Добавить(АспектСписка);
	КонецЦикла;
	ОбновитьПредпочтенияПрофиляНаСервере();

	Для Каждого СтратегияСписка Из KimiКонтекстСервер.Стратегии() Цикл
		Элементы.СтратегияКонтекста.СписокВыбора.Добавить(СтратегияСписка);
		Элементы.СтратегияПрогона.СписокВыбора.Добавить(СтратегияСписка);
	КонецЦикла;

	// Инварианты (День 14): флажок по умолчанию включён в режиме «Memory & State»,
	// выключен в полном (прецедент памяти Дня 11 — прогоны прошлых дней не меняются).
	// Обычный текст: работает и в режиме Google-only, инструменты не нужны
	// (в отличие от состояния задачи Дня 13). Таблица — из справочника
	// KimiИнварианты (хранение отдельно от диалога).
	ИнвариантыВключены = РежимMemoryAndState;
	ЗагрузитьИнвариантыНаСервере();
	Для Каждого ИмяКатегорииИнварианта Из KimiИнвариантыСервер.ИменаКатегорий() Цикл
		Элементы.ИнвариантыТаблицаКатегория.СписокВыбора.Добавить(ИмяКатегорииИнварианта);
	КонецЦикла;

	ИнициализироватьСравнениеСтратегий();

	ЛимитМодели = KimiТокеныСервер.ЛимитКонтекста(KimiAPIСервер.МодельПоУмолчанию());
	ЛимитКонтекста = ?(ЛимитМодели = Неопределено, 0, ЛимитМодели);

	Активный = KimiЧатыАгентаСервер.АктивныйДиалог();
	Если Активный <> Неопределено Тогда
		ЗагрузитьЧатНаСервере(Активный);
	Иначе
		ОбновитьСписокЧатовНаСервере();
	КонецЕсли;

КонецПроцедуры
