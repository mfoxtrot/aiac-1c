&НаКлиенте
Процедура ОтправитьВопрос(Команда)

	ОтправитьВопросАгенту();

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДиалог(Команда)

	История.Очистить();
	ЖурналРаботы.Очистить();
	СтатусОтвета = "";
	ОбновитьЧат();

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВопросАгенту()

	ТекстВопроса = СокрЛП(ТекущийВопрос);
	Если Не ЗначениеЗаполнено(ТекстВопроса) Тогда
		Возврат;
	КонецЕсли;

	ДобавитьСообщениеВИсторию("Вы", ТекстВопроса);
	ТекущийВопрос = "";

	ПоказатьОповещениеПользователя(НСтр("ru = 'Агент Kimi'"), , НСтр("ru = 'Выполняется запрос…'"));

	Попытка
		РезультатАгента = ВыполнитьЗапросАгентаНаСервере();
	Исключение
		Сообщить(ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	ДобавитьСообщениеВИсторию("Kimi", РезультатАгента.Ответ);
	ЗаполнитьЖурнал(РезультатАгента.Журнал);
	ОбновитьСтатус(РезультатАгента);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСообщениеВИсторию(Автор, ТекстСообщения)

	НоваяСтрока = История.Добавить();
	НоваяСтрока.Роль = Автор;
	НоваяСтрока.Текст = ТекстСообщения;
	НоваяСтрока.Отправлено = ТекущаяДата();

	ОбновитьЧат();

КонецПроцедуры

// Пересобирает HTML чата из истории диалога: каждое сообщение — «пузырь» с рамкой
// и скруглением, сообщения пользователя прижаты вправо, модели — влево,
// внизу пузыря мелкая метка с датой и временем.
//
&НаКлиенте
Процедура ОбновитьЧат()

	ЧастиHTML = Новый Массив;
	ЧастиHTML.Добавить(ЗаголовокHTMLЧата());

	Для Каждого СтрокаИстории Из История Цикл
		ЧастиHTML.Добавить(БлокСообщенияHTML(СтрокаИстории));
	КонецЦикла;

	ЧастиHTML.Добавить("</body></html>");

	ЧатHTML = СтрСоединить(ЧастиHTML, Символы.ПС);

КонецПроцедуры

// Возвращает шапку HTML-чата: оформление «пузырей» сообщений и скрипт автоскролла
// к последнему сообщению (выполняется при каждой перезагрузке документа в поле).
//
// Возвращаемое значение:
//   Строка - HTML с открывающими тегами html/head/body и блоком style.
//
&НаКлиенте
Функция ЗаголовокHTMLЧата()

	Возврат
	"<html><head><style>
	|body { font-family: 'Segoe UI', Tahoma, Arial, sans-serif; font-size: 13px; margin: 6px; background: #ffffff; }
	|.msg { margin: 6px 0; }
	|.user { text-align: right; }
	|.bot { text-align: left; }
	|.bubble { display: inline-block; text-align: left; max-width: 75%; padding: 6px 10px;
	|	border-radius: 12px; border: 1px solid #999999; word-wrap: break-word; }
	|.user .bubble { background: #e9f5ea; border-color: #2e7d32; }
	|.bot .bubble { background: #e9f0fa; border-color: #1a3a6b; }
	|.author { font-weight: bold; font-size: 11px; margin-bottom: 2px; }
	|.user .author { color: #1b5e20; }
	|.bot .author { color: #123a6d; }
	|.time { font-size: 10px; color: #888888; margin-top: 3px; text-align: right; }
	|</style></head>
	|<body onload=""window.scrollTo(0, document.body.scrollHeight);"">";

КонецФункции

// Формирует HTML-блок одного сообщения чата.
//
// Параметры:
//   СтрокаИстории - данные таблицы История: Роль, Текст, Отправлено.
//
// Возвращаемое значение:
//   Строка - HTML-блок сообщения.
//
&НаКлиенте
Функция БлокСообщенияHTML(СтрокаИстории)

	Пользователь = (СтрокаИстории.Роль = "Вы");
	Класс = ?(Пользователь, "user", "bot");
	Автор = ?(Пользователь, "Вы", "Kimi");
	Момент = Формат(СтрокаИстории.Отправлено, "ДЛФ=D") + " " + Формат(СтрокаИстории.Отправлено, "ДЛФ=T");

	Возврат СтрШаблон(
		"<div class=""msg %1""><div class=""bubble""><div class=""author"">%2</div>%3<div class=""time"">%4</div></div></div>",
		Класс, Автор, ЭкранироватьHTML(СтрокаИстории.Текст), Момент);

КонецФункции

// Экранирует символы HTML и заменяет переводы строк на <br>.
//
// Параметры:
//   Текст - Строка - исходный текст сообщения.
//
// Возвращаемое значение:
//   Строка - текст, безопасный для подстановки в HTML.
//
&НаКлиенте
Функция ЭкранироватьHTML(Текст)

	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, Символ(13), "");
	Результат = СтрЗаменить(Результат, Символы.ПС, "<br>");

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ЗаполнитьЖурнал(ЖурналАгента)

	ЖурналРаботы.Очистить();
	Для Каждого ЗаписьЖурнала Из ЖурналАгента Цикл
		НоваяСтрока = ЖурналРаботы.Добавить();
		НоваяСтрока.Итерация = ЗаписьЖурнала.Итерация;
		НоваяСтрока.Действие = ЗаписьЖурнала.Действие;
		НоваяСтрока.Инструмент = ЗаписьЖурнала.Инструмент;
		НоваяСтрока.Аргументы = ЗаписьЖурнала.Аргументы;
		НоваяСтрока.Результат = ЗаписьЖурнала.Результат;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатус(РезультатАгента)

	ВремяСекунд = Окр(РезультатАгента.ВремяМиллисекунд / 1000, 1);
	СтатусОтвета = СтрШаблон(НСтр("ru = 'Итераций: %1 · Вызовов инструментов: %2 · Токены: %3 · Время: %4 с'"),
		РезультатАгента.ЧислоИтераций, РезультатАгента.ЧислоВызововИнструментов,
		РезультатАгента.ТокеныВсего, Формат(ВремяСекунд, "ЧГ="));

	Если РезультатАгента.ЛимитИтерацийИсчерпан Тогда
		СтатусОтвета = СтатусОтвета + " " + НСтр("ru = '(лимит итераций исчерпан)'");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ВыполнитьЗапросАгентаНаСервере()

	ИсторияДиалога = РеквизитФормыВЗначение("История");

	Возврат KimiАгентСервер.ВыполнитьЗапросАгента(ИсторияДиалога, Не ИнструментыВключены);

КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИнструментыВключены = Истина;

КонецПроцедуры
