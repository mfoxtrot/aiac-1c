&НаКлиенте
Процедура ОтправитьВопрос(Команда)

	ОтправитьВопросАгенту();

КонецПроцедуры

&НаКлиенте
Процедура НовыйЧат(Команда)

	НовыйЧатНаСервере();
	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВопросАгенту()

	ТекстВопроса = СокрЛП(ТекущийВопрос);
	Если Не ЗначениеЗаполнено(ТекстВопроса) Тогда
		Возврат;
	КонецЕсли;

	ДобавитьСообщениеВИсторию("user", ТекстВопроса);
	ТекущийВопрос = "";

	ПоказатьОповещениеПользователя(НСтр("ru = 'Агент Kimi'"), , НСтр("ru = 'Выполняется запрос…'"));

	Попытка
		РезультатАгента = ВыполнитьЗапросАгентаНаСервере();
	Исключение
		Сообщить(ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	ДобавитьСообщенияАгентаВИсторию(РезультатАгента.НовыеСообщения);
	СохранитьТекущийЧат();
	ЗаполнитьЖурнал(РезультатАгента.Журнал);
	ОбновитьСтатус(РезультатАгента);
	ОбновитьСписокЧатовHTML();

КонецПроцедуры

// Сохраняет текущий диалог в документ; неуспех сохранения не отменяет показ ответа,
// но сообщается пользователю (контекст перезапуска не восстановится).
//
&НаКлиенте
Процедура СохранитьТекущийЧат()

	Попытка
		СохранитьТекущийЧатНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Не удалось сохранить диалог:'") + " " + ОписаниеОшибки(), СтатусСообщения.Важное);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСообщениеВИсторию(Роль, ТекстСообщения)

	НоваяСтрока = История.Добавить();
	НоваяСтрока.Роль = Роль;
	НоваяСтрока.Текст = ТекстСообщения;
	НоваяСтрока.Отправлено = ТекущаяДата();

	ОбновитьЧат();

КонецПроцедуры

// Дописывает в историю сообщения, добавленные циклом агента (ответы ассистента,
// включая промежуточные с вызовами инструментов, и tool-сообщения с результатами).
// Служебные реквизиты (вызовы инструментов, идентификаторы вызовов) сохраняются
// в истории — из них без потерь восстанавливается контекст для API.
//
// Параметры:
//   НовыеСообщения - Массив из Структура - см. KimiАгентСервер.ВыполнитьЗапросАгента.
//
&НаКлиенте
Процедура ДобавитьСообщенияАгентаВИсторию(НовыеСообщения)

	Для Каждого Сообщение Из НовыеСообщения Цикл
		НоваяСтрока = История.Добавить();
		НоваяСтрока.Роль = Сообщение.Роль;
		НоваяСтрока.Текст = ?(Сообщение.Текст = Неопределено, "", Сообщение.Текст);
		НоваяСтрока.Отправлено = ТекущаяДата();

		ВызовыИнструментов = Неопределено;
		Если Сообщение.Свойство("ВызовыИнструментов", ВызовыИнструментов)
			И ВызовыИнструментов.Количество() > 0 Тогда
			НоваяСтрока.ВызовыИнструментов = ВызовыИнструментовВJSON(ВызовыИнструментов);
		КонецЕсли;

		ИдВызова = Неопределено;
		Если Сообщение.Свойство("ИдВызова", ИдВызова) Тогда
			НоваяСтрока.ИдВызова = ИдВызова;
		КонецЕсли;
	КонецЦикла;

	ОбновитьЧат();

КонецПроцедуры

// Сериализует вызовы инструментов сообщения в JSON-строку для хранения в истории.
// Ключи wire-формата (id/name/arguments) — так сериализация не зависит от имён
// полей внутренних структур.
//
&НаКлиенте
Функция ВызовыИнструментовВJSON(ВызовыИнструментов)

	ДанныеВызовов = Новый Массив;
	Для Каждого Вызов Из ВызовыИнструментов Цикл
		ДанныеВызовов.Добавить(Новый Структура("id, name, arguments", Вызов.Ид, Вызов.Имя, Вызов.Аргументы));
	КонецЦикла;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеВызовов);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Пересобирает HTML чата из истории диалога: каждое сообщение — «пузырь» с рамкой
// и скруглением, сообщения пользователя прижаты вправо, модели — влево,
// внизу пузыря мелкая метка с датой и временем. Сообщения выводятся в обратном
// порядке (новые первыми в разметке) — контейнер column-reverse показывает их снизу.
// Служебные сообщения (tool и пустые ответы ассистента с вызовами инструментов)
// в ленте не показываются — их след виден в журнале работы агента.
//
&НаКлиенте
Процедура ОбновитьЧат()

	ЧастиHTML = Новый Массив;
	ЧастиHTML.Добавить(ЗаголовокHTMLЧата());

	Индекс = История.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если История[Индекс].Роль <> "tool" И ЗначениеЗаполнено(История[Индекс].Текст) Тогда
			ЧастиHTML.Добавить(БлокСообщенияHTML(История[Индекс]));
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	ЧастиHTML.Добавить("</div></body></html>");

	ЧатHTML = СтрСоединить(ЧастиHTML, Символы.ПС);

КонецПроцедуры

// Возвращает шапку HTML-чата: оформление «пузырей» сообщений и контейнер ленты.
// Автоскролл к последнему сообщению — без JavaScript (сценарии в HTML-поле не выполняются):
// контейнер flex с column-reverse открывается у низа, поэтому сообщения добавляются
// в обратном порядке (новые первыми в разметке — визуально внизу).
//
// Возвращаемое значение:
//   Строка - HTML с открывающими тегами html/head/body, блоком style и контейнером ленты.
//
&НаКлиенте
Функция ЗаголовокHTMLЧата()

	Возврат
	"<html><head><style>
	|html, body { height: 100%; margin: 0; padding: 0; }
	|body { font-family: 'Segoe UI', Tahoma, Arial, sans-serif; font-size: 13px; background: #ffffff; }
	|#chat { height: 100%; overflow-y: auto; display: flex; flex-direction: column-reverse; }
	|.msg { margin: 6px; }
	|.user { text-align: right; }
	|.bot { text-align: left; }
	|.bubble { display: inline-block; text-align: left; max-width: 75%; padding: 6px 10px;
	|	border-radius: 12px; border: 1px solid #999999; word-wrap: break-word; }
	|.user .bubble { background: #e9f5ea; border-color: #2e7d32; }
	|.bot .bubble { background: #e9f0fa; border-color: #1a3a6b; }
	|.author { font-weight: bold; font-size: 11px; margin-bottom: 2px; }
	|.user .author { color: #1b5e20; }
	|.bot .author { color: #123a6d; }
	|.time { font-size: 10px; color: #888888; margin-top: 3px; text-align: right; }
	|</style></head><body><div id=""chat"">";

КонецФункции

// Формирует HTML-блок одного сообщения чата.
//
// Параметры:
//   СтрокаИстории - данные таблицы История: Роль, Текст, Отправлено.
//
// Возвращаемое значение:
//   Строка - HTML-блок сообщения.
//
&НаКлиенте
Функция БлокСообщенияHTML(СтрокаИстории)

	Пользователь = (СтрокаИстории.Роль = "user");
	Класс = ?(Пользователь, "user", "bot");
	Автор = ?(Пользователь, "Вы", "Kimi");
	Момент = Формат(СтрокаИстории.Отправлено, "ДЛФ=D") + " " + Формат(СтрокаИстории.Отправлено, "ДЛФ=T");

	Возврат СтрШаблон(
		"<div class=""msg %1""><div class=""bubble""><div class=""author"">%2</div>%3<div class=""time"">%4</div></div></div>",
		Класс, Автор, ЭкранироватьHTML(СтрокаИстории.Текст), Момент);

КонецФункции

// Экранирует символы HTML и заменяет переводы строк на <br>.
//
// Параметры:
//   Текст - Строка - исходный текст сообщения.
//
// Возвращаемое значение:
//   Строка - текст, безопасный для подстановки в HTML.
//
&НаКлиенте
Функция ЭкранироватьHTML(Текст)

	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, Символ(13), "");
	Результат = СтрЗаменить(Результат, Символы.ПС, "<br>");

	Возврат Результат;

КонецФункции

// Пересобирает HTML ленты чатов из таблицы Чаты (новые первыми): первым пунктом —
// «Новый чат», далее карточки диалогов; текущий диалог подсвечен. Клик по карточке —
// псевдо-ссылка chat:<ид>, обрабатывается в СписокЧатовПриНажатии.
//
&НаКлиенте
Процедура ОбновитьСписокЧатовHTML()

	ЧастиHTML = Новый Массив;
	ЧастиHTML.Добавить(ЗаголовокHTMLСпискаЧатов());

	Для Каждого СтрокаЧата Из Чаты Цикл
		ЧастиHTML.Добавить(БлокЧатаHTML(СтрокаЧата));
	КонецЦикла;

	ЧастиHTML.Добавить("</div></body></html>");

	СписокЧатовHTML = СтрСоединить(ЧастиHTML, Символы.ПС);

КонецПроцедуры

// Возвращает шапку ленты чатов: оформление карточек и пункт «Новый чат».
//
&НаКлиенте
Функция ЗаголовокHTMLСпискаЧатов()

	Возврат
	"<html><head><style>
	|html, body { height: 100%; margin: 0; padding: 0; }
	|body { font-family: 'Segoe UI', Tahoma, Arial, sans-serif; font-size: 13px; background: #ffffff; }
	|#chats { height: 100%; overflow-y: auto; }
	|a.newchat { display: block; margin: 6px; padding: 6px 10px; border: 1px dashed #2e7d32;
	|	color: #1b5e20; text-decoration: none; border-radius: 8px; text-align: center; }
	|a.chat { display: block; margin: 4px 6px; padding: 6px 10px; border: 1px solid #999999;
	|	border-radius: 10px; text-decoration: none; color: #222222; }
	|a.chat .title { font-weight: bold; font-size: 13px; color: #123a6d; word-wrap: break-word; }
	|a.chat .meta { font-size: 10px; color: #888888; margin-top: 3px; }
	|a.chat.active { background: #e9f0fa; border-color: #1a3a6b; }
	|</style></head><body><div id=""chats"">
	|<a class=""newchat"" href=""chat:new"">+ Новый чат</a>";

КонецФункции

// Формирует HTML-карточку одного чата ленты.
//
// Параметры:
//   СтрокаЧата - данные таблицы Чаты: Ссылка, Наименование, Дата, ДатаЗавершения.
//
// Возвращаемое значение:
//   Строка - HTML-блок чата.
//
&НаКлиенте
Функция БлокЧатаHTML(СтрокаЧата)

	ЭтоТекущий = (СтрокаЧата.Ссылка = ТекущийЧат);
	Класс = ?(ЭтоТекущий, "chat active", "chat");

	Заголовок = СтрокаЧата.Наименование;
	Если Не ЗначениеЗаполнено(Заголовок) Тогда
		Заголовок = СтрШаблон(НСтр("ru = 'Диалог от %1'"), Формат(СтрокаЧата.Дата, "ДЛФ=D"));
	КонецЕсли;

	Мета = Формат(СтрокаЧата.Дата, "ДЛФ=D") + " " + Формат(СтрокаЧата.Дата, "ДЛФ=T");
	Если ЗначениеЗаполнено(СтрокаЧата.ДатаЗавершения) Тогда
		Мета = Мета + " " + НСтр("ru = '· завершён'");
	КонецЕсли;

	Возврат СтрШаблон(
		"<a class=""%1"" href=""chat:%2""><div class=""title"">%3</div><div class=""meta"">%4</div></a>",
		Класс, XMLСтрока(СтрокаЧата.Ссылка), ЭкранироватьHTML(Заголовок), ЭкранироватьHTML(Мета));

КонецФункции

// Обработчик нажатий в ленте чатов: переход по псевдо-ссылкам карточек.
// Адрес ссылки — "chat:<ид диалога>"; идентификатор "new" означает создание нового чата.
// Адрес читается через DOM-элемент события; чтение обёрнуто в попытку —
// состав свойств DOM зависит от движка HTML-поля.
//
&НаКлиенте
Процедура СписокЧатовПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Адрес = АдресСсылкиСпискаЧатов(ДанныеСобытия);

	Позиция = СтрНайти(Адрес, "chat:");
	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;

	ИдЧата = Сред(Адрес, Позиция + 5);
	Если ИдЧата = "new" Тогда
		НовыйЧат(Неопределено);
	Иначе
		ПереключитьЧат(ИдЧата);
	КонецЕсли;

КонецПроцедуры

// Извлекает адрес (href) нажатой ссылки из данных события HTML-поля.
//
&НаКлиенте
Функция АдресСсылкиСпискаЧатов(ДанныеСобытия)

	Попытка
		Если ТипЗнч(ДанныеСобытия) = Тип("Строка") Тогда
			Возврат ДанныеСобытия;
		КонецЕсли;
		Если ДанныеСобытия.Element = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат ДанныеСобытия.Element.href;
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Переключает форму на выбранный в ленте диалог: загружает его сообщения
// (контекст для API восстанавливается целиком, включая вызовы инструментов).
//
// Параметры:
//   ИдЧата - Строка - XML-строка ссылки на диалог (из псевдо-ссылки карточки).
//
&НаКлиенте
Процедура ПереключитьЧат(ИдЧата)

	ВыбранныйЧат = Неопределено;
	Для Каждого СтрокаЧата Из Чаты Цикл
		Если XMLСтрока(СтрокаЧата.Ссылка) = ИдЧата Тогда
			ВыбранныйЧат = СтрокаЧата.Ссылка;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ВыбранныйЧат = Неопределено Или ВыбранныйЧат = ТекущийЧат Тогда
		ОбновитьСписокЧатовHTML();
		Возврат;
	КонецЕсли;

	ЗагрузитьЧатНаСервере(ВыбранныйЧат);
	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЖурнал(ЖурналАгента)

	ЖурналРаботы.Очистить();
	Для Каждого ЗаписьЖурнала Из ЖурналАгента Цикл
		НоваяСтрока = ЖурналРаботы.Добавить();
		НоваяСтрока.Итерация = ЗаписьЖурнала.Итерация;
		НоваяСтрока.Действие = ЗаписьЖурнала.Действие;
		НоваяСтрока.Инструмент = ЗаписьЖурнала.Инструмент;
		НоваяСтрока.Аргументы = ЗаписьЖурнала.Аргументы;
		НоваяСтрока.Результат = ЗаписьЖурнала.Результат;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатус(РезультатАгента)

	ВремяСекунд = Окр(РезультатАгента.ВремяМиллисекунд / 1000, 1);
	СтатусОтвета = СтрШаблон(НСтр("ru = 'Итераций: %1 · Вызовов инструментов: %2 · Токены: %3 · Время: %4 с'"),
		РезультатАгента.ЧислоИтераций, РезультатАгента.ЧислоВызововИнструментов,
		РезультатАгента.ТокеныВсего, Формат(ВремяСекунд, "ЧГ="));

	Если РезультатАгента.ЛимитИтерацийИсчерпан Тогда
		СтатусОтвета = СтатусОтвета + " " + НСтр("ru = '(лимит итераций исчерпан)'");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();

КонецПроцедуры

&НаСервере
Функция ВыполнитьЗапросАгентаНаСервере()

	ИсторияДиалога = РеквизитФормыВЗначение("История");

	Возврат KimiАгентСервер.ВыполнитьЗапросАгента(ИсторияДиалога, Не ИнструментыВключены);

КонецФункции

&НаСервере
Процедура СохранитьТекущийЧатНаСервере()

	ИсторияДиалога = РеквизитФормыВЗначение("История");
	ТекущийЧат = KimiЧатыАгентаСервер.СохранитьДиалог(ТекущийЧат, ИсторияДиалога);
	ЗаголовокТекущегоЧата = ТекущийЧат.Наименование;

	ОбновитьСписокЧатовНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЧатНаСервере(Ссылка)

	ДанныеДиалога = KimiЧатыАгентаСервер.ЗагрузитьДиалог(Ссылка);
	ТекущийЧат = Ссылка;
	ЗаголовокТекущегоЧата = ДанныеДиалога.Наименование;
	ЗначениеВРеквизитФормы(ДанныеДиалога.История, "История");

	ЖурналРаботы.Очистить();
	СтатусОтвета = "";

	ОбновитьСписокЧатовНаСервере();

КонецПроцедуры

&НаСервере
Процедура НовыйЧатНаСервере()

	KimiЧатыАгентаСервер.ЗавершитьДиалог(ТекущийЧат);
	ТекущийЧат = Документы.KimiДиалог.ПустаяСсылка();
	ЗаголовокТекущегоЧата = "";
	История.Очистить();
	ЖурналРаботы.Очистить();
	СтатусОтвета = "";

	ОбновитьСписокЧатовНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокЧатовНаСервере()

	ЗначениеВРеквизитФормы(KimiЧатыАгентаСервер.СписокДиалогов(), "Чаты");

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИнструментыВключены = Истина;

	Активный = KimiЧатыАгентаСервер.АктивныйДиалог();
	Если Активный <> Неопределено Тогда
		ЗагрузитьЧатНаСервере(Активный);
	Иначе
		ОбновитьСписокЧатовНаСервере();
	КонецЕсли;

КонецПроцедуры
