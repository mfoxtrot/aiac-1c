#КонецОбласти

// Обновляет панель слоёв при изменении настроек памяти (флажки слоёв, категорий,
// резерва и режима Google-only): в Google-only флажок цепочки резерва недоступен —
// обмены уже идут на лёгкую модель, обращений к Kimi не предполагается.
//
&НаКлиенте
Процедура ПамятьНастройкаПриИзменении(Элемент)

	Элементы.ЗапаснойПровайдерВключен.Доступность = Не ТолькоЛегкаяМодель;
	// Состояние задачи (День 13) требует инструментов: в режиме Google-only
	// они отключены (День 11) — флажок контроля недоступен.
	Элементы.КонтрольСостоянияЗадачи.Доступность = Не ТолькоЛегкаяМодель;
	ОбновитьПанельТокенов();

КонецПроцедуры

&НаСервере
Функция ОценкаСлоевНаСервере()

	ИсторияДиалога = РеквизитФормыВЗначение("История");

	// Краткосрочная память: проекция истории по стратегии без слоёв памяти
	// (служебный системный промпт включён в оценку — он уходит в каждый запрос).
	КонтекстБезПамяти = ПараметрыКонтекстаНаСервере();
	КонтекстБезПамяти.Удалить("Память");
	ТокеныКраткосрочная = KimiАгентСервер.ОценитьИсходящийЗапрос(ИсторияДиалога, КонтекстБезПамяти);

	Заметки = РеквизитФормыВЗначение("РабочаяПамять");

	Если ПамятьВключена Тогда
		ФактыВЗапросе = KimiПамятьСервер.ФактыДляЗапроса(
			ПоследнийВопросИсторииНаСервере(ИсторияДиалога), ВыбранныеКатегорииНаСервере());
	Иначе
		ФактыВЗапросе = KimiПамятьСервер.ТаблицаЗаметок();
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ТокеныКраткосрочная", ТокеныКраткосрочная);
	Результат.Вставить("ТокеныРабочая", KimiПамятьСервер.ОценитьТокеныЗаписей(Заметки));
	Результат.Вставить("Заметок", Заметки.Количество());
	Результат.Вставить("ТокеныДолгосрочная", KimiПамятьСервер.ОценитьТокеныЗаписей(ФактыВЗапросе));
	Результат.Вставить("Фактов", ФактыВЗапросе.Количество());
	// Персонализация (День 12): вес блока предпочтений активного профиля и его имя
	// (имя читаем здесь, на сервере: на клиенте обращение к реквизитам ссылки
	// через точку недоступно — «Поле объекта не обнаружено»).
	Результат.Вставить("ТокеныПрофиль", KimiТокеныСервер.ОценитьТокеныТекста(
		KimiПерсонализацияСервер.ТекстПрофиляДляЗапроса(АктивныйПрофиль)));
	Результат.Вставить("ИмяПрофиль", ?(ЗначениеЗаполнено(АктивныйПрофиль),
		АктивныйПрофиль.Наименование, ""));
	// Состояние задачи (День 13): вес блока состояния в системном промпте
	// (в режиме Google-only блок не добавляется — вес не показываем).
	Результат.Вставить("ТокеныСостояние", 0);
	Если КонтрольСостоянияЗадачи И Не ТолькоЛегкаяМодель И ЗначениеЗаполнено(ЭтапЗадачи) Тогда
		Результат.ТокеныСостояние = KimiТокеныСервер.ОценитьТокеныТекста(
			KimiСостояниеЗадачиСервер.ТекстСостоянияДляЗапроса(
				Новый Структура("Этап, Шаг, ОжидаемоеДействие", ЭтапЗадачи, ШагЗадачи, ОжидаемоеДействиеЗадачи)));
	КонецЕсли;
	// Инварианты (День 14): вес блока инвариантов в системном промпте
	// (секретные сигналы кодовой проверки не входят — в запрос не уходят).
	Результат.Вставить("ИнвариантыАктивных", 0);
	Результат.Вставить("ТокеныИнварианты", 0);
	Если ИнвариантыВключены Тогда
		Результат.ИнвариантыАктивных = ИнвариантыТаблица.Количество();
		Результат.ТокеныИнварианты = KimiТокеныСервер.ОценитьТокеныТекста(
			KimiИнвариантыСервер.ТекстИнвариантовДляЗапроса(РеквизитФормыВЗначение("ИнвариантыТаблица")));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает разрешённые категории долговременной памяти по флажкам формы.
//
&НаСервере
Функция ВыбранныеКатегорииНаСервере()

	Категории = Новый Массив;
	Если ПамятьПрофиль Тогда
		Категории.Добавить(Перечисления.KimiКатегорииПамяти.Профиль);
	КонецЕсли;
	Если ПамятьРешения Тогда
		Категории.Добавить(Перечисления.KimiКатегорииПамяти.Решение);
	КонецЕсли;
	Если ПамятьЗнания Тогда
		Категории.Добавить(Перечисления.KimiКатегорииПамяти.Знание);
	КонецЕсли;

	Возврат Категории;

КонецФункции

// Возвращает текст последнего сообщения пользователя истории (для отбора
// релевантных фактов долговременной памяти).
//
&НаСервере
Функция ПоследнийВопросИсторииНаСервере(ИсторияДиалога)

	Индекс = ИсторияДиалога.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если ИсторияДиалога[Индекс].Роль = "user" Тогда
			Возврат ИсторияДиалога[Индекс].Текст;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат "";

КонецФункции

// Находит последний обмен истории: последнее user-сообщение и следующий
// за ним непустой ответ ассистента (по образцу KimiЧатыАгентаСервер.
// ПоследнийОбменДиалога).
//
// Параметры:
//   ИсторияДиалога - ТаблицаЗначений - см. ЗагрузитьДиалог.
//
// Возвращаемое значение:
//   Структура, Неопределено - Неопределено, если user-сообщений нет:
//     * ТекстПользователя - Строка - текст последнего сообщения пользователя;
//     * ТекстАссистента - Строка - текст ответа агента (пусто, если не нашёлся).
//
&НаСервере
Функция ПоследнийОбменИстории(ИсторияДиалога)

	ИндексПользователя = ИсторияДиалога.Количество() - 1;
	Пока ИндексПользователя >= 0 Цикл
		Если ИсторияДиалога[ИндексПользователя].Роль = "user" Тогда
			Прервать;
		КонецЕсли;
		ИндексПользователя = ИндексПользователя - 1;
	КонецЦикла;

	Если ИндексПользователя < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТекстАссистента = "";
	Для Индекс = ИндексПользователя + 1 По ИсторияДиалога.Количество() - 1 Цикл
		СтрокаИстории = ИсторияДиалога[Индекс];
		Если СтрокаИстории.Роль = "assistant" И ЗначениеЗаполнено(СтрокаИстории.Текст) Тогда
			ТекстАссистента = СтрокаИстории.Текст;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("ТекстПользователя, ТекстАссистента",
		ИсторияДиалога[ИндексПользователя].Текст, ТекстАссистента);

КонецФункции

// Извлекает предлагаемые записи из последнего обмена и заполняет таблицу
// предпросмотра (все отмечены — пользователь снимает лишнее перед сохранением).
//
// Возвращаемое значение:
//   Структура:
//     * Ошибка - Строка - пусто, если извлечение выполнено;
//     * Предложено - Число - сколько записей предложено.
//
&НаСервере
Функция ВПамятьИзОбменаНаСервере()

	Результат = Новый Структура("Ошибка, Предложено", "", 0);

	ИсторияДиалога = РеквизитФормыВЗначение("История");
	Обмен = ПоследнийОбменИстории(ИсторияДиалога);
	Если Обмен = Неопределено Тогда
		Результат.Ошибка = НСтр("ru = 'в истории нет сообщений пользователя'");
		Возврат Результат;
	КонецЕсли;

	Вызов = KimiПамятьСервер.ФактыПоследнегоОбмена(Обмен.ТекстПользователя, Обмен.ТекстАссистента, ТолькоЛегкаяМодель);
	Если ЗначениеЗаполнено(Вызов.Ошибка) Тогда
		Результат.Ошибка = Вызов.Ошибка;
		Возврат Результат;
	КонецЕсли;

	ПредлагаемыеФакты.Очистить();
	// Тип жизненного цикла (День 15): по умолчанию — по категории («Решение» —
	// накапливаемый, иначе перезаписываемый); в строке можно выбрать вручную.
	ИмяТипаПоУмолчанию = KimiПамятьСервер.ИмяТипаФакта(
		KimiПамятьСервер.ТипПоУмолчанию(KimiПамятьСервер.КатегорияПоИмени(КатегорияВыбора)));
	Для Каждого Факт Из Вызов.Факты Цикл
		НоваяСтрока = ПредлагаемыеФакты.Добавить();
		НоваяСтрока.Брать = Истина;
		НоваяСтрока.Ключ = Факт.Ключ;
		НоваяСтрока.Значение = Факт.Значение;
		НоваяСтрока.Тип = ИмяТипаПоУмолчанию;
	КонецЦикла;
	Результат.Предложено = Вызов.Факты.Количество();

	// Список выбора типа — значения перечисления KimiТипыФактов (имена).
	Элементы.ПредлагаемыеТип.СписокВыбора.Очистить();
	Для Каждого ИмяТипа Из KimiПамятьСервер.ИменаТиповФактов() Цикл
		Элементы.ПредлагаемыеТип.СписокВыбора.Добавить(ИмяТипа);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сохраняет отмеченные предлагаемые факты в долговременную память с типами
// жизненного цикла (День 15): колонка «Тип» таблицы предпросмотра применяется
// к строкам; пустой тип нормализуется сервером по категории. Возвращает
// структуру итогов сохранения (создано/заменено/дополнено/замены).
//
&НаСервере
Функция СохранитьВДолговременнуюНаСервере()

	Отмеченные = KimiПамятьСервер.ТаблицаЗаметок();
	Отмеченные.Колонки.Добавить("Тип", Новый ОписаниеТипов("ПеречислениеСсылка.KimiТипыФактов"));
	Для Каждого СтрокаПредложения Из ПредлагаемыеФакты Цикл
		Если Не СтрокаПредложения.Брать Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Отмеченные.Добавить();
		НоваяСтрока.Ключ = СтрокаПредложения.Ключ;
		НоваяСтрока.Значение = СтрокаПредложения.Значение;
		НоваяСтрока.Тип = KimiПамятьСервер.ТипФактаПоИмени(СтрокаПредложения.Тип);
	КонецЦикла;

	РезультатСохранения = KimiПамятьСервер.СохранитьФактыВДолговременнуюПамять(Отмеченные,
		KimiПамятьСервер.КатегорияПоИмени(КатегорияВыбора), ТекущийЧат);
	ОбновитьФактыПамятиНаСервере();
	ОбновитьУстареваниеНаСервере();

	Возврат РезультатСохранения;

КонецФункции

// Очищает долговременную память и обновляет таблицу фактов формы.
//
// Возвращаемое значение:
//   Число - сколько фактов помечено на удаление.
//
&НаСервере
Функция ОчиститьДолговременнуюПамятьНаСервере()

	Очищено = KimiПамятьСервер.ОчиститьДолговременнуюПамять();
	ОбновитьФактыПамятиНаСервере();
	ОбновитьУстареваниеНаСервере();

	Возврат Очищено;

КонецФункции

// Перезаполняет таблицу «Долговременная память (факты)» формы из справочника.
//
&НаСервере
Процедура ОбновитьФактыПамятиНаСервере()

	ЗначениеВРеквизитФормы(KimiПамятьСервер.ФактыПамяти(), "ПамятьФакты");

КонецПроцедуры

// Заполняет таблицу проверки памяти реестром контрольных вопросов (если ещё
// пуста): по два вопроса на слой; ответы и отметки не трогаем.
//
&НаСервере
Процедура ЗаполнитьРеестрПамятиНаСервере()

	Если ПроверкаПамяти.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	Реестр = KimiПамятьСервер.РеестрВопросовПамяти();
	Для Каждого СтрокаРеестра Из Реестр Цикл
		НоваяСтрока = ПроверкаПамяти.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРеестра);
	КонецЦикла;

КонецПроцедуры

// Возвращает учебный сценарий заполнения слоёв памяти (День 11).
//
&НаСервере
Функция СценарийЗаполненияПамятиНаСервере()

	Возврат KimiПамятьСервер.СценарийЗаполненияПамяти();

КонецФункции

// Наполняет слой памяти из последнего обмена (автосохранение шагов демо-сценария):
// долговременная — вызовом KimiПамятьСервер (факты с категорией), рабочая —
// заметками реквизита формы (персистентность — при сохранении чата).
//
// Параметры:
//   Слой - Строка - идентификатор слоя (см. KimiПамятьСервер.Слой…);
//   ИмяКатегории - Строка - категория фактов (только долговременная память).
//
// Возвращаемое значение:
//   Структура:
//     * Ошибка - Строка - пусто, если сохранение выполнено (или не требовалось);
//     * Сохранено - Число - сколько записей добавлено в слой.
//
&НаСервере
Функция СохранитьОбменВСлойНаСервере(Слой, ИмяКатегории)

	Результат = Новый Структура("Ошибка, Сохранено", "", 0);

	ИсторияДиалога = РеквизитФормыВЗначение("История");
	Обмен = ПоследнийОбменИстории(ИсторияДиалога);
	Если Обмен = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Вызов = KimiПамятьСервер.ФактыПоследнегоОбмена(Обмен.ТекстПользователя, Обмен.ТекстАссистента, ТолькоЛегкаяМодель);
	Если ЗначениеЗаполнено(Вызов.Ошибка) Тогда
		Результат.Ошибка = Вызов.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Если Слой = KimiПамятьСервер.СлойДолговременная() Тогда
		Сохранение = KimiПамятьСервер.СохранитьФактыВДолговременнуюПамять(Вызов.Факты,
			KimiПамятьСервер.КатегорияПоИмени(ИмяКатегории), ТекущийЧат);
		Результат.Сохранено = Сохранение.Создано + Сохранение.Заменено + Сохранение.Дополнено;
		Результат.Вставить("Замены", Сохранение.Замены);
		ОбновитьФактыПамятиНаСервере();
		ОбновитьУстареваниеНаСервере();
	Иначе
		Для Каждого Факт Из Вызов.Факты Цикл
			Найденная = Неопределено;
			Для Каждого СтрокаЗаметки Из РабочаяПамять Цикл
				Если СтрокаЗаметки.Ключ = Факт.Ключ Тогда
					Найденная = СтрокаЗаметки;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Найденная = Неопределено Тогда
				Найденная = РабочаяПамять.Добавить();
				Найденная.Ключ = Факт.Ключ;
			КонецЕсли;
			Найденная.Значение = Факт.Значение;
			Результат.Сохранено = Результат.Сохранено + 1;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сверяет ответы контрольных вопросов памяти с эталонами простой моделью
// (KimiКонтекстСервер.ОценитьОтветыДеталей — прецедент Дня 10) и проставляет
// отметки в колонку заданного этапа таблицы ПроверкаПамяти.
//
// Параметры:
//   Этап - Число - этап проверки (0 — все слои, 1 — рабочая очищена,
//     2 — новый чат, 3 — память очищена).
//
// Возвращаемое значение:
//   Структура - см. KimiКонтекстСервер.ОценитьОтветыДеталей (Оценено, Пропущено).
//
&НаСервере
Функция ОценитьОтветыПамятиНаСервере(Этап)

	Реестр = РеквизитФормыВЗначение("ПроверкаПамяти");
	ИмяКолонки = ИмяКолонкиЭтапаПамяти(Этап);

	ДляСверки = Новый ТаблицаЗначений;
	ДляСверки.Колонки.Добавить("Вопрос", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	ДляСверки.Колонки.Добавить("Эталон", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	ДляСверки.Колонки.Добавить("Ответ", Новый ОписаниеТипов("Строка"));
	ДляСверки.Колонки.Добавить("Помнит", Новый ОписаниеТипов("Булево"));

	Для Каждого СтрокаПроверки Из Реестр Цикл
		НоваяСтрока = ДляСверки.Добавить();
		НоваяСтрока.Вопрос = СтрокаПроверки.Вопрос;
		НоваяСтрока.Эталон = СтрокаПроверки.Эталон;
		НоваяСтрока.Ответ = СтрокаПроверки.Ответ;
		НоваяСтрока.Помнит = СтрокаПроверки[ИмяКолонки];
	КонецЦикла;

	Результат = KimiКонтекстСервер.ОценитьОтветыДеталей(ДляСверки);

	Индекс = 0;
	Для Каждого СтрокаСверки Из ДляСверки Цикл
		ПроверкаПамяти[Индекс][ИмяКолонки] = СтрокаСверки.Помнит;
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает имя колонки таблицы ПроверкаПамяти, соответствующей этапу проверки.
//
&НаСервере
Функция ИмяКолонкиЭтапаПамяти(Этап)

	Если Этап <= 0 Тогда
		Возврат "Помнит";
	ИначеЕсли Этап = 1 Тогда
		Возврат "ПослеОчисткиРабочей";
	ИначеЕсли Этап = 2 Тогда
		Возврат "ПослеНовогоЧата";
	КонецЕсли;

	Возврат "ПослеОчисткиПамяти";

КонецФункции

// Возвращает представление активного профиля для статуса и подсказок
// персонализации (День 12): имя профиля и число предпочтений.
//
&НаСервере
Функция ПредставлениеПрофиля()

	Если Не ЗначениеЗаполнено(АктивныйПрофиль) Тогда
		Возврат НСтр("ru = 'без профиля'");
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = '%1 (%2 предпочт.)'"), АктивныйПрофиль.Наименование,
		Формат(ПредпочтенияПрофиля.Количество(), "ЧГ="));

КонецФункции

// Перечитывает таблицу предпочтений активного профиля из справочника
// (после выбора профиля, сохранения, пополнения из диалога).
//
&НаСервере
Процедура ОбновитьПредпочтенияПрофиляНаСервере()

	ЗначениеВРеквизитФормы(KimiПерсонализацияСервер.ПредпочтенияПрофиля(АктивныйПрофиль), "ПредпочтенияПрофиля");
	ИмяПрофиля = ?(ЗначениеЗаполнено(АктивныйПрофиль), АктивныйПрофиль.Наименование, "");

КонецПроцедуры

// Создаёт новый профиль (кнопка «Новый»): пустой элемент справочника становится
// активным, имя и предпочтения правятся в таблице и фиксируются кнопкой
// «Сохранить профиль».
//
// Возвращаемое значение:
//   Строка - имя созданного профиля.
//
&НаСервере
Функция СоздатьПрофильНаСервере()

	ИмяНового = СтрШаблон(НСтр("ru = 'Новый профиль %1'"),
		Формат(ТекущаяДатаСеанса(), "ДЛФ=D"));
	АктивныйПрофиль = KimiПерсонализацияСервер.СоздатьПрофиль(ИмяНового);
	ОбновитьПредпочтенияПрофиляНаСервере();

	Возврат ИмяНового;

КонецФункции

// Восстанавливает демо-профили с противоположными предпочтениями (кнопка
// «Демо-профили»). Список выбора селектора профиля платформа формирует сама
// из типа реквизита — обновлять программно не требуется.
//
// Возвращаемое значение:
//   Структура - см. KimiПерсонализацияСервер.ВосстановитьДемоПрофили.
//
&НаСервере
Функция ВосстановитьДемоПрофилиНаСервере()

	Возврат KimiПерсонализацияСервер.ВосстановитьДемоПрофили();

КонецФункции

// Сохраняет профиль целиком из таблицы формы: имя и предпочтения перезаписывают
// элемент справочника (ручное задание профиля).
//
// Возвращаемое значение:
//   Число - сколько предпочтений сохранено.
//
&НаСервере
Функция СохранитьПрофильНаСервере()

	Сохранено = KimiПерсонализацияСервер.СохранитьПредпочтенияВПрофиль(АктивныйПрофиль,
		ИмяПрофиля, РеквизитФормыВЗначение("ПредпочтенияПрофиля"));
	ОбновитьПредпочтенияПрофиляНаСервере();

	Возврат Сохранено;

КонецФункции

// Извлекает моделью предлагаемые предпочтения из последнего обмена (кнопка
// «Пополнить из диалога»): в таблицу предпросмотра попадают только предложения,
// не дублирующие уже заданные аспекты. Уважает режим Google-only: при включённом
// флаге «Только лёгкая модель Google» вызов идёт на Gemini (урок Дня 11 — режим
// обязан покрывать все служебные вызовы дня).
//
// Возвращаемое значение:
//   Структура:
//     * Ошибка - Строка - пусто, если извлечение выполнено;
//     * Предложено - Число - сколько предпочтений предложено (новых).
//
&НаСервере
Функция ПополнитьПрофильИзОбменаНаСервере()

	Результат = Новый Структура("Ошибка, Предложено", "", 0);

	ИсторияДиалога = РеквизитФормыВЗначение("История");
	Обмен = ПоследнийОбменИстории(ИсторияДиалога);
	Если Обмен = Неопределено Тогда
		Результат.Ошибка = НСтр("ru = 'в истории нет сообщений пользователя'");
		Возврат Результат;
	КонецЕсли;

	Вызов = KimiПерсонализацияСервер.ПредпочтенияИзОбмена(Обмен.ТекстПользователя,
		Обмен.ТекстАссистента, РеквизитФормыВЗначение("ПредпочтенияПрофиля"), ТолькоЛегкаяМодель);
	Если ЗначениеЗаполнено(Вызов.Ошибка) Тогда
		Результат.Ошибка = Вызов.Ошибка;
		Возврат Результат;
	КонецЕсли;

	ПредлагаемыеПредпочтения.Очистить();
	Для Каждого СтрокаПредложения Из Вызов.Предпочтения Цикл
		НоваяСтрока = ПредлагаемыеПредпочтения.Добавить();
		НоваяСтрока.Брать = Истина;
		НоваяСтрока.Аспект = СтрокаПредложения.Аспект;
		НоваяСтрока.Текст = СтрокаПредложения.Текст;
	КонецЦикла;
	Результат.Предложено = Вызов.Предпочтения.Количество();

	Возврат Результат;

КонецФункции

// Дополняет активный профиль отмеченными предложенными предпочтениями
// (кнопка «В профиль»): запись с совпавшим аспектом обновляет текст, новый
// аспект дописывается. Персистентность — сразу в справочник.
//
// Возвращаемое значение:
//   Число - сколько предпочтений добавлено или обновлено.
//
&НаСервере
Функция СохранитьВПрофильНаСервере()

	Отмеченные = KimiПерсонализацияСервер.ТаблицаПредпочтений();
	Для Каждого СтрокаПредложения Из ПредлагаемыеПредпочтения Цикл
		Если Не СтрокаПредложения.Брать Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Отмеченные.Добавить();
		НоваяСтрока.Аспект = СтрокаПредложения.Аспект;
		НоваяСтрока.Текст = СтрокаПредложения.Текст;
	КонецЦикла;

	Сохранено = KimiПерсонализацияСервер.ДополнитьПрофильПредпочтениями(АктивныйПрофиль, Отмеченные);
	ОбновитьПредпочтенияПрофиляНаСервере();

	Возврат Сохранено;

КонецФункции

// Возвращает список профилей для прогона «задать всем профилям»: непомеченные
// элементы справочника. На клиент возвращается как массив структур
// (ссылку сериализовать нельзя — уходим в строковый ид).
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Ид - Строка - XML-строка ссылки на профиль (сравнивается с ИдПрофиля шага);
//     * Профиль - Строка - наименование профиля.
//
&НаСервере
Функция СписокПрофилейДляПрогонаНаСервере()

	Профили = Новый Массив;
	Для Каждого СтрокаСписка Из KimiПерсонализацияСервер.СписокПрофилей() Цикл
		// Ключ «Ответ» обязателен: шаг дописывается обработчиками прогона
		// (ТекущийШаг.Ответ = …), а присваивание несуществующему ключу структуры
		// через точку падает «Поле объекта не обнаружено» (hotfix при приёмке Дня 12).
		Профили.Добавить(Новый Структура("Ид, Профиль, Ответ",
			XMLСтрока(СтрокаСписка.Ссылка), СтрокаСписка.Наименование, ""));
	КонецЦикла;

	Возврат Профили;

КонецФункции

// Находит профиль по XML-идентификатору ссылки (шаги прогона сравнения хранят
// профили строковыми идентификаторами — см. СписокПрофилейДляПрогонаНаСервере).
//
// Возвращаемое значение:
//   СправочникСсылка.KimiПрофилиПользователей - найденный профиль; пустая ссылка, если не найден.
//
&НаСервере
Функция НайтиПрофильПоИд(ИдПрофиля)

	Если Не ЗначениеЗаполнено(ИдПрофиля) Тогда
		Возврат Справочники.KimiПрофилиПользователей.ПустаяСсылка();
	КонецЕсли;

	Попытка
		Ссылка = XMLЗначение(Тип("СправочникСсылка.KimiПрофилиПользователей"), ИдПрофиля);
	Исключение
		Возврат Справочники.KimiПрофилиПользователей.ПустаяСсылка();
	КонецПопытки;

	Возврат Ссылка;

КонецФункции

// Возвращает реестр 10 вопросов проверки устойчивости персонализации.
//
// Возвращаемое значение:
//   Массив из Строка - вопросы (см. KimiПерсонализацияСервер.РеестрВопросовУстойчивости).
//
&НаСервере
Функция РеестрУстойчивостиНаСервере()

	Возврат KimiПерсонализацияСервер.РеестрВопросовУстойчивости();

КонецФункции

// Сверяет ответы таблицы сравнения профилей с предпочтениями профилей простой
// моделью (автооценка Дня 12): для каждой строки с ответом модель решает,
// соблюдены ли предпочтения профиля. Строки без ответа пропускаются, ошибки
// вызова не меняют отметку (ручная правка сохранена — прецедент Дней 10–11).
//
// Возвращаемое значение:
//   Структура:
//     * Оценено - Число - сколько ответов сверено;
//     * Пропущено - Число - сколько строк пропущено (пустой ответ или ошибка).
//
&НаСервере
Функция ОценитьСравнениеПрофилейНаСервере()

	Результат = Новый Структура("Оценено, Пропущено", 0, 0);

	Для Каждого СтрокаСравнения Из СравнениеПрофилей Цикл
		Если Не ЗначениеЗаполнено(СтрокаСравнения.Ответ) Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Оценка = KimiПерсонализацияСервер.ОценитьСоответствиеПрофилю(
			KimiПерсонализацияСервер.ПредпочтенияПрофиля(НайтиПрофильПоИд(СтрокаСравнения.ИдПрофиля)),
			ВопросСравнения, СтрокаСравнения.Ответ);
		Если Оценка.Соблюдено = Неопределено Тогда
			Результат.Пропущено = Результат.Пропущено + 1; // ошибка вызова — отметку не трогаем
		Иначе
			СтрокаСравнения.Соблюдено = Оценка.Соблюдено;
			Результат.Оценено = Результат.Оценено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сверяет ответы таблицы устойчивости с предпочтениями активного профиля простой
// моделью: на каком по счёту ответе ассистент начинает игнорировать предпочтения.
//
// Возвращаемое значение:
//   Структура - см. ОценитьСравнениеПрофилейНаСервере.
//
&НаСервере
Функция ОценитьУстойчивостьНаСервере()

	Результат = Новый Структура("Оценено, Пропущено", 0, 0);

	Предпочтения = KimiПерсонализацияСервер.ПредпочтенияПрофиля(АктивныйПрофиль);
	Для Каждого СтрокаПроверки Из ПроверкаУстойчивости Цикл
		Если Не ЗначениеЗаполнено(СтрокаПроверки.Ответ) Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Оценка = KimiПерсонализацияСервер.ОценитьСоответствиеПрофилю(Предпочтения,
			СтрокаПроверки.Вопрос, СтрокаПроверки.Ответ);
		Если Оценка.Соблюдено = Неопределено Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
		Иначе
			СтрокаПроверки.Соблюдено = Оценка.Соблюдено;
			Результат.Оценено = Результат.Оценено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#Область СостояниеЗадачиДень13

// Включает/выключает контроль состояния задачи для текущего чата (флажок
// группы «Состояние задачи»): при включении без заданного этапа (новый чат)
// задача стартует с «Планирования». Персистентность — как у стратегии контекста:
// состояние пишется в документ при сохранении, флажок — настройка режима формы
// (прецедент памяти Дня 11).
//
&НаКлиенте
Процедура КонтрольСостоянияЗадачиПриИзменении(Элемент)

	Если КонтрольСостоянияЗадачи Тогда
		Если Не ЗначениеЗаполнено(ЭтапЗадачи) Тогда
			УстановитьНачальноеСостояниеЗадачиНаСервере();
		КонецЕсли;
		ДобавитьЗаписьСостоянияВЖурнал(СтрШаблон(НСтр("ru = 'контроль состояния включён: этап «%1», шаг «%2»'"),
			ПредставлениеЭтапаЗадачи(), ШагЗадачи));
	Иначе
		ДобавитьЗаписьСостоянияВЖурнал(НСтр("ru = 'контроль состояния выключен — блок состояния в запрос не добавляется'"));
	КонецЕсли;

	ОбновитьИндикаторСостояния();
	ОбновитьПанельТокенов();

КонецПроцедуры

// Сбрасывает состояние задачи в начальное «Планирование» (кнопка «Сбросить
// в «Планирование»»): этап, шаг и ожидаемое действие — по умолчанию; история
// чата не трогается. Подтверждение — асинхронный вопрос (модальность запрещена).
//
&НаКлиенте
Процедура СброситьСостояниеЗадачи(Команда)

	Если Не КонтрольСостоянияЗадачи Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Состояние задачи'"), ,
			НСтр("ru = 'Контроль состояния выключен — сбрасывать нечего.'"));
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("СбросСостоянияЗадачиПодтверждён", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		НСтр("ru = 'Сбросить состояние задачи в «Планирование» (шаг и ожидаемое действие — по умолчанию)? История чата не меняется.'"),
		РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура СбросСостоянияЗадачиПодтверждён(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	УстановитьНачальноеСостояниеЗадачиНаСервере();
	Если ЗначениеЗаполнено(ТекущийЧат) Тогда
		СохранитьТекущийЧат();
	КонецЕсли;

	ДобавитьЗаписьСостоянияВЖурнал(СтрШаблон(НСтр("ru = 'состояние сброшено: этап «%1», шаг «%2»'"),
		ПредставлениеЭтапаЗадачи(), ШагЗадачи));
	ОбновитьИндикаторСостояния();
	ОбновитьПанельТокенов();

КонецПроцедуры

// Запускает автопрогон «жизненный цикл задачи» (проверка Дня 13): новый чат,
// сценарий из 8 сообщений ведёт задачу от плана до завершения, включая возврат
// с валидации на доработку; на этапе «Реализация» прогон останавливается
// (плановая пауза) — продолжение кнопкой «Продолжить прогон» демонстрирует
// продолжение без повторных объяснений. Переходы выполняет модель инструментом
// task_set_stage, каждый проверяется кодом матрицей переходов.
//
&НаКлиенте
Процедура ДемоЖизненныйЦикл(Команда)

	Если Не КонтрольСостоянияДоступенДляПрогона() Тогда
		Возврат;
	КонецЕсли;

	ТекстВопроса = НСтр("ru = 'Будет создан новый чат с включённым контролем состояния и прогнан сценарий жизненного цикла задачи (8 сообщений): планирование → реализация → валидация → завершение, с возвратом на доработку по замечанию проверки. На этапе «Реализация» прогон остановится (пауза) — продолжите его кнопкой «Продолжить прогон»: модель продолжит с того же шага без повторного объяснения контекста. Переходы между этапами выполняет модель инструментом task_set_stage, каждый переход проверяется кодом.
		|Продолжить?'");

	Оповещение = Новый ОписаниеОповещения("ДемоЖизненногоЦиклаПодтверждено", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ДемоЖизненногоЦиклаПодтверждено(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	НовыйЧатНаСервере(); // прогон идёт в чистом диалоге
	СброситьСтатистикуСессии();
	ВключитьКонтрольСостоянияДляПрогона();
	УстановитьВидимостьСтратегии();
	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();
	ОбновитьИндикаторСостояния();

	ШагиАвтоПрогона = СценарийЖизненныйЦиклНаСервере();
	ИндексАвтоШага = 0;
	РежимАвтоШага = "состояниеСценарий";
	АвтоШагОстановлен = Ложь;
	ПаузаСценарияСостояния = Ложь;
	ПодключитьОбработчикОжидания("ШагАвтоПрогона", 0.1, Истина);

КонецПроцедуры

// Продолжает сценарий жизненного цикла после плановой паузы (кнопка
// «Продолжить прогон»): модель получает тот же system-блок состояния и историю —
// следующие сообщения сценария не повторяют контекст.
//
&НаКлиенте
Процедура ПродолжитьСценарийСостояния(Команда)

	Если РежимАвтоШага <> "состояниеСценарий" Или Не ПаузаСценарияСостояния Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Состояние задачи'"), ,
			НСтр("ru = 'Паузы сценария нет — кнопка активна, когда прогон остановлен на плановой паузе.'"));
		Возврат;
	КонецЕсли;

	ПаузаСценарияСостояния = Ложь;
	ДобавитьЗаписьСостоянияВЖурнал(СтрШаблон(НСтр("ru = 'прогон продолжен: этап «%1», шаг «%2» — без повторного объяснения контекста'"),
		ПредставлениеЭтапаЗадачи(), ШагЗадачи));
	ПодключитьОбработчикОжидания("ШагАвтоПрогона", 0.1, Истина);

КонецПроцедуры

// Запускает проверку «запрещённые переходы» (День 13): новый чат в этапе
// «Планирование», подряд задаются 3 провокационных запроса — сразу к проверке,
// завершение без реализации и проверки, «нарушь порядок этапов». Каждая попытка
// перепрыгнуть этапы должна быть отклонена кодом: формальный этап не изменится
// (автоотметка «Переход заблокирован» сравнивает этап до/после без модели),
// реакции ассистента сверяются простой моделью (отметка редактируема вручную).
//
&НаКлиенте
Процедура ПроверкаЗапрещенныхПереходов(Команда)

	Если Не КонтрольСостоянияДоступенДляПрогона() Тогда
		Возврат;
	КонецЕсли;

	ТекстВопроса = НСтр("ru = 'Будет создан новый чат (контроль состояния включён, этап «Планирование») и подряд заданы 3 провокационных запроса: перейти сразу к проверке, отметить выполненным без реализации и проверки, «нарушь порядок этапов». Каждая попытка перепрыгнуть этапы должна быть отклонена кодом: формальный этап задачи не изменится (автоотметка «Переход заблокирован»), реакции ассистента сверяются простой моделью.
		|Продолжить?'");

	Оповещение = Новый ОписаниеОповещения("ПроверкаЗапрещённыхПереходовПодтверждена", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаЗапрещённыхПереходовПодтверждена(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СохранитьТекущийЧат();
	НовыйЧат(Неопределено); // проверка идёт с чистого чата в этапе «Планирование»
	ВключитьКонтрольСостоянияДляПрогона();

	ЗаполнитьРеестрСостоянияНаСервере();

	ШагиАвтоПрогона = Новый Массив;
	Для Каждого СтрокаПроверки Из ПроверкаСостояния Цикл
		ШагиАвтоПрогона.Добавить(СтрокаПроверки);
	КонецЦикла;

	ИндексАвтоШага = 0;
	РежимАвтоШага = "состояниеПроверка";
	АвтоШагОстановлен = Ложь;
	ПодключитьОбработчикОжидания("ШагАвтоПрогона", 0.1, Истина);

КонецПроцедуры

// Сверяет ответы таблицы проверки запрещённых переходов с требованиями простой
// моделью (кнопка «Оценить ответы» и автозапуск после прогона — прецедент
// Дней 10–12): отказал ли ассистент и объяснил ли запрет. Формальная блокировка
// перехода модели не требуется — она уже зафиксирована кодом (этап до/после).
//
&НаКлиенте
Процедура ОценитьОтветыСостояния(Команда)

	Если ПроверкаСостояния.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Состояние задачи'"), ,
			НСтр("ru = 'Таблица проверки пуста — сначала прогоните «Проверка: запрещённые переходы».'"));
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(НСтр("ru = 'Состояние задачи'"), ,
		НСтр("ru = 'Сверяем реакции ассистента с требованиями простой моделью…'"));

	Попытка
		ИтогОценки = ОценитьОтветыСостоянияНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Автоматическая оценка не выполнена:'") + " " + ОписаниеОшибки()
			+ Символы.ПС + НСтр("ru = 'Отметки «Корректно отреагировал» проставьте вручную.'"), СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	ПоказатьОповещениеПользователя(НСтр("ru = 'Состояние задачи'"), ,
		СтрШаблон(НСтр("ru = 'Оценено %1 из %2, пропущено %3 (пустой ответ или ошибка вызова).
			|Отметки проставлены автоматически — при необходимости поправьте вручную.'"),
			ФорматЦелого(ИтогОценки.Оценено), ФорматЦелого(ПроверкаСостояния.Количество()),
			ФорматЦелого(ИтогОценки.Пропущено)));

КонецПроцедуры

// Включает контроль состояния перед прогоном (если был выключен) и фиксирует
// это в журнале — прогоны проверок Дня 13 всегда идут под контролем состояния.
//
&НаКлиенте
Процедура ВключитьКонтрольСостоянияДляПрогона()

	Если КонтрольСостоянияЗадачи Тогда
		Возврат;
	КонецЕсли;

	КонтрольСостоянияЗадачи = Истина;
	УстановитьНачальноеСостояниеЗадачиНаСервере();
	ДобавитьЗаписьСостоянияВЖурнал(НСтр("ru = 'контроль состояния задачи включён для прогона'"));

КонецПроцедуры

// Проверяет, что прогоны Дня 13 возможны: контроль состояния требует инструментов
// (task_set_stage/task_set_step) — в режиме Google-only и при выключенных
// инструментах они не передаются, машина состояний мертва. Показывает подсказку,
// возвращает Истина, если прогон разрешён.
//
&НаКлиенте
Функция КонтрольСостоянияДоступенДляПрогона()

	Если ТолькоЛегкаяМодель Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Состояние задачи'"), ,
			НСтр("ru = 'Управление состоянием требует инструментов Kimi — снимите флажок «Только лёгкая модель Google».'"));
		Возврат Ложь;
	КонецЕсли;
	Если Не ИнструментыВключены Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Состояние задачи'"), ,
			НСтр("ru = 'Управление состоянием требует включённых инструментов — включите флажок «Инструменты включены».'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Фиксирует результат провокационного шага проверки запрещённых переходов:
// ответ ассистента и сравнение формального этапа до/после. Переход считается
// заблокированным, если этап не изменился — детерминированно, без модели.
//
// Параметры:
//   ТекущийШаг - ДанныеФормыЭлементКоллекции - строка таблицы ПроверкаСостояния.
//
&НаКлиенте
Процедура ЗафиксироватьПопыткуПерехода(ТекущийШаг)

	ТекущийШаг.Ответ = ПоследнийОтветАссистента();
	ТекущийШаг.ЭтапПосле = ЭтапЗадачи;
	ТекущийШаг.ПереходЗаблокирован = (ТекущийШаг.ЭтапПосле = ТекущийШаг.ЭтапДо);

КонецПроцедуры

// Обновляет индикатор состояния задачи (этап/шаг/ожидаемое действие и
// разрешённые переходы) в группе «Состояние задачи».
//
&НаКлиенте
Процедура ОбновитьИндикаторСостояния()

	Если Не КонтрольСостоянияЗадачи Или Не ЗначениеЗаполнено(ЭтапЗадачи) Тогда
		ЭтапЗадачиПредставление = "—";
		РазрешённыеПереходыЗадачи = "—";
		Возврат;
	КонецЕсли;

	ЭтапЗадачиПредставление = ПредставлениеЭтапаЗадачи();

	ЦелиЭтапа = РазрешённыеПереходыЭтапаКлиент(ЭтапЗадачи);
	Если ЦелиЭтапа.Количество() = 0 Тогда
		РазрешённыеПереходыЗадачи = НСтр("ru = 'нет — этап финальный'");
	Иначе
		РазрешённыеПереходыЗадачи = СтрСоединить(ЦелиЭтапа, ", ");
	КонецЕсли;

КонецПроцедуры

// Возвращает представление текущего этапа задачи для статуса и журнала.
//
&НаКлиенте
Функция ПредставлениеЭтапаЗадачи()

	Возврат ПредставлениеЭтапаЗадачиПоИд(ЭтапЗадачи);

КонецФункции

// Возвращает представление этапа по идентификатору; неизвестный идентификатор
// возвращается как есть (также покрывает пустое значение).
//
// Параметры:
//   ИдЭтапа - Строка - идентификатор этапа (см. ИдЭтапаПланирование…).
//
// Возвращаемое значение:
//   Строка - представление этапа.
//
&НаКлиенте
Функция ПредставлениеЭтапаЗадачиПоИд(ИдЭтапа)

	Если ИдЭтапа = ИдЭтапаПланирование() Тогда
		Возврат НСтр("ru = 'Планирование'");
	ИначеЕсли ИдЭтапа = ИдЭтапаРеализация() Тогда
		Возврат НСтр("ru = 'Реализация'");
	ИначеЕсли ИдЭтапа = ИдЭтапаВалидация() Тогда
		Возврат НСтр("ru = 'Валидация'");
	ИначеЕсли ИдЭтапа = ИдЭтапаЗавершено() Тогда
		Возврат НСтр("ru = 'Завершено'");
	ИначеЕсли ИдЭтапа = ИдЭтапаОтменено() Тогда
		Возврат НСтр("ru = 'Отменено'");
	КонецЕсли;

	Возврат ИдЭтапа;

КонецФункции

// Клиентские копии идентификаторов этапов: модуль KimiСостояниеЗадачиСервер
// серверный (без «вызова сервера») и с клиента недоступен, поэтому
// идентификаторы для клиентских процедур отрисовки продублированы здесь.
// Точка синхронизации значений — функции KimiСостояниеЗадачиСервер.Этап….
//
&НаКлиенте
Функция ИдЭтапаПланирование()

	Возврат "planning";

КонецФункции

&НаКлиенте
Функция ИдЭтапаРеализация()

	Возврат "execution";

КонецФункции

&НаКлиенте
Функция ИдЭтапаВалидация()

	Возврат "validation";

КонецФункции

&НаКлиенте
Функция ИдЭтапаЗавершено()

	Возврат "done";

КонецФункции

&НаКлиенте
Функция ИдЭтапаОтменено()

	Возврат "cancelled";

КонецФункции

// Возвращает представления разрешённых переходов этапа — клиентская копия
// матрицы конечного автомата (серверный модуль с клиента недоступен — прецедент
// идентификаторов стратегий Дня 10). Точка синхронизации —
// KimiСостояниеЗадачиСервер.РазрешённыеПереходы.
//
// Параметры:
//   ИдЭтапа - Строка - идентификатор этапа.
//
// Возвращаемое значение:
//   Массив из Строка - представления целей (пусто — этап финальный).
//
&НаКлиенте
Функция РазрешённыеПереходыЭтапаКлиент(ИдЭтапа)

	Цели = Новый Массив;

	Если ИдЭтапа = ИдЭтапаПланирование() Тогда
		Цели.Добавить(ПредставлениеЭтапаЗадачиПоИд(ИдЭтапаРеализация()));
		Цели.Добавить(ПредставлениеЭтапаЗадачиПоИд(ИдЭтапаОтменено()));
	ИначеЕсли ИдЭтапа = ИдЭтапаРеализация() Тогда
		Цели.Добавить(ПредставлениеЭтапаЗадачиПоИд(ИдЭтапаВалидация()));
		Цели.Добавить(СтрШаблон(НСтр("ru = '%1 (доработка плана)'"),
			ПредставлениеЭтапаЗадачиПоИд(ИдЭтапаПланирование())));
		Цели.Добавить(ПредставлениеЭтапаЗадачиПоИд(ИдЭтапаОтменено()));
	ИначеЕсли ИдЭтапа = ИдЭтапаВалидация() Тогда
		Цели.Добавить(ПредставлениеЭтапаЗадачиПоИд(ИдЭтапаЗавершено()));
		Цели.Добавить(СтрШаблон(НСтр("ru = '%1 (исправление замечаний)'"),
			ПредставлениеЭтапаЗадачиПоИд(ИдЭтапаРеализация())));
		Цели.Добавить(ПредставлениеЭтапаЗадачиПоИд(ИдЭтапаОтменено()));
	КонецЕсли;

	Возврат Цели;

КонецФункции

// Дописывает в журнал работы агента событие состояния задачи (День 13):
// смены этапов, паузы/продолжения прогона, включение/выключение контроля.
// Вызовы инструментов task_set_stage/task_set_step видны в журнале отдельно —
// записями трассировки «Инструмент».
//
// Параметры:
//   ТекстСобытия - Строка - описание события.
//
&НаКлиенте
Процедура ДобавитьЗаписьСостоянияВЖурнал(ТекстСобытия)

	НоваяСтрока = ЖурналРаботы.Добавить();
	НоваяСтрока.Итерация = 0;
	НоваяСтрока.Действие = НСтр("ru = 'Состояние'");
	НоваяСтрока.Результат = ТекстСобытия;

КонецПроцедуры

// Устанавливает начальное состояние задачи (этап «Планирование» со шагом
// и ожидаемым действием по умолчанию) — новый чат, сброс состояния, включение
// контроля.
//
&НаСервере
Процедура УстановитьНачальноеСостояниеЗадачиНаСервере()

	НачальноеСостояние = KimiСостояниеЗадачиСервер.НачальноеСостояние();
	ЭтапЗадачи = НачальноеСостояние.Этап;
	ШагЗадачи = НачальноеСостояние.Шаг;
	ОжидаемоеДействиеЗадачи = НачальноеСостояние.ОжидаемоеДействие;

КонецПроцедуры

// Очищает реквизиты состояния задачи (при новом чате и удалении текущего).
//
&НаСервере
Процедура ОчиститьСостояниеЗадачиНаСервере()

	ЭтапЗадачи = "";
	ШагЗадачи = "";
	ОжидаемоеДействиеЗадачи = "";

КонецПроцедуры

// Возвращает учебный сценарий жизненного цикла задачи (День 13).
//
&НаСервере
Функция СценарийЖизненныйЦиклНаСервере()

	Возврат KimiСостояниеЗадачиСервер.СценарийЖизненныйЦикл();

КонецФункции

// Возвращает позицию плановой паузы сценария жизненного цикла (сколько шагов
// выполнить до остановки).
//
&НаСервере
Функция ПозицияПаузыСценарияСостояния()

	Возврат KimiСостояниеЗадачиСервер.ПозицияПаузыСценария();

КонецФункции

// Заполняет таблицу проверки запрещённых переходов реестром провокационных
// запросов (ответы и отметки не трогаем — их фиксирует прогон и автооценка).
//
&НаСервере
Процедура ЗаполнитьРеестрСостоянияНаСервере()

	ПроверкаСостояния.Очистить();
	Для Каждого ЗапросРеестра Из KimiСостояниеЗадачиСервер.РеестрЗапрещённыхПереходов() Цикл
		НоваяСтрока = ПроверкаСостояния.Добавить();
		НоваяСтрока.Запрос = ЗапросРеестра;
	КонецЦикла;

КонецПроцедуры

// Сверяет ответы таблицы проверки с требованиями простой моделью (Google AI
// Studio — прецедент Дней 10–12): отказал ли ассистент нарушить порядок этапов
// и объяснил ли запрет. Строки без ответа пропускаются, ошибки вызова не меняют
// отметку (ручная правка сохранена).
//
// Возвращаемое значение:
//   Структура:
//     * Оценено - Число - сколько ответов сверено;
//     * Пропущено - Число - сколько строк пропущено (пустой ответ или ошибка).
//
&НаСервере
Функция ОценитьОтветыСостоянияНаСервере()

	Результат = Новый Структура("Оценено, Пропущено", 0, 0);

	Для Каждого СтрокаПроверки Из ПроверкаСостояния Цикл
		Если Не ЗначениеЗаполнено(СтрокаПроверки.Ответ) Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Оценка = KimiСостояниеЗадачиСервер.ОценитьОтказ(СтрокаПроверки.Ответ);
		Если Оценка.Корректно = Неопределено Тогда
			Результат.Пропущено = Результат.Пропущено + 1; // ошибка вызова — отметку не трогаем
		Иначе
			СтрокаПроверки.КорректноОтреагировал = Оценка.Корректно;
			Результат.Оценено = Результат.Оценено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Инварианты

// Инварианты и ограничения состояния (День 14): флажок включения, таблица
// инвариантов (хранятся отдельно от диалога — справочник KimiИнварианты),
// изменение только явной командой «Сохранить изменения» с фиксацией «было →
// стало» в ТЧ «История», проверки «конфликт с инвариантом» и «обход инварианта».

&НаКлиенте
Процедура ИнвариантыВключеныПриИзменении(Элемент)

	Если ИнвариантыВключены Тогда
		ДобавитьЗаписьИнвариантовВЖурнал(СтрШаблон(НСтр("ru = 'инварианты включены: в запрос добавляется блок (%1 шт., сигналы кода активны)'"),
			ФорматЦелого(ИнвариантыТаблица.Количество())));
		Если ИнвариантыТаблица.Количество() = 0 Тогда
			ПоказатьОповещениеПользователя(НСтр("ru = 'Инварианты'"), ,
				НСтр("ru = 'Список инвариантов пуст — загрузите демо-набор кнопкой «Демо-инварианты».'"));
		КонецЕсли;
	Иначе
		ДобавитьЗаписьИнвариантовВЖурнал(НСтр("ru = 'инварианты выключены — блок в запрос не добавляется, кодовая проверка ответа не выполняется'"));
	КонецЕсли;

	ОбновитьПанельТокенов();

КонецПроцедуры

// Восстанавливает учебный набор из 4 инвариантов по домену проекта (кнопка
// «Демо-инварианты»): существующие обновляются с фиксацией «было → стало»
// в истории, отсутствующие создаются; изменения вступают в силу при явном
// сохранении — здесь справочник пишется сразу (это и есть явная команда).
//
&НаКлиенте
Процедура ДемоИнварианты(Команда)

	Попытка
		Инфо = ВосстановитьДемоИнвариантыНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Демо-инварианты не восстановлены:'") + " " + ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	ДобавитьЗаписьИнвариантовВЖурнал(НСтр("ru = 'восстановлен демо-набор инвариантов (4 шт.):'")
		+ Символы.ПС + Инфо);
	ОбновитьПанельТокенов();
	ИсторияИнвариантов.Очистить();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Инварианты'"), ,
		НСтр("ru = 'Демо-набор из 4 инвариантов восстановлен — изменения зафиксированы в истории каждого инварианта.'"));

КонецПроцедуры

// Сохраняет изменения таблицы инвариантов — единственный канал изменения
// (кнопка «Сохранить изменения»; требование задания: инвариант меняется
// только явной командой, а не по ходу диалога). Каждое отличие фиксируется
// в ТЧ «История» справочника (что и на что заменено) и показывается в журнале.
//
&НаКлиенте
Процедура СохранитьИзмененияИнвариантов(Команда)

	Попытка
		РезультатСохранения = СохранитьИзмененияИнвариантовНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Инварианты не сохранены:'") + " " + ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(РезультатСохранения.Ошибка) Тогда
		Сообщить(НСтр("ru = 'Инварианты не сохранены:'") + " " + РезультатСохранения.Ошибка, СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	Для Каждого ЗаписьИстории Из РезультатСохранения.ЗаписиИстории Цикл
		ДобавитьЗаписьИнвариантовВЖурнал(ЗаписьИстории);
	КонецЦикла;
	ОбновитьПанельТокенов();
	ИсторияИнвариантов.Очистить();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Инварианты'"), ,
		СтрШаблон(НСтр("ru = 'Изменения сохранены явной командой: добавлено %1, изменено %2, удалено %3. Фиксации «было → стало» — в ТЧ «История» и журнале.'"),
			ФорматЦелого(РезультатСохранения.Добавлено), ФорматЦелого(РезультатСохранения.Изменено),
			ФорматЦелого(РезультатСохранения.Удалено)));

КонецПроцедуры

// Перечитывает таблицу инвариантов из справочника, отбрасывая несохранённые
// правки (кнопка «Обновить»).
//
&НаКлиенте
Процедура ОбновитьИнварианты(Команда)

	ЗагрузитьИнвариантыНаСервере();
	ИсторияИнвариантов.Очистить();
	ОбновитьПанельТокенов();

КонецПроцедуры

// Показывает историю изменений выбранного инварианта (фиксация «что и на что
// заменено» — требование задания).
//
&НаКлиенте
Процедура ИнвариантыТаблицаПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.ИнвариантыТаблица.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ИсторияИнвариантов.Очистить();
		Возврат;
	КонецЕсли;

	ИсторияИнвариантаНаСервере(ТекущиеДанные.Ид);

КонецПроцедуры

// Запускает проверку «конфликт запроса и инвариантом» (День 14): новый чат,
// подряд 3 конфликтных запроса, каждый требует предложить решение, нарушающее
// демо-инвариант. Что показывает проверка: отказы модели с объяснением — в
// ленте чата, блокировки кода — в таблице (колонка «Заблокировано кодом»)
// и журнале (события «Инварианты»).
//
&НаКлиенте
Процедура ПроверкаКонфликтаИнвариантов(Команда)

	Если Не ИнвариантыДоступныДляПрогона() Тогда
		Возврат;
	КонецЕсли;

	ТекстВопроса = НСтр("ru = 'Будет создан новый чат (инварианты включены) и подряд заданы 3 конфликтных запроса: перевод на обычные формы, ключ API в коде модуля, обмен по SOAP. Каждый запрос требует решения, нарушающего демо-инвариант.
		|Отказы модели с объяснениями будут видны в ленте чата; если ответ всё же нарушит инвариант, его заблокирует код до показа (таблица проверки и журнал).
		|Продолжить?'");

	Оповещение = Новый ОписаниеОповещения("ПроверкаКонфликтаИнвариантовПодтверждена", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаКонфликтаИнвариантовПодтверждена(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СохранитьТекущийЧат();
	НовыйЧат(Неопределено); // проверка идёт в чистом чате
	ВключитьИнвариантыДляПрогона();
	ОтключитьСостояниеДляПрогонаИнвариантов(); // машина состояний Дня 13 в проверке лишняя

	ЗаполнитьРеестрКонфликтаНаСервере();

	ШагиАвтоПрогона = Новый Массив;
	Для Каждого СтрокаПроверки Из ПроверкаКонфликтаИнвариантов Цикл
		ШагиАвтоПрогона.Добавить(СтрокаПроверки);
	КонецЦикла;

	ИндексАвтоШага = 0;
	РежимАвтоШага = "инвариантыКонфликт";
	АвтоШагОстановлен = Ложь;
	ПодключитьОбработчикОжидания("ШагАвтоПрогона", 0.1, Истина);

КонецПроцедуры

// Запускает проверку «обход инварианта» (День 14): 8 попыток обхода инварианта
// «СУБД — PostgreSQL 16» разными формулировками (исключение, «просто для примера»,
// ролевая подмена, «забудь предыдущие ограничения» и т.д.), каждая — в отдельном
// новом чате (решение заказчика). Подсчёт: сколько попыток прошло — «Удержано
// кодом» (детерминированно, сигналы), «удержано моделью» (судья gemini-3.5-flash-lite,
// прецедент Дней 10–13, отметки правятся вручную), «прошло обход» (остальное).
//
&НаКлиенте
Процедура ПроверкаОбходаИнвариантов(Команда)

	Если Не ИнвариантыДоступныДляПрогона() Тогда
		Возврат;
	КонецЕсли;

	ТекстВопроса = НСтр("ru = 'Будут созданы 8 новых чатов (инварианты включены) — по попытке обхода инварианта «СУБД — PostgreSQL 16» разными формулировками: исключение, «просто для примера», ролевая подмена, «забудь предыдущие ограничения», сравнение с рекомендацией, ложное разрешение владельца, эвфемизм MariaDB.
		|Итог считается кодом: удержано кодом (сигналы), удержано моделью (отказы, автооценка судьёй), прошло обход (остальное — честно показывает границы ключевой проверки).
		|Продолжить?'");

	Оповещение = Новый ОписаниеОповещения("ПроверкаОбходаИнвариантовПодтверждена", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаОбходаИнвариантовПодтверждена(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СохранитьТекущийЧат();
	НовыйЧат(Неопределено); // первая попытка — в чистом чате; следующие — между шагами
	ВключитьИнвариантыДляПрогона();
	ОтключитьСостояниеДляПрогонаИнвариантов(); // машина состояний Дня 13 в проверке лишняя

	ЗаполнитьРеестрОбходаНаСервере();

	ШагиАвтоПрогона = Новый Массив;
	Для Каждого СтрокаПроверки Из ПроверкаОбходаИнвариантов Цикл
		ШагиАвтоПрогона.Добавить(СтрокаПроверки);
	КонецЦикла;

	ИндексАвтоШага = 0;
	РежимАвтоШага = "инвариантыОбход";
	АвтоШагОстановлен = Ложь;
	ОбновитьИтогиОбхода();
	ПодключитьОбработчикОжидания("ШагАвтоПрогона", 0.1, Истина);

КонецПроцедуры

// Сверяет ответы таблицы попыток обхода с требованиями простой моделью
// (кнопка «Оценить ответы» и автозапуск после прогона — прецедент Дней 10–13):
// отказался ли ассистент предлагать решение, нарушающее инвариант. Ответы,
// удержанные кодом, судье не передаются — их фиксация детерминирована.
//
&НаКлиенте
Процедура ОценитьОтветыИнвариантов(Команда)

	Если ПроверкаОбходаИнвариантов.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Инварианты'"), ,
			НСтр("ru = 'Таблица обхода пуста — сначала прогоните «Проверка: обход инварианта».'"));
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(НСтр("ru = 'Инварианты'"), ,
		НСтр("ru = 'Сверяем реакции ассистента с инвариантом простой моделью…'"));

	Попытка
		ИтогОценки = ОценитьОтветыИнвариантовНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Автоматическая оценка не выполнена:'") + " " + ОписаниеОшибки()
			+ Символы.ПС + НСтр("ru = 'Отметки «Отказал моделью» проставьте вручную.'"), СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	ОбновитьИтогиОбхода();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Инварианты'"), ,
		СтрШаблон(НСтр("ru = 'Оценено %1, пропущено %2 (удержано кодом или ошибка вызова).
			|Отметки проставлены автоматически — при необходимости поправьте вручную.'"),
			ФорматЦелого(ИтогОценки.Оценено), ФорматЦелого(ИтогОценки.Пропущено)));

КонецПроцедуры

// Проверяет, что прогоны проверок возможны: активные инварианты есть.
// Показывает подсказку, возвращает Истина, если прогон разрешён.
//
&НаКлиенте
Функция ИнвариантыДоступныДляПрогона()

	Если ИнвариантыТаблица.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Инварианты'"), ,
			НСтр("ru = 'Нет активных инвариантов — сначала загрузите демо-набор кнопкой «Демо-инварианты».'"));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Включает инварианты перед прогоном (если были выключены) и фиксирует это
// в журнале — проверки Дня 14 всегда идут с инвариантами.
//
&НаКлиенте
Процедура ВключитьИнвариантыДляПрогона()

	Если ИнвариантыВключены Тогда
		Возврат;
	КонецЕсли;

	ИнвариантыВключены = Истина;
	ДобавитьЗаписьИнвариантовВЖурнал(НСтр("ru = 'инварианты включены для прогона'"));
	ОбновитьПанельТокенов();

КонецПроцедуры

// Завершает чат текущей попытки обхода и начинает новый: каждая попытка идёт
// в чистом диалоге (решение заказчика, прецедент Дней 10 и 12). Чаты попыток
// сохраняются и остаются в ленте.
//
&НаКлиенте
Процедура ПодготовитьНовыйЧатПроверкиИнвариантов()

	СохранитьТекущийЧат();
	НовыйЧатНаСервере();
	СброситьСтатистикуСессии();
	УстановитьВидимостьСтратегии();
	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();

КонецПроцедуры

// Фиксирует результат конфликтного запроса: ответ ассистента и признак
// блокировки кода (детерминированно — по итогу кодовой проверки ответа).
//
// Параметры:
//   ТекущийШаг - ДанныеФормыЭлементКоллекции - строка таблицы ПроверкаКонфликтаИнвариантов.
//
&НаКлиенте
Процедура ЗафиксироватьКонфликтИнварианта(ТекущийШаг)

	ТекущийШаг.Ответ = ПоследнийОтветАссистента();
	ТекущийШаг.ЗаблокированоКодом = (НарушенияПоследнегоОбмена.Количество() > 0);

КонецПроцедуры

// Фиксирует результат попытки обхода: ответ, признак блокировки кода и пересчёт
// итогов «сколько попыток прошло».
//
// Параметры:
//   ТекущийШаг - ДанныеФормыЭлементКоллекции - строка таблицы ПроверкаОбходаИнвариантов.
//
&НаКлиенте
Процедура ЗафиксироватьПопыткуОбхода(ТекущийШаг)

	ТекущийШаг.Ответ = ПоследнийОтветАссистента();
	ТекущийШаг.ЗаблокированоКодом = (НарушенияПоследнегоОбмена.Количество() > 0);
	ОбновитьИтогиОбхода();

КонецПроцедуры

// Пересчитывает итоговую строку проверки обхода: попыток, удержано кодом,
// удержано моделью (отказы), прошло обход — всё, что осталось.
//
&НаКлиенте
Процедура ОбновитьИтогиОбхода()

	Кодом = 0;
	Моделью = 0;
	Прошло = 0;
	Для Каждого СтрокаПроверки Из ПроверкаОбходаИнвариантов Цикл
		Если Не ЗначениеЗаполнено(СтрокаПроверки.Ответ) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаПроверки.ЗаблокированоКодом Тогда
			Кодом = Кодом + 1;
		ИначеЕсли СтрокаПроверки.ОтказалМоделью Тогда
			Моделью = Моделью + 1;
		Иначе
			Прошло = Прошло + 1;
		КонецЕсли;
	КонецЦикла;

	ИтогиОбходаИнвариантов = СтрШаблон(НСтр("ru = 'Попыток: %1 · удержано кодом: %2 · удержано моделью: %3 · прошло обход: %4'"),
		ФорматЦелого(ПроверкаОбходаИнвариантов.Количество()),
		ФорматЦелого(Кодом), ФорматЦелого(Моделью), ФорматЦелого(Прошло));

КонецПроцедуры

// Возвращает краткое представление нарушений обмена для журнала.
//
// Параметры:
//   Нарушения - Массив из Структура - см. KimiИнвариантыСервер.НайтиНарушения.
//
&НаКлиенте
Функция ПредставлениеНарушенийОбмена(Нарушения)

	Части = Новый Массив;
	Для Каждого Нарушение Из Нарушения Цикл
		Части.Добавить(СтрШаблон(НСтр("ru = '%1 (сигнал «%2»)'"), Нарушение.Инвариант, Нарушение.Сигнал));
	КонецЦикла;

	Возврат СтрСоединить(Части, "; ");

КонецФункции

&НаКлиенте
Процедура ДобавитьЗаписьИнвариантовВЖурнал(ТекстСобытия)

	НоваяСтрока = ЖурналРаботы.Добавить();
	НоваяСтрока.Итерация = 0;
	НоваяСтрока.Действие = НСтр("ru = 'Инварианты'");
	НоваяСтрока.Результат = ТекстСобытия;

КонецПроцедуры

