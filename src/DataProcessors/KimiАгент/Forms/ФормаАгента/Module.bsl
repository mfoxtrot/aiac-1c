&НаКлиенте
Процедура ОтправитьВопрос(Команда)

	ОтправитьВопросАгенту();

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДиалог(Команда)

	История.Очистить();
	ЖурналРаботы.Очистить();
	СтатусОтвета = "";
	ИнициализироватьЧат();

КонецПроцедуры

&НаКлиенте
Процедура ПриСозданииНаКлиенте(Отказ, СтандартнаяОбработка)

	ИнициализироватьЧат();

КонецПроцедуры

// Очищает чат и задаёт ширину колонок ленты: колонка 1 — автор, колонка 2 — текст сообщения.
//
&НаКлиенте
Процедура ИнициализироватьЧат()

	ЧатТабДок.Очистить();
	ЧатТабДок.Область(, 1, , 1).ШиринаКолонки = 10;
	ЧатТабДок.Область(, 2, , 2).ШиринаКолонки = 100;

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВопросАгенту()

	ТекстВопроса = СокрЛП(ТекущийВопрос);
	Если Не ЗначениеЗаполнено(ТекстВопроса) Тогда
		Возврат;
	КонецЕсли;

	ДобавитьСообщениеВИсторию("Вы", ТекстВопроса);
	ТекущийВопрос = "";

	ПоказатьОповещениеПользователя(НСтр("ru = 'Агент Kimi'"), , НСтр("ru = 'Выполняется запрос…'"));

	Попытка
		РезультатАгента = ВыполнитьЗапросАгентаНаСервере();
	Исключение
		Сообщить(ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	ДобавитьСообщениеВИсторию("Kimi", РезультатАгента.Ответ);
	ЗаполнитьЖурнал(РезультатАгента.Журнал);
	ОбновитьСтатус(РезультатАгента);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСообщениеВИсторию(Автор, ТекстСообщения)

	НоваяСтрока = История.Добавить();
	НоваяСтрока.Роль = Автор;
	НоваяСтрока.Текст = ТекстСообщения;

	ДобавитьСообщениеВЧат(Автор, ТекстСообщения);

КонецПроцедуры

// Дописывает сообщение в ленту чата: колонка 1 — автор (полужирный, цвет роли),
// колонка 2 — текст (перенос, авто-высота строки), затем прокручивает ленту к новой строке.
//
// Параметры:
//   Автор - Строка - "Вы" или "Kimi";
//   ТекстСообщения - Строка - текст сообщения (может быть многострочным).
//
&НаКлиенте
Процедура ДобавитьСообщениеВЧат(Автор, ТекстСообщения)

	НомерСтроки = ЧатТабДок.ВысотаТаблицы + 1;

	ОбластьАвтора = ЧатТабДок.Область(НомерСтроки, 1, НомерСтроки, 1);
	ОбластьАвтора.Текст = Автор;
	ОбластьАвтора.Шрифт = Новый Шрифт(Новый Шрифт(), , НачертаниеШрифта.Полужирный);
	// Цвета повторяют стилевые элементы KimiЦветПользователя (Web.DarkGreen)
	// и KimiЦветМодели (Web.DarkBlue): табличный документ ссылки на стили не поддерживает.
	ОбластьАвтора.ЦветТекста = ?(Автор = "Вы", Новый Цвет(0, 100, 0), Новый Цвет(0, 0, 139));

	ОбластьСообщения = ЧатТабДок.Область(НомерСтроки, 2, НомерСтроки, 2);
	ОбластьСообщения.Текст = ТекстСообщения;
	ОбластьСообщения.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;

	ОбластьСтроки = ЧатТабДок.Область(НомерСтроки, 1, НомерСтроки, 2);
	ОбластьСтроки.АвтоВысотаСтроки = Истина;

	Элементы.Чат.ТекущаяОбласть = ОбластьСтроки;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЖурнал(ЖурналАгента)

	ЖурналРаботы.Очистить();
	Для Каждого ЗаписьЖурнала Из ЖурналАгента Цикл
		НоваяСтрока = ЖурналРаботы.Добавить();
		НоваяСтрока.Итерация = ЗаписьЖурнала.Итерация;
		НоваяСтрока.Действие = ЗаписьЖурнала.Действие;
		НоваяСтрока.Инструмент = ЗаписьЖурнала.Инструмент;
		НоваяСтрока.Аргументы = ЗаписьЖурнала.Аргументы;
		НоваяСтрока.Результат = ЗаписьЖурнала.Результат;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатус(РезультатАгента)

	ВремяСекунд = Окр(РезультатАгента.ВремяМиллисекунд / 1000, 1);
	СтатусОтвета = СтрШаблон(НСтр("ru = 'Итераций: %1 · Вызовов инструментов: %2 · Токены: %3 · Время: %4 с'"),
		РезультатАгента.ЧислоИтераций, РезультатАгента.ЧислоВызововИнструментов,
		РезультатАгента.ТокеныВсего, Формат(ВремяСекунд, "ЧГ="));

	Если РезультатАгента.ЛимитИтерацийИсчерпан Тогда
		СтатусОтвета = СтатусОтвета + " " + НСтр("ru = '(лимит итераций исчерпан)'");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ВыполнитьЗапросАгентаНаСервере()

	ИсторияДиалога = РеквизитФормыВЗначение("История");

	Возврат KimiАгентСервер.ВыполнитьЗапросАгента(ИсторияДиалога, Не ИнструментыВключены);

КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИнструментыВключены = Истина;

КонецПроцедуры
