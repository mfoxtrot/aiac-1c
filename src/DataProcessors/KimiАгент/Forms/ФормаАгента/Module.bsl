// Запускает прогон учебного сценария заполнения слоёв памяти (День 11):
// новый чат, 6 сообщений — каждое порождает данные заявленного слоя
// (долговременная — с категорией, рабочая, краткосрочная), слои наполняются
// автоматически с фиксацией в журнале; после прогона автоматически задаются
// контрольные вопросы этапа «все слои заполнены».
//
&НаКлиенте
Процедура ДемоЗаполнитьПамять(Команда)

	ТекстВопроса = НСтр("ru = 'Будет создан новый чат и прогнан учебный сценарий из 6 сообщений: каждое порождает данные своего слоя памяти — имя и проект (профиль), решения по СУБД и облаку (решения), курсы валют (знания) уйдут в долговременную память; параметры текущей задачи — в рабочую; деталь о завтрашней планёрке останется в текущем диалоге. Слои наполняются автоматически (явный выбор зафиксирован сценарием и виден в журнале), после прогона автоматически задаются контрольные вопросы.
		|Продолжить?'");

	Оповещение = Новый ОписаниеОповещения("ДемоЗаполненияПодтверждено", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ДемоЗаполненияПодтверждено(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	НовыйЧатНаСервере(); // прогон идёт в чистом диалоге
	СброситьСтатистикуСессии();
	ЭтапПроверкиПамяти = 0;
	ПроверкаПамяти.Очистить();
	ПредлагаемыеФакты.Очистить();
	УстановитьВидимостьСтратегии();
	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();

	ШагиАвтоПрогона = СценарийЗаполненияПамятиНаСервере();
	ИндексАвтоШага = 0;
	РежимАвтоШага = "памятьСценарий";
	АвтоШагОстановлен = Ложь;
	ПодключитьОбработчикОжидания("ШагАвтоПрогона", 0.1, Истина);

КонецПроцедуры

// Задаёт контрольные вопросы текущего этапа проверки (6 вопросов, по два на
// слой) и фиксирует ответы в таблице ПроверкаПамяти; после прогона ответы
// автоматически сверяются с эталонами простой моделью (по образцу Дня 10).
//
&НаКлиенте
Процедура ЗадатьВопросыПамяти(Команда)

	Если История.Количество() = 0 И ЭтапПроверкиПамяти < 2 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Модель памяти'"), ,
			НСтр("ru = 'История пуста — сначала прогоните «Демо: заполнить слои».'"));
		Возврат;
	КонецЕсли;

	ЗаполнитьРеестрПамятиНаСервере();
	Если ПроверкаПамяти.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ШагиАвтоПрогона = Новый Массив;
	Для Каждого СтрокаПроверки Из ПроверкаПамяти Цикл
		ШагиАвтоПрогона.Добавить(СтрокаПроверки);
	КонецЦикла;

	ИндексАвтоШага = 0;
	РежимАвтоШага = "памятьВопросы";
	АвтоШагОстановлен = Ложь;
	ПодключитьОбработчикОжидания("ШагАвтоПрогона", 0.1, Истина);

КонецПроцедуры

// Этап 1 проверки модели памяти: очищает рабочую память и повторяет контрольные
// вопросы — вопросы рабочего слоя должны перестать получать ответы, остальные
// слои продолжают работать.
//
&НаКлиенте
Процедура ЭтапОчиститьРабочую(Команда)

	РабочаяПамять.Очистить();
	Если ЗначениеЗаполнено(ТекущийЧат) Тогда
		СохранитьТекущийЧат();
	КонецЕсли;
	ЭтапПроверкиПамяти = Макс(ЭтапПроверкиПамяти, 1);

	ДобавитьЗаписьПамятиВЖурнал(НСтр("ru = 'этап 1: рабочая память очищена — задаём контрольные вопросы'"));
	ОбновитьПанельТокенов();
	ЗадатьВопросыПамяти(Неопределено);

КонецПроцедуры

// Этап 2 проверки: завершает текущий чат и повторяет контрольные вопросы в
// новом — краткосрочная память сброшена; долговременная должна продолжать
// отвечать (факты уходят в запрос независимо от диалога).
//
&НаКлиенте
Процедура ЭтапНовыйЧат(Команда)

	НовыйЧат(Неопределено);
	ЭтапПроверкиПамяти = Макс(ЭтапПроверкиПамяти, 2);

	ДобавитьЗаписьПамятиВЖурнал(НСтр("ru = 'этап 2: новый чат (краткосрочная память сброшена) — задаём контрольные вопросы'"));
	ЗадатьВопросыПамяти(Неопределено);

КонецПроцедуры

// Этап 3 проверки: очищает долговременную память и повторяет контрольные
// вопросы — вопросы долговременного слоя должны перестать получать ответы.
//
&НаКлиенте
Процедура ЭтапОчиститьПамять(Команда)

	Оповещение = Новый ОписаниеОповещения("ОчисткаПамятиЭтапПодтверждена", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		НСтр("ru = 'Этап 3: очистить долговременную память? Все факты будут помечены на удаление (обратимо).'"),
		РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ОчисткаПамятиЭтапПодтверждена(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Очищено = ОчиститьДолговременнуюПамятьНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Не удалось очистить долговременную память:'") + " " + ОписаниеОшибки(),
			СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	ЭтапПроверкиПамяти = 3;
	ДобавитьЗаписьПамятиВЖурнал(СтрШаблон(НСтр("ru = 'этап 3: долговременная память очищена (фактов помечено %1) — задаём контрольные вопросы'"),
		ФорматЦелого(Очищено)));
	ОбновитьПанельТокенов();
	ЗадатьВопросыПамяти(Неопределено);

КонецПроцедуры

// Сверяет ответы контрольных вопросов памяти с эталонами простой моделью
// (Google AI Studio — прецедент Дня 10) и проставляет отметки в колонку
// текущего этапа. Отметки остаются редактируемыми: автоматика предлагает,
// заказчик правит при необходимости.
//
&НаКлиенте
Процедура ОценитьОтветыПамяти(Команда)

	Если ПроверкаПамяти.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Модель памяти'"), ,
			НСтр("ru = 'Реестр пуст — сначала задайте контрольные вопросы.'"));
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(НСтр("ru = 'Модель памяти'"), ,
		НСтр("ru = 'Сверяем ответы с эталонами простой моделью…'"));

	Попытка
		ИтогОценки = ОценитьОтветыПамятиНаСервере(ЭтапПроверкиПамяти);
	Исключение
		Сообщить(НСтр("ru = 'Автоматическая оценка не выполнена:'") + " " + ОписаниеОшибки()
			+ Символы.ПС + НСтр("ru = 'Отметки проставьте вручную.'"), СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	ПоказатьОповещениеПользователя(НСтр("ru = 'Модель памяти'"), ,
		СтрШаблон(НСтр("ru = 'Этап «%1»: оценено %2 из %3, пропущено %4 (пустой ответ или ошибка вызова).
			|Отметки проставлены автоматически — при необходимости поправьте вручную.'"),
			ИмяЭтапаПамяти(ЭтапПроверкиПамяти), ФорматЦелого(ИтогОценки.Оценено),
			ФорматЦелого(ПроверкаПамяти.Количество()), ФорматЦелого(ИтогОценки.Пропущено)));

КонецПроцедуры

// Наполняет заявленный шагом сценария слой памяти: краткосрочная не требует
// действий (это сам диалог), рабочая пополняется заметками, долговременная —
// фактами с категорией шага. Ошибка извлечения сообщается, прогон не рвётся.
//
// Параметры:
//   ТекущийШаг - Структура - шаг сценария (Текст, Слой, Категория).
//
&НаКлиенте
Процедура СохранитьОбменВСлой(ТекущийШаг)

	Если ТекущийШаг.Слой = ИдСлояКраткосрочная() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Результат = СохранитьОбменВСлойНаСервере(ТекущийШаг.Слой, ТекущийШаг.Категория);
	Исключение
		Сообщить(НСтр("ru = 'Автосохранение слоя памяти не выполнено:'") + " " + ОписаниеОшибки(),
			СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		Сообщить(СтрШаблон(НСтр("ru = 'Автосохранение слоя «%1» не выполнено: %2'"),
			ТекущийШаг.Слой, Результат.Ошибка), СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	Если ТекущийШаг.Слой = ИдСлояДолговременная() Тогда
		ТекстСобытия = СтрШаблон(НСтр("ru = 'в долговременную память сохранено фактов: %1 (категория «%2»)'"),
			ФорматЦелого(Результат.Сохранено), ТекущийШаг.Категория);
	Иначе
		ТекстСобытия = СтрШаблон(НСтр("ru = 'в рабочую память добавлено заметок: %1'"), ФорматЦелого(Результат.Сохранено));
	КонецЕсли;
	ДобавитьЗаписьПамятиВЖурнал(ТекстСобытия);
	ЗаменыСлоя = Неопределено;
	Если Результат.Свойство("Замены", ЗаменыСлоя) И ЗаменыСлоя <> Неопределено Тогда
		// День 15: конфликтующие значения заменяются, а не добавляются рядом —
		// каждая замена видна в журнале (что было → что стало).
		Для Каждого Замена Из ЗаменыСлоя Цикл
			Если Замена.Действие = "замена" Тогда
				ДобавитьЗаписьПамятиВЖурнал(СтрШаблон(НСтр("ru = 'факт «%1»: замена — было «%2» → стало «%3»'"),
					Замена.Ключ, Замена.Было, Замена.Стало));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ОбновитьПанельТокенов();

КонецПроцедуры

#Область УстареваниеПамятиДень15

// Запускает прогон учебного сценария Дня 15 «факты меняются по ходу диалога»:
// новый чат, изменения фактов в рабочем чате, контрольные вопросы после каждого
// изменения — в новых чатах (агент отвечает только из памяти). Перед прогоном
// ключи демо очищаются (детерминированный повтор), память включается принудительно.
//
&НаКлиенте
Процедура ДемоИзменениеФактов(Команда)

	ТекстВопроса = НСтр("ru = 'Будет создан новый чат и прогнан сценарий Дня 15: факты будут меняться по ходу диалога (срок сдвинется, требование отменят, подход заменят, решения накопятся списком, появится временный факт), после каждого изменения контрольный вопрос задаётся в НОВОМ чате — агент отвечает только из памяти. Ключи демо перед прогоном очищаются, память включается принудительно.
		|Продолжить?'");

	Оповещение = Новый ОписаниеОповещения("ДемоИзменениеФактовПодтверждено", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ДемоИзменениеФактовПодтверждено(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ОчищеноКлючей = ПодготовитьДемоУстареванияНаСервере();
	ПамятьВключена = Истина; // контроль в новом чате возможен только с инъекцией фактов
	РабочийЧатУстаревания = Неопределено;
	ПроверкаУстаревания.Очистить();
	ОбновитьИтогиУстаревания();

	НовыйЧатНаСервере(); // прогон идёт в чистом диалоге
	СброситьСтатистикуСессии();
	УстановитьВидимостьСтратегии();
	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();
	ОбновитьУстареваниеНаСервере();

	ДобавитьЗаписьПамятиВЖурнал(СтрШаблон(НСтр("ru = 'демо Дня 15: ключи сценария очищены (%1 фактов), память включена для прогона'"),
		ФорматЦелого(ОчищеноКлючей)));

	ШагиАвтоПрогона = СценарийИзмененияФактовНаСервере();
	ИндексАвтоШага = 0;
	РежимАвтоШага = "устареваниеДемо";
	АвтоШагОстановлен = Ложь;
	ПодключитьОбработчикОжидания("ШагАвтоПрогона", 0.1, Истина);

КонецПроцедуры

// Завершает задачу (проверка очистки Дня 15): рабочая память очищается, временные
// факты помечаются на удаление; перезаписываемые и накапливаемые факты сохраняются.
//
&НаКлиенте
Процедура ЗавершитьЗадачу(Команда)

	ТекстВопроса = НСтр("ru = 'Завершить задачу? Рабочая память задачи будет очищена, временные факты долговременной памяти удалены (обратимо); перезаписываемые и накапливаемые факты сохранятся.'");
	Оповещение = Новый ОписаниеОповещения("ЗавершитьЗадачуПодтверждено", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьЗадачуПодтверждено(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	СохранитьТекущийЧат();
	ДиалогЗадачи = ТекущийЧат;
	Если ЗначениеЗаполнено(РабочийЧатУстаревания) Тогда
		// После прогона форма сидит в контрольном чате: заметки задачи живут
		// в рабочем чате прогона — очищаем его документ.
		ДиалогЗадачи = РабочийЧатУстаревания;
	КонецЕсли;

	Попытка
		ИтогЗавершения = ЗавершитьЗадачуНаСервере(ДиалогЗадачи);
	Исключение
		Сообщить(НСтр("ru = 'Не удалось завершить задачу:'") + " " + ОписаниеОшибки(),
			СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	РабочаяПамять.Очистить();
	Если ТекущийЧат = ДиалогЗадачи Тогда
		ЗагрузитьЧатПоСсылкеНаСервере(ДиалогЗадачи); // перечитать очищенную рабочую память
	КонецЕсли;
	ОбновитьУстареваниеНаСервере();
	ОбновитьПанельТокенов();

	ДобавитьЗаписьПамятиВЖурнал(СтрШаблон(НСтр("ru = 'задача завершена: рабочая память очищена (%1 заметок), временных фактов удалено %2, долговременных фактов сохранено %3'"),
		ФорматЦелого(ИтогЗавершения.ОчищеноЗаметок), ФорматЦелого(ИтогЗавершения.УдаленоВременных),
		ФорматЦелого(ИтогЗавершения.СохраненоФактов)));
	ПоказатьОповещениеПользователя(НСтр("ru = 'Устаревание памяти'"), ,
		СтрШаблон(НСтр("ru = 'Задача завершена: рабочая память очищена, временных фактов удалено %1, долговременных сохранено %2. Устаревшие значения остались только в истории замен.'"),
			ФорматЦелого(ИтогЗавершения.УдаленоВременных), ФорматЦелого(ИтогЗавершения.СохраненоФактов)));

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьУстаревание(Команда)

	ОбновитьУстареваниеНаСервере();

КонецПроцедуры

// Сверяет ответы контрольных вопросов с эталонами простой моделью (прецедент
// Дней 10–14; запускается и автоматически после прогона). Отметки «Назвал
// актуальное» редактируются вручную.
//
&НаКлиенте
Процедура ОценитьОтветыУстаревания(Команда)

	Если ПроверкаУстаревания.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Устаревание памяти'"), ,
			НСтр("ru = 'Таблица проверки пуста — сначала прогоните «Демо: изменение фактов».'"));
		Возврат;
	КонецЕсли;

	ПоказатьОповещениеПользователя(НСтр("ru = 'Устаревание памяти'"), ,
		НСтр("ru = 'Сверяем ответы с эталонами простой моделью…'"));

	Попытка
		ИтогОценки = ОценитьАктуальностьНаСервере();
	Исключение
		Сообщить(НСтр("ru = 'Автоматическая оценка не выполнена:'") + " " + ОписаниеОшибки()
			+ Символы.ПС + НСтр("ru = 'Отметки проставьте вручную.'"), СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	ОбновитьИтогиУстаревания();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Устаревание памяти'"), ,
		СтрШаблон(НСтр("ru = 'Оценено %1 из %2, пропущено %3 (пустой ответ или ошибка вызова).
			|Отметки проставлены автоматически — при необходимости поправьте вручную.'"),
			ФорматЦелого(ИтогОценки.Оценено), ФорматЦелого(ПроверкаУстаревания.Количество()),
			ФорматЦелого(ИтогОценки.Пропущено)));

КонецПроцедуры

// Показывает историю замен факта, выбранного в таблице (фиксация «что было,
// что стало» — требование Дня 15).
//
&НаКлиенте
Процедура УстареваниеФактыПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.УстареваниеФакты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИсторияУстареванияНаСервере(ТекущиеДанные.Ключ);

КонецПроцедуры

// Фиксирует результат шага прогона «устареваниеДемо» по его типу: изменение —
// сохранение факта с разрешением конфликта, рабочая — заметка задачи, контроль —
// ответ + детерминированная проверка промпта.
//
// Параметры:
//   ТекущийШаг - Структура - шаг сценария (см. KimiПамятьСервер.СценарийИзмененияФактов).
//
&НаКлиенте
Процедура ЗафиксироватьШагУстаревания(ТекущийШаг)

	Если ТекущийШаг.ТипШага = "контроль" Тогда
		ЗафиксироватьКонтрольУстаревания(ТекущийШаг);
	ИначеЕсли ТекущийШаг.ТипШага = "рабочая" Тогда
		ЗафиксироватьРабочуюЗаметуУстаревания(ТекущийШаг);
	Иначе
		ЗафиксироватьИзменениеУстаревания(ТекущийШаг);
	КонецЕсли;

КонецПроцедуры

// Сохраняет факт шага-«изменение» в долговременную память с заявленным типом;
// конфликтующее значение заменяется сервером (не добавляется рядом), замена
// фиксируется в истории и журнале.
//
&НаКлиенте
Процедура ЗафиксироватьИзменениеУстаревания(ТекущийШаг)

	Попытка
		Сохранение = СохранитьФактШагаНаСервере(ТекущийШаг);
	Исключение
		Сообщить(СтрШаблон(НСтр("ru = 'Сохранение факта «%1» не выполнено:'"), ТекущийШаг.ФактКлюч)
			+ " " + ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат;
	КонецПопытки;

	Если Сохранение.Создано > 0 Тогда
		ДобавитьЗаписьПамятиВЖурнал(СтрШаблон(НСтр("ru = 'факт «%1» создан (%2): «%3»'"),
			ТекущийШаг.ФактКлюч, ТекущийШаг.ФактТип, ТекущийШаг.ФактЗначение));
	КонецЕсли;
	Для Каждого Замена Из Сохранение.Замены Цикл
		Если Замена.Действие = "замена" Тогда
			ДобавитьЗаписьПамятиВЖурнал(СтрШаблон(НСтр("ru = 'факт «%1»: замена — было «%2» → стало «%3»'"),
				Замена.Ключ, Замена.Было, Замена.Стало));
		Иначе
			ДобавитьЗаписьПамятиВЖурнал(СтрШаблон(НСтр("ru = 'факт «%1»: входящее «%2» отклонено — в памяти свежее (приоритет даты записи)'"),
				Замена.Ключ, Замена.Стало));
		КонецЕсли;
	КонецЦикла;
	Если Сохранение.Дополнено > 0 Тогда
		ДобавитьЗаписьПамятиВЖурнал(СтрШаблон(НСтр("ru = 'факт «%1» дополнен (%2): «%3»'"),
			ТекущийШаг.ФактКлюч, ТекущийШаг.ФактТип, ТекущийШаг.ФактЗначение));
	КонецЕсли;
	ОбновитьУстареваниеНаСервере();
	ОбновитьПанельТокенов();

КонецПроцедуры

// Дописывает заметку шага-«рабочая» в рабочую память текущей задачи
// (используется проверкой очистки после завершения задачи).
//
&НаКлиенте
Процедура ЗафиксироватьРабочуюЗаметуУстаревания(ТекущийШаг)

	Найденная = Неопределено;
	Для Каждого СтрокаЗаметки Из РабочаяПамять Цикл
		Если СтрокаЗаметки.Ключ = ТекущийШаг.ФактКлюч Тогда
			Найденная = СтрокаЗаметки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Найденная = Неопределено Тогда
		Найденная = РабочаяПамять.Добавить();
		Найденная.Ключ = ТекущийШаг.ФактКлюч;
	КонецЕсли;
	Найденная.Значение = ТекущийШаг.ФактЗначение;
	СохранитьТекущийЧат();

	ДобавитьЗаписьПамятиВЖурнал(СтрШаблон(НСтр("ru = 'в рабочую память добавлена заметка «%1» (проверка очистки при завершении задачи)'"),
		ТекущийШаг.ФактКлюч));
	ОбновитьПанельТокенов();

КонецПроцедуры

// Фиксирует результат контрольного шага: ответ агента (задан в новом чате —
// источник знания только память) и детерминированную проверку промпта:
// устаревшие значения отсутствуют в инъекции, актуальные на месте.
//
&НаКлиенте
Процедура ЗафиксироватьКонтрольУстаревания(ТекущийШаг)

	Промпт = ПромптЧистНаСервере(ТекущийШаг);

	СтрокаПроверки = Неопределено;
	Для Каждого Строка Из ПроверкаУстаревания Цикл
		Если Строка.Вопрос = ТекущийШаг.Вопрос Тогда
			СтрокаПроверки = Строка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если СтрокаПроверки = Неопределено Тогда
		СтрокаПроверки = ПроверкаУстаревания.Добавить();
		СтрокаПроверки.Факт = ТекущийШаг.ФактКлюч;
		СтрокаПроверки.Было = ТекущийШаг.Было;
		СтрокаПроверки.Эталон = ТекущийШаг.Эталон;
		СтрокаПроверки.Вопрос = ТекущийШаг.Вопрос;
	КонецЕсли;
	СтрокаПроверки.Ответ = ПоследнийОтветАссистента();
	СтрокаПроверки.ПромптЧист = Промпт.Чист;

	ДобавитьЗаписьПамятиВЖурнал(СтрШаблон(НСтр("ru = 'контроль «%1»: промпт — %2'"),
		ТекущийШаг.ФактКлюч, Промпт.Детали));
	ОбновитьИтогиУстаревания();

КонецПроцедуры

// Сохраняет текущий чат, фиксирует ссылку рабочего чата прогона (лениво — при
// первом контроле) и начинает контрольный чат: вопрос уходит в чистый диалог.
//
&НаКлиенте
Процедура ПодготовитьКонтрольныйЧатУстаревания()

	СохранитьТекущийЧат();
	Если Не ЗначениеЗаполнено(РабочийЧатУстаревания) Тогда
		РабочийЧатУстаревания = ТекущийЧат;
	КонецЕсли;
	НовыйЧатНаСервере();
	СброситьСтатистикуСессии();
	УстановитьВидимостьСтратегии();
	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();

КонецПроцедуры

// Возвращает прогон из контрольного чата в рабочий (до первого контроля ничего
// не делает: работаем в стартовом чате прогона). Контрольный чат сохраняется
// и остаётся в ленте как доказательство ответа из памяти.
//
&НаКлиенте
Процедура ПодготовитьРабочийЧатУстаревания()

	Если Не ЗначениеЗаполнено(РабочийЧатУстаревания)
		Или ТекущийЧат = РабочийЧатУстаревания Тогда
		Возврат;
	КонецЕсли;

	СохранитьТекущийЧат();
	ЗагрузитьЧатПоСсылкеНаСервере(РабочийЧатУстаревания);
	СброситьСтатистикуСессии();
	УстановитьВидимостьСтратегии();
	ОбновитьЧат();
	ОбновитьСписокЧатовHTML();
	ОбновитьПанельТокенов();

КонецПроцедуры

// Пересчитывает итоговую строку проверки: сколько контролей выполнено, сколько
// раз агент назвал устаревшее значение, чист ли промпт.
//
&НаКлиенте
Процедура ОбновитьИтогиУстаревания()

	Контролей = 0;
	Устаревших = 0;
	ПромптЧистВсе = Истина;
	Для Каждого СтрокаПроверки Из ПроверкаУстаревания Цикл
		Если Не ЗначениеЗаполнено(СтрокаПроверки.Ответ) Тогда
			Продолжить;
		КонецЕсли;
		Контролей = Контролей + 1;
		Если Не СтрокаПроверки.Актуальное Тогда
			Устаревших = Устаревших + 1;
		КонецЕсли;
		ПромптЧистВсе = ПромптЧистВсе И СтрокаПроверки.ПромптЧист;
	КонецЦикла;

	ИтогиУстаревания = СтрШаблон(НСтр("ru = 'Контролей: %1 · устаревших ответов: %2 · промпт чист: %3'"),
		ФорматЦелого(Контролей), ФорматЦелого(Устаревших),
		?(ПромптЧистВсе, НСтр("ru = 'да'"), НСтр("ru = 'нет'")));

КонецПроцедуры

&НаСервере
Функция СценарийИзмененияФактовНаСервере()

	Возврат KimiПамятьСервер.СценарийИзмененияФактов();

КонецФункции

&НаСервере
Функция ПодготовитьДемоУстареванияНаСервере()

	Удалено = KimiПамятьСервер.ПодготовитьДемоУстаревания();
	ОбновитьУстареваниеНаСервере();

	Возврат Удалено;

КонецФункции

&НаСервере
Функция СохранитьФактШагаНаСервере(ТекущийШаг)

	// Имя переменной не перекрывает реквизит формы «Факты» (объект данных формы
	// недоступен для записи — hotfix при приёмке Дня 15).
	ТаблицаФакта = KimiПамятьСервер.ТаблицаЗаметок();
	НоваяСтрока = ТаблицаФакта.Добавить();
	НоваяСтрока.Ключ = ТекущийШаг.ФактКлюч;
	НоваяСтрока.Значение = ТекущийШаг.ФактЗначение;

	РезультатСохранения = KimiПамятьСервер.СохранитьФактыВДолговременнуюПамять(ТаблицаФакта,
		KimiПамятьСервер.КатегорияПоИмени(ТекущийШаг.ФактКатегория), ТекущийЧат,
		KimiПамятьСервер.ТипФактаПоИмени(ТекущийШаг.ФактТип));
	ОбновитьФактыПамятиНаСервере();
	ОбновитьУстареваниеНаСервере();

	Возврат РезультатСохранения;

КонецФункции

// Детерминированно проверяет инъекцию долговременной памяти для контрольного
// вопроса: устаревшие значения (шага и всех замен факта) отсутствуют, пункты
// эталона присутствуют. Дополнения накапливаемого списка утечкой не считаются:
// их текст законно живёт в актуальном значении.
//
&НаСервере
Функция ПромптЧистНаСервере(ТекущийШаг)

	// Имя переменной не перекрывает реквизит формы «История» (объект данных формы
	// недоступен для записи — hotfix при приёмке Дня 15).
	СтарыеЗначения = Новый Массив;
	Если ЗначениеЗаполнено(ТекущийШаг.Было) Тогда
		СтарыеЗначения.Добавить(ТекущийШаг.Было);
	КонецЕсли;
	ЗаписиИстории = KimiПамятьСервер.ИсторияФакта(ТекущийШаг.ФактКлюч);
	Для Каждого ЗаписьИстории Из ЗаписиИстории Цикл
		Если ЗаписьИстории.Действие = "замена" И ЗначениеЗаполнено(ЗаписьИстории.БылоЗначение) Тогда
			СтарыеЗначения.Добавить(ЗаписьИстории.БылоЗначение);
		КонецЕсли;
	КонецЦикла;

	Возврат KimiПамятьСервер.ПромптЧист(ТекущийШаг.Вопрос, ВыбранныеКатегорииНаСервере(),
		ТекущийШаг.Эталон, СтарыеЗначения);

КонецФункции

&НаСервере
Функция ОценитьАктуальностьНаСервере()

	Реестр = РеквизитФормыВЗначение("ПроверкаУстаревания");
	Итог = KimiПамятьСервер.ОценитьАктуальностьОтветов(Реестр);
	ЗначениеВРеквизитФормы(Реестр, "ПроверкаУстаревания");

	Возврат Итог;

КонецФункции

&НаСервере
Процедура ОбновитьУстареваниеНаСервере()

