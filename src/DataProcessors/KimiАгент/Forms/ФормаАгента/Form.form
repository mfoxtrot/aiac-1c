    <toolTip>
      <key>ru</key>
      <value>Добавить в историю учебные тексты заведомо больше контекстного окна модели (около 1,2 млн токенов) — следующий запрос будет честно отклонён API с ошибкой 400</value>
    </toolTip>
    <use>
      <common>true</common>
    </use>
