          <title>
            <key>ru</key>
            <value>Проверка «обход инварианта»: попытки, удержание кодом и моделью</value>
          </title>
          <visible>true</visible>
          <enabled>true</enabled>
          <userVisible>
            <common>true</common>
          </userVisible>
          <dataPath xsi:type="form:DataPath">
            <segments>ПроверкаОбходаИнвариантов</segments>
