&НаКлиенте
Перем СценарииПрогона;
&НаКлиенте
Перем ИндексТекущегоШага;
&НаКлиенте
Перем ТребуетсяОстановка;
&НаКлиенте
Перем ДатаЗапускаПрогона;

&НаКлиенте
Процедура ВыполнитьПрогон(Команда)

	СценарииПрогона = Новый Массив;

	Для Каждого СтрокаЗадачи Из Задачи Цикл
		Если Не СтрокаЗадачи.Использовать Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаСпособа Из Способы Цикл
			Если Не СтрокаСпособа.Использовать Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого СтрокаУсилия Из Усилия Цикл
				Если Не СтрокаУсилия.Использовать Тогда
					Продолжить;
				КонецЕсли;
				СценарииПрогона.Добавить(Новый Структура("Задача, Способ, Усилие",
					СтрокаЗадачи.Задача, СтрокаСпособа.Способ, СтрокаУсилия.Усилие));
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Если СценарииПрогона.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте хотя бы одну задачу, один способ и одно усилие.'"));
		Возврат;
	КонецЕсли;

	Результаты.Очистить();
	ИндексТекущегоШага = 0;
	ТребуетсяОстановка = Ложь;
	ДатаЗапускаПрогона = ТекущаяДата();

	УстановитьДоступностьКнопок(Ложь);

	ВыполнитьСледующийШаг();

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьПрогон(Команда)

	ТребуетсяОстановка = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРезультаты(Команда)

	ОчиститьРезультатыНаСервере();
	Результаты.Очистить();
	СтатусПрогона = "";

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтчет(Команда)

	ОткрытьФорму("Отчет.KimiРезультатыРассуждений");

КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьЗадачи(Команда)

	ВосстановитьЗадачиНаСервере();
	ЗаполнитьЗадачи();

КонецПроцедуры

&НаКлиенте
Процедура РезультатыПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Результаты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПросмотрОтвета = "";
		ПросмотрРассуждения = "";
		ПросмотрПромпта = "";
		Возврат;
	КонецЕсли;

	ПросмотрОтвета = ТекущиеДанные.Ответ;
	ПросмотрРассуждения = ТекущиеДанные.Рассуждение;
	ПросмотрПромпта = ТекущиеДанные.СоставленныйПромпт;

КонецПроцедуры

&НаКлиенте
Процедура РезультатыВерноПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Результаты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановитьВерностьНаСервере(ТекущиеДанные.Задача, ТекущиеДанные.Способ,
		ТекущиеДанные.УсилиеРассуждения, ТекущиеДанные.Попытка, ТекущиеДанные.Верно);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСледующийШаг()

	Если ТребуетсяОстановка Тогда
		ЗавершитьПрогон(Истина);
		Возврат;
	КонецЕсли;

	Если ИндексТекущегоШага >= СценарииПрогона.Количество() Тогда
		ЗавершитьПрогон(Ложь);
		Возврат;
	КонецЕсли;

	Шаг = СценарииПрогона[ИндексТекущегоШага];
	ИндексТекущегоШага = ИндексТекущегоШага + 1;

	СтатусПрогона = СтрШаблон(НСтр("ru = 'Шаг %1 из %2: %3 · %4 · %5'"),
		ИндексТекущегоШага, СценарииПрогона.Количество(),
		Строка(Шаг.Задача), Строка(Шаг.Способ), Строка(Шаг.Усилие));
	ОбновитьОтображениеДанных();

	РезультатШага = KimiРассуждениеСервер.РешитьЗадачу(Шаг.Задача, Шаг.Способ, Шаг.Усилие, ДатаЗапускаПрогона);

	ДобавитьСтрокуРезультатов(РезультатШага);

	ПодключитьОбработчикОжидания("ВыполнитьСледующийШаг", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПрогон(Остановлен)

	УстановитьДоступностьКнопок(Истина);

	Если Остановлен Тогда
		СтатусПрогона = СтрШаблон(НСтр("ru = 'Прогон остановлен пользователем (выполнено %1 из %2).'"),
			ИндексТекущегоШага, СценарииПрогона.Количество());
	Иначе
		СтатусПрогона = СтрШаблон(НСтр("ru = 'Прогон завершён: %1 шагов. Отметьте верность ответов; сводка — в отчёте.'"),
			ИндексТекущегоШага);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКнопок(Доступность)

	Элементы.ВыполнитьПрогон.Доступность = Доступность;
	Элементы.ОчиститьРезультаты.Доступность = Доступность;
	Элементы.ВосстановитьЗадачи.Доступность = Доступность;
	Элементы.ОткрытьОтчет.Доступность = Доступность;
	Элементы.ОстановитьПрогон.Доступность = Не Доступность;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуРезультатов(Результат)

	НоваяСтрока = Результаты.Добавить();
	НоваяСтрока.Задача = Результат.Задача;
	НоваяСтрока.Способ = Результат.Способ;
	НоваяСтрока.УсилиеРассуждения = Результат.УсилиеРассуждения;
	НоваяСтрока.Попытка = Результат.Попытка;
	НоваяСтрока.Верно = Результат.Верно;
	НоваяСтрока.ЭталонНайден = Результат.ЭталонНайден;
	НоваяСтрока.ТокеныВсего = Результат.ТокеныВсего;
	НоваяСтрока.ВремяСекунд = Округл(Результат.ВремяМиллисекунд / 1000, 1);
	НоваяСтрока.СообщениеОбОшибке = Результат.СообщениеОбОшибке;
	НоваяСтрока.Ответ = Результат.Ответ;
	НоваяСтрока.Рассуждение = Результат.Рассуждение;
	НоваяСтрока.СоставленныйПромпт = Результат.СоставленныйПромпт;

	Если ЗначениеЗаполнено(Результат.СообщениеОбОшибке) Тогда
		Сообщить(Результат.СообщениеОбОшибке, СтатусСообщения.Важное);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	KimiРассуждениеСервер.НаполнитьЗадачиПоУмолчанию();
	ЗаполнитьЗадачи();
	ЗаполнитьСпособыИУсилия();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗадачи()

	Задачи.Очистить();
	Для Каждого СтрокаЗадачи Из KimiРассуждениеСервер.СписокЗадач() Цикл
		НоваяСтрока = Задачи.Добавить();
		НоваяСтрока.Использовать = Истина;
		НоваяСтрока.Задача = СтрокаЗадачи.Задача;
		НоваяСтрока.Категория = СтрокаЗадачи.Категория;
		НоваяСтрока.ЭталонныйОтвет = СтрокаЗадачи.ЭталонныйОтвет;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпособыИУсилия()

	Способы.Очистить();
	НоваяСтрока = Способы.Добавить();
	НоваяСтрока.Использовать = Истина;
	НоваяСтрока.Способ = Перечисления.KimiСпособыРассуждения.ПрямойОтвет;
	НоваяСтрока = Способы.Добавить();
	НоваяСтрока.Использовать = Истина;
	НоваяСтрока.Способ = Перечисления.KimiСпособыРассуждения.Пошагово;
	НоваяСтрока = Способы.Добавить();
	НоваяСтрока.Использовать = Истина;
	НоваяСтрока.Способ = Перечисления.KimiСпособыРассуждения.Самопромпт;
	НоваяСтрока = Способы.Добавить();
	НоваяСтрока.Использовать = Истина;
	НоваяСтрока.Способ = Перечисления.KimiСпособыРассуждения.Эксперты;

	Усилия.Очистить();
	НоваяСтрока = Усилия.Добавить();
	НоваяСтрока.Использовать = Истина;
	НоваяСтрока.Усилие = Перечисления.KimiУсилиеРассуждения.low;
	НоваяСтрока = Усилия.Добавить();
	НоваяСтрока.Использовать = Истина;
	НоваяСтрока.Усилие = Перечисления.KimiУсилиеРассуждения.max;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиститьРезультатыНаСервере()

	KimiРассуждениеСервер.ОчиститьРезультаты();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВосстановитьЗадачиНаСервере()

	KimiРассуждениеСервер.НаполнитьЗадачиПоУмолчанию();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьВерностьНаСервере(Задача, Способ, Усилие, Попытка, Верно)

	KimiРассуждениеСервер.УстановитьВерность(Задача, Способ, Усилие, Попытка, Верно);

КонецПроцедуры
