&НаКлиенте
Перем СценарииПрогона;
&НаКлиенте
Перем ИндексТекущегоШага;
&НаКлиенте
Перем ТребуетсяОстановка;
&НаКлиенте
Перем ДатаЗапускаПрогона;

&НаКлиенте
Функция ТемпературыЭксперимента()

	Температуры = Новый Массив;
	Температуры.Добавить(0);
	Температуры.Добавить(0.7);
	Температуры.Добавить(1.2);

	Возврат Температуры;

КонецФункции

&НаКлиенте
Функция ПредставлениеТемпературы(Температура)

	Если Температура < 0 Тогда
		Возврат НСтр("ru = 'без temperature'");
	КонецЕсли;

	Возврат Строка(Температура);

КонецФункции

&НаКлиенте
Процедура ВыполнитьПрогон(Команда)

	Если ЧислоПопыток < 1 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Число попыток должно быть не меньше 1.'"));
		Возврат;
	КонецЕсли;

	СценарииПрогона = Новый Массив;

	Для Каждого СтрокаЗадачи Из Задачи Цикл
		Если Не СтрокаЗадачи.Использовать Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Температура Из ТемпературыЭксперимента() Цикл
			ДобавитьСценарииПопыток(СтрокаЗадачи.Задача, Температура, МодельЭксперимента);
		КонецЦикла;
		Если КонтрольныйПрогон Тогда
			ДобавитьСценарииПопыток(СтрокаЗадачи.Задача, -1, "");
		КонецЕсли;
	КонецЦикла;

	Если СценарииПрогона.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте хотя бы одну задачу.'"));
		Возврат;
	КонецЕсли;

	Результаты.Очистить();
	ВыводыМодели = "";
	ИндексТекущегоШага = 0;
	ТребуетсяОстановка = Ложь;
	ДатаЗапускаПрогона = ТекущаяДата();

	УстановитьДоступностьКнопок(Ложь);

	ВыполнитьСледующийШаг();

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьПрогон(Команда)

	ТребуетсяОстановка = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРезультаты(Команда)

	ОчиститьРезультатыНаСервере();
	Результаты.Очистить();
	СтатусПрогона = "";
	ВыводыМодели = "";

КонецПроцедуры

&НаКлиенте
Процедура ПроанализироватьРезультаты(Команда)

	Если Результаты.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет результатов для анализа: выполните прогон.'"));
		Возврат;
	КонецЕсли;

	СтатусПрогона = НСтр("ru = 'Модель-аналитик изучает результаты прогона...'");
	ОбновитьОтображениеДанных();

	Попытка
		ВыводыМодели = ПроанализироватьНаСервере(ДатаЗапускаПрогона, МодельАнализа);
		СтатусПрогона = НСтр("ru = 'Анализ результатов выполнен.');
	Исключение
		ВыводыМодели = "";
		СтатусПрогона = "";
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьЗадачи(Команда)

	ВосстановитьЗадачиНаСервере();
	ЗаполнитьЗадачи();

КонецПроцедуры

&НаКлиенте
Процедура РезультатыПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Результаты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПросмотрОтвета = "";
		ПросмотрРассуждения = "";
		Возврат;
	КонецЕсли;

	ПросмотрОтвета = ТекущиеДанные.Ответ;
	ПросмотрРассуждения = ТекущиеДанные.Рассуждение;

КонецПроцедуры

&НаКлиенте
Процедура РезультатыВерноПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Результаты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановитьВерностьНаСервере(ТекущиеДанные.Задача, ТекущиеДанные.ТемператураЧисло,
		ТекущиеДанные.НомерПопытки, ТекущиеДанные.Верно);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСценарииПопыток(ЗадачаСсылка, Температура, Модель)

	Для НомерПопытки = 1 По ЧислоПопыток Цикл
		СценарииПрогона.Добавить(Новый Структура("Задача, Температура, Модель",
			ЗадачаСсылка, Температура, Модель));
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСледующийШаг()

	Если ТребуетсяОстановка Тогда
		ЗавершитьПрогон(Истина);
		Возврат;
	КонецЕсли;

	Если ИндексТекущегоШага >= СценарииПрогона.Количество() Тогда
		ЗавершитьПрогон(Ложь);
		Возврат;
	КонецЕсли;

	Шаг = СценарииПрогона[ИндексТекущегоШага];
	ИндексТекущегоШага = ИндексТекущегоШага + 1;

	СтатусПрогона = СтрШаблон(НСтр("ru = 'Шаг %1 из %2: %3 · температура %4'"),
		ИндексТекущегоШага, СценарииПрогона.Количество(),
		Строка(Шаг.Задача), ПредставлениеТемпературы(Шаг.Температура));
	ОбновитьОтображениеДанных();

	РезультатШага = KimiТемператураСервер.ВыполнитьПопытку(Шаг.Задача, Шаг.Температура,
		Шаг.Модель, ДатаЗапускаПрогона);

	ДобавитьСтрокуРезультатов(РезультатШага);

	ПодключитьОбработчикОжидания("ВыполнитьСледующийШаг", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПрогон(Остановлен)

	УстановитьДоступностьКнопок(Истина);

	Если Остановлен Тогда
		СтатусПрогона = СтрШаблон(НСтр("ru = 'Прогон остановлен пользователем (выполнено %1 из %2).'"),
			ИндексТекущегоШага, СценарииПрогона.Количество());
	Иначе
		СтатусПрогона = СтрШаблон(НСтр("ru = 'Прогон завершён: %1 шагов. Отметьте верность ответов; выводы — кнопка ""Проанализировать результаты"".'"),
			ИндексТекущегоШага);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКнопок(Доступность)

	Элементы.ВыполнитьПрогон.Доступность = Доступность;
	Элементы.ОчиститьРезультаты.Доступность = Доступность;
	Элементы.ВосстановитьЗадачи.Доступность = Доступность;
	Элементы.ПроанализироватьРезультаты.Доступность = Доступность;
	Элементы.ОстановитьПрогон.Доступность = Не Доступность;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуРезультатов(Результат)

	НоваяСтрока = Результаты.Добавить();
	НоваяСтрока.Задача = Результат.Задача;
	НоваяСтрока.Тип = Результат.ТипЗадачи;
	НоваяСтрока.Температура = ПредставлениеТемпературы(Результат.Температура);
	НоваяСтрока.ТемператураЧисло = Результат.Температура;
	НоваяСтрока.НомерПопытки = Результат.НомерПопытки;
	НоваяСтрока.Верно = Результат.Верно;
	НоваяСтрока.ЭталонНайден = Результат.ЭталонНайден;
	НоваяСтрока.ТокеныВсего = Результат.ТокеныВсего;
	НоваяСтрока.ВремяСекунд = Окр(Результат.ВремяМиллисекунд / 1000, 1);
	НоваяСтрока.СообщениеОбОшибке = Результат.СообщениеОбОшибке;
	НоваяСтрока.Ответ = Результат.Ответ;
	НоваяСтрока.Рассуждение = Результат.Рассуждение;

	Если ЗначениеЗаполнено(Результат.СообщениеОбОшибке) Тогда
		Сообщить(Результат.СообщениеОбОшибке, СтатусСообщения.Важное);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТемпературыПрогона = ПредставлениеТемператур();
	ЧислоПопыток = 5;

	KimiТемператураСервер.НаполнитьЗадачиПоУмолчанию();
	ЗаполнитьЗадачи();
	ОпределитьМодели();

КонецПроцедуры

&НаСервере
Функция ПредставлениеТемператур()

	// Набор температур фиксирован заданием курса (0 / 0.7 / 1.2); см. также ТемпературыЭксперимента.
	Представления = Новый Массив;
	Представления.Добавить(Строка(0));
	Представления.Добавить(Строка(0.7));
	Представления.Добавить(Строка(1.2));

	Возврат СтрСоединить(Представления, " · ");

КонецФункции

&НаСервере
Процедура ЗаполнитьЗадачи()

	Задачи.Очистить();
	ЕстьОтмеченныйОдинОтвет = Ложь;
	ЕстьОтмеченнаяГенерация = Ложь;

	Для Каждого СтрокаСписка Из KimiТемператураСервер.СписокЗадач() Цикл
		НоваяСтрока = Задачи.Добавить();
		НоваяСтрока.Задача = СтрокаСписка.Задача;
		НоваяСтрока.Тип = СтрокаСписка.Тип;
		НоваяСтрока.ЭталонныйОтвет = СтрокаСписка.ЭталонныйОтвет;

		Если СтрокаСписка.Тип = KimiТемператураСервер.ТипЗадачиОдинОтвет() Тогда
			НоваяСтрока.Использовать = Не ЕстьОтмеченныйОдинОтвет;
			ЕстьОтмеченныйОдинОтвет = Истина;
		Иначе
			НоваяСтрока.Использовать = Не ЕстьОтмеченнаяГенерация;
			ЕстьОтмеченнаяГенерация = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОпределитьМодели()

	Попытка
		ДоступныеМодели = KimiAPIСервер.ДоступныеМодели();
	Исключение
		ДоступныеМодели = Новый Массив;
		Сообщить(НСтр("ru = 'Не удалось получить список доступных моделей:'")
			+ " " + ОписаниеОшибки(), СтатусСообщения.Внимание);
	КонецПопытки;

	МодельЭксперимента = KimiТемператураСервер.ВыбратьМодельЭксперимента(ДоступныеМодели);
	МодельАнализа = KimiТемператураСервер.ВыбратьМодельАнализа(ДоступныеМодели);
	КонтрольныйПрогон = Не ЗначениеЗаполнено(МодельЭксперимента);

	Элементы.МодельЭксперимента.СписокВыбора.Очистить();
	Элементы.МодельЭксперимента.СписокВыбора.Добавить("",
		НСтр("ru = 'по умолчанию (kimi-k3.1-pro-highspeed)'"));
	Для Каждого ИмяКандидата Из KimiТемператураСервер.МоделиСРегулируемойТемпературой() Цикл
		Если ДоступныеМодели.Найти(ИмяКандидата) <> Неопределено Тогда
			Элементы.МодельЭксперимента.СписокВыбора.Добавить(ИмяКандидата);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

