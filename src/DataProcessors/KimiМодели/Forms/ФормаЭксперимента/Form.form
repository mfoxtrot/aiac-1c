  <formCommands>
    <name>ВыполнитьПрогон</name>
    <title>
      <key>ru</key>
      <value>Выполнить прогон</value>
    </title>
    <id>1</id>
    <toolTip>
      <key>ru</key>
      <value>Последовательно выполнить сценарии "задача × модель (3 яруса) × попытка" для отмеченных задач</value>
    </toolTip>
    <use>
      <common>true</common>
    </use>
    <action xsi:type="form:FormCommandHandlerContainer">
