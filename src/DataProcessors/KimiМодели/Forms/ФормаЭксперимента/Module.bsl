&НаКлиенте
Перем СценарииПрогона;
&НаКлиенте
Перем ИндексТекущегоШага;
&НаКлиенте
Перем ТребуетсяОстановка;
&НаКлиенте
Перем ДатаЗапускаПрогона;

&НаКлиенте
Процедура ВыполнитьПрогон(Команда)

	Если ЧислоПопыток < 1 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Число попыток должно быть не меньше 1.'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(МодельМалая)
		Или Не ЗначениеЗаполнено(МодельСредняя)
		Или Не ЗначениеЗаполнено(МодельФлагман) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите модели всех трёх ярусов.'"));
		Возврат;
	КонецЕсли;

	Попытка
		ПроверитьКлючиНаСервере(МодельМалая, МодельСредняя, МодельФлагман);
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ОписанияМоделей = ОписанияМоделейНаСервере(МодельМалая, МодельСредняя, МодельФлагман);

	СценарииПрогона = Новый Массив;

	Для Каждого СтрокаЗадачи Из Задачи Цикл
		Если Не СтрокаЗадачи.Использовать Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ОписаниеМодели Из ОписанияМоделей Цикл
			ДобавитьСценарииПопыток(СтрокаЗадачи.Задача, ОписаниеМодели);
		КонецЦикла;
	КонецЦикла;

	Если СценарииПрогона.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте хотя бы одну задачу.'"));
		Возврат;
	КонецЕсли;

	Результаты.Очистить();
	Итоги.Очистить();
	ВыводыМодели = "";
	ИндексТекущегоШага = 0;
	ТребуетсяОстановка = Ложь;
	ДатаЗапускаПрогона = ТекущаяДата();

	УстановитьДоступностьКнопок(Ложь);

	ВыполнитьСледующийШаг();

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьПрогон(Команда)

	ТребуетсяОстановка = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтоги(Команда)

	Если Не ЗначениеЗаполнено(ДатаЗапускаПрогона) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Итогов нет: выполните прогон.'"));
		Возврат;
	КонецЕсли;

	ЗаполнитьИтогиНаСервере(ДатаЗапускаПрогона);

КонецПроцедуры

&НаКлиенте
Процедура ПроанализироватьРезультаты(Команда)

	Если Результаты.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нет результатов для анализа: выполните прогон.'"));
		Возврат;
	КонецЕсли;

	СтатусПрогона = НСтр("ru = 'Модель-аналитик изучает результаты прогона...'");
	ОбновитьОтображениеДанных();

	Попытка
		ВыводыМодели = ПроанализироватьНаСервере(ДатаЗапускаПрогона, МодельАнализа);
		СтатусПрогона = НСтр("ru = 'Анализ результатов выполнен.'");
	Исключение
		ВыводыМодели = "";
		СтатусПрогона = "";
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура СводкаОтчет(Команда)

	ОткрытьФорму("Отчет.KimiИтогиМоделей.Форма");

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРезультаты(Команда)

	ОчиститьРезультатыНаСервере();
	Результаты.Очистить();
	Итоги.Очистить();
	СтатусПрогона = "";
	ВыводыМодели = "";

КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьЗадачи(Команда)

	ВосстановитьЗадачиНаСервере();
	ЗаполнитьЗадачи();

КонецПроцедуры

&НаКлиенте
Процедура РезультатыПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Результаты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПросмотрОтвета = "";
		ПросмотрРассуждения = "";
		Возврат;
	КонецЕсли;

	ПросмотрОтвета = ТекущиеДанные.Ответ;
	ПросмотрРассуждения = ТекущиеДанные.Рассуждение;

КонецПроцедуры

&НаКлиенте
Процедура РезультатыВерноПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Результаты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановитьВерностьНаСервере(ТекущиеДанные.Задача, ТекущиеДанные.Модель,
		ТекущиеДанные.НомерПопытки, ТекущиеДанные.Верно);
	ЗаполнитьИтогиНаСервере(ДатаЗапускаПрогона);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСценарииПопыток(ЗадачаСсылка, ОписаниеМодели)

	Для НомерПопытки = 1 По ЧислоПопыток Цикл
		СценарииПрогона.Добавить(Новый Структура("Задача, ОписаниеМодели", ЗадачаСсылка, ОписаниеМодели));
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСледующийШаг()

	Если ТребуетсяОстановка Тогда
		ЗавершитьПрогон(Истина);
		Возврат;
	КонецЕсли;

	Если ИндексТекущегоШага >= СценарииПрогона.Количество() Тогда
		ЗавершитьПрогон(Ложь);
		Возврат;
	КонецЕсли;

	Шаг = СценарииПрогона[ИндексТекущегоШага];
	ИндексТекущегоШага = ИндексТекущегоШага + 1;

	СтатусПрогона = СтрШаблон(НСтр("ru = 'Шаг %1 из %2: %3 · %4 (%5)'"),
		ИндексТекущегоШага, СценарииПрогона.Количество(),
		Строка(Шаг.Задача), Шаг.ОписаниеМодели.Модель, Шаг.ОписаниеМодели.Ярус);
	ОбновитьОтображениеДанных();

	РезультатШага = KimiМоделиСервер.ВыполнитьПопытку(Шаг.Задача, Шаг.ОписаниеМодели, ДатаЗапускаПрогона);

	ДобавитьСтрокуРезультатов(РезультатШага);

	ПодключитьОбработчикОжидания("ВыполнитьСледующийШаг", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПрогон(Остановлен)

	УстановитьДоступностьКнопок(Истина);

	Если Остановлен Тогда
		СтатусПрогона = СтрШаблон(НСтр("ru = 'Прогон остановлен пользователем (выполнено %1 из %2).'"),
			ИндексТекущегоШага, СценарииПрогона.Количество());
	Иначе
		СтатусПрогона = СтрШаблон(НСтр("ru = 'Прогон завершён: %1 шагов. Отметьте верность ответов; итоги — в таблице ниже, выводы — кнопка ""Проанализировать результаты"".'"),
			ИндексТекущегоШага);
	КонецЕсли;

	ЗаполнитьИтогиНаСервере(ДатаЗапускаПрогона);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКнопок(Доступность)

	Элементы.ВыполнитьПрогон.Доступность = Доступность;
	Элементы.ОчиститьРезультаты.Доступность = Доступность;
	Элементы.ВосстановитьЗадачи.Доступность = Доступность;
	Элементы.ПроанализироватьРезультаты.Доступность = Доступность;
	Элементы.ОбновитьИтоги.Доступность = Доступность;
	Элементы.СводкаОтчет.Доступность = Доступность;
	Элементы.ОстановитьПрогон.Доступность = Не Доступность;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуРезультатов(Результат)

	НоваяСтрока = Результаты.Добавить();
	НоваяСтрока.Задача = Результат.Задача;
	НоваяСтрока.Модель = Результат.Модель;
	НоваяСтрока.Провайдер = Результат.Провайдер;
	НоваяСтрока.НомерПопытки = Результат.НомерПопытки;
	НоваяСтрока.Верно = Результат.Верно;
	НоваяСтрока.ЭталонНайден = Результат.ЭталонНайден;
	НоваяСтрока.ТокеныВсего = Результат.ТокеныВсего;
	НоваяСтрока.ВремяСекунд = Окр(Результат.ВремяМиллисекунд / 1000, 1);
	НоваяСтрока.Стоимость = Результат.Стоимость;
	НоваяСтрока.СообщениеОбОшибке = Результат.СообщениеОбОшибке;
	НоваяСтрока.Ответ = Результат.Ответ;
	НоваяСтрока.Рассуждение = Результат.Рассуждение;

	Если ЗначениеЗаполнено(Результат.СообщениеОбОшибке) Тогда
		Сообщить(Результат.СообщениеОбОшибке, СтатусСообщения.Важное);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЧислоПопыток = 1;

	KimiМоделиСервер.НаполнитьЗадачиПоУмолчанию();
	ЗаполнитьЗадачи();
	ОпределитьМодели();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗадачи()

	Задачи.Очистить();

	Для Каждого СтрокаСписка Из KimiМоделиСервер.СписокЗадач() Цикл
		НоваяСтрока = Задачи.Добавить();
		НоваяСтрока.Задача = СтрокаСписка.Задача;
		НоваяСтрока.ЭталонныйОтвет = СтрокаСписка.ЭталонныйОтвет;
		НоваяСтрока.Использовать = Истина;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОпределитьМодели()

	Попытка
		ДоступныеМодели = KimiAPIСервер.ДоступныеМодели();
	Исключение
		ДоступныеМодели = Новый Массив;
		Сообщить(НСтр("ru = 'Не удалось получить список доступных моделей:'")
			+ " " + ОписаниеОшибки(), СтатусСообщения.Внимание);
	КонецПопытки;

	МодельМалая = KimiМоделиСервер.ВыбратьМодельЯруса(НСтр("ru = 'Малая модель'"), ДоступныеМодели);
	МодельСредняя = KimiМоделиСервер.ВыбратьМодельЯруса(НСтр("ru = 'Средняя модель'"), ДоступныеМодели);
	МодельФлагман = KimiМоделиСервер.ВыбратьМодельЯруса(НСтр("ru = 'Флагманская модель'"), ДоступныеМодели);
	МодельАнализа = KimiМоделиСервер.ВыбратьМодельАнализа(ДоступныеМодели);

	ЗаполнитьСписокВыбораМоделей(Элементы.МодельМалая, МоделиGroqСПредставлениями());
	ЗаполнитьСписокВыбораМоделей(Элементы.МодельСредняя,
		ДоступныеСПредставлениями(ДоступныеМодели, ПредпочтенияЯруса(НСтр("ru = 'Средняя модель'"))));
	ЗаполнитьСписокВыбораМоделей(Элементы.МодельФлагман,
		ДоступныеСПредставлениями(ДоступныеМодели, ПредпочтенияЯруса(НСтр("ru = 'Флагманская модель'"))));

КонецПроцедуры

&НаСервере
Функция ПредпочтенияЯруса(Ярус)

	Для Каждого ОписаниеЯруса Из KimiМоделиСервер.ЯрусыЭксперимента() Цикл
		Если ОписаниеЯруса.Ярус = Ярус Тогда
			Возврат ОписаниеЯруса.Предпочтения;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Массив;

КонецФункции

&НаСервере
Функция МоделиGroqСПредставлениями()

	Результат = Новый Массив;
	Для Каждого ИмяМодели Из KimiМоделиСервер.МоделиGroq() Цикл
		Представление = СтрШаблон(НСтр("ru = '%1 (Groq, бесплатный тариф)'"), ИмяМодели);
		Результат.Добавить(Новый Структура("Имя, Представление", ИмяМодели, Представление));
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ДоступныеСПредставлениями(ДоступныеМодели, Запасные)

	Результат = Новый Массив;
	Для Каждого ИмяМодели Из ДоступныеМодели Цикл
		Результат.Добавить(Новый Структура("Имя, Представление", ИмяМодели, ИмяМодели));
	КонецЦикла;

	// Список моделей недоступен (например, сбой GET /v1/models) - предлагаем
	// фиксированные кандидатов яруса, чтобы прогон не блокировался.
	Для Каждого ИмяМодели Из Запасные Цикл
		Если ДоступныеМодели.Найти(ИмяМодели) = Неопределено Тогда
			Результат.Добавить(Новый Структура("Имя, Представление", ИмяМодели, ИмяМодели));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьСписокВыбораМоделей(ЭлементФормы, МоделиСПредставлениями)

	ЭлементФормы.СписокВыбора.Очистить();
	Для Каждого ОписаниеМодели Из МоделиСПредставлениями Цикл
		ЭлементФормы.СписокВыбора.Добавить(ОписаниеМодели.Имя, ОписаниеМодели.Представление);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ОписанияМоделейНаСервере(ИмяМалой, ИмяСредней, ИмяФлагмана)

	Описания = Новый Массив;

	Малая = KimiМоделиСервер.ОписаниеМодели(ИмяМалой);
	Малая.Ярус = НСтр("ru = 'Малая модель'");
	Описания.Добавить(Малая);

	Средняя = KimiМоделиСервер.ОписаниеМодели(ИмяСредней);
	Средняя.Ярус = НСтр("ru = 'Средняя модель'");
	Описания.Добавить(Средняя);

	Флагман = KimiМоделиСервер.ОписаниеМодели(ИмяФлагмана);
	Флагман.Ярус = НСтр("ru = 'Флагманская модель'");
	Описания.Добавить(Флагман);

	Возврат Описания;

КонецФункции

&НаСервере
Процедура ЗаполнитьИтогиНаСервере(ДатаЗапуска)

	Итоги.Очистить();

	Сводка = KimiМоделиСервер.СводныеИтоги(ДатаЗапуска);
	Для Каждого СтрокаСводки Из Сводка Цикл
		НоваяСтрока = Итоги.Добавить();
		НоваяСтрока.Модель = СтрокаСводки.Модель;
		НоваяСтрока.Провайдер = СтрокаСводки.Провайдер;
		НоваяСтрока.Ярус = ЯрусМодели(СтрокаСводки.Модель);
		НоваяСтрока.Верных = СтрокаСводки.Верных;
		НоваяСтрока.ВсегоПопыток = СтрокаСводки.ВсегоПопыток;
		НоваяСтрока.СреднееВремяСек = Окр(СтрокаСводки.СреднееВремяМиллисекунд / 1000, 1);
		НоваяСтрока.ТокеныВсего = СтрокаСводки.ТокеныВсего;
		НоваяСтрока.СтоимостьВсего = СтрокаСводки.СтоимостьВсего;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ЯрусМодели(ИмяМодели)

	Если ИмяМодели = МодельМалая Тогда
		Возврат НСтр("ru = 'Малая модель'");
	ИначеЕсли ИмяМодели = МодельСредняя Тогда
		Возврат НСтр("ru = 'Средняя модель'");
	ИначеЕсли ИмяМодели = МодельФлагман Тогда
		Возврат НСтр("ru = 'Флагманская модель'");
	КонецЕсли;

	Возврат "";

КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьКлючиНаСервере(ИмяМалой, ИмяСредней, ИмяФлагмана)

	ИменаМоделей = Новый Массив;
	ИменаМоделей.Добавить(ИмяМалой);
	ИменаМоделей.Добавить(ИмяСредней);
	ИменаМоделей.Добавить(ИмяФлагмана);
	KimiМоделиСервер.ПроверитьКлючиAPI(ИменаМоделей);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиститьРезультатыНаСервере()

	KimiМоделиСервер.ОчиститьРезультаты();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВосстановитьЗадачиНаСервере()

	KimiМоделиСервер.НаполнитьЗадачиПоУмолчанию();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьВерностьНаСервере(Задача, Модель, НомерПопытки, Верно)

	KimiМоделиСервер.УстановитьВерность(Задача, Модель, НомерПопытки, Верно);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроанализироватьНаСервере(ДатаЗапуска, МодельАнализа)

	Возврат KimiМоделиСервер.Проанализировать(ДатаЗапуска, МодельАнализа);

КонецФункции
