&НаКлиенте
Процедура ОтправитьВопрос(Команда)

	ОтправитьВопросМодели();

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьИсторию(Команда)

	История.Очистить();
	СтатусОтвета = "";

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПарсинг(Команда)

	ТекстОтвета = ПоследнийОтветМодели();
	Если ТекстОтвета = Неопределено Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'В истории пока нет ответа Kimi.'"), , НСтр("ru = 'Проверка парсинга'"));
		Возврат;
	КонецЕсли;

	РезультатПроверки = ПроверитьJSONНаСервере(ТекстОтвета);
	ПоказатьПредупреждение(, РезультатПроверки, , НСтр("ru = 'Проверка парсинга'"));

КонецПроцедуры

&НаКлиенте
Функция ПоследнийОтветМодели()

	Индекс = История.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если История[Индекс].Роль = "Kimi" Тогда
			Возврат История[Индекс].Текст;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Процедура ФорматОтветаПриИзменении(Элемент)

	Элементы.СхемаОтвета.Видимость = (ФорматОтвета = "json_schema");

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВопросМодели()

	ТекстВопроса = СокрЛП(ТекущийВопрос);
	Если Не ЗначениеЗаполнено(ТекстВопроса) Тогда
		Возврат;
	КонецЕсли;

	ДобавитьСообщениеВИсторию("Вы", ТекстВопроса);
	ТекущийВопрос = "";

	ПоказатьОповещениеПользователя(НСтр("ru = 'Kimi'"), , НСтр("ru = 'Отправка запроса…'"));

	Попытка
		РезультатЗапроса = ОтправитьИсториюНаСервере();
		ДобавитьСообщениеВИсторию("Kimi", РезультатЗапроса.Текст);
		ОбновитьСтатусОтвета(РезультатЗапроса);
	Исключение
		Сообщить(ОписаниеОшибки(), СтатусСообщения.Важное);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусОтвета(РезультатЗапроса)

	ЛимитТокенов = ?(МаксимумТокенов > 0, Формат(МаксимумТокенов, "ЧГ="), НСтр("ru = 'нет'"));
	ПричинаЗавершения = РезультатЗапроса.ПричинаЗавершения;
	Если ПричинаЗавершения = "length" Тогда
		ПричинаЗавершения = НСтр("ru = 'обрезан по max_tokens'");
	КонецЕсли;

	СтатусОтвета = СтрШаблон(НСтр("ru = 'Токены: запрос %1, ответ %2 (лимит %3). Завершение: %4.'"),
		РезультатЗапроса.ТокеныЗапроса, РезультатЗапроса.ТокеныОтвета, ЛимитТокенов, ПричинаЗавершения);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСообщениеВИсторию(Автор, ТекстСообщения)

	НоваяСтрока = История.Добавить();
	НоваяСтрока.Роль = Автор;
	НоваяСтрока.Текст = ТекстСообщения;

	Элементы.История.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ФорматОтвета = "text";

	СписокФорматов = Элементы.ФорматОтвета.СписокВыбора;
	СписокФорматов.Добавить("text", НСтр("ru = 'Текст (без ограничений)'"));
	СписокФорматов.Добавить("json_object", НСтр("ru = 'JSON (json_object)'"));
	СписокФорматов.Добавить("json_schema", НСтр("ru = 'Строгая схема (json_schema)'"));

	Если Не ЗначениеЗаполнено(ОписаниеФормата) Тогда
		ОписаниеФормата = ОписаниеФорматаПоУмолчанию();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СхемаОтвета) Тогда
		СхемаОтвета = СхемаОтветаПоУмолчанию();
	КонецЕсли;

	Элементы.СхемаОтвета.Видимость = Ложь;

КонецПроцедуры

&НаСервере
Функция ОтправитьИсториюНаСервере()

	Сообщения = Новый Массив;
	Если ИспользоватьОписаниеФормата И ЗначениеЗаполнено(ОписаниеФормата) Тогда
		Сообщения.Добавить(Новый Структура("Роль, Текст", "system", ОписаниеФормата));
	КонецЕсли;
	Для Каждого СтрокаИстории Из История Цикл
		РольAPI = ?(СтрокаИстории.Роль = "Вы", "user", "assistant");
		Сообщения.Добавить(Новый Структура("Роль, Текст", РольAPI, СтрокаИстории.Текст));
	КонецЦикла;

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("МаксимумТокенов", МаксимумТокенов);
	ПараметрыЗапроса.Вставить("СтопПоследовательность", СтопПоследовательность);
	ПараметрыЗапроса.Вставить("ФорматОтвета", ФорматОтвета);
	ПараметрыЗапроса.Вставить("СхемаОтвета", СхемаОтвета);

	Возврат KimiAPIСервер.ОтправитьДиалог(Сообщения, ПараметрыЗапроса);

КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьJSONНаСервере(ТекстJSON)

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстJSON);
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат НСтр("ru = 'Ответ НЕ парсится.'") + Символы.ПС + ОписаниеОшибки();
	КонецПопытки;

	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Возврат СтрШаблон(НСтр("ru = 'Ответ — корректный JSON-объект. Свойств верхнего уровня: %1.'"),
			Данные.Количество());
	КонецЕсли;

	Возврат НСтр("ru = 'Ответ парсится как JSON, но корень не является объектом (массив или скаляр).'");

КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеФорматаПоУмолчанию()

	Возврат НСтр("ru = 'Отвечай строго одним JSON-объектом без пояснений и без Markdown-разметки. Поля: ""ответ"" (строка) — развернутый ответ на вопрос; ""уверенность"" (число от 0 до 1) — уверенность в ответе; ""ключевые_слова"" (массив строк).'");

КонецФункции

&НаСервереБезКонтекста
Функция СхемаОтветаПоУмолчанию()

	Возврат "{
	|	""type"": ""object"",
	|	""properties"": {
	|		""ответ"": {""type"": ""string"", ""description"": ""Ответ на вопрос""},
	|		""уверенность"": {""type"": ""number"", ""description"": ""Уверенность в ответе от 0 до 1""},
	|		""ключевые_слова"": {""type"": ""array"", ""items"": {""type"": ""string""}, ""description"": ""Ключевые слова ответа""}
	|	},
	|	""required"": [""ответ"", ""ключевые_слова""],
	|	""additionalProperties"": false
	|}";

КонецФункции
