    <toolTip>
      <key>ru</key>
      <value>Правило жизненного цикла (День 15): перезаписываемый (срок, статус, версия), накапливаемый (решения, история), временный (удаляется при завершении задачи). Пустой тип нормализуется по категории: «Решение» — накапливаемый, иначе перезаписываемый</value>
    </toolTip>
    <minValue xsi:type="core:UndefinedValue"/>
    <maxValue xsi:type="core:UndefinedValue"/>
