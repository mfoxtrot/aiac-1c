  <producedTypes>
    <refType typeId="c4439f53-1a94-4e8f-a350-583b2e8781eb" valueTypeId="b125cb3e-8539-4140-849f-00c665eb6b1a"/>
    <listType typeId="8deec5e7-b6ae-4f9a-8f29-326377792a89" valueTypeId="2f162a70-cf30-4444-9539-9dac0e4f5c34"/>
