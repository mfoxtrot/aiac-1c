#Область ПрограммныйИнтерфейс

// Отправляет диалог сообщений к API Kimi и возвращает структуру с ответом модели.
// Обёртка общей функции ВыполнитьЗапрос; используется формой чата.
//
// Параметры:
//   Сообщения - Массив из Структура:
//     * Роль - Строка - роль отправителя в терминах API: "system", "user", "assistant" или "tool";
//     * Текст - Строка - текст сообщения.
//     Для сообщений цикла инструментов (function calling) структура дополняется реквизитами:
//     * ВызовыИнструментов - Массив из Структура("Ид, Имя, Аргументы") - для assistant с вызовами
//       инструментов (см. ВызовыИнструментов в возвращаемом значении);
//     * ИдВызова - Строка - для сообщения с ролью "tool": идентификатор вызова (tool_call_id).
//   Параметры - Структура, Неопределено - управляющие параметры запроса:
//     * МаксимумТокенов - Число - ограничение длины ответа (max_tokens); 0 - не задавать;
//     * СтопПоследовательность - Строка - стоп-последовательность (stop); пусто - не задавать;
//     * ФорматОтвета - Строка - "text" (без ограничений), "json_object" или "json_schema";
//     * СхемаОтвета - Строка - JSON Schema в виде строки; используется для "json_schema";
//     * УсилиеРассуждения - Строка - значение reasoning_effort ("low", "high", "max"); пусто - по умолчанию модели;
//     * Температура - Число - значение параметра temperature; отрицательное - не задавать;
//     * Модель - Строка - имя модели; пусто - модель по умолчанию (см. ИмяМодели);
//     * Таймаут - Число - таймаут HTTP-соединения, сек.; 0 - по умолчанию (60). Служебный параметр,
//       в тело запроса не попадает;
//     * АдресСервера - Строка - адрес сервера API без схемы и пути (например, "api.groq.com");
//       пусто - сервер Kimi (см. АдресСервера). Служебный параметр, в тело запроса не попадает;
//     * БазовыйПуть - Строка - префикс ресурса запроса (например, "/openai/v1" для Groq);
//       пусто - "/v1". Служебный параметр, в тело запроса не попадает;
//     * КлючAPI - Строка - ключ доступа; пусто - константа KimiApiKey. Служебный параметр,
//       в тело запроса не попадает. Позволяет обращаться к совместимым API других провайдеров;
//     * Инструменты - Массив из Структура - схемы инструментов для function calling
//       (параметр запроса tools); не заданы или пустые - не отправляются;
//     * ВыборИнструмента - Строка - значение tool_choice ("auto", "none", "required");
//       пусто - по умолчанию ("auto").
//
// Возвращаемое значение:
//   Структура:
//     * Текст - Строка - текст ответа модели;
//     * Рассуждение - Строка - цепочка рассуждения модели (reasoning_content); пустая строка, если API её не вернул;
//     * ПричинаЗавершения - Строка - значение finish_reason от API ("stop", "length" и пр.);
//     * ВызовыИнструментов - Массив из Структура - запрошенные моделью вызовы инструментов (tool_calls):
//       * Ид - Строка - идентификатор вызова (tool_call_id);
//       * Имя - Строка - имя инструмента;
//       * Аргументы - Строка - аргументы вызова в виде JSON-строки;
//     * ТокеныЗапроса - Число - prompt_tokens из блока usage;
//     * ТокеныОтвета - Число - completion_tokens из блока usage;
//     * ТокеныРассуждения - Число - токены рассуждения (completion_tokens_details.reasoning_tokens);
//     * ТокеныВсего - Число - total_tokens из блока usage;
//     * ВремяМиллисекунд - Число - длительность HTTP-вызова.
//
Функция ОтправитьДиалог(Сообщения, Параметры = Неопределено) Экспорт

	Возврат ВыполнитьЗапрос(Сообщения, Параметры);

КонецФункции

// Выполняет запрос к API Kimi (POST /v1/chat/completions) и возвращает структуру с ответом модели.
//
// Параметры и возвращаемое значение: см. ОтправитьДиалог.
//
Функция ВыполнитьЗапрос(Сообщения, Параметры = Неопределено) Экспорт

	АдресСервера = АдресСервераЗапроса(Параметры);
	КлючAPI = КлючAPIЗапроса(Параметры, АдресСервера);

	СообщенияAPI = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		СообщенияAPI.Добавить(СообщениеВФорматAPI(Сообщение));
	КонецЦикла;

	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("model", ИмяМодели());
	ПараметрыЗапроса.Вставить("messages", СообщенияAPI);
	ДополнитьПараметрыЗапроса(ПараметрыЗапроса, Параметры);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ПараметрыЗапроса);
	ТелоЗапроса = ЗаписьJSON.Закрыть();

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);
	Заголовки.Вставить("Content-Type", "application/json");

	ЗапросHTTP = Новый HTTPЗапрос(БазовыйПутьЗапроса(Параметры) + "/chat/completions", Заголовки);
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	СоединениеHTTP = Новый HTTPСоединение(АдресСервера, 443,
		Неопределено, Неопределено, Неопределено, ТаймаутСоединения(Параметры), Новый ЗащищенноеСоединениеOpenSSL);

	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		ОтветHTTP = СоединениеHTTP.ВызватьHTTPМетод("POST", ЗапросHTTP);
	Исключение
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось соединиться с сервером API (%1) по причине:'")
			+ " " + ОписаниеОшибки(), АдресСервера);
	КонецПопытки;

	ВремяМиллисекунд = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;

	ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если ОтветHTTP.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Сервер API (%1) вернул код состояния %2. Тело ответа: %3'"),
			АдресСервера, ОтветHTTP.КодСостояния, ТелоОтвета);
	КонецЕсли;

	ДанныеОтвета = ПрочитатьОтветJSON(ТелоОтвета);

	ВариантыОтвета = ДанныеОтвета["choices"];
	Если ВариантыОтвета = Неопределено Или ВариантыОтвета.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Сервер API (%1) не вернул варианты ответа.'"), АдресСервера);
	КонецЕсли;

	ВариантОтвета = ВариантыОтвета[0];
	СообщениеМодели = ВариантОтвета["message"];
	Если СообщениеМодели = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Сервер API (%1) вернул ответ без сообщения модели.'"), АдресСервера);
	КонецЕсли;

	ТекстРассуждения = СообщениеМодели["reasoning_content"];

	Результат = Новый Структура;
	Результат.Вставить("Текст", СообщениеМодели["content"]);
	Результат.Вставить("Рассуждение", ?(ТекстРассуждения = Неопределено, "", ТекстРассуждения));
	Результат.Вставить("ПричинаЗавершения", ВариантОтвета["finish_reason"]);
	Результат.Вставить("ВызовыИнструментов", ВызовыИнструментовИзОтвета(СообщениеМодели));
	Результат.Вставить("ВремяМиллисекунд", ВремяМиллисекунд);

	ИспользованиеТокенов = ДанныеОтвета["usage"];
	Результат.Вставить("ТокеныЗапроса", ТокеныИспользования(ИспользованиеТокенов, "prompt_tokens"));
	Результат.Вставить("ТокеныОтвета", ТокеныИспользования(ИспользованиеТокенов, "completion_tokens"));
	Результат.Вставить("ТокеныВсего", ТокеныИспользования(ИспользованиеТокенов, "total_tokens"));
	Результат.Вставить("ТокеныРассуждения", ТокеныРассужденияИзОтвета(ИспользованиеТокенов));

	Возврат Результат;

КонецФункции

// Возвращает идентификаторы моделей, доступных ключу API (GET /v1/models).
//
// Возвращаемое значение:
//   Массив из Строка - идентификаторы доступных моделей; пустой массив, если API не вернул список.
//
Функция ДоступныеМодели() Экспорт

	КлючAPI = Константы.KimiApiKey.Получить();
	Если Не ЗначениеЗаполнено(КлючAPI) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан ключ API Kimi. Заполните константу ""Ключ API Kimi"".'");
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);

	ЗапросHTTP = Новый HTTPЗапрос("/v1/models", Заголовки);

	СоединениеHTTP = Новый HTTPСоединение(АдресСервера(), 443,
		Неопределено, Неопределено, Неопределено, 60, Новый ЗащищенноеСоединениеOpenSSL);

	Попытка
		ОтветHTTP = СоединениеHTTP.ВызватьHTTPМетод("GET", ЗапросHTTP);
	Исключение
		ВызватьИсключение НСтр("ru = 'Не удалось соединиться с API Kimi по причине:'")
			+ " " + ОписаниеОшибки();
	КонецПопытки;

	ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если ОтветHTTP.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'API Kimi вернул код состояния %1. Тело ответа: %2'"),
			ОтветHTTP.КодСостояния, ТелоОтвета);
	КонецЕсли;

	ДанныеОтвета = ПрочитатьОтветJSON(ТелоОтвета);

	Модели = Новый Массив;
	ЗаписиМоделей = ДанныеОтвета["data"];
	Если ЗаписиМоделей = Неопределено Тогда
		Возврат Модели;
	КонецЕсли;

	Для Каждого ЗаписьМодели Из ЗаписиМоделей Цикл
		Идентификатор = ЗаписьМодели["id"];
		Если Идентификатор <> Неопределено Тогда
			Модели.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;

	Возврат Модели;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает имя модели Kimi, используемой для диалога.
// Актуальный список моделей: https://platform.kimi.ai/docs/models
//
// Возвращаемое значение:
//   Строка - имя модели.
//
Функция ИмяМодели()

	Возврат "kimi-k3.1-pro-highspeed";

КонецФункции

// Возвращает адрес сервера API Kimi.
//
// Возвращаемое значение:
//   Строка - адрес сервера без схемы и пути.
//
Функция АдресСервера()

	Возврат "api.moonshot.ai";

КонецФункции

// Возвращает таймаут HTTP-соединения запроса: из необязательного параметра "Таймаут"
// (секунды) или значение по умолчанию. Параметр служебный — в тело запроса не попадает.
//
// Параметры:
//   Параметры - Структура, Неопределено - см. ОтправитьДиалог.
//
// Возвращаемое значение:
//   Число - таймаут в секундах.
//
Функция ТаймаутСоединения(Параметры)

	Таймаут = Неопределено;
	Если Параметры <> Неопределено
		И Параметры.Свойство("Таймаут", Таймаут)
		И Таймаут > 0 Тогда
		Возврат Таймаут;
	КонецЕсли;

	Возврат 60;

КонецФункции

// Возвращает адрес сервера API запроса: из необязательного параметра "АдресСервера"
// или адрес сервера Kimi по умолчанию. Параметр служебный — в тело запроса не попадает.
//
// Параметры:
//   Параметры - Структура, Неопределено - см. ОтправитьДиалог.
//
// Возвращаемое значение:
//   Строка - адрес сервера без схемы и пути.
//
Функция АдресСервераЗапроса(Параметры)

	АдресСервераПараметр = Неопределено;
	Если Параметры <> Неопределено
		И Параметры.Свойство("АдресСервера", АдресСервераПараметр)
		И ЗначениеЗаполнено(АдресСервераПараметр) Тогда
		Возврат АдресСервераПараметр;
	КонецЕсли;

	Возврат АдресСервера();

КонецФункции

// Возвращает префикс ресурса запроса: из необязательного параметра "БазовыйПуть"
// или "/v1" по умолчанию. Параметр служебный — в тело запроса не попадает.
//
// Параметры:
//   Параметры - Структура, Неопределено - см. ОтправитьДиалог.
//
// Возвращаемое значение:
//   Строка - базовый путь ресурса (например, "/v1", "/openai/v1").
//
Функция БазовыйПутьЗапроса(Параметры)

	БазовыйПуть = Неопределено;
	Если Параметры <> Неопределено
		И Параметры.Свойство("БазовыйПуть", БазовыйПуть)
		И ЗначениеЗаполнено(БазовыйПуть) Тогда
		Возврат БазовыйПуть;
	КонецЕсли;

	Возврат "/v1";

КонецФункции

// Возвращает ключ API запроса: из необязательного параметра "КлючAPI" или константы
// KimiApiKey по умолчанию. Параметр служебный — в тело запроса не попадает.
//
// Параметры:
//   Параметры - Структура, Неопределено - см. ОтправитьДиалог;
//   АдресСервера - Строка - адрес сервера запроса (для сообщения об ошибке).
//
// Возвращаемое значение:
//   Строка - ключ доступа.
//
Функция КлючAPIЗапроса(Параметры, АдресСервера)

	КлючAPI = Неопределено;
	Если Параметры <> Неопределено
		И Параметры.Свойство("КлючAPI", КлючAPI)
		И ЗначениеЗаполнено(КлючAPI) Тогда
		Возврат КлючAPI;
	КонецЕсли;

	КлючAPI = Константы.KimiApiKey.Получить();
	Если Не ЗначениеЗаполнено(КлючAPI) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан ключ API Kimi. Заполните константу ""Ключ API Kimi"".'");
	КонецЕсли;

	Возврат КлючAPI;

КонецФункции

// Дополняет тело запроса к API управляющими параметрами: model, max_tokens, stop,
// response_format, reasoning_effort, temperature, tools, tool_choice.
//
// Параметры:
//   ПараметрыЗапроса - Соответствие - сериализуемое тело запроса;
//   Параметры - Структура, Неопределено - см. ОтправитьДиалог.
//
Процедура ДополнитьПараметрыЗапроса(ПараметрыЗапроса, Параметры)

	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Модель = Неопределено;
	Если Параметры.Свойство("Модель", Модель) И ЗначениеЗаполнено(Модель) Тогда
		ПараметрыЗапроса.Вставить("model", Модель);
	КонецЕсли;

	Температура = Неопределено;
	Если Параметры.Свойство("Температура", Температура) И Температура >= 0 Тогда
		ПараметрыЗапроса.Вставить("temperature", Температура);
	КонецЕсли;

	МаксимумТокенов = Неопределено;
	Если Параметры.Свойство("МаксимумТокенов", МаксимумТокенов) И МаксимумТокенов > 0 Тогда
		ПараметрыЗапроса.Вставить("max_tokens", МаксимумТокенов);
	КонецЕсли;

	СтопПоследовательность = Неопределено;
	Если Параметры.Свойство("СтопПоследовательность", СтопПоследовательность)
		И СтопПоследовательность <> Неопределено Тогда
		СтопПоследовательность = СтрЗаменить(СтопПоследовательность, "\n", Символы.ПС);
		СтопПоследовательность = СтрЗаменить(СтопПоследовательность, "\t", Символы.Таб);
		Если ЗначениеЗаполнено(СтопПоследовательность) Тогда
			ПараметрыЗапроса.Вставить("stop", СтопПоследовательность);
		КонецЕсли;
	КонецЕсли;

	ФорматОтвета = Неопределено;
	Параметры.Свойство("ФорматОтвета", ФорматОтвета);
	Если ФорматОтвета = "json_object" Тогда
		ПараметрыЗапроса.Вставить("response_format", Новый Структура("type", "json_object"));
	ИначеЕсли ФорматОтвета = "json_schema" Тогда
		СхемаОтвета = Неопределено;
		Параметры.Свойство("СхемаОтвета", СхемаОтвета);
		ПараметрыЗапроса.Вставить("response_format", ФорматПоСхеме(СхемаОтвета));
	КонецЕсли;

	УсилиеРассуждения = Неопределено;
	Если Параметры.Свойство("УсилиеРассуждения", УсилиеРассуждения)
		И ЗначениеЗаполнено(УсилиеРассуждения) Тогда
		ПараметрыЗапроса.Вставить("reasoning_effort", УсилиеРассуждения);
	КонецЕсли;

	Инструменты = Неопределено;
	Если Параметры.Свойство("Инструменты", Инструменты)
		И Инструменты <> Неопределено
		И Инструменты.Количество() > 0 Тогда
		ПараметрыЗапроса.Вставить("tools", Инструменты);
	КонецЕсли;

	ВыборИнструмента = Неопределено;
	Если Параметры.Свойство("ВыборИнструмента", ВыборИнструмента)
		И ЗначениеЗаполнено(ВыборИнструмента) Тогда
		ПараметрыЗапроса.Вставить("tool_choice", ВыборИнструмента);
	КонецЕсли;

КонецПроцедуры

// Формирует значение параметра response_format для строгой схемы ответа (Structured Output).
//
// Параметры:
//   ТекстСхемы - Строка - JSON Schema, описывающая структуру ответа.
//
// Возвращаемое значение:
//   Структура - значение для параметра "response_format".
//
Функция ФорматПоСхеме(ТекстСхемы)

	Если Не ЗначениеЗаполнено(ТекстСхемы) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнена схема ответа (JSON Schema).'");
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстСхемы);
		Схема = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		ВызватьИсключение НСтр("ru = 'Схема ответа не является корректным JSON:'") + " " + ОписаниеОшибки();
	КонецПопытки;

	ОписаниеСхемы = Новый Структура;
	ОписаниеСхемы.Вставить("name", "kimi_chat_answer");
	ОписаниеСхемы.Вставить("strict", Истина);
	ОписаниеСхемы.Вставить("schema", Схема);

	ФорматОтвета = Новый Структура;
	ФорматОтвета.Вставить("type", "json_schema");
	ФорматОтвета.Вставить("json_schema", ОписаниеСхемы);

	Возврат ФорматОтвета;

КонецФункции

// Преобразует сообщение диалога в сериализуемый формат API.
// Базовый вариант сообщения: Структура("Роль, Текст"). Дополнительно поддерживаются
// сообщения цикла инструментов (function calling):
//   - assistant с вызовами инструментов: реквизит "ВызовыИнструментов" (Массив структур "Ид, Имя, Аргументы");
//   - результат инструмента: роль "tool" и реквизит "ИдВызова" (идентификатор вызова, tool_call_id).
//
// Параметры:
//   Сообщение - Структура - сообщение диалога (см. выше).
//
// Возвращаемое значение:
//   Соответствие - сообщение в формате API.
//
Функция СообщениеВФорматAPI(Сообщение)

	СообщениеAPI = Новый Соответствие;
	СообщениеAPI.Вставить("role", Сообщение.Роль);
	СообщениеAPI.Вставить("content", ?(Сообщение.Текст = Неопределено, "", Сообщение.Текст));

	ИдВызова = Неопределено;
	Если Сообщение.Свойство("ИдВызова", ИдВызова) Тогда
		СообщениеAPI.Вставить("tool_call_id", ИдВызова);
		Возврат СообщениеAPI;
	КонецЕсли;

	ВызовыИнструментов = Неопределено;
	Если Сообщение.Свойство("ВызовыИнструментов", ВызовыИнструментов)
		И ВызовыИнструментов.Количество() > 0 Тогда
		СообщениеAPI.Вставить("tool_calls", ВызовыИнструментовВФорматAPI(ВызовыИнструментов));
	КонецЕсли;

	Возврат СообщениеAPI;

КонецФункции

// Преобразует вызовы инструментов сообщения в сериализуемый формат API.
//
// Параметры:
//   ВызовыИнструментов - Массив из Структура:
//     * Ид - Строка - идентификатор вызова (tool_call_id);
//     * Имя - Строка - имя инструмента;
//     * Аргументы - Строка - аргументы вызова в виде JSON-строки.
//
// Возвращаемое значение:
//   Массив из Соответствие - вызовы в формате API.
//
Функция ВызовыИнструментовВФорматAPI(ВызовыИнструментов)

	ВызовыAPI = Новый Массив;
	Для Каждого Вызов Из ВызовыИнструментов Цикл
		ФункцияВызова = Новый Соответствие;
		ФункцияВызова.Вставить("name", Вызов.Имя);
		ФункцияВызова.Вставить("arguments", Вызов.Аргументы);

		ВызовAPI = Новый Соответствие;
		ВызовAPI.Вставить("id", Вызов.Ид);
		ВызовAPI.Вставить("type", "function");
		ВызовAPI.Вставить("function", ФункцияВызова);

		ВызовыAPI.Добавить(ВызовAPI);
	КонецЦикла;

	Возврат ВызовыAPI;

КонецФункции

// Разбирает запрошенные моделью вызовы инструментов (tool_calls) из сообщения ответа API.
//
// Параметры:
//   СообщениеМодели - Соответствие, Неопределено - объект choices[0].message ответа API.
//
// Возвращаемое значение:
//   Массив из Структура - вызовы инструментов:
//     * Ид - Строка - идентификатор вызова (tool_call_id);
//     * Имя - Строка - имя инструмента;
//     * Аргументы - Строка - аргументы вызова в виде JSON-строки (требуют ПрочитатьJSON).
//
Функция ВызовыИнструментовИзОтвета(СообщениеМодели)

	ВызовыИнструментов = Новый Массив;
	Если СообщениеМодели = Неопределено Тогда
		Возврат ВызовыИнструментов;
	КонецЕсли;

	ДанныеВызовов = СообщениеМодели["tool_calls"];
	Если ДанныеВызовов = Неопределено Тогда
		Возврат ВызовыИнструментов;
	КонецЕсли;

	Для Каждого ДанныеВызова Из ДанныеВызовов Цикл
		ФункцияВызова = ДанныеВызова["function"];
		Если ФункцияВызова = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Вызов = Новый Структура;
		Вызов.Вставить("Ид", ДанныеВызова["id"]);
		Вызов.Вставить("Имя", ФункцияВызова["name"]);
		Вызов.Вставить("Аргументы", ФункцияВызова["arguments"]);

		ВызовыИнструментов.Добавить(Вызов);
	КонецЦикла;

	Возврат ВызовыИнструментов;

КонецФункции

// Преобразует строку JSON в соответствие.
//
// Параметры:
//   СтрокаJSON - Строка - текст в формате JSON.
//
// Возвращаемое значение:
//   Соответствие - данные, прочитанные из строки.
//
Функция ПрочитатьОтветJSON(СтрокаJSON)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();

	Возврат Данные;

КонецФункции

// Возвращает число токенов из блока usage ответа API.
//
// Параметры:
//   ИспользованиеТокенов - Соответствие, Неопределено - блок usage ответа;
//   ИмяПоля - Строка - имя поля блока (prompt_tokens, completion_tokens, total_tokens).
//
// Возвращаемое значение:
//   Число - значение поля; 0, если блок или поле отсутствуют.
//
Функция ТокеныИспользования(ИспользованиеТокенов, ИмяПоля)

	Если ИспользованиеТокенов = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	ЗначениеПоля = ИспользованиеТокенов[ИмяПоля];
	Возврат ?(ЗначениеПоля = Неопределено, 0, ЗначениеПоля);

КонецФункции

// Возвращает число токенов рассуждения из блока usage ответа API.
//
// Параметры:
//   ИспользованиеТокенов - Соответствие, Неопределено - блок usage ответа.
//
// Возвращаемое значение:
//   Число - значение completion_tokens_details.reasoning_tokens; 0, если блок отсутствует.
//
Функция ТокеныРассужденияИзОтвета(ИспользованиеТокенов)

	Если ИспользованиеТокенов = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	ДеталиОтвета = ИспользованиеТокенов["completion_tokens_details"];
	Если ДеталиОтвета = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	ТокеныРассуждения = ДеталиОтвета["reasoning_tokens"];
	Возврат ?(ТокеныРассуждения = Неопределено, 0, ТокеныРассуждения);

КонецФункции

#КонецОбласти
