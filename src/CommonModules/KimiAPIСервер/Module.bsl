#Область ПрограммныйИнтерфейс

// Отправляет диалог сообщений к API Kimi и возвращает структуру с ответом модели.
// Обёртка общей функции ВыполнитьЗапрос; используется формой чата.
//
// Параметры:
//   Сообщения - Массив из Структура:
//     * Роль - Строка - роль отправителя в терминах API: "system", "user" или "assistant";
//     * Текст - Строка - текст сообщения.
//   Параметры - Структура, Неопределено - управляющие параметры запроса:
//     * МаксимумТокенов - Число - ограничение длины ответа (max_tokens); 0 - не задавать;
//     * СтопПоследовательность - Строка - стоп-последовательность (stop); пусто - не задавать;
//     * ФорматОтвета - Строка - "text" (без ограничений), "json_object" или "json_schema";
//     * СхемаОтвета - Строка - JSON Schema в виде строки; используется для "json_schema";
//     * УсилиеРассуждения - Строка - значение reasoning_effort ("low", "high", "max"); пусто - по умолчанию модели.
//
// Возвращаемое значение:
//   Структура:
//     * Текст - Строка - текст ответа модели;
//     * Рассуждение - Строка - цепочка рассуждения модели (reasoning_content); пустая строка, если API её не вернул;
//     * ПричинаЗавершения - Строка - значение finish_reason от API ("stop", "length" и пр.);
//     * ТокеныЗапроса - Число - prompt_tokens из блока usage;
//     * ТокеныОтвета - Число - completion_tokens из блока usage;
//     * ТокеныРассуждения - Число - токены рассуждения (completion_tokens_details.reasoning_tokens);
//     * ТокеныВсего - Число - total_tokens из блока usage;
//     * ВремяМиллисекунд - Число - длительность HTTP-вызова.
//
Функция ОтправитьДиалог(Сообщения, Параметры = Неопределено) Экспорт

	Возврат ВыполнитьЗапрос(Сообщения, Параметры);

КонецФункции

// Выполняет запрос к API Kimi (POST /v1/chat/completions) и возвращает структуру с ответом модели.
//
// Параметры и возвращаемое значение: см. ОтправитьДиалог.
//
Функция ВыполнитьЗапрос(Сообщения, Параметры = Неопределено) Экспорт

	КлючAPI = Константы.KimiApiKey.Получить();
	Если Не ЗначениеЗаполнено(КлючAPI) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан ключ API Kimi. Заполните константу ""Ключ API Kimi"".'");
	КонецЕсли;

	СообщенияAPI = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		СообщениеAPI = Новый Соответствие;
		СообщениеAPI.Вставить("role", Сообщение.Роль);
		СообщениеAPI.Вставить("content", Сообщение.Текст);
		СообщенияAPI.Добавить(СообщениеAPI);
	КонецЦикла;

	ПараметрыЗапроса = Новый Соответствие;
	ПараметрыЗапроса.Вставить("model", ИмяМодели());
	ПараметрыЗапроса.Вставить("messages", СообщенияAPI);
	ДополнитьПараметрыЗапроса(ПараметрыЗапроса, Параметры);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ПараметрыЗапроса);
	ТелоЗапроса = ЗаписьJSON.Закрыть();

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);
	Заголовки.Вставить("Content-Type", "application/json");

	ЗапросHTTP = Новый HTTPЗапрос("/v1/chat/completions", Заголовки);
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	СоединениеHTTP = Новый HTTPСоединение(АдресСервера(), 443,
		Неопределено, Неопределено, Неопределено, 60, Новый ЗащищенноеСоединениеOpenSSL);

	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		ОтветHTTP = СоединениеHTTP.ВызватьHTTPМетод("POST", ЗапросHTTP);
	Исключение
		ВызватьИсключение НСтр("ru = 'Не удалось соединиться с API Kimi по причине:'")
			+ " " + ОписаниеОшибки();
	КонецПопытки;

	ВремяМиллисекунд = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;

	ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если ОтветHTTP.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'API Kimi вернул код состояния %1. Тело ответа: %2'"),
			ОтветHTTP.КодСостояния, ТелоОтвета);
	КонецЕсли;

	ДанныеОтвета = ПрочитатьОтветJSON(ТелоОтвета);

	ВариантыОтвета = ДанныеОтвета["choices"];
	Если ВариантыОтвета = Неопределено Или ВариантыОтвета.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'API Kimi не вернул варианты ответа.'");
	КонецЕсли;

	ВариантОтвета = ВариантыОтвета[0];
	СообщениеМодели = ВариантОтвета["message"];
	Если СообщениеМодели = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'API Kimi вернул ответ без сообщения модели.'");
	КонецЕсли;

	ТекстРассуждения = СообщениеМодели["reasoning_content"];

	Результат = Новый Структура;
	Результат.Вставить("Текст", СообщениеМодели["content"]);
	Результат.Вставить("Рассуждение", ?(ТекстРассуждения = Неопределено, "", ТекстРассуждения));
	Результат.Вставить("ПричинаЗавершения", ВариантОтвета["finish_reason"]);
	Результат.Вставить("ВремяМиллисекунд", ВремяМиллисекунд);

	ИспользованиеТокенов = ДанныеОтвета["usage"];
	Результат.Вставить("ТокеныЗапроса", ТокеныИспользования(ИспользованиеТокенов, "prompt_tokens"));
	Результат.Вставить("ТокеныОтвета", ТокеныИспользования(ИспользованиеТокенов, "completion_tokens"));
	Результат.Вставить("ТокеныВсего", ТокеныИспользования(ИспользованиеТокенов, "total_tokens"));
	Результат.Вставить("ТокеныРассуждения", ТокеныРассужденияИзОтвета(ИспользованиеТокенов));

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает имя модели Kimi, используемой для диалога.
// Актуальный список моделей: https://platform.kimi.ai/docs/models
//
// Возвращаемое значение:
//   Строка - имя модели.
//
Функция ИмяМодели()

	Возврат "kimi-k3.1-pro-highspeed";

КонецФункции

// Возвращает адрес сервера API Kimi.
//
// Возвращаемое значение:
//   Строка - адрес сервера без схемы и пути.
//
Функция АдресСервера()

	Возврат "api.moonshot.ai";

КонецФункции

// Дополняет тело запроса к API управляющими параметрами: max_tokens, stop, response_format, reasoning_effort.
//
// Параметры:
//   ПараметрыЗапроса - Соответствие - сериализуемое тело запроса;
//   Параметры - Структура, Неопределено - см. ОтправитьДиалог.
//
Процедура ДополнитьПараметрыЗапроса(ПараметрыЗапроса, Параметры)

	Если Параметры = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Параметры.МаксимумТокенов > 0 Тогда
		ПараметрыЗапроса.Вставить("max_tokens", Параметры.МаксимумТокенов);
	КонецЕсли;

	СтопПоследовательность = СтрЗаменить(Параметры.СтопПоследовательность, "\n", Символы.ПС);
	СтопПоследовательность = СтрЗаменить(СтопПоследовательность, "\t", Символы.Таб);
	Если ЗначениеЗаполнено(СтопПоследовательность) Тогда
		ПараметрыЗапроса.Вставить("stop", СтопПоследовательность);
	КонецЕсли;

	Если Параметры.ФорматОтвета = "json_object" Тогда
		ПараметрыЗапроса.Вставить("response_format", Новый Структура("type", "json_object"));
	ИначеЕсли Параметры.ФорматОтвета = "json_schema" Тогда
		ПараметрыЗапроса.Вставить("response_format", ФорматПоСхеме(Параметры.СхемаОтвета));
	КонецЕсли;

	УсилиеРассуждения = Неопределено;
	Если Параметры.Свойство("УсилиеРассуждения", УсилиеРассуждения)
		И ЗначениеЗаполнено(УсилиеРассуждения) Тогда
		ПараметрыЗапроса.Вставить("reasoning_effort", УсилиеРассуждения);
	КонецЕсли;

КонецПроцедуры

// Формирует значение параметра response_format для строгой схемы ответа (Structured Output).
//
// Параметры:
//   ТекстСхемы - Строка - JSON Schema, описывающая структуру ответа.
//
// Возвращаемое значение:
//   Структура - значение для параметра "response_format".
//
Функция ФорматПоСхеме(ТекстСхемы)

	Если Не ЗначениеЗаполнено(ТекстСхемы) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнена схема ответа (JSON Schema).'");
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстСхемы);
		Схема = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		ВызватьИсключение НСтр("ru = 'Схема ответа не является корректным JSON:'") + " " + ОписаниеОшибки();
	КонецПопытки;

	ОписаниеСхемы = Новый Структура;
	ОписаниеСхемы.Вставить("name", "kimi_chat_answer");
	ОписаниеСхемы.Вставить("strict", Истина);
	ОписаниеСхемы.Вставить("schema", Схема);

	ФорматОтвета = Новый Структура;
	ФорматОтвета.Вставить("type", "json_schema");
	ФорматОтвета.Вставить("json_schema", ОписаниеСхемы);

	Возврат ФорматОтвета;

КонецФункции

// Преобразует строку JSON в соответствие.
//
// Параметры:
//   СтрокаJSON - Строка - текст в формате JSON.
//
// Возвращаемое значение:
//   Соответствие - данные, прочитанные из строки.
//
Функция ПрочитатьОтветJSON(СтрокаJSON)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();

	Возврат Данные;

КонецФункции

// Возвращает число токенов из блока usage ответа API.
//
// Параметры:
//   ИспользованиеТокенов - Соответствие, Неопределено - блок usage ответа;
//   ИмяПоля - Строка - имя поля блока (prompt_tokens, completion_tokens, total_tokens).
//
// Возвращаемое значение:
//   Число - значение поля; 0, если блок или поле отсутствуют.
//
Функция ТокеныИспользования(ИспользованиеТокенов, ИмяПоля)

	Если ИспользованиеТокенов = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	ЗначениеПоля = ИспользованиеТокенов[ИмяПоля];
	Возврат ?(ЗначениеПоля = Неопределено, 0, ЗначениеПоля);

КонецФункции

// Возвращает число токенов рассуждения из блока usage ответа API.
//
// Параметры:
//   ИспользованиеТокенов - Соответствие, Неопределено - блок usage ответа.
//
// Возвращаемое значение:
//   Число - значение completion_tokens_details.reasoning_tokens; 0, если блок отсутствует.
//
Функция ТокеныРассужденияИзОтвета(ИспользованиеТокенов)

	Если ИспользованиеТокенов = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	ДеталиОтвета = ИспользованиеТокенов["completion_tokens_details"];
	Если ДеталиОтвета = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	ТокеныРассуждения = ДеталиОтвета["reasoning_tokens"];
	Возврат ?(ТокеныРассуждения = Неопределено, 0, ТокеныРассуждения);

КонецФункции

#КонецОбласти
