#Область ПрограммныйИнтерфейс

// Решает задачу выбранным способом промптинга, записывает результат в регистр сведений
// и возвращает его для отображения в форме.
//
// Параметры:
//   Задача - СправочникСсылка.KimiЗадачиРассуждений - решаемая задача;
//   Способ - ПеречислениеСсылка.KimiСпособыРассуждения - способ промптинга;
//   Усилие - ПеречислениеСсылка.KimiУсилиеРассуждения - уровень рассуждения модели;
//   ДатаЗапуска - Дата - дата и время начала прогона; связывает записи одного прогона.
//
// Возвращаемое значение:
//   Структура:
//     * Задача - СправочникСсылка.KimiЗадачиРассуждений;
//     * Способ - ПеречислениеСсылка.KimiСпособыРассуждения;
//     * УсилиеРассуждения - ПеречислениеСсылка.KimiУсилиеРассуждения;
//     * НомерПопытки - Число - номер попытки в ячейке "задача × способ × усилие";
//     * Ответ - Строка - ответ модели (пустая строка при ошибке);
//     * Рассуждение - Строка - цепочки рассуждения модели по всем вызовам ячейки;
//     * СоставленныйПромпт - Строка - промпт, составленный моделью (только способ "Самопромпт");
//     * ЭталонНайден - Булево - Истина, если эталонный ответ найден в тексте ответа (подсказка для оценки);
//     * Верно - Булево - начальное значение совпадает с подсказкой; окончательно отмечает пользователь;
//     * ТокеныЗапроса - Число - суммарные prompt_tokens по всем вызовам ячейки;
//     * ТокеныОтвета - Число - суммарные completion_tokens по всем вызовам ячейки;
//     * ТокеныВсего - Число - суммарные total_tokens по всем вызовам ячейки;
//     * ТокеныРассуждения - Число - суммарные токены рассуждения по всем вызовам ячейки;
//     * ВремяМиллисекунд - Число - суммарная длительность HTTP-вызовов ячейки;
//     * СообщениеОбОшибке - Строка - пустая строка, если все вызовы завершились успешно.
//
Функция РешитьЗадачу(Задача, Способ, Усилие, ДатаЗапуска) Экспорт

	ДанныеЗадачи = ДанныеЗадачи(Задача);

	Результат = НовыйРезультат(Задача, Способ, Усилие);
	Результат.НомерПопытки = СледующаяПопытка(Задача, Способ, Усилие);

	Попытка
		РешитьЗадачуСпособом(ДанныеЗадачи, Способ, Усилие, Результат);
	Исключение
		Результат.СообщениеОбОшибке = ОписаниеОшибки();
	КонецПопытки;

	Результат.ЭталонНайден = ЭталонНайден(ДанныеЗадачи.ЭталонныйОтвет, Результат.Ответ);
	Результат.Верно = Результат.ЭталонНайден;

	ЗаписатьРезультат(Результат, ДатаЗапуска);

	Возврат Результат;

КонецФункции

// Устанавливает отметку "Верно" в существующей записи регистра.
//
// Параметры:
//   Задача - СправочникСсылка.KimiЗадачиРассуждений;
//   Способ - ПеречислениеСсылка.KimiСпособыРассуждения;
//   Усилие - ПеречислениеСсылка.KimiУсилиеРассуждения;
//   НомерПопытки - Число - номер попытки;
//   Верно - Булево - новое значение отметки.
//
Процедура УстановитьВерность(Задача, Способ, Усилие, НомерПопытки, Верно) Экспорт

	МенеджерЗаписи = РегистрыСведений.РезультатыРассужденийKimi.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Задача = Задача;
	МенеджерЗаписи.Способ = Способ;
	МенеджерЗаписи.УсилиеРассуждения = Усилие;
	МенеджерЗаписи.НомерПопытки = НомерПопытки;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.Верно = Верно;
	МенеджерЗаписи.Записать();

КонецПроцедуры

// Удаляет все записи регистра результатов.
//
Процедура ОчиститьРезультаты() Экспорт

	НаборЗаписей = РегистрыСведений.РезультатыРассужденийKimi.СоздатьНаборЗаписей();
	НаборЗаписей.Записать();

КонецПроцедуры

// Возвращает список задач справочника для заполнения таблицы формы.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Задача - СправочникСсылка.KimiЗадачиРассуждений;
//     * Наименование - Строка;
//     * Категория - Строка;
//     * ЭталонныйОтвет - Строка.
//
Функция СписокЗадач() Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Задачи.Ссылка КАК Задача,
	|	Задачи.Наименование КАК Наименование,
	|	Задачи.Категория КАК Категория,
	|	Задачи.ЭталонныйОтвет КАК ЭталонныйОтвет
	|ИЗ
	|	Справочник.KimiЗадачиРассуждений КАК Задачи
	|
	|УПОРЯДОЧИТЬ ПО
	|	Задачи.Код");

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Создаёт в справочнике задачи учебного набора, которых ещё нет.
//
Процедура НаполнитьЗадачиПоУмолчанию() Экспорт

	Для Каждого ОписаниеЗадачи Из ЗадачиПоУмолчанию() Цикл

		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Задачи.Ссылка
		|ИЗ
		|	Справочник.KimiЗадачиРассуждений КАК Задачи
		|ГДЕ
		|	Задачи.Наименование = &Наименование");
		Запрос.УстановитьПараметр("Наименование", ОписаниеЗадачи.Наименование);

		Если Не Запрос.Выполнить().Пустой() Тогда
			Продолжить;
		КонецЕсли;

		НоваяЗадача = Справочники.KimiЗадачиРассуждений.СоздатьЭлемент();
		НоваяЗадача.Наименование = ОписаниеЗадачи.Наименование;
		НоваяЗадача.ТекстЗадачи = ОписаниеЗадачи.ТекстЗадачи;
		НоваяЗадача.ЭталонныйОтвет = ОписаниеЗадачи.ЭталонныйОтвет;
		НоваяЗадача.Категория = ОписаниеЗадачи.Категория;
		НоваяЗадача.Записать();

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает реквизиты задачи.
//
// Параметры:
//   Задача - СправочникСсылка.KimiЗадачиРассуждений.
//
// Возвращаемое значение:
//   Структура:
//     * Наименование - Строка;
//     * ТекстЗадачи - Строка;
//     * ЭталонныйОтвет - Строка.
//
Функция ДанныеЗадачи(Задача)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Задачи.Наименование КАК Наименование,
	|	Задачи.ТекстЗадачи КАК ТекстЗадачи,
	|	Задачи.ЭталонныйОтвет КАК ЭталонныйОтвет
	|ИЗ
	|	Справочник.KimiЗадачиРассуждений КАК Задачи
	|ГДЕ
	|	Задачи.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Задача);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Результат = Новый Структура("Наименование, ТекстЗадачи, ЭталонныйОтвет");
	ЗаполнитьЗначенияСвойств(Результат, Выборка);

	Возврат Результат;

КонецФункции

// Формирует структуру результата с начальными значениями.
//
Функция НовыйРезультат(Задача, Способ, Усилие)

	Результат = Новый Структура;
	Результат.Вставить("Задача", Задача);
	Результат.Вставить("Способ", Способ);
	Результат.Вставить("УсилиеРассуждения", Усилие);
	Результат.Вставить("НомерПопытки", 0);
	Результат.Вставить("Ответ", "");
	Результат.Вставить("Рассуждение", "");
	Результат.Вставить("СоставленныйПромпт", "");
	Результат.Вставить("ЭталонНайден", Ложь);
	Результат.Вставить("Верно", Ложь);
	Результат.Вставить("ТокеныЗапроса", 0);
	Результат.Вставить("ТокеныОтвета", 0);
	Результат.Вставить("ТокеныВсего", 0);
	Результат.Вставить("ТокеныРассуждения", 0);
	Результат.Вставить("ВремяМиллисекунд", 0);
	Результат.Вставить("СообщениеОбОшибке", "");

	Возврат Результат;

КонецФункции

// Решает задачу заданным способом, заполняя поля результата. Способ "Самопромпт"
// выполняет два вызова API: составление промпта и решение с ним.
//
Процедура РешитьЗадачуСпособом(ДанныеЗадачи, Способ, Усилие, Результат)

	ПараметрыВызова = ПараметрыВызова(Усилие);

	Если Способ = Перечисления.KimiСпособыРассуждения.ПрямойОтвет Тогда

		Сообщения = Новый Массив;
		Сообщения.Добавить(Новый Структура("Роль, Текст", "user", ДанныеЗадачи.ТекстЗадачи));
		ОтветМодели = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, ПараметрыВызова);
		ПрименитьИтогиВызова(Результат, ОтветМодели, Истина);

	ИначеЕсли Способ = Перечисления.KimiСпособыРассуждения.Пошагово Тогда

		Сообщения = Новый Массив;
		Сообщения.Добавить(Новый Структура("Роль, Текст", "system", ТекстИнструкцииПошагово()));
		Сообщения.Добавить(Новый Структура("Роль, Текст", "user", ДанныеЗадачи.ТекстЗадачи));
		ОтветМодели = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, ПараметрыВызова);
		ПрименитьИтогиВызова(Результат, ОтветМодели, Истина);

	ИначеЕсли Способ = Перечисления.KimiСпособыРассуждения.Самопромпт Тогда

		Сообщения = Новый Массив;
		Сообщения.Добавить(Новый Структура("Роль, Текст", "user", ТекстЗапросаСоставитьПромпт(ДанныеЗадачи.ТекстЗадачи)));
		ПромптРешения = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, ПараметрыВызова);
		ПрименитьИтогиВызова(Результат, ПромптРешения, Ложь);
		Результат.СоставленныйПромпт = ПромптРешения.Текст;

		Сообщения = Новый Массив;
		Сообщения.Добавить(Новый Структура("Роль, Текст", "system", ПромптРешения.Текст));
		Сообщения.Добавить(Новый Структура("Роль, Текст", "user", ДанныеЗадачи.ТекстЗадачи));
		ОтветМодели = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, ПараметрыВызова);
		ПрименитьИтогиВызова(Результат, ОтветМодели, Истина);

	Иначе // Эксперты

		Сообщения = Новый Массив;
		Сообщения.Добавить(Новый Структура("Роль, Текст", "system", ТекстИнструкцииЭксперты()));
		Сообщения.Добавить(Новый Структура("Роль, Текст", "user",
			ДанныеЗадачи.ТекстЗадачи + Символы.ПС + Символы.ПС + ТекстЗапросаЭкспертам()));
		ОтветМодели = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, ПараметрыВызова);
		ПрименитьИтогиВызова(Результат, ОтветМодели, Истина);

	КонецЕсли;

КонецПроцедуры

// Накапливает в результате токены, время и рассуждение вызова; признак ИтоговыйОтвет
// дополнительно переносит текст ответа модели в результат.
//
Процедура ПрименитьИтогиВызова(Результат, ДанныеВызова, ИтоговыйОтвет)

	Если ЗначениеЗаполнено(ДанныеВызова.Рассуждение) Тогда
		Если ЗначениеЗаполнено(Результат.Рассуждение) Тогда
			Результат.Рассуждение = Результат.Рассуждение + Символы.ПС + Символы.ПС;
		КонецЕсли;
		Результат.Рассуждение = Результат.Рассуждение + ДанныеВызова.Рассуждение;
	КонецЕсли;

	Если ИтоговыйОтвет Тогда
		Результат.Ответ = ДанныеВызова.Текст;
	КонецЕсли;

	Результат.ТокеныЗапроса = Результат.ТокеныЗапроса + ДанныеВызова.ТокеныЗапроса;
	Результат.ТокеныОтвета = Результат.ТокеныОтвета + ДанныеВызова.ТокеныОтвета;
	Результат.ТокеныВсего = Результат.ТокеныВсего + ДанныеВызова.ТокеныВсего;
	Результат.ТокеныРассуждения = Результат.ТокеныРассуждения + ДанныеВызова.ТокеныРассуждения;
	Результат.ВремяМиллисекунд = Результат.ВремяМиллисекунд + ДанныеВызова.ВремяМиллисекунд;

КонецПроцедуры

// Возвращает параметры HTTP-вызова для заданного усилия рассуждения.
//
Функция ПараметрыВызова(Усилие)

	Параметры = Новый Структура;
	Параметры.Вставить("МаксимумТокенов", 0);
	Параметры.Вставить("СтопПоследовательность", "");
	Параметры.Вставить("ФорматОтвета", "text");
	Параметры.Вставить("СхемаОтвета", "");
	Параметры.Вставить("УсилиеРассуждения", ИмяУсилияВAPI(Усилие));

	Возврат Параметры;

КонецФункции

// Преобразует значение перечисления в имя параметра reasoning_effort API.
//
Функция ИмяУсилияВAPI(Усилие)

	Если Усилие = Перечисления.KimiУсилиеРассуждения.low Тогда
		Возврат "low";
	КонецЕсли;

	Возврат "max";

КонецФункции

// Проверяет, встречается ли эталонный ответ в тексте ответа модели (регистронезависимо).
//
Функция ЭталонНайден(ЭталонныйОтвет, ОтветМодели)

	Если Не ЗначениеЗаполнено(ЭталонныйОтвет) Или Не ЗначениеЗаполнено(ОтветМодели) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНайти(НРег(ОтветМодели), НРег(СокрЛП(ЭталонныйОтвет))) > 0;

КонецФункции

// Возвращает следующий номер попытки для ячейки "задача × способ × усилие".
//
Функция СледующаяПопытка(Задача, Способ, Усилие)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МАКСИМУМ(Результаты.НомерПопытки) КАК ПоследняяПопытка
	|ИЗ
	|	РегистрСведений.РезультатыРассужденийKimi КАК Результаты
	|ГДЕ
	|	Результаты.Задача = &Задача
	|	И Результаты.Способ = &Способ
	|	И Результаты.УсилиеРассуждения = &УсилиеРассуждения");
	Запрос.УстановитьПараметр("Задача", Задача);
	Запрос.УстановитьПараметр("Способ", Способ);
	Запрос.УстановитьПараметр("УсилиеРассуждения", Усилие);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат ?(Выборка.ПоследняяПопытка = Неопределено, 0, Выборка.ПоследняяПопытка) + 1;

КонецФункции

// Записывает результат в регистр сведений.
//
Процедура ЗаписатьРезультат(Результат, ДатаЗапуска)

	НаборЗаписей = РегистрыСведений.РезультатыРассужденийKimi.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Задача.Установить(Результат.Задача);
	НаборЗаписей.Отбор.Способ.Установить(Результат.Способ);
	НаборЗаписей.Отбор.УсилиеРассуждения.Установить(Результат.УсилиеРассуждения);
	НаборЗаписей.Отбор.НомерПопытки.Установить(Результат.НомерПопытки);

	Запись = НаборЗаписей.Добавить();
	Запись.Задача = Результат.Задача;
	Запись.Способ = Результат.Способ;
	Запись.УсилиеРассуждения = Результат.УсилиеРассуждения;
	Запись.НомерПопытки = Результат.НомерПопытки;
	Запись.ДатаЗапуска = ДатаЗапуска;
	Запись.Ответ = Результат.Ответ;
	Запись.Рассуждение = Результат.Рассуждение;
	Запись.СоставленныйПромпт = Результат.СоставленныйПромпт;
	Запись.Верно = Результат.Верно;
	Запись.ЭталонНайден = Результат.ЭталонНайден;
	Запись.ТокеныЗапроса = Результат.ТокеныЗапроса;
	Запись.ТокеныОтвета = Результат.ТокеныОтвета;
	Запись.ТокеныВсего = Результат.ТокеныВсего;
	Запись.ТокеныРассуждения = Результат.ТокеныРассуждения;
	Запись.ВремяМиллисекунд = Результат.ВремяМиллисекунд;
	Запись.СообщениеОбОшибке = Результат.СообщениеОбОшибке;

	НаборЗаписей.Записать();

КонецПроцедуры

// Инструкция способа "Пошагово".
//
Функция ТекстИнструкцииПошагово()

	Возврат НСтр("ru = 'Решай задачу пошагово: сначала выпиши условие и выдели ключевые факты, затем выполни рассуждение шаг за шагом и только после этого сформулируй окончательный ответ.'");

КонецФункции

// Запрос первого вызова способа "Самопромпт": составление промпта для решения задачи.
//
Функция ТекстЗапросаСоставитьПромпт(ТекстЗадачи)

	Возврат НСтр("ru = 'По задаче ниже составь промпт для языковой модели, которая решит эту задачу. Промпт должен задавать модели роль, план рассуждения и требования к формату ответа. Выведи только текст промпта, без вступлений и оформления.'")
		+ Символы.ПС + Символы.ПС + ТекстЗадачи;

КонецФункции

// Инструкция способа "Эксперты": роли группы экспертов.
//
Функция ТекстИнструкцииЭксперты()

	Возврат НСтр("ru = 'Ты — группа из трёх независимых экспертов, решающих задачу совместно. Аналитик — формализует условие и выделяет ключевые факты. Инженер — строит пошаговое решение. Критик — проверяет решение на ошибки и несоответствия условию. Каждый эксперт сначала высказывает своё мнение, затем группа сводит мнения в итоговый ответ.'");

КонецФункции

// Запрос способа "Эксперты": требование к структуре ответа.
//
Функция ТекстЗапросаЭкспертам()

	Возврат НСтр("ru = 'Решите задачу: сначала по очереди выскажитесь всем троим (Аналитик, Инженер, Критик), затем сформулируйте итоговый ответ группы.'");

КонецФункции

// Возвращает учебный набор задач с известными ответами.
