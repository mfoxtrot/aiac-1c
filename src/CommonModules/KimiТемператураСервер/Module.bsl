#Область ПрограммныйИнтерфейс

// Выполняет один шаг эксперимента "задача × температура": отправляет текст задачи выбранной
// модели с заданной температурой (или без неё), записывает результат в регистр сведений
// и возвращает его для отображения в форме.
//
// Параметры:
//   Задача - СправочникСсылка.KimiЗадачиРассуждений, СправочникСсылка.KimiЗадачиГенерации - решаемая задача;
//   Температура - Число - значение параметра temperature; отрицательное - не передавать (контрольный прогон);
//   МодельЭксперимента - Строка - имя модели; пустая строка - модель по умолчанию (см. KimiAPIСервер.ИмяМодели);
//   ДатаЗапуска - Дата - дата и время начала прогона; связывает записи одного прогона.
//
// Возвращаемое значение:
//   Структура:
//     * Задача - СправочникСсылка - задача шага;
//     * Температура - Число - переданное значение температуры; -1, если параметр не передавался;
//     * НомерПопытки - Число - номер попытки в ячейке "задача × температура";
//     * ТипЗадачи - Строка - тип задачи (см. ТипЗадачиОдинОтвет/ТипЗадачиГенерация);
//     * Ответ - Строка - ответ модели (пустая строка при ошибке);
//     * Рассуждение - Строка - цепочка рассуждения модели (пустая строка, если API её не вернул);
//     * ЭталонНайден - Булево - Истина, если эталонный ответ найден в тексте ответа (подсказка для оценки);
//     * Верно - Булево - начальное значение совпадает с подсказкой; окончательно отмечает пользователь;
//     * ТокеныЗапроса - Число - prompt_tokens из блока usage;
//     * ТокеныОтвета - Число - completion_tokens из блока usage;
//     * ТокеныВсего - Число - total_tokens из блока usage;
//     * ВремяМиллисекунд - Число - длительность HTTP-вызова;
//     * СообщениеОбОшибке - Строка - пустая строка, если вызов завершился успешно.
//
Функция ВыполнитьПопытку(Задача, Температура, МодельЭксперимента, ДатаЗапуска) Экспорт

	ДанныеЗадачи = ДанныеЗадачи(Задача);

	Результат = НовыйРезультат(Задача, Температура, МодельЭксперимента, ДанныеЗадачи.ТипЗадачи);
	Результат.НомерПопытки = СледующаяПопытка(Задача, Температура);

	Попытка
		Сообщения = Новый Массив;
		Сообщения.Добавить(Новый Структура("Роль, Текст", "user", ДанныеЗадачи.ТекстЗадачи));
		ОтветМодели = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, ПараметрыВызова(Температура, МодельЭксперимента));

		Результат.Ответ = ОтветМодели.Текст;
		Результат.Рассуждение = ОтветМодели.Рассуждение;
		Результат.ТокеныЗапроса = ОтветМодели.ТокеныЗапроса;
		Результат.ТокеныОтвета = ОтветМодели.ТокеныОтвета;
		Результат.ТокеныВсего = ОтветМодели.ТокеныВсего;
		Результат.ВремяМиллисекунд = ОтветМодели.ВремяМиллисекунд;
	Исключение
		Результат.СообщениеОбОшибке = ОписаниеОшибки();
	КонецПопытки;

	Результат.ЭталонНайден = ЭталонНайден(ДанныеЗадачи.ЭталонныйОтвет, Результат.Ответ);
	Результат.Верно = Результат.ЭталонНайден;

	ЗаписатьРезультат(Результат, ДатаЗапуска);

	Возврат Результат;

КонецФункции

// Анализирует результаты одного прогона моделью-аналитиком и возвращает её выводы.
//
// Параметры:
//   ДатаЗапуска - Дата - дата запуска анализируемого прогона;
//   МодельАнализа - Строка - имя модели-аналитика; пустая строка - модель по умолчанию.
//
// Возвращаемое значение:
//   Строка - выводы модели-аналитика.
//
Функция Проанализировать(ДатаЗапуска, МодельАнализа) Экспорт

	РезультатыПрогона = РезультатыПрогона(ДатаЗапуска);
	Если РезультатыПрогона.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Нет результатов для анализа: выполните прогон.'");
	КонецЕсли;

	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("Роль, Текст", "system", ТекстИнструкцииАналитика()));
	Сообщения.Добавить(Новый Структура("Роль, Текст", "user", ТекстДанныхЭксперимента(РезультатыПрогона)));

	Параметры = ПараметрыВызова(-1, МодельАнализа);
	// Анализ — один вызов со всеми ответами прогона: рассуждение модели на большом
	// входе может идти минуты, поэтому таймаут повышен (секунды).
	Параметры.Таймаут = 600;

	ОтветМодели = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, Параметры);

	Возврат ОтветМодели.Текст;

КонецФункции

// Устанавливает отметку "Верно" в существующей записи регистра.
//
// Параметры:
//   Задача - СправочникСсылка.KimiЗадачиРассуждений, СправочникСсылка.KimiЗадачиГенерации;
//   Температура - Число - измерение регистра;
//   НомерПопытки - Число - номер попытки;
//   Верно - Булево - новое значение отметки.
//
Процедура УстановитьВерность(Задача, Температура, НомерПопытки, Верно) Экспорт

	МенеджерЗаписи = РегистрыСведений.РезультатыТемпературыKimi.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Задача = Задача;
	МенеджерЗаписи.Температура = КлючТемпературы(Температура);
	МенеджерЗаписи.НомерПопытки = НомерПопытки;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.Верно = Верно;
	МенеджерЗаписи.Записать();

КонецПроцедуры

// Удаляет все записи регистра результатов.
//
Процедура ОчиститьРезультаты() Экспорт

	НаборЗаписей = РегистрыСведений.РезультатыТемпературыKimi.СоздатьНаборЗаписей();
	НаборЗаписей.Записать();

КонецПроцедуры

// Возвращает общий список задач обоих типов для заполнения таблицы формы.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Задача - СправочникСсылка.KimiЗадачиРассуждений, СправочникСсылка.KimiЗадачиГенерации;
//     * Наименование - Строка;
//     * Тип - Строка - тип задачи (см. ТипЗадачиОдинОтвет/ТипЗадачиГенерация);
//     * ЭталонныйОтвет - Строка - пусто для задач на генерацию.
//
Функция СписокЗадач() Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Задача");
	Результат.Колонки.Добавить("Наименование");
	Результат.Колонки.Добавить("Тип");
	Результат.Колонки.Добавить("ЭталонныйОтвет");

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Задачи.Ссылка КАК Задача,
	|	Задачи.Наименование КАК Наименование,
	|	Задачи.ЭталонныйОтвет КАК ЭталонныйОтвет
	|ИЗ
	|	Справочник.KimiЗадачиРассуждений КАК Задачи
	|
	|УПОРЯДОЧИТЬ ПО
	|	Задачи.Код");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаСписка = Результат.Добавить();
		СтрокаСписка.Задача = Выборка.Задача;
		СтрокаСписка.Наименование = Выборка.Наименование;
		СтрокаСписка.Тип = ТипЗадачиОдинОтвет();
		СтрокаСписка.ЭталонныйОтвет = Выборка.ЭталонныйОтвет;
	КонецЦикла;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Задачи.Ссылка КАК Задача,
	|	Задачи.Наименование КАК Наименование
	|ИЗ
	|	Справочник.KimiЗадачиГенерации КАК Задачи
	|
	|УПОРЯДОЧИТЬ ПО
	|	Задачи.Код");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаСписка = Результат.Добавить();
		СтрокаСписка.Задача = Выборка.Задача;
		СтрокаСписка.Наименование = Выборка.Наименование;
		СтрокаСписка.Тип = ТипЗадачиГенерация();
		СтрокаСписка.ЭталонныйОтвет = "";
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Создаёт в справочниках задачи учебного набора, которых ещё нет
// (задачи с одним ответом и задачи на генерацию).
//
Процедура НаполнитьЗадачиПоУмолчанию() Экспорт

	KimiРассуждениеСервер.НаполнитьЗадачиПоУмолчанию();

	Для Каждого ОписаниеЗадачи Из ЗадачиГенерацииПоУмолчанию() Цикл

		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Задачи.Ссылка
		|ИЗ
		|	Справочник.KimiЗадачиГенерации КАК Задачи
		|ГДЕ
		|	Задачи.Наименование = &Наименование");
		Запрос.УстановитьПараметр("Наименование", ОписаниеЗадачи.Наименование);

		Если Не Запрос.Выполнить().Пустой() Тогда
			Продолжить;
		КонецЕсли;

		НоваяЗадача = Справочники.KimiЗадачиГенерации.СоздатьЭлемент();
		НоваяЗадача.Наименование = ОписаниеЗадачи.Наименование;
		НоваяЗадача.ТекстЗадачи = ОписаниеЗадачи.ТекстЗадачи;
		НоваяЗадача.Записать();

	КонецЦикла;

КонецПроцедуры

// Возвращает имя модели для классического прогона с регулируемой температурой:
// первую доступную ключу модель из списка устаревших кандидатов, где temperature
// ещё принимал произвольные значения. Пустая строка - кандидатов нет, прогон пойдёт
// на модели по умолчанию (temperature фиксирована платформой, попытки зафиксируют ошибки API).
//
// Параметры:
//   ДоступныеМодели - Массив из Строка - результат KimiAPIСервер.ДоступныеМодели().
//
// Возвращаемое значение:
//   Строка - имя модели; пустая строка - использовать модель по умолчанию.
//
Функция ВыбратьМодельЭксперимента(ДоступныеМодели) Экспорт

	Для Каждого ИмяКандидата Из МоделиСРегулируемойТемпературой() Цикл
		Если ДоступныеМодели.Найти(ИмяКандидата) <> Неопределено Тогда
			Возврат ИмяКандидата;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Возвращает список устаревших моделей с исторической поддержкой произвольной temperature
// (порядок - от предпочтительной). Источник: список моделей и параметров platform.kimi.ai.
//
// Возвращаемое значение:
//   Массив из Строка - имена моделей-кандидатов.
//
Функция МоделиСРегулируемойТемпературой() Экспорт

	Модели = Новый Массив;
	Модели.Добавить("kimi-k2-turbo-preview");
	Модели.Добавить("kimi-k2-0905-preview");
	Модели.Добавить("kimi-k2-0711-preview");
	Модели.Добавить("moonshot-v1-8k");
	Модели.Добавить("moonshot-v1-32k");
	Модели.Добавить("moonshot-v1-128k");

	Возврат Модели;

КонецФункции

// Возвращает имя модели-аналитика: топовую из доступных ключу моделей.
// Пустая строка - доступные модели не определены, будет использована модель по умолчанию.
//
// Параметры:
//   ДоступныеМодели - Массив из Строка - результат KimiAPIСервер.ДоступныеМодели().
//
// Возвращаемое значение:
//   Строка - имя модели; пустая строка - модель по умолчанию.
//
Функция ВыбратьМодельАнализа(ДоступныеМодели) Экспорт

	Предпочтения = Новый Массив;
	Предпочтения.Добавить("kimi-k3.1-pro");
	Предпочтения.Добавить("kimi-k3.1-pro-highspeed");
	Предпочтения.Добавить("kimi-k3");

	Для Каждого ИмяКандидата Из Предпочтения Цикл
		Если ДоступныеМодели.Найти(ИмяКандидата) <> Неопределено Тогда
			Возврат ИмяКандидата;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Возвращает наименование типа задач с одним правильным ответом.
//
Функция ТипЗадачиОдинОтвет() Экспорт

	Возврат НСтр("ru = 'Один ответ'");

КонецФункции

// Возвращает наименование типа задач на генерацию.
//
Функция ТипЗадачиГенерация() Экспорт

	Возврат НСтр("ru = 'Генерация'");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает реквизиты задачи независимо от типа справочника.
//
// Параметры:
//   Задача - СправочникСсылка.KimiЗадачиРассуждений, СправочникСсылка.KimiЗадачиГенерации.
//
// Возвращаемое значение:
//   Структура:
//     * Наименование - Строка;
//     * ТекстЗадачи - Строка;
//     * ЭталонныйОтвет - Строка - пусто для задач на генерацию;
//     * ТипЗадачи - Строка - см. ТипЗадачиОдинОтвет/ТипЗадачиГенерация.
//
Функция ДанныеЗадачи(Задача)

	ЭтоГенерация = ТипЗнч(Задача) = Тип("СправочникСсылка.KimiЗадачиГенерации");
	ИмяТаблицы = ?(ЭтоГенерация, "Справочник.KimiЗадачиГенерации", "Справочник.KimiЗадачиРассуждений");

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Задачи.Наименование КАК Наименование,
	|	Задачи.ТекстЗадачи КАК ТекстЗадачи
	|ИЗ
	|	" + ИмяТаблицы + " КАК Задачи
	|ГДЕ
	|	Задачи.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Задача);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Результат = Новый Структура;
	Результат.Вставить("Наименование", Выборка.Наименование);
	Результат.Вставить("ТекстЗадачи", Выборка.ТекстЗадачи);
	Результат.Вставить("ЭталонныйОтвет", "");
	Результат.Вставить("ТипЗадачи", ТипЗадачиГенерация());

	Если Не ЭтоГенерация Тогда
		Результат.ТипЗадачи = ТипЗадачиОдинОтвет();
		ЗапросЭталона = Новый Запрос(
		"ВЫБРАТЬ
		|	Задачи.ЭталонныйОтвет КАК ЭталонныйОтвет
		|ИЗ
		|	Справочник.KimiЗадачиРассуждений КАК Задачи
		|ГДЕ
		|	Задачи.Ссылка = &Ссылка");
		ЗапросЭталона.УстановитьПараметр("Ссылка", Задача);
		ВыборкаЭталона = ЗапросЭталона.Выполнить().Выбрать();
		Если ВыборкаЭталона.Следующий() Тогда
			Результат.ЭталонныйОтвет = ВыборкаЭталона.ЭталонныйОтвет;
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Формирует структуру результата с начальными значениями.
//
Функция НовыйРезультат(Задача, Температура, МодельЭксперимента, ТипЗадачи)

	Результат = Новый Структура;
	Результат.Вставить("Задача", Задача);
	Результат.Вставить("Температура", Температура);
	Результат.Вставить("Модель", МодельЭксперимента);
	Результат.Вставить("ТипЗадачи", ТипЗадачи);
	Результат.Вставить("НомерПопытки", 0);
	Результат.Вставить("Ответ", "");
	Результат.Вставить("Рассуждение", "");
	Результат.Вставить("ЭталонНайден", Ложь);
	Результат.Вставить("Верно", Ложь);
	Результат.Вставить("ТокеныЗапроса", 0);
	Результат.Вставить("ТокеныОтвета", 0);
	Результат.Вставить("ТокеныВсего", 0);
	Результат.Вставить("ВремяМиллисекунд", 0);
	Результат.Вставить("СообщениеОбОшибке", "");

	Возврат Результат;

КонецФункции

// Возвращает параметры HTTP-вызова для шага эксперимента.
//
Функция ПараметрыВызова(Температура, Модель)

	Параметры = Новый Структура;
	Параметры.Вставить("МаксимумТокенов", 0);
	Параметры.Вставить("СтопПоследовательность", "");
	Параметры.Вставить("ФорматОтвета", "text");
	Параметры.Вставить("СхемаОтвета", "");
	Параметры.Вставить("УсилиеРассуждения", "");
	Параметры.Вставить("Температура", Температура);
	Параметры.Вставить("Модель", Модель);
	Параметры.Вставить("Таймаут", 0);

	Возврат Параметры;

КонецФункции

// Проверяет, встречается ли эталонный ответ в тексте ответа модели (регистронезависимо).
//
Функция ЭталонНайден(ЭталонныйОтвет, ОтветМодели)

	Если Не ЗначениеЗаполнено(ЭталонныйОтвет) Или Не ЗначениеЗаполнено(ОтветМодели) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНайти(НРег(ОтветМодели), НРег(СокрЛП(ЭталонныйОтвет))) > 0;

КонецФункции

// Возвращает следующий номер попытки для ячейки "задача × температура".
//
Функция СледующаяПопытка(Задача, Температура)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(Результаты.НомерПопытки), 0) КАК ПоследняяПопытка
	|ИЗ
	|	РегистрСведений.РезультатыТемпературыKimi КАК Результаты
	|ГДЕ
	|	Результаты.Задача = &Задача
	|	И Результаты.Температура = &Температура");
	Запрос.УстановитьПараметр("Задача", Задача);
	Запрос.УстановитьПараметр("Температура", КлючТемпературы(Температура));

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.ПоследняяПопытка + 1;

КонецФункции

// Преобразует числовое значение температуры в ключ измерения регистра.
// Числовым измерением пользоваться нельзя: платформа считает 0 пустым значением
// и отклоняет запись, поэтому ключ - строка.
//
// Параметры:
//   Температура - Число - значение параметра temperature; отрицательное - параметр не передавался.
//
// Возвращаемое значение:
//   Строка - "0", "0,7", "1,2" и т.п.; "не задана" для контрольного прогона.
//
Функция КлючТемпературы(Температура)

	Если Температура < 0 Тогда
		Возврат "не задана";
	КонецЕсли;

	Возврат Строка(Температура);

КонецФункции

// Записывает результат попытки в регистр сведений.
//
Процедура ЗаписатьРезультат(Результат, ДатаЗапуска)

	НаборЗаписей = РегистрыСведений.РезультатыТемпературыKimi.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Задача.Установить(Результат.Задача);
	НаборЗаписей.Отбор.Температура.Установить(КлючТемпературы(Результат.Температура));
	НаборЗаписей.Отбор.НомерПопытки.Установить(Результат.НомерПопытки);

	Запись = НаборЗаписей.Добавить();
	Запись.Задача = Результат.Задача;
	Запись.Температура = КлючТемпературы(Результат.Температура);
	Запись.НомерПопытки = Результат.НомерПопытки;
	Запись.ДатаЗапуска = ДатаЗапуска;
	Запись.Модель = Результат.Модель;
	Запись.Ответ = Результат.Ответ;
	Запись.Рассуждение = Результат.Рассуждение;
	Запись.Верно = Результат.Верно;
	Запись.ЭталонНайден = Результат.ЭталонНайден;
	Запись.ТокеныЗапроса = Результат.ТокеныЗапроса;
	Запись.ТокеныОтвета = Результат.ТокеныОтвета;
	Запись.ТокеныВсего = Результат.ТокеныВсего;
	Запись.ВремяМиллисекунд = Результат.ВремяМиллисекунд;
	Запись.СообщениеОбОшибке = Результат.СообщениеОбОшибке;

	НаборЗаписей.Записать();

КонецПроцедуры

// Возвращает результаты прогона по дате запуска.
//
Функция РезультатыПрогона(ДатаЗапуска)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Результаты.Задача КАК Задача,
	|	Результаты.Температура КАК Температура,
	|	Результаты.НомерПопытки КАК НомерПопытки,
	|	Результаты.Ответ КАК Ответ,
	|	Результаты.ЭталонНайден КАК ЭталонНайден,
	|	Результаты.Верно КАК Верно,
	|	Результаты.Модель КАК Модель,
	|	Результаты.СообщениеОбОшибке КАК СообщениеОбОшибке
	|ИЗ
	|	РегистрСведений.РезультатыТемпературыKimi КАК Результаты
	|ГДЕ
	|	Результаты.ДатаЗапуска = &ДатаЗапуска
	|
	|УПОРЯДОЧИТЬ ПО
	|	Результаты.Задача,
	|	Результаты.Температура,
	|	Результаты.НомерПопытки");
	Запрос.УстановитьПараметр("ДатаЗапуска", ДатаЗапуска);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Формирует текст данных эксперимента для модели-аналитика.
//
Функция ТекстДанныхЭксперимента(РезультатыПрогона)

	Части = Новый Массив;
	Части.Добавить(НСтр("ru = 'Эксперимент: влияние параметра temperature на ответы модели Kimi.'"));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Всего попыток в выборке: %1'"), РезультатыПрогона.Количество()));

	ТекущаяЗадача = Неопределено;
	ТекущаяТемпература = Неопределено;

	Для Каждого ЗаписьПрогона Из РезультатыПрогона Цикл

		Если ТекущаяЗадача <> ЗаписьПрогона.Задача Тогда
			ТекущаяЗадача = ЗаписьПрогона.Задача;
			ТекущаяТемпература = Неопределено;
			ДанныеЗадачи = ДанныеЗадачи(ТекущаяЗадача);
			Части.Добавить("");
			Части.Добавить(СтрШаблон(НСтр("ru = '=== Задача: %1 (тип: %2)'"),
				ДанныеЗадачи.Наименование, ДанныеЗадачи.ТипЗадачи));
			Части.Добавить(СтрШаблон(НСтр("ru = 'Текст задачи: %1'"), ДанныеЗадачи.ТекстЗадачи));
			Если ЗначениеЗаполнено(ДанныеЗадачи.ЭталонныйОтвет) Тогда
				Части.Добавить(СтрШаблон(НСтр("ru = 'Эталонный ответ: %1'"), ДанныеЗадачи.ЭталонныйОтвет));
			КонецЕсли;
		КонецЕсли;

		Если ТекущаяТемпература <> ЗаписьПрогона.Температура Тогда
			ТекущаяТемпература = ЗаписьПрогона.Температура;
			ТекстТемпературы = ТекущаяТемпература;
			Если ТекстТемпературы = КлючТемпературы(-1) Тогда
				ТекстТемпературы = НСтр("ru = 'не задана (умолчание платформы)'");
			КонецЕсли;
			Части.Добавить(СтрШаблон(НСтр("ru = '--- Температура: %1'"), ТекстТемпературы));
		КонецЕсли;

		Части.Добавить(СтрШаблон(НСтр("ru = 'Попытка %1 (модель: %2; отмечено «Верно»: %3; эталон найден автоматически: %4)'"),
			ЗаписьПрогона.НомерПопытки,
			?(ЗначениеЗаполнено(ЗаписьПрогона.Модель), ЗаписьПрогона.Модель, НСтр("ru = 'по умолчанию'")),
			?(ЗаписьПрогона.Верно, НСтр("ru = 'да'"), НСтр("ru = 'нет'")),
			?(ЗаписьПрогона.ЭталонНайден, НСтр("ru = 'да'"), НСтр("ru = 'нет'"))));

		Если ЗначениеЗаполнено(ЗаписьПрогона.СообщениеОбОшибке) Тогда
			Части.Добавить(СтрШаблон(НСтр("ru = 'Ошибка API: %1'"), ЗаписьПрогона.СообщениеОбОшибке));
		Иначе
			Части.Добавить(СтрШаблон(НСтр("ru = 'Ответ: %1'"), Лев(ЗаписьПрогона.Ответ, 10000)));
		КонецЕсли;

	КонецЦикла;

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// Возвращает инструкцию модели-аналитика: какие выводы требуются и контекст платформы.
//
Функция ТекстИнструкцииАналитика()

	Возврат НСтр("ru = 'Ты — аналитик учебного эксперимента с языковой моделью Kimi. Ниже — результаты прогонов: для каждой задачи выполнено несколько попыток с разной температурой (или без неё). Сформулируй выводы по пунктам:
	|1. Разнообразие ответов: насколько ответы отличаются между прогонами внутри каждой ячейки ""задача × температура"" (сколько уникальных ответов, сильно ли различаются формулировки).
	|2. Задачи с одним правильным ответом: сколько ответов верно (сверь эталон и отметки), зависит ли точность от температуры.
	|3. Задачи на генерацию: где разнообразие ответов полезно, а где вредит пригодности результата.
	|4. Рекомендация: для каких типов задач какая температура (0 / 0.7 / 1.2 / умолчание платформы) подходит лучше всего.
	|5. Повторяемость: даёт ли temperature = 0 одинаковый ответ каждый раз — по имеющимся данным; если попыток с ней нет или все они завершились ошибкой, прямо скажи об этом.
	|
	|Контекст платформы: у моделей Kimi K3/K3.1 параметр temperature фиксирован платформой (1.0), запрос с другим значением возвращает ошибку; устаревшие модели могли ограничивать диапазон допустимых значений (например, до 1.0). Если попытки завершились ошибками API — не выдумывай ответы, сделай вывод на основе успешных (контрольных) прогонов и объясни ограничение.
	|
	|Пиши по-русски, структурируй ответ подзаголовками по пяти пунктам, будь краток и опирайся только на переданные данные.'");

КонецФункции

// Возвращает учебный набор задач на генерацию.
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Наименование - Строка;
//     * ТекстЗадачи - Строка.
//
Функция ЗадачиГенерацииПоУмолчанию()

	СписокЗадач = Новый Массив;

	Задача = Новый Структура("Наименование, ТекстЗадачи");
	Задача.Наименование = НСтр("ru = 'Названия для кофейни'");
	Задача.ТекстЗадачи = НСтр("ru = 'Придумай 5 вариантов названия для кофейни у моря в небольшом туристическом городке. Выведи только список названий, каждое с новой строки.'");
	СписокЗадач.Добавить(Задача);

	Задача = Новый Структура("Наименование, ТекстЗадачи");
	Задача.Наименование = НСтр("ru = 'Слоган для йогурта'");
	Задача.ТекстЗадачи = НСтр("ru = 'Напиши один короткий рекламный слоган (не больше 10 слов) для натурального йогурта «Лесная поляна».'");
	СписокЗадач.Добавить(Задача);

	Задача = Новый Структура("Наименование, ТекстЗадачи");
	Задача.Наименование = НСтр("ru = 'Описание товара'");
	Задача.ТекстЗадачи = НСтр("ru = 'Напиши описание умной кружки, которая поддерживает заданную температуру напитка, — 2–3 предложения для карточки товара в интернет-магазине.'");
	СписокЗадач.Добавить(Задача);

	Возврат СписокЗадач;

КонецФункции

#КонецОбласти
