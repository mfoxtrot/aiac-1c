#Область ПрограммныйИнтерфейс

// Возвращает последний незавершённый диалог агента (ДатаЗавершения пустая).
// Именно его форма агента автоматически продолжает при открытии — сценарий
// "перезапустили приложение и продолжили общение" (задание Дня 7).
//
// Возвращаемое значение:
//   ДокументСсылка.KimiДиалог, Неопределено - активный диалог; Неопределено, если таких нет.
//
Функция АктивныйДиалог() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Диалог.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.KimiДиалог КАК Диалог
	|ГДЕ
	|	НЕ Диалог.ПометкаУдаления
	|	И Диалог.ДатаЗавершения = &ПустаяДата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Диалог.Дата УБЫВ";
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает список диалогов для ленты чатов формы агента, новые первыми.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Ссылка - ДокументСсылка.KimiДиалог - диалог;
//     * Наименование - Строка - заголовок диалога (может быть пустым);
//     * Дата - Дата - дата начала диалога (стандартный реквизит документа);
//     * ДатаЗавершения - Дата - момент завершения; пустая дата — диалог активен;
//     * Ид - Строка - XML-строка ссылки (для псевдо-ссылок ленты чатов; XMLСтрока
//       со ссылками доступна только на сервере).
//
Функция СписокДиалогов() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Диалог.Ссылка КАК Ссылка,
	|	Диалог.Наименование КАК Наименование,
	|	Диалог.Дата КАК Дата,
	|	Диалог.ДатаЗавершения КАК ДатаЗавершения
	|ИЗ
	|	Документ.KimiДиалог КАК Диалог
	|ГДЕ
	|	НЕ Диалог.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Диалог.Дата УБЫВ";

	Диалоги = Запрос.Выполнить().Выгрузить();
	Диалоги.Колонки.Добавить("Ид", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	Для Каждого СтрокаДиалога Из Диалоги Цикл
		СтрокаДиалога.Ид = XMLСтрока(СтрокаДиалога.Ссылка);
	КонецЦикла;

	Возврат Диалоги;

КонецФункции

// Загружает сохранённый диалог: заголовок и полную историю сообщений
// (включая вызовы инструментов и их результаты) для передачи в API,
// а также состояние управления контекстом: стратегию, сводку и границу сжатой
// зоны (День 9) и блок фактов (День 10).
//
// Параметры:
//   Ссылка - ДокументСсылка.KimiДиалог - загружаемый диалог.
//
// Возвращаемое значение:
//   Структура:
//     * Наименование - Строка - заголовок диалога;
//     * ТокеныИтого - Число - сумма токенов по сообщениям (вес истории, реквизит шапки);
//     * СтратегияКонтекста - Строка - идентификатор стратегии (пусто — диалог Дней 7–9,
//       ведёт себя как «Полный»; см. KimiКонтекстСервер.Стратегии);
//     * Сводка - Строка - сводка сжатой части истории (пусто — диалог не сжимался);
//     * СжатоДо - Число - сколько первых сообщений заменены сводкой (0 — не сжимался);
//     * ХвостСообщений - Число - размер не-сжатого хвоста, установленный для диалога;
//     * Факты - ТаблицаЗначений - блок фактов ключ-значение (пусто — не накапливался);
//     * РабочаяПамять - ТаблицаЗначений - заметки текущей задачи, ключ-значение
//       (рабочая память, День 11; пусто — не накапливалась);
//     * Профиль - СправочникСсылка.KimiПрофилиПользователей - профиль персонализации
//       чата (День 12; пустая ссылка — диалог без профиля);
//     * СостояниеЗадачи - Структура - состояние задачи как конечный автомат (День 13):
//       Этап (пусто — контроль состояния не включался), Шаг, ОжидаемоеДействие.
//     * История - ТаблицаЗначений - сообщения в порядке табличной части:
//       ** Роль - Строка - "user" / "assistant" / "tool";
//       ** Текст - Строка - текст сообщения;
//       ** Отправлено - Дата - момент сообщения;
//       ** ВызовыИнструментов - Строка - JSON-массив tool_calls (у assistant);
//       ** ИдВызова - Строка - tool_call_id (у tool);
//       ** Токены - Число - токены сообщения (факт completion у assistant, оценка — у прочих).
//
Функция ЗагрузитьДиалог(Ссылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Сообщения.Роль КАК Роль,
	|	Сообщения.Текст КАК Текст,
	|	Сообщения.Отправлено КАК Отправлено,
	|	Сообщения.ВызовыИнструментов КАК ВызовыИнструментов,
	|	Сообщения.ИдВызова КАК ИдВызова,
	|	Сообщения.Токены КАК Токены
	|ИЗ
	|	Документ.KimiДиалог.Сообщения КАК Сообщения
	|ГДЕ
	|	Сообщения.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сообщения.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Результат = Новый Структура;
	Результат.Вставить("Наименование", Ссылка.Наименование);
	Результат.Вставить("ТокеныИтого", Ссылка.ТокеныИтого);
	Результат.Вставить("СтратегияКонтекста", Ссылка.СтратегияКонтекста);
	Результат.Вставить("Сводка", Ссылка.Сводка);
	Результат.Вставить("СжатоДо", Ссылка.СжатоДо);
	Результат.Вставить("ХвостСообщений", Ссылка.ХвостСообщений);
	Результат.Вставить("Факты", Ссылка.Факты.Выгрузить());
	Результат.Вставить("РабочаяПамять", Ссылка.РабочаяПамять.Выгрузить());
	Результат.Вставить("Профиль", Ссылка.Профиль);
	Результат.Вставить("СостояниеЗадачи", Новый Структура("Этап, Шаг, ОжидаемоеДействие",
		Ссылка.ЭтапЗадачи, Ссылка.ШагЗадачи, Ссылка.ОжидаемоеДействиеЗадачи));
	Результат.Вставить("История", Запрос.Выполнить().Выгрузить());

	Возврат Результат;

КонецФункции

// Сохраняет диалог целиком: перезаписывает табличную часть сообщений историей формы
// (идемпотентно — можно вызывать после каждого обмена). Документ создаётся лениво —
// при первом сохранённом сообщении, чтобы не плодить пустые диалоги. Заголовок диалога
// формируется один раз — лёгкой моделью по первым сообщениям, при недоступности —
// обрезком первого вопроса. Токены сообщений (День 8): у ассистента приходит факт
// completion из результата агента, у строк без токенов (вопросы, инструменты) считается
// локальная оценка текста; реквизит шапки ТокеныИтого пересчитывается суммой по ТЧ.
// Управление контекстом (Дни 9–10): в документ пишутся стратегия, сводка, граница
// сжатой зоны и блок фактов; поддержка стратегии выполняется внутри сохранения
// (форма делает один серверный вызов):
//   — «Сводка»: не-сжатая зона длиннее хвоста + блок → старейший блок переносится
//     в сводку вызовом модели (автосжатие Дня 9);
//   — «Факты»: после записи блок фактов обновляется вызовом модели-экстрактора
//     по последнему обмену (user-сообщение + ответ агента);
//   — «Окно» и «Полный»: поддержка не требуется (0 вызовов модели).
// Рабочая память (День 11) не требует вызовов модели: заметки текущей задачи
// (ключ "РабочаяПамять" параметра) пишутся в табличную часть документа как есть.
// Состояние задачи (День 13) тоже пишется без вызовов модели: реквизиты
// ЭтапЗадачи/ШагЗадачи/ОжидаемоеДействиеЗадачи — из ключа "СостояниеЗадачи" параметра.
// Ошибка поддержки не отменяет сохранение: диалог пишется в прежнем состоянии,
// причина возвращается для показа пользователю.
//
// Параметры:
//   Ссылка - ДокументСсылка.KimiДиалог - сохраняемый диалог; пустая ссылка — создать новый;
//   ИсторияДиалога - ТаблицаЗначений - см. возвращаемое значение ЗагрузитьДиалог;
//   ПараметрыКонтекста - Структура, Неопределено - управление контекстом (Дни 9–11):
//     * Стратегия - Строка - идентификатор стратегии (см. KimiКонтекстСервер.Стратегии);
//     * Хвост - Число - размер не-сжатого хвоста (пишется в реквизит документа);
//     * Блок - Число - размер блока сжатия (стратегия «Сводка»);
//     * Сводка - Строка - текущая сводка диалога (пишется в реквизит документа);
//     * СжатоДо - Число - текущая граница сжатой зоны;
//     * Факты - ТаблицаЗначений - текущий блок фактов ключ-значение;
//     * РабочаяПамять - ТаблицаЗначений, Неопределено - заметки текущей задачи
//       (День 11; ключ отсутствует или Неопределено — табличная часть не меняется);
//     * Профиль - СправочникСсылка.KimiПрофилиПользователей, Неопределено - профиль
//       персонализации чата (День 12; читается через Свойство — прочие дни не тронуты);
//     * СостояниеЗадачи - Структура, Неопределено - состояние задачи (День 13;
//       см. KimiСостояниеЗадачиСервер.НачальноеСостояние; ключ отсутствует или
//       Неопределено — реквизиты состояния документа не меняются).
//
// Возвращаемое значение:
//   Структура:
//     * Диалог - ДокументСсылка.KimiДиалог - сохранённый (или созданный) диалог;
//     * Сводка - Строка - сводка после сохранения;
//     * СжатоДо - Число - граница сжатой зоны после сохранения;
//     * СжатиеПрименено - Булево - Истина, если этим сохранением блок перенесён в сводку;
//     * ИнфоСжатие - Структура, Неопределено - метрики вызова сводки:
//       ** СжатоСообщений - Число - сколько сообщений перенесено в сводку;
//       ** ТокеныЗапроса - Число - prompt_tokens вызова сводки;
//       ** ТокеныОтвета - Число - completion_tokens вызова сводки;
//       ** Стоимость - Число - расчётная стоимость вызова сводки, USD;
//       ** ВремяМиллисекунд - Число - длительность вызова;
//     * ОшибкаСжатия - Строка - пусто, если сжатие не требовалось или выполнено успешно;
//     * Факты - ТаблицаЗначений - блок фактов после сохранения (обновлённый, если
//       обновление выполнено; прежний — если не потребовалось или была ошибка).
//       Внимание: таблица не сериализуется для передачи на клиент — при вызове
//       из формы из возвращаемой структуры её удаляют после переноса в реквизит;
//       на клиент передаётся счётчик (см. ЧислоФактов);
//     * ЧислоФактов - Число - размер блока фактов после сохранения;
//     * ФактыОбновлены - Булево - Истина, если этим сохранением блок фактов обновлён
//       вызовом модели;
//     * ИнфоФакты - Структура, Неопределено - метрики вызова экстрактора:
//       ** ТокеныЗапроса - Число - prompt_tokens вызова экстрактора;
//       ** ТокеныОтвета - Число - completion_tokens вызова экстрактора;
//       ** Стоимость - Число - расчётная стоимость вызова экстрактора, USD;
//       ** ВремяМиллисекунд - Число - длительность вызова;
//     * ОшибкаФактов - Строка - пусто, если обновление фактов не требовалось или успешно.
//
Функция СохранитьДиалог(Ссылка, ИсторияДиалога, ПараметрыКонтекста = Неопределено) Экспорт

	Если ЗначениеЗаполнено(Ссылка) Тогда
		ДокументОбъект = Ссылка.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.KimiДиалог.СоздатьДокумент();
		// Платформа не заполняет Дату программно созданного документа —
		// для непроводимого документа без неё запись отклоняется.
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;

	// Продолжили завершённый диалог (кликнули его карточку в ленте) — он снова активен.
	Если ЗначениеЗаполнено(ДокументОбъект.ДатаЗавершения) Тогда
		ДокументОбъект.ДатаЗавершения = '00010101';
	КонецЕсли;

	ДокументОбъект.Сообщения.Очистить();
	ТокеныИтого = 0;
	Для Каждого СтрокаИстории Из ИсторияДиалога Цикл
		НоваяСтрока = ДокументОбъект.Сообщения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИстории);

		Если НоваяСтрока.Токены = 0 Тогда
			// Вопросы и результаты инструментов: API отдаёт входные токены только суммарно
			// по запросу — точная атрибуция невозможна, оцениваем текст локально.
			НоваяСтрока.Токены = KimiТокеныСервер.ОценитьТокеныТекста(НоваяСтрока.Текст);
		КонецЕсли;
		ТокеныИтого = ТокеныИтого + НоваяСтрока.Токены;
	КонецЦикла;
	ДокументОбъект.ТокеныИтого = ТокеныИтого;

	Результат = Новый Структура;
	Результат.Вставить("СжатиеПрименено", Ложь);
	Результат.Вставить("ИнфоСжатие", Неопределено);
	Результат.Вставить("ОшибкаСжатия", "");
	Результат.Вставить("ФактыОбновлены", Ложь);
	Результат.Вставить("ИнфоФакты", Неопределено);
	Результат.Вставить("ОшибкаФактов", "");

	Если ПараметрыКонтекста <> Неопределено Тогда
		Стратегия = KimiКонтекстСервер.НормализоватьСтратегию(ПараметрыКонтекста.Стратегия);

		ДокументОбъект.СтратегияКонтекста = Стратегия;
		ДокументОбъект.Сводка = ПараметрыКонтекста.Сводка;
		ДокументОбъект.СжатоДо = ПараметрыКонтекста.СжатоДо;
		ДокументОбъект.ХвостСообщений = ПараметрыКонтекста.Хвост;

		ДокументОбъект.Факты.Очистить();
		Если ПараметрыКонтекста.Факты <> Неопределено Тогда
			Для Каждого СтрокаФакта Из ПараметрыКонтекста.Факты Цикл
				НоваяСтрока = ДокументОбъект.Факты.Добавить();
				НоваяСтрока.Ключ = СтрокаФакта.Ключ;
				НоваяСтрока.Значение = СтрокаФакта.Значение;
			КонецЦикла;
		КонецЕсли;

		// Рабочая память (День 11): заметки текущей задачи — как есть, без вызовов модели.
		РабочаяПамять = Неопределено;
		Если ПараметрыКонтекста.Свойство("РабочаяПамять", РабочаяПамять) И РабочаяПамять <> Неопределено Тогда
			ДокументОбъект.РабочаяПамять.Очистить();
			Для Каждого Заметка Из РабочаяПамять Цикл
				НоваяСтрока = ДокументОбъект.РабочаяПамять.Добавить();
				НоваяСтрока.Ключ = Заметка.Ключ;
				НоваяСтрока.Значение = Заметка.Значение;
			КонецЦикла;
		КонецЕсли;

		// Профиль персонализации чата (День 12): пишется из параметра при каждом
		// сохранении — смена профиля в середине чата переключает его для этого диалога.
		ПрофильЧата = Неопределено;
		Если ПараметрыКонтекста.Свойство("Профиль", ПрофильЧата) И ПрофильЧата <> Неопределено Тогда
			ДокументОбъект.Профиль = ПрофильЧата;
		КонецЕсли;

		// Состояние задачи (День 13): пишется из параметра при каждом сохранении —
		// переходы фиксируются в документе вместе с историей, и пауза/перезапуск
		// восстанавливают состояние вместе с чатом (продолжение без повторных объяснений).
		СостояниеЗадачи = Неопределено;
		Если ПараметрыКонтекста.Свойство("СостояниеЗадачи", СостояниеЗадачи)
			И СостояниеЗадачи <> Неопределено Тогда
			ДокументОбъект.ЭтапЗадачи = СостояниеЗадачи.Этап;
			ДокументОбъект.ШагЗадачи = СостояниеЗадачи.Шаг;
			ДокументОбъект.ОжидаемоеДействиеЗадачи = СостояниеЗадачи.ОжидаемоеДействие;
		КонецЕсли;

		Если Стратегия = KimiКонтекстСервер.СтратегияСводка() Тогда
			СжатьДоПорога(ДокументОбъект, ИсторияДиалога, ПараметрыКонтекста.Блок, Результат, ЛегкаяМодельВключена(ПараметрыКонтекста));
		ИначеЕсли Стратегия = KimiКонтекстСервер.СтратегияФакты() Тогда
			ОбновитьФактыДиалога(ДокументОбъект, ИсторияДиалога, Результат, ЛегкаяМодельВключена(ПараметрыКонтекста));
		КонецЕсли;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДокументОбъект.Наименование) И ДокументОбъект.Сообщения.Количество() > 0 Тогда
		ДокументОбъект.Наименование = СформироватьЗаголовок(ДокументОбъект);
	КонецЕсли;

	ДокументОбъект.Записать();

	Результат.Вставить("Диалог", ДокументОбъект.Ссылка);
	Результат.Вставить("Сводка", ДокументОбъект.Сводка);
	Результат.Вставить("СжатоДо", ДокументОбъект.СжатоДо);
	Результат.Вставить("Факты", ДокументОбъект.Факты.Выгрузить());
	Результат.Вставить("ЧислоФактов", ДокументОбъект.Факты.Количество());

	Возврат Результат;

КонецФункции

// Принудительно сжимает историю диалога до заданного хвоста (кнопка «Сжать сейчас»):
// переносит в сводку все блоки, пока не-сжатая зона не уместится в хвост.
// Сжатие работает вне зависимости от флажка автосжатия — кнопка для ручной демонстрации.
//
// Параметры:
//   Ссылка - ДокументСсылка.KimiДиалог - сжимаемый диалог;
//   ИсторияДиалога - ТаблицаЗначений - актуальная история (табличная часть перезаписывается ею же);
//   Хвост - Число - желаемый размер не-сжатого хвоста;
//   Блок - Число - размер блока сжатия;
//   ЛегкаяМодель - Булево - режим Google-only (День 11): сводка на лёгкой модели
//     Google AI Studio без обращений к Kimi (умолчание Ложь).
//
// Возвращаемое значение:
//   Структура - как у СохранитьДиалог (сводка, сжатие и факты): фактовый механизм
//   не задействован — ФактыОбновлены = Ложь, ЧислоФактов — текущий размер блока.
//
Функция СжатьДиалог(Ссылка, ИсторияДиалога, Хвост, Блок, ЛегкаяМодель = Ложь) Экспорт

	ДокументОбъект = Ссылка.ПолучитьОбъект();

	Результат = Новый Структура;
	Результат.Вставить("СжатиеПрименено", Ложь);
	Результат.Вставить("ИнфоСжатие", Неопределено);
	Результат.Вставить("ОшибкаСжатия", "");
	Результат.Вставить("ФактыОбновлены", Ложь);
	Результат.Вставить("ИнфоФакты", Неопределено);
	Результат.Вставить("ОшибкаФактов", "");
	Результат.Вставить("ЧислоФактов", ДокументОбъект.Факты.Количество());

	СжатьДоУпора(ДокументОбъект, ИсторияДиалога, Хвост, Блок, Результат, ЛегкаяМодель);

	ДокументОбъект.Записать();

	Результат.Вставить("Диалог", ДокументОбъект.Ссылка);
	Результат.Вставить("Сводка", ДокументОбъект.Сводка);
	Результат.Вставить("СжатоДо", ДокументОбъект.СжатоДо);

	Возврат Результат;

КонецФункции

// Создаёт ветку диалога (ветвление, День 10): новый документ — точная копия
// сохранённого состояния исходника на момент вызова (checkpoint): история сообщений,
// стратегия контекста, сводка и граница сжатой зоны, блок фактов, рабочая память
// (День 11), профиль персонализации (День 12), состояние задачи (День 13), вес истории.
// Исходный диалог не изменяется — он и есть соседняя ветка. Две ветки от одного
// места — два вызова подряд (до продолжения диалога). Ветка видна в ленте чатов
// как самостоятельный диалог (заголовок с маркером «· ветка»); происхождение
// фиксирует реквизит «Ветка от». Ветка создаётся активной (ДатаЗавершения пустая)
// и продолжается независимо от исходника, со своей стратегией.
// Вызывающая сторона обязана сохранить текущий чат перед ветвлением —
// checkpoint фиксирует именно последнее сохранённое состояние документа.
//
// Параметры:
//   Исходник - ДокументСсылка.KimiДиалог - диалог, от которого создаётся ветка.
//
// Возвращаемое значение:
//   ДокументСсылка.KimiДиалог - созданная ветка.
//
Функция СоздатьВетку(Исходник) Экспорт

	ИсходныйОбъект = Исходник.ПолучитьОбъект();

	Ветка = Документы.KimiДиалог.СоздатьДокумент();
	Ветка.Дата = ТекущаяДатаСеанса();
	Ветка.Наименование = Лев(СокрЛП(ИсходныйОбъект.Наименование) + " " + НСтр("ru = '· ветка'"), 100);
	Ветка.ВеткаОт = Исходник;
	Ветка.СтратегияКонтекста = ИсходныйОбъект.СтратегияКонтекста;
	Ветка.ХвостСообщений = ИсходныйОбъект.ХвостСообщений;
	Ветка.Сводка = ИсходныйОбъект.Сводка;
	Ветка.СжатоДо = ИсходныйОбъект.СжатоДо;
	Ветка.ТокеныИтого = ИсходныйОбъект.ТокеныИтого;
	Ветка.Профиль = ИсходныйОбъект.Профиль; // персонализация наследуется веткой (День 12)
	// Состояние задачи наследуется веткой (День 13): ветка продолжает жизненный
	// цикл с этапа checkpoint'а исходника.
	Ветка.ЭтапЗадачи = ИсходныйОбъект.ЭтапЗадачи;
	Ветка.ШагЗадачи = ИсходныйОбъект.ШагЗадачи;
	Ветка.ОжидаемоеДействиеЗадачи = ИсходныйОбъект.ОжидаемоеДействиеЗадачи;

	Для Каждого СтрокаСообщения Из ИсходныйОбъект.Сообщения Цикл
		НоваяСтрока = Ветка.Сообщения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСообщения);
	КонецЦикла;
	Для Каждого СтрокаФакта Из ИсходныйОбъект.Факты Цикл
		НоваяСтрока = Ветка.Факты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаФакта);
	КонецЦикла;
	Для Каждого Заметка Из ИсходныйОбъект.РабочаяПамять Цикл
		НоваяСтрока = Ветка.РабочаяПамять.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Заметка);
	КонецЦикла;

	Ветка.Записать();

	Возврат Ветка.Ссылка;

КонецФункции

// Завершает диалог: проставляет дату завершения (вызывается при создании нового чата).
// Если заголовок так и не сформировался — подставляет заголовок-заглушку по первому вопросу.
//
// Параметры:
//   Ссылка - ДокументСсылка.KimiДиалог - завершаемый диалог.
//
Процедура ЗавершитьДиалог(Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	Если ДокументОбъект = Неопределено Или ЗначениеЗаполнено(ДокументОбъект.ДатаЗавершения) Тогда
		Возврат;
	КонецЕсли;

	ДокументОбъект.ДатаЗавершения = ТекущаяДатаСеанса();
	Если Не ЗначениеЗаполнено(ДокументОбъект.Наименование) Тогда
		ДокументОбъект.Наименование = СформироватьЗаголовок(ДокументОбъект);
	КонецЕсли;
	ДокументОбъект.Записать();

КонецПроцедуры

// «Удаляет» диалог: устанавливает пометку удаления (физическое удаление не требуется).
// Помеченные диалоги не попадают ни в ленту чатов, ни в автопродолжение при открытии формы.
//
// Параметры:
//   Ссылка - ДокументСсылка.KimiДиалог - удаляемый диалог.
//
Процедура УдалитьДиалог(Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	Если ДокументОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДокументОбъект.УстановитьПометкуУдаления(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает признак режима Google-only из параметров контекста сохранения
// (День 11, доработка при приёмке): приёмка дня без единого обращения к Kimi —
// сводка и экстрактор фактов идут на лёгкую модель Google AI Studio.
//
Функция ЛегкаяМодельВключена(ПараметрыКонтекста)

	ЛегкаяМодель = Ложь;
	Если ПараметрыКонтекста <> Неопределено Тогда
		ПараметрыКонтекста.Свойство("ТолькоЛегкаяМодель", ЛегкаяМодель);
	КонецЕсли;

	Возврат ЛегкаяМодель = Истина;

КонецФункции

// Переносит в сводку один блок (в пределах порога хвоста + блок) — автосжатие при сохранении.
//
Процедура СжатьДоПорога(ДокументОбъект, ИсторияДиалога, Блок, Результат, ЛегкаяМодель)

	Сжимаемых = KimiКонтекстСервер.ТребуетсяСжатие(ИсторияДиалога, ДокументОбъект.СжатоДо,
		ДокументОбъект.ХвостСообщений, Блок);
	Если Сжимаемых > 0 Тогда
		ПрименитьСжатие(ДокументОбъект, ИсторияДиалога, Сжимаемых, Результат, ЛегкаяМодель);
	КонецЕсли;

КонецПроцедуры

// Переносит в сводку блоки до тех пор, пока не-сжатая зона не уместится в хвост
// (не более ста итераций — страховка от зацикливания при неожиданной структуре истории).
//
Процедура СжатьДоУпора(ДокументОбъект, ИсторияДиалога, Хвост, Блок, Результат, ЛегкаяМодель)

	ДокументОбъект.ХвостСообщений = Хвост;

	Для Счётчик = 1 По 100 Цикл
		Сжимаемых = KimiКонтекстСервер.ТребуетсяСжатие(ИсторияДиалога, ДокументОбъект.СжатоДо, Хвост, Блок);
		Если Сжимаемых = 0 Тогда
			Прервать;
		КонецЕсли;

		БылоСжато = ДокументОбъект.СжатоДо;
		ПрименитьСжатие(ДокументОбъект, ИсторияДиалога, Сжимаемых, Результат, ЛегкаяМодель);
		Если ДокументОбъект.СжатоДо = БылоСжато Тогда
			// Сжатие не продвинулось (ошибка вызова или пустая сводка) — дальше бессмысленно.
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Вызывает модель-сжиматель и фиксирует результат в реквизитах документа.
// Ошибка вызова не прерывает сохранение: диалог остаётся в прежнем состоянии сжатия,
// причина возвращается в Результат.ОшибкаСжатия. ЛегкаяМодель (режим Google-only Дня 11)
// переводит вызов на лёгкую модель Google AI Studio — приёмка дня без обращений к Kimi.
//
Процедура ПрименитьСжатие(ДокументОбъект, ИсторияДиалога, Сжимаемых, Результат, ЛегкаяМодель)

	ВызовСводки = KimiКонтекстСервер.СжатьИсторию(ИсторияДиалога, ДокументОбъект.СжатоДо,
		Сжимаемых, ДокументОбъект.Сводка, ЛегкаяМодель);

	Если ЗначениеЗаполнено(ВызовСводки.Ошибка) Тогда
		Результат.ОшибкаСжатия = ВызовСводки.Ошибка;
		Возврат;
	КонецЕсли;

	ДокументОбъект.Сводка = ВызовСводки.Сводка;
	ДокументОбъект.СжатоДо = ДокументОбъект.СжатоДо + Сжимаемых;

	Результат.СжатиеПрименено = Истина;
	Результат.ОшибкаСжатия = "";

	ИнфоСжатие = Новый Структура;
	ИнфоСжатие.Вставить("СжатоСообщений", Сжимаемых);
	ИнфоСжатие.Вставить("ТокеныЗапроса", ВызовСводки.ТокеныЗапроса);
	ИнфоСжатие.Вставить("ТокеныОтвета", ВызовСводки.ТокеныОтвета);
	ИнфоСжатие.Вставить("Стоимость", ВызовСводки.Стоимость);
	ИнфоСжатие.Вставить("ВремяМиллисекунд", ВызовСводки.ВремяМиллисекунд);
	Результат.ИнфоСжатие = ИнфоСжатие;

КонецПроцедуры

// Обновляет блок фактов диалога вызовом модели-экстрактора (поддержка стратегии
// «Факты», День 10): последний обмен истории (user-сообщение + ответ агента)
// передаётся вместе с текущими фактами, ответ модели — полный обновлённый список.
// Обновление по последнему обмену, а не по всей истории: инкрементальная память
// симметрична инкрементальной сводке Дня 9. Ошибка не прерывает сохранение:
// блок фактов остаётся прежним, причина возвращается в Результат.ОшибкаФактов.
// ЛегкаяМодель (режим Google-only Дня 11) переводит вызов на лёгкую модель
// Google AI Studio — приёмка дня без обращений к Kimi.
//
Процедура ОбновитьФактыДиалога(ДокументОбъект, ИсторияДиалога, Результат, ЛегкаяМодель)

	Обмен = ПоследнийОбменДиалога(ИсторияДиалога);
	Если Обмен = Неопределено Тогда
		Возврат; // в истории нет сообщений пользователя — обновлять не по чему
	КонецЕсли;

	ВызовФактов = KimiКонтекстСервер.ОбновитьФакты(ДокументОбъект.Факты.Выгрузить(),
		Обмен.ТекстПользователя, Обмен.ТекстАссистента, ЛегкаяМодель);

	Если ЗначениеЗаполнено(ВызовФактов.Ошибка) Тогда
		Результат.ОшибкаФактов = ВызовФактов.Ошибка;
		Возврат;
	КонецЕсли;

	ДокументОбъект.Факты.Очистить();
	Для Каждого СтрокаФакта Из ВызовФактов.Факты Цикл
		НоваяСтрока = ДокументОбъект.Факты.Добавить();
		НоваяСтрока.Ключ = СтрокаФакта.Ключ;
		НоваяСтрока.Значение = СтрокаФакта.Значение;
	КонецЦикла;

	Результат.ФактыОбновлены = Истина;
	Результат.ОшибкаФактов = "";

	ИнфоФакты = Новый Структура;
	ИнфоФакты.Вставить("ТокеныЗапроса", ВызовФактов.ТокеныЗапроса);
	ИнфоФакты.Вставить("ТокеныОтвета", ВызовФактов.ТокеныОтвета);
	ИнфоФакты.Вставить("Стоимость", ВызовФактов.Стоимость);
	ИнфоФакты.Вставить("ВремяМиллисекунд", ВызовФактов.ВремяМиллисекунд);
	Результат.ИнфоФакты = ИнфоФакты;

КонецПроцедуры

// Находит последний обмен диалога: последнее user-сообщение истории и следующий
// за ним непустой ответ ассистента (промежуточные tool-сообщения пропускаются).
//
// Параметры:
//   ИсторияДиалога - ТаблицаЗначений - см. ЗагрузитьДиалог.
//
// Возвращаемое значение:
//   Структура, Неопределено - Неопределено, если в истории нет user-сообщений:
//     * ТекстПользователя - Строка - текст последнего сообщения пользователя;
//     * ТекстАссистента - Строка - текст ответа агента (пусто, если не нашёлся).
//
Функция ПоследнийОбменДиалога(ИсторияДиалога)

	ИндексПользователя = ИсторияДиалога.Количество() - 1;
	Пока ИндексПользователя >= 0 Цикл
		Если ИсторияДиалога[ИндексПользователя].Роль = "user" Тогда
			Прервать;
		КонецЕсли;
		ИндексПользователя = ИндексПользователя - 1;
	КонецЦикла;

	Если ИндексПользователя < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТекстАссистента = "";
	Для Индекс = ИндексПользователя + 1 По ИсторияДиалога.Количество() - 1 Цикл
		СтрокаИстории = ИсторияДиалога[Индекс];
		Если СтрокаИстории.Роль = "assistant" И ЗначениеЗаполнено(СтрокаИстории.Текст) Тогда
			ТекстАссистента = СтрокаИстории.Текст;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("ТекстПользователя, ТекстАссистента",
		ИсторияДиалога[ИндексПользователя].Текст, ТекстАссистента);

КонецФункции

// Формирует заголовок диалога: сначала пробует лёгкую модель (Google AI Studio,
// константа GeminiApiKey — День 5), при любой ошибке или пустом ключе —
// обрезок первого вопроса пользователя.
//
// Параметры:
//   ДокументОбъект - ДокументОбъект.KimiДиалог - диалог с заполненной табличной частью.
//
// Возвращаемое значение:
//   Строка - заголовок (не длиннее 100 символов — ограничение реквизита).
//
Функция СформироватьЗаголовок(ДокументОбъект)

	ТекстЗаголовка = "";

	КлючGemini = Константы.GeminiApiKey.Получить();
	Если ЗначениеЗаполнено(КлючGemini) Тогда
		Попытка
			ТекстЗаголовка = ЗаголовокМоделью(ДокументОбъект, КлючGemini);
		Исключение
			ТекстЗаголовка = "";
		КонецПопытки;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстЗаголовка) Тогда
		ТекстЗаголовка = ЗаголовокИзПервогоВопроса(ДокументОбъект);
	КонецЕсли;

	Возврат Лев(СокрЛП(ТекстЗаголовка), 100);

КонецФункции

// Запрашивает заголовок диалога у лёгкой модели Google AI Studio (OpenAI-совместимый
// интерфейс — вызов через общий KimiAPIСервер.ВыполнитьЗапрос, День 5).
// Kimi-специфичные поля (reasoning_effort и пр.) не передаём.
//
Функция ЗаголовокМоделью(ДокументОбъект, КлючAPI)

	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("Роль, Текст", "user", ТекстЗапросаЗаголовка(ДокументОбъект)));

	Параметры = Новый Структура;
	Параметры.Вставить("Модель", МодельЗаголовков());
	Параметры.Вставить("АдресСервера", "generativelanguage.googleapis.com");
	Параметры.Вставить("БазовыйПуть", "/v1beta/openai");
	Параметры.Вставить("КлючAPI", КлючAPI);
	Параметры.Вставить("МаксимумТокенов", 60);

	Результат = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, Параметры);

	Возврат ?(Результат.Текст = Неопределено, "", Результат.Текст);

КонецФункции

// Возвращает имя лёгкой модели для формирования заголовков чатов.
// Точка смены — та же линейка, что малый ярус Дня 5: бесплатный тариф AI Studio
// (500 запросов в день), актуальность имён сверять с каталогом провайдера.
//
Функция МодельЗаголовков()

	Возврат "gemini-3.5-flash-lite";

КонецФункции

// Собирает текст запроса к модели-именователю: первые несколько сообщений диалога.
//
Функция ТекстЗапросаЗаголовка(ДокументОбъект)

	ЧастиДиалога = Новый Массив;
	Для Каждого СтрокаСообщения Из ДокументОбъект.Сообщения Цикл
		ЭтоПоказываемоеСообщение = СтрокаСообщения.Роль = "user"
			Или (СтрокаСообщения.Роль = "assistant" И ЗначениеЗаполнено(СтрокаСообщения.Текст));
		Если ЭтоПоказываемоеСообщение Тогда
			ЧастиДиалога.Добавить(СтрокаСообщения.Роль + ": " + Лев(СтрокаСообщения.Текст, 300));
		КонецЕсли;
		Если ЧастиДиалога.Количество() >= 4 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон(НСтр("ru = 'Начало диалога пользователя с ИИ-ассистентом:
		|%1
		|
		|Сформулируй короткий заголовок (не более 50 символов), передающий тему диалога.
		|Ответь только заголовком: без кавычек, пояснений и переводов строк.'"),
		СтрСоединить(ЧастиДиалога, Символы.ПС));

КонецФункции

// Заголовок-заглушка: обрезок первого вопроса пользователя; если вопросов нет — по дате.
//
Функция ЗаголовокИзПервогоВопроса(ДокументОбъект)

	Для Каждого СтрокаСообщения Из ДокументОбъект.Сообщения Цикл
		Если СтрокаСообщения.Роль = "user" И ЗначениеЗаполнено(СтрокаСообщения.Текст) Тогда
			ТекстВопроса = СтрЗаменить(СокрЛП(СтрокаСообщения.Текст), Символы.ПС, " ");
			Возврат Лев(ТекстВопроса, 100);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон(НСтр("ru = 'Диалог от %1'"), Формат(ДокументОбъект.Дата, "ДЛФ=D"));

КонецФункции

#КонецОбласти
