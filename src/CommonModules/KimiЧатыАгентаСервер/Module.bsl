#Область ПрограммныйИнтерфейс

// Возвращает последний незавершённый диалог агента (ДатаЗавершения пустая).
// Именно его форма агента автоматически продолжает при открытии — сценарий
// "перезапустили приложение и продолжили общение" (задание Дня 7).
//
// Возвращаемое значение:
//   ДокументСсылка.KimiДиалог, Неопределено - активный диалог; Неопределено, если таких нет.
//
Функция АктивныйДиалог() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Диалог.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.KimiДиалог КАК Диалог
	|ГДЕ
	|	Диалог.ДатаЗавершения = &ПустаяДата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Диалог.Дата УБЫВ";
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает список диалогов для ленты чатов формы агента, новые первыми.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Ссылка - ДокументСсылка.KimiДиалог - диалог;
//     * Наименование - Строка - заголовок диалога (может быть пустым);
//     * Дата - Дата - дата начала диалога (стандартный реквизит документа);
//     * ДатаЗавершения - Дата - момент завершения; пустая дата — диалог активен;
//     * Ид - Строка - XML-строка ссылки (для псевдо-ссылок ленты чатов; XMLСтрока
//       со ссылками доступна только на сервере).
//
Функция СписокДиалогов() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Диалог.Ссылка КАК Ссылка,
	|	Диалог.Наименование КАК Наименование,
	|	Диалог.Дата КАК Дата,
	|	Диалог.ДатаЗавершения КАК ДатаЗавершения
	|ИЗ
	|	Документ.KimiДиалог КАК Диалог
	|
	|УПОРЯДОЧИТЬ ПО
	|	Диалог.Дата УБЫВ";

	Диалоги = Запрос.Выполнить().Выгрузить();
	Диалоги.Колонки.Добавить("Ид", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	Для Каждого СтрокаДиалога Из Диалоги Цикл
		СтрокаДиалога.Ид = XMLСтрока(СтрокаДиалога.Ссылка);
	КонецЦикла;

	Возврат Диалоги;

КонецФункции

// Загружает сохранённый диалог: заголовок и полную историю сообщений
// (включая вызовы инструментов и их результаты) для передачи в API.
//
// Параметры:
//   Ссылка - ДокументСсылка.KimiДиалог - загружаемый диалог.
//
// Возвращаемое значение:
//   Структура:
//     * Наименование - Строка - заголовок диалога;
//     * История - ТаблицаЗначений - сообщения в порядке табличной части:
//       ** Роль - Строка - "user" / "assistant" / "tool";
//       ** Текст - Строка - текст сообщения;
//       ** Отправлено - Дата - момент сообщения;
//       ** ВызовыИнструментов - Строка - JSON-массив tool_calls (у assistant);
//       ** ИдВызова - Строка - tool_call_id (у tool).
//
Функция ЗагрузитьДиалог(Ссылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Сообщения.Роль КАК Роль,
	|	Сообщения.Текст КАК Текст,
	|	Сообщения.Отправлено КАК Отправлено,
	|	Сообщения.ВызовыИнструментов КАК ВызовыИнструментов,
	|	Сообщения.ИдВызова КАК ИдВызова
	|ИЗ
	|	Документ.KimiДиалог.Сообщения КАК Сообщения
	|ГДЕ
	|	Сообщения.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сообщения.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Результат = Новый Структура;
	Результат.Вставить("Наименование", Ссылка.Наименование);
	Результат.Вставить("История", Запрос.Выполнить().Выгрузить());

	Возврат Результат;

КонецФункции

// Сохраняет диалог целиком: перезаписывает табличную часть сообщений историей формы
// (идемпотентно — можно вызывать после каждого обмена). Документ создаётся лениво —
// при первом сохранённом сообщении, чтобы не плодить пустые диалоги. Заголовок диалога
// формируется один раз — лёгкой моделью по первым сообщениям, при недоступности —
// обрезком первого вопроса.
//
// Параметры:
//   Ссылка - ДокументСсылка.KimiДиалог - сохраняемый диалог; пустая ссылка — создать новый;
//   ИсторияДиалога - ТаблицаЗначений - см. возвращаемое значение ЗагрузитьДиалог.
//
// Возвращаемое значение:
//   ДокументСсылка.KimiДиалог - сохранённый (или созданный) диалог.
//
Функция СохранитьДиалог(Ссылка, ИсторияДиалога) Экспорт

	Если ЗначениеЗаполнено(Ссылка) Тогда
		ДокументОбъект = Ссылка.ПолучитьОбъект();
	Иначе
		ДокументОбъект = Документы.KimiДиалог.СоздатьДокумент();
		// Платформа не заполняет Дату программно созданного документа —
		// для непроводимого документа без неё запись отклоняется.
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;

	// Продолжили завершённый диалог (кликнули его карточку в ленте) — он снова активен.
	Если ЗначениеЗаполнено(ДокументОбъект.ДатаЗавершения) Тогда
		ДокументОбъект.ДатаЗавершения = '00010101';
	КонецЕсли;

	ДокументОбъект.Сообщения.Очистить();
	Для Каждого СтрокаИстории Из ИсторияДиалога Цикл
		НоваяСтрока = ДокументОбъект.Сообщения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИстории);
	КонецЦикла;

	Если Не ЗначениеЗаполнено(ДокументОбъект.Наименование) И ДокументОбъект.Сообщения.Количество() > 0 Тогда
		ДокументОбъект.Наименование = СформироватьЗаголовок(ДокументОбъект);
	КонецЕсли;

	ДокументОбъект.Записать();

	Возврат ДокументОбъект.Ссылка;

КонецФункции

// Завершает диалог: проставляет дату завершения (вызывается при создании нового чата).
// Если заголовок так и не сформировался — подставляет заголовок-заглушку по первому вопросу.
//
// Параметры:
//   Ссылка - ДокументСсылка.KimiДиалог - завершаемый диалог.
//
Процедура ЗавершитьДиалог(Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ДокументОбъект = Ссылка.ПолучитьОбъект();
	Если ДокументОбъект = Неопределено Или ЗначениеЗаполнено(ДокументОбъект.ДатаЗавершения) Тогда
		Возврат;
	КонецЕсли;

	ДокументОбъект.ДатаЗавершения = ТекущаяДатаСеанса();
	Если Не ЗначениеЗаполнено(ДокументОбъект.Наименование) Тогда
		ДокументОбъект.Наименование = СформироватьЗаголовок(ДокументОбъект);
	КонецЕсли;
	ДокументОбъект.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует заголовок диалога: сначала пробует лёгкую модель (Google AI Studio,
// константа GeminiApiKey — День 5), при любой ошибке или пустом ключе —
// обрезок первого вопроса пользователя.
//
// Параметры:
//   ДокументОбъект - ДокументОбъект.KimiДиалог - диалог с заполненной табличной частью.
//
// Возвращаемое значение:
//   Строка - заголовок (не длиннее 100 символов — ограничение реквизита).
//
Функция СформироватьЗаголовок(ДокументОбъект)

	ТекстЗаголовка = "";

	КлючGemini = Константы.GeminiApiKey.Получить();
	Если ЗначениеЗаполнено(КлючGemini) Тогда
		Попытка
			ТекстЗаголовка = ЗаголовокМоделью(ДокументОбъект, КлючGemini);
		Исключение
			ТекстЗаголовка = "";
		КонецПопытки;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстЗаголовка) Тогда
		ТекстЗаголовка = ЗаголовокИзПервогоВопроса(ДокументОбъект);
	КонецЕсли;

	Возврат Лев(СокрЛП(ТекстЗаголовка), 100);

КонецФункции

// Запрашивает заголовок диалога у лёгкой модели Google AI Studio (OpenAI-совместимый
// интерфейс — вызов через общий KimiAPIСервер.ВыполнитьЗапрос, День 5).
// Kimi-специфичные поля (reasoning_effort и пр.) не передаём.
//
Функция ЗаголовокМоделью(ДокументОбъект, КлючAPI)

	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("Роль, Текст", "user", ТекстЗапросаЗаголовка(ДокументОбъект)));

	Параметры = Новый Структура;
	Параметры.Вставить("Модель", МодельЗаголовков());
	Параметры.Вставить("АдресСервера", "generativelanguage.googleapis.com");
	Параметры.Вставить("БазовыйПуть", "/v1beta/openai");
	Параметры.Вставить("КлючAPI", КлючAPI);
	Параметры.Вставить("МаксимумТокенов", 60);

	Результат = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, Параметры);

	Возврат ?(Результат.Текст = Неопределено, "", Результат.Текст);

КонецФункции

// Возвращает имя лёгкой модели для формирования заголовков чатов.
// Точка смены — та же линейка, что малый ярус Дня 5: бесплатный тариф AI Studio
// (500 запросов в день), актуальность имён сверять с каталогом провайдера.
//
Функция МодельЗаголовков()

	Возврат "gemini-3.5-flash-lite";

КонецФункции

// Собирает текст запроса к модели-именователю: первые несколько сообщений диалога.
//
Функция ТекстЗапросаЗаголовка(ДокументОбъект)

	ЧастиДиалога = Новый Массив;
	Для Каждого СтрокаСообщения Из ДокументОбъект.Сообщения Цикл
		ЭтоПоказываемоеСообщение = СтрокаСообщения.Роль = "user"
			Или (СтрокаСообщения.Роль = "assistant" И ЗначениеЗаполнено(СтрокаСообщения.Текст));
		Если ЭтоПоказываемоеСообщение Тогда
			ЧастиДиалога.Добавить(СтрокаСообщения.Роль + ": " + Лев(СтрокаСообщения.Текст, 300));
		КонецЕсли;
		Если ЧастиДиалога.Количество() >= 4 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон(НСтр("ru = 'Начало диалога пользователя с ИИ-ассистентом:
		|%1
		|
		|Сформулируй короткий заголовок (не более 50 символов), передающий тему диалога.
		|Ответь только заголовком: без кавычек, пояснений и переводов строк.'"),
		СтрСоединить(ЧастиДиалога, Символы.ПС));

КонецФункции

// Заголовок-заглушка: обрезок первого вопроса пользователя; если вопросов нет — по дате.
//
Функция ЗаголовокИзПервогоВопроса(ДокументОбъект)

	Для Каждого СтрокаСообщения Из ДокументОбъект.Сообщения Цикл
		Если СтрокаСообщения.Роль = "user" И ЗначениеЗаполнено(СтрокаСообщения.Текст) Тогда
			ТекстВопроса = СтрЗаменить(СокрЛП(СтрокаСообщения.Текст), Символы.ПС, " ");
			Возврат Лев(ТекстВопроса, 100);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон(НСтр("ru = 'Диалог от %1'"), Формат(ДокументОбъект.Дата, "ДЛФ=D"));

КонецФункции

#КонецОбласти
