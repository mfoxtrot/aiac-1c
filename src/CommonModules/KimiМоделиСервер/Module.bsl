#Область ПрограммныйИнтерфейс

// Выполняет один шаг эксперимента "задача × модель": отправляет текст задачи выбранной
// модели, записывает результат в регистр сведений и возвращает его для отображения в форме.
//
// Параметры:
//   Задача - СправочникСсылка.KimiЗадачиРассуждений - решаемая задача;
//   ОписаниеМодели - Структура - см. ОписаниеМодели;
//   ДатаЗапуска - Дата - дата и время начала прогона; связывает записи одного прогона.
//
// Возвращаемое значение:
//   Структура:
//     * Задача - СправочникСсылка - задача шага;
//     * Модель - Строка - имя модели;
//     * Провайдер - Строка - провайдер модели;
//     * Ярус - Строка - ярус модели в эксперименте (см. ЯрусыЭксперимента);
//     * НомерПопытки - Число - номер попытки в ячейке "задача × модель";
//     * Ответ - Строка - ответ модели (пустая строка при ошибке);
//     * Рассуждение - Строка - цепочка рассуждения модели (пустая строка, если API её не вернул);
//     * ЭталонНайден - Булево - Истина, если эталонный ответ найден в тексте ответа (подсказка для оценки);
//     * Верно - Булево - начальное значение совпадает с подсказкой; окончательно отмечает пользователь;
//     * ТокеныЗапроса - Число - prompt_tokens из блока usage;
//     * ТокеныОтвета - Число - completion_tokens из блока usage;
//     * ТокеныРассуждения - Число - токены рассуждения (reasoning_tokens);
//     * ТокеныВсего - Число - total_tokens из блока usage;
//     * ВремяМиллисекунд - Число - длительность HTTP-вызова;
//     * Стоимость - Число - расчётная стоимость вызова, USD (0, если тариф неизвестен);
//     * СообщениеОбОшибке - Строка - пустая строка, если вызов завершился успешно.
//
Функция ВыполнитьПопытку(Задача, ОписаниеМодели, ДатаЗапуска) Экспорт

	ДанныеЗадачи = ДанныеЗадачи(Задача);

	Результат = НовыйРезультат(Задача, ОписаниеМодели);
	Результат.НомерПопытки = СледующаяПопытка(Задача, ОписаниеМодели.Модель);

	Попытка
		Сообщения = Новый Массив;
		Сообщения.Добавить(Новый Структура("Роль, Текст", "user", ДанныеЗадачи.ТекстЗадачи));
		ОтветМодели = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, ПараметрыВызова(ОписаниеМодели));

		Результат.Ответ = ОтветМодели.Текст;
		Результат.Рассуждение = ОтветМодели.Рассуждение;
		Результат.ТокеныЗапроса = ОтветМодели.ТокеныЗапроса;
		Результат.ТокеныОтвета = ОтветМодели.ТокеныОтвета;
		Результат.ТокеныРассуждения = ОтветМодели.ТокеныРассуждения;
		Результат.ТокеныВсего = ОтветМодели.ТокеныВсего;
		Результат.ВремяМиллисекунд = ОтветМодели.ВремяМиллисекунд;
		Результат.Стоимость = СтоимостьВызова(ОписаниеМодели.Модель,
			ОтветМодели.ТокеныЗапроса, ОтветМодели.ТокеныОтвета);
	Исключение
		Результат.СообщениеОбОшибке = ОписаниеОшибки();
	КонецПопытки;

	Результат.ЭталонНайден = ЭталонНайден(ДанныеЗадачи.ЭталонныйОтвет, Результат.Ответ);
	Результат.Верно = Результат.ЭталонНайден;

	ЗаписатьРезультат(Результат, ДатаЗапуска);

	Возврат Результат;

КонецФункции

// Анализирует результаты одного прогона моделью-аналитиком (семейство Kimi) и возвращает
// её выводы: сравнение моделей по точности, скорости, ресурсоёмкости и стоимости.
//
// Параметры:
//   ДатаЗапуска - Дата - дата запуска анализируемого прогона;
//   МодельАнализа - Строка - имя модели-аналитика; пустая строка - модель по умолчанию.
//
// Возвращаемое значение:
//   Строка - выводы модели-аналитика.
//
Функция Проанализировать(ДатаЗапуска, МодельАнализа) Экспорт

	РезультатыПрогона = РезультатыПрогона(ДатаЗапуска);
	Если РезультатыПрогона.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Нет результатов для анализа: выполните прогон.'");
	КонецЕсли;

	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("Роль, Текст", "system", ТекстИнструкцииАналитика()));
	Сообщения.Добавить(Новый Структура("Роль, Текст", "user", ТекстДанныхЭксперимента(РезультатыПрогона)));

	ОписаниеАналитика = ОписаниеМодели(?(ЗначениеЗаполнено(МодельАнализа), МодельАнализа, "kimi-k3.1-pro"));
	Параметры = ПараметрыВызова(ОписаниеАналитика);
	// Анализ — один вызов со всеми ответами прогона: рассуждение модели на большом
	// входе может идти минуты, поэтому таймаут повышен (секунды).
	Параметры.Таймаут = 600;
	// Судьбе не нужна глубокая цепочка рассуждений: low ускоряет анализ в разы
	// при сохранном качестве выводов по структурированным данным.
	Параметры.УсилиеРассуждения = "low";

	ОтветМодели = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, Параметры);

	Возврат ОтветМодели.Текст;

КонецФункции

// Устанавливает отметку "Верно" в существующей записи регистра.
//
// Параметры:
//   Задача - СправочникСсылка.KimiЗадачиРассуждений;
//   Модель - Строка - измерение регистра;
//   НомерПопытки - Число - номер попытки;
//   Верно - Булево - новое значение отметки.
//
Процедура УстановитьВерность(Задача, Модель, НомерПопытки, Верно) Экспорт

	МенеджерЗаписи = РегистрыСведений.РезультатыМоделейKimi.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Задача = Задача;
	МенеджерЗаписи.Модель = Модель;
	МенеджерЗаписи.НомерПопытки = НомерПопытки;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.Верно = Верно;
	МенеджерЗаписи.Записать();

КонецПроцедуры

// Удаляет все записи регистра результатов.
//
Процедура ОчиститьРезультаты() Экспорт

	НаборЗаписей = РегистрыСведений.РезультатыМоделейKimi.СоздатьНаборЗаписей();
	НаборЗаписей.Записать();

КонецПроцедуры

// Возвращает список задач учебного набора для заполнения таблицы формы.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Задача - СправочникСсылка.KimiЗадачиРассуждений;
//     * Наименование - Строка;
//     * ЭталонныйОтвет - Строка.
//
Функция СписокЗадач() Экспорт

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Задача");
	Результат.Колонки.Добавить("Наименование");
	Результат.Колонки.Добавить("ЭталонныйОтвет");

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Задачи.Ссылка КАК Задача,
	|	Задачи.Наименование КАК Наименование,
	|	Задачи.ЭталонныйОтвет КАК ЭталонныйОтвет
	|ИЗ
	|	Справочник.KimiЗадачиРассуждений КАК Задачи
	|
	|УПОРЯДОЧИТЬ ПО
	|	Задачи.Код");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаСписка = Результат.Добавить();
		СтрокаСписка.Задача = Выборка.Задача;
		СтрокаСписка.Наименование = Выборка.Наименование;
		СтрокаСписка.ЭталонныйОтвет = Выборка.ЭталонныйОтвет;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Создаёт в справочнике задачи учебного набора, которых ещё нет.
//
Процедура НаполнитьЗадачиПоУмолчанию() Экспорт

	KimiРассуждениеСервер.НаполнитьЗадачиПоУмолчанию();

КонецПроцедуры

// Возвращает три яруса эксперимента с фиксированными моделями (решение заказчика):
// малая дешёвая (Groq, бесплатный тариф), средняя (предыдущий флагман Kimi)
// и флагманская модель.
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Ярус - Строка - наименование яруса;
//     * Предпочтения - Массив из Строка - имена моделей-кандидатов в порядке предпочтения.
//
Функция ЯрусыЭксперимента() Экспорт

	Ярусы = Новый Массив;

	МалыйЯрус = Новый Структура;
	МалыйЯрус.Вставить("Ярус", НСтр("ru = 'Малая модель'"));
	МалыйЯрус.Вставить("Предпочтения", МоделиGroq());
	Ярусы.Добавить(МалыйЯрус);

	СреднийЯрус = Новый Структура;
	СреднийЯрус.Вставить("Ярус", НСтр("ru = 'Средняя модель'"));
	Средние = Новый Массив;
	Средние.Добавить("kimi-k3");
	СреднийЯрус.Вставить("Предпочтения", Средние);
	Ярусы.Добавить(СреднийЯрус);

	ФлагманскийЯрус = Новый Структура;
	ФлагманскийЯрус.Вставить("Ярус", НСтр("ru = 'Флагманская модель'"));
	Флагманы = Новый Массив;
	Флагманы.Добавить("kimi-k3.1-pro");
	Флагманы.Добавить("kimi-k3");
	ФлагманскийЯрус.Вставить("Предпочтения", Флагманы);
	Ярусы.Добавить(ФлагманскийЯрус);

	Возврат Ярусы;

КонецФункции

// Возвращает список моделей Groq для малого яруса (порядок - от предпочтительной).
// Имена фиксированы внешним заданием курса; ключ - константа GroqApiKey.
// Каталог Groq на 2026-11-09: модели llama-3.1-8b-instant и llama-3.3-70b-versatile
// переведены в Enterprise (закрыты для бесплатного тарифа, sunset 2026-08-16) -
// заменены на актуальные production-модели семейства gpt-oss (console.groq.com/docs/models).
//
// Возвращаемое значение:
//   Массив из Строка - имена моделей.
//
Функция МоделиGroq() Экспорт

	Модели = Новый Массив;
	Модели.Добавить("openai/gpt-oss-20b");
	Модели.Добавить("openai/gpt-oss-120b");

	Возврат Модели;

КонецФункции

// Возвращает служебное описание модели для вызовов API: провайдер, адрес сервера,
// базовый путь ресурса и ключ. Совместимые с OpenAI API провайдеры отличаются только
// этими четырьмя значениями.
//
// Параметры:
//   ИмяМодели - Строка - имя модели.
//
// Возвращаемое значение:
//   Структура:
//     * Модель - Строка - имя модели;
//     * Провайдер - Строка - "Groq" или "Moonshot AI";
//     * АдресСервера - Строка - адрес сервера API;
//     * БазовыйПуть - Строка - префикс ресурса;
//     * КлючAPI - Строка - ключ доступа (по константе провайдера).
//
Функция ОписаниеМодели(ИмяМодели) Экспорт

	ЭтоGroq = МоделиGroq().Найти(ИмяМодели) <> Неопределено;

	Описание = Новый Структура;
	Описание.Вставить("Модель", ИмяМодели);
	Описание.Вставить("Провайдер", ?(ЭтоGroq, "Groq", "Moonshot AI"));
	Описание.Вставить("АдресСервера", ?(ЭтоGroq, "api.groq.com", "api.moonshot.ai"));
	Описание.Вставить("БазовыйПуть", ?(ЭтоGroq, "/openai/v1", "/v1"));
	Описание.Вставить("КлючAPI", ?(ЭтоGroq, Константы.GroqApiKey.Получить(), ""));
	Описание.Вставить("Ярус", "");

	Возврат Описание;

КонецФункции

// Проверяет, что для всех выбранных моделей заполнены ключи API; иначе вызывает исключение
// с подсказкой, какую константу заполнить.
//
// Параметры:
//   ИменаМоделей - Массив из Строка - выбранные в форме модели.
//
Процедура ПроверитьКлючиAPI(ИменаМоделей) Экспорт

	ЕстьGroq = Ложь;
	ЕстьMoonshot = Ложь;
	Для Каждого ИмяМодели Из ИменаМоделей Цикл
		Если МоделиGroq().Найти(ИмяМодели) <> Неопределено Тогда
			ЕстьGroq = Истина;
		Иначе
			ЕстьMoonshot = Истина;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьMoonshot И Не ЗначениеЗаполнено(Константы.KimiApiKey.Получить()) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан ключ API Kimi. Заполните константу ""Ключ API Kimi"".'");
	КонецЕсли;

	Если ЕстьGroq И Не ЗначениеЗаполнено(Константы.GroqApiKey.Получить()) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан ключ API Groq. Заполните константу ""Ключ API Groq"" (бесплатный ключ: console.groq.com).'");
	КонецЕсли;

КонецПроцедуры

// Возвращает имя модели для яруса: первую доступную ключу из списка предпочтений.
// Пустая строка - ярус оставить пустым (модель по умолчанию Kimi).
//
// Параметры:
//   Ярус - Строка - наименование яруса (см. ЯрусыЭксперимента);
//   ДоступныеМодели - Массив из Строка - результат KimiAPIСервер.ДоступныеМодели().
//
// Возвращаемое значение:
//   Строка - имя модели; пустая строка - выбрать нельзя.
//
Функция ВыбратьМодельЯруса(Ярус, ДоступныеМодели) Экспорт

	Для Каждого ОписаниеЯруса Из ЯрусыЭксперимента() Цикл
		Если ОписаниеЯруса.Ярус <> Ярус Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ИмяКандидата Из ОписаниеЯруса.Предпочтения Цикл
			ЭтоGroq = МоделиGroq().Найти(ИмяКандидата) <> Неопределено;
			Если ЭтоGroq Или ДоступныеМодели.Найти(ИмяКандидата) <> Неопределено Тогда
				Возврат ИмяКандидата;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат "";

КонецФункции

// Возвращает имя модели-аналитика: топовую из доступных ключу моделей.
// Пустая строка - доступные модели не определены, будет использована модель по умолчанию.
//
// Параметры:
//   ДоступныеМодели - Массив из Строка - результат KimiAPIСервер.ДоступныеМодели().
//
// Возвращаемое значение:
//   Строка - имя модели; пустая строка - модель по умолчанию.
//
Функция ВыбратьМодельАнализа(ДоступныеМодели) Экспорт

	Предпочтения = Новый Массив;
	Предпочтения.Добавить("kimi-k3.1-pro");
	Предпочтения.Добавить("kimi-k3.1-pro-highspeed");
	Предпочтения.Добавить("kimi-k3");

	Для Каждого ИмяКандидата Из Предпочтения Цикл
		Если ДоступныеМодели.Найти(ИмяКандидата) <> Неопределено Тогда
			Возврат ИмяКандидата;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Возвращает тарифы модели, USD за 1 млн токенов (вход без учёта кэша / выход).
// Источники: platform.kimi.ai (Moonshot, проверено 2026-11-09 через прайс-агрегаторы
// aipricing.guru и requesty.ai), console.groq.com/docs/models (Groq, Developer plan,
// проверено 2026-11-09). Прайсы меняются - при смене моделей обновить таблицу.
//
// Параметры:
//   ИмяМодели - Строка - имя модели.
//
// Возвращаемое значение:
//   Структура:
//     * ЦенаВходаЗаМлн - Число;
//     * ЦенаВыходаЗаМлн - Число;
//   Неопределено - тариф модели не зафиксирован.
//
Функция ЦенаМодели(ИмяМодели) Экспорт

	Если ИмяМодели = "openai/gpt-oss-20b" Тогда
		Возврат Новый Структура("ЦенаВходаЗаМлн, ЦенаВыходаЗаМлн", 0.075, 0.30);
	ИначеЕсли ИмяМодели = "openai/gpt-oss-120b" Тогда
		Возврат Новый Структура("ЦенаВходаЗаМлн, ЦенаВыходаЗаМлн", 0.15, 0.60);
	ИначеЕсли ИмяМодели = "kimi-k3.1-pro" Тогда
		Возврат Новый Структура("ЦенаВходаЗаМлн, ЦенаВыходаЗаМлн", 2.00, 10.00);
	ИначеЕсли ИмяМодели = "kimi-k3.1-pro-highspeed" Тогда
		Возврат Новый Структура("ЦенаВходаЗаМлн, ЦенаВыходаЗаМлн", 4.00, 20.00);
	ИначеЕсли ИмяМодели = "kimi-k3" Тогда
		Возврат Новый Структура("ЦенаВходаЗаМлн, ЦенаВыходаЗаМлн", 3.00, 15.00);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает расчётную стоимость вызова, USD: токены запроса и ответа по тарифам модели.
// Тариф не зафиксирован - стоимость 0.
//
// Параметры:
//   ИмяМодели - Строка - имя модели;
//   ТокеныЗапроса - Число - prompt_tokens из блока usage;
//   ТокеныОтвета - Число - completion_tokens из блока usage.
//
// Возвращаемое значение:
//   Число - стоимость в USD.
//
Функция СтоимостьВызова(ИмяМодели, ТокеныЗапроса, ТокеныОтвета) Экспорт

	Тариф = ЦенаМодели(ИмяМодели);
	Если Тариф = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ТокеныЗапроса / 1000000 * Тариф.ЦенаВходаЗаМлн
		+ ТокеныОтвета / 1000000 * Тариф.ЦенаВыходаЗаМлн;

КонецФункции

// Возвращает итоговую таблицу "модель → верных / время / токены / стоимость" прогона.
// Считается запросом по регистру (без участия LLM).
//
// Параметры:
//   ДатаЗапуска - Дата - дата запуска прогона.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Модель - Строка;
//     * Провайдер - Строка;
//     * Верных - Число;
//     * ВсегоПопыток - Число;
//     * СреднееВремяМиллисекунд - Число;
//     * ТокеныВсего - Число;
//     * СтоимостьВсего - Число.
//
Функция СводныеИтоги(ДатаЗапуска) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Результаты.Модель КАК Модель,
	|	МАКСИМУМ(Результаты.Провайдер) КАК Провайдер,
	|	СУММА(ВЫБОР
	|		КОГДА Результаты.Верно
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК Верных,
	|	КОЛИЧЕСТВО(*) КАК ВсегоПопыток,
	|	СРЕДНЕЕ(Результаты.ВремяМиллисекунд) КАК СреднееВремяМиллисекунд,
	|	СУММА(Результаты.ТокеныВсего) КАК ТокеныВсего,
	|	СУММА(Результаты.Стоимость) КАК СтоимостьВсего
	|ИЗ
	|	РегистрСведений.РезультатыМоделейKimi КАК Результаты
	|ГДЕ
	|	Результаты.ДатаЗапуска = &ДатаЗапуска
	|
	|СГРУППИРОВАТЬ ПО
	|	Результаты.Модель
	|
	|УПОРЯДОЧИТЬ ПО
	|	Результаты.Модель");
	Запрос.УстановитьПараметр("ДатаЗапуска", ДатаЗапуска);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Читает реквизиты задачи из справочника.
//
// Параметры:
//   Задача - СправочникСсылка.KimiЗадачиРассуждений.
//
// Возвращаемое значение:
//   Структура:
//     * Наименование - Строка;
//     * ТекстЗадачи - Строка;
//     * ЭталонныйОтвет - Строка.
//
Функция ДанныеЗадачи(Задача)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Задачи.Наименование КАК Наименование,
	|	Задачи.ТекстЗадачи КАК ТекстЗадачи,
	|	Задачи.ЭталонныйОтвет КАК ЭталонныйОтвет
	|ИЗ
	|	Справочник.KimiЗадачиРассуждений КАК Задачи
	|ГДЕ
	|	Задачи.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Задача);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Результат = Новый Структура;
	Результат.Вставить("Наименование", Выборка.Наименование);
	Результат.Вставить("ТекстЗадачи", Выборка.ТекстЗадачи);
	Результат.Вставить("ЭталонныйОтвет", Выборка.ЭталонныйОтвет);

	Возврат Результат;

КонецФункции

// Формирует структуру результата с начальными значениями.
//
Функция НовыйРезультат(Задача, ОписаниеМодели)

	Результат = Новый Структура;
	Результат.Вставить("Задача", Задача);
	Результат.Вставить("Модель", ОписаниеМодели.Модель);
	Результат.Вставить("Провайдер", ОписаниеМодели.Провайдер);
	Результат.Вставить("Ярус", ОписаниеМодели.Ярус);
	Результат.Вставить("НомерПопытки", 0);
	Результат.Вставить("Ответ", "");
	Результат.Вставить("Рассуждение", "");
	Результат.Вставить("ЭталонНайден", Ложь);
	Результат.Вставить("Верно", Ложь);
	Результат.Вставить("ТокеныЗапроса", 0);
	Результат.Вставить("ТокеныОтвета", 0);
	Результат.Вставить("ТокеныРассуждения", 0);
	Результат.Вставить("ТокеныВсего", 0);
	Результат.Вставить("ВремяМиллисекунд", 0);
	Результат.Вставить("Стоимость", 0);
	Результат.Вставить("СообщениеОбОшибке", "");

	Возврат Результат;

КонецФункции

// Возвращает параметры HTTP-вызова для шага эксперимента.
//
Функция ПараметрыВызова(ОписаниеМодели)

	Параметры = Новый Структура;
	Параметры.Вставить("МаксимумТокенов", 0);
	Параметры.Вставить("СтопПоследовательность", "");
	Параметры.Вставить("ФорматОтвета", "text");
	Параметры.Вставить("СхемаОтвета", "");
	Параметры.Вставить("УсилиеРассуждения", "");
	Параметры.Вставить("Температура", -1);
	Параметры.Вставить("Модель", ОписаниеМодели.Модель);
	Параметры.Вставить("Таймаут", 0);
	Параметры.Вставить("АдресСервера", ОписаниеМодели.АдресСервера);
	Параметры.Вставить("БазовыйПуть", ОписаниеМодели.БазовыйПуть);
	Параметры.Вставить("КлючAPI", ОписаниеМодели.КлючAPI);

	Возврат Параметры;

КонецФункции

// Проверяет, встречается ли эталонный ответ в тексте ответа модели (регистронезависимо).
//
Функция ЭталонНайден(ЭталонныйОтвет, ОтветМодели)

	Если Не ЗначениеЗаполнено(ЭталонныйОтвет) Или Не ЗначениеЗаполнено(ОтветМодели) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНайти(НРег(ОтветМодели), НРег(СокрЛП(ЭталонныйОтвет))) > 0;

КонецФункции

// Возвращает следующий номер попытки для ячейки "задача × модель".
//
Функция СледующаяПопытка(Задача, ИмяМодели)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(Результаты.НомерПопытки), 0) КАК ПоследняяПопытка
	|ИЗ
	|	РегистрСведений.РезультатыМоделейKimi КАК Результаты
	|ГДЕ
	|	Результаты.Задача = &Задача
	|	И Результаты.Модель = &Модель");
	Запрос.УстановитьПараметр("Задача", Задача);
	Запрос.УстановитьПараметр("Модель", ИмяМодели);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.ПоследняяПопытка + 1;

КонецФункции

// Записывает результат попытки в регистр сведений.
//
Процедура ЗаписатьРезультат(Результат, ДатаЗапуска)

	НаборЗаписей = РегистрыСведений.РезультатыМоделейKimi.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Задача.Установить(Результат.Задача);
	НаборЗаписей.Отбор.Модель.Установить(Результат.Модель);
	НаборЗаписей.Отбор.НомерПопытки.Установить(Результат.НомерПопытки);

	Запись = НаборЗаписей.Добавить();
	Запись.Задача = Результат.Задача;
	Запись.Модель = Результат.Модель;
	Запись.НомерПопытки = Результат.НомерПопытки;
	Запись.ДатаЗапуска = ДатаЗапуска;
	Запись.Провайдер = Результат.Провайдер;
	Запись.Ответ = Результат.Ответ;
	Запись.Рассуждение = Результат.Рассуждение;
	Запись.Верно = Результат.Верно;
	Запись.ЭталонНайден = Результат.ЭталонНайден;
	Запись.ТокеныЗапроса = Результат.ТокеныЗапроса;
	Запись.ТокеныОтвета = Результат.ТокеныОтвета;
	Запись.ТокеныРассуждения = Результат.ТокеныРассуждения;
	Запись.ТокеныВсего = Результат.ТокеныВсего;
	Запись.ВремяМиллисекунд = Результат.ВремяМиллисекунд;
	Запись.Стоимость = Результат.Стоимость;
	Запись.СообщениеОбОшибке = Результат.СообщениеОбОшибке;

	НаборЗаписей.Записать();

КонецПроцедуры

// Возвращает результаты прогона по дате запуска.
//
Функция РезультатыПрогона(ДатаЗапуска)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Результаты.Задача КАК Задача,
	|	Результаты.Модель КАК Модель,
	|	Результаты.Провайдер КАК Провайдер,
	|	Результаты.НомерПопытки КАК НомерПопытки,
	|	Результаты.Ответ КАК Ответ,
	|	Результаты.ЭталонНайден КАК ЭталонНайден,
	|	Результаты.Верно КАК Верно,
	|	Результаты.ТокеныВсего КАК ТокеныВсего,
	|	Результаты.ТокеныРассуждения КАК ТокеныРассуждения,
	|	Результаты.ВремяМиллисекунд КАК ВремяМиллисекунд,
	|	Результаты.Стоимость КАК Стоимость,
	|	Результаты.СообщениеОбОшибке КАК СообщениеОбОшибке
	|ИЗ
	|	РегистрСведений.РезультатыМоделейKimi КАК Результаты
	|ГДЕ
	|	Результаты.ДатаЗапуска = &ДатаЗапуска
	|
	|УПОРЯДОЧИТЬ ПО
	|	Результаты.Задача,
	|	Результаты.Модель,
	|	Результаты.НомерПопытки");
	Запрос.УстановитьПараметр("ДатаЗапуска", ДатаЗапуска);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Формирует текст данных эксперимента для модели-аналитика.
//
Функция ТекстДанныхЭксперимента(РезультатыПрогона)

	Части = Новый Массив;
	Части.Добавить(НСтр("ru = 'Эксперимент: сравнение версий моделей. Одни и те же задачи с эталонными ответами решены тремя моделями: малой дешёвой (Groq), средней (предыдущий флагман Kimi) и флагманской (Kimi K3.1 Pro). Рассуждение у моделей Kimi K3 всегда включено; у модели Groq рассуждения нет.'"));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Всего попыток в выборке: %1'"), РезультатыПрогона.Количество()));

	ТекущаяЗадача = Неопределено;

	Для Каждого ЗаписьПрогона Из РезультатыПрогона Цикл

		Если ТекущаяЗадача <> ЗаписьПрогона.Задача Тогда
			ТекущаяЗадача = ЗаписьПрогона.Задача;
			ДанныеЗадачи = ДанныеЗадачи(ТекущаяЗадача);
			Части.Добавить("");
			Части.Добавить(СтрШаблон(НСтр("ru = '=== Задача: %1'"), ДанныеЗадачи.Наименование));
			Части.Добавить(СтрШаблон(НСтр("ru = 'Текст задачи: %1'"), ДанныеЗадачи.ТекстЗадачи));
			Части.Добавить(СтрШаблон(НСтр("ru = 'Эталонный ответ: %1'"), ДанныеЗадачи.ЭталонныйОтвет));
		КонецЕсли;

		Части.Добавить(СтрШаблон(НСтр("ru = '--- Модель: %1 (провайдер: %2; попытка %3; отмечено «Верно»: %4; эталон найден автоматически: %5)'"),
			ЗаписьПрогона.Модель,
			ЗаписьПрогона.Провайдер,
			ЗаписьПрогона.НомерПопытки,
			?(ЗаписьПрогона.Верно, НСтр("ru = 'да'"), НСтр("ru = 'нет'")),
			?(ЗаписьПрогона.ЭталонНайден, НСтр("ru = 'да'"), НСтр("ru = 'нет'"))));

		Если ЗначениеЗаполнено(ЗаписьПрогона.СообщениеОбОшибке) Тогда
			Части.Добавить(СтрШаблон(НСтр("ru = 'Ошибка API: %1'"), ЗаписьПрогона.СообщениеОбОшибке));
		Иначе
			Части.Добавить(СтрШаблон(НСтр("ru = 'Ответ: %1'"), Лев(ЗаписьПрогона.Ответ, 10000)));
		КонецЕсли;

	КонецЦикла;

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// Возвращает инструкцию модели-аналитика: какие выводы требуются и контекст платформы.
//
Функция ТекстИнструкцииАналитика()

	Возврат НСтр("ru = 'Ты — аналитик учебного эксперимента: одни и те же задачи с известными эталонными ответами решены тремя моделями — малой дешёвой (Groq, llama), средней (Kimi K3) и флагманской (Kimi K3.1 Pro). Ниже — результаты прогонов с ответами, отметками верности, временем, токенами и расчётной стоимостью. Сформулируй выводы по пунктам:
	|1. Точность: сколько задач решено верно каждой моделью (суди по отметкам «Верно»; сверяй с эталоном), насколько ответы малой модели близки к эталону.
	|2. Скорость: среднее время ответа каждой модели, краткая разница между ярусами.
	|3. Ресурсоёмкость: суммарные токены каждой модели; какую долю токенов Kimi K3/K3.1 съедает рассуждение.
	|4. Стоимость: суммарная расчётная стоимость прогона каждой модели; во сколько раз флагман дороже малой модели (по тарифам). Учти: малая модель в этом прогоне могла выполняться на бесплатном тарифе Groq — стоимость для неё рассчитана по ценам платного тарифа, укажи это.
	|5. Достаточность малой модели: на каких задачах (по типам и конкретно) ответы малой модели полностью пригодны и её использование оправдано, а где без флагмана не обойтись.
	|
	|Контекст платформы: у моделей Kimi K3/K3.1 рассуждение всегда включено и его нельзя отключить; параметры сэмплирования у них фиксированы платформой. Если попытки завершились ошибками API — не выдумывай ответы, сделай вывод по успешным попыткам и прямо скажи об ограничении.
	|
	|Пиши по-русски, структурируй ответ подзаголовками по пяти пунктам, будь краток и опирайся только на переданные данные.'");

КонецФункции

#КонецОбласти
