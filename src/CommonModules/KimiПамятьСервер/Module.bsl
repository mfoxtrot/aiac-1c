#Область ПрограммныйИнтерфейс

// Возвращает идентификатор слоя «краткосрочная память» — текущий диалог:
// в запрос попадает проекция истории по стратегии управления контекстом
// (Дни 9–10): полная история / хвост N / факты диалога + хвост / сводка + хвост.
//
Функция СлойКраткосрочная() Экспорт

	Возврат "Краткосрочная";

КонецФункции

// Возвращает идентификатор слоя «рабочая память» — заметки текущей задачи:
// табличная часть РабочаяПамять документа KimiДиалог; в запрос попадает
// весь блок целиком, пока задача активна.
//
Функция СлойРабочая() Экспорт

	Возврат "Рабочая";

КонецФункции

// Возвращает идентификатор слоя «долговременная память» — факты справочника
// KimiФактыПамяти (профиль, решения, знания); в запрос попадают по правилу
// отбора ФактыДляЗапроса (профиль всегда + релевантные вопросу).
//
Функция СлойДолговременная() Экспорт

	Возврат "Долговременная";

КонецФункции

// Возвращает имена категорий долговременной памяти (в терминах перечисления
// KimiКатегорииПамяти) — для подписей и списков выбора формы. Точка синхронизации
// значений — имена значений перечисления.
//
// Возвращаемое значение:
//   Массив из Строка - «Профиль», «Решение», «Знание».
//
Функция ИменаКатегорий() Экспорт

	Имена = Новый Массив;
	Имена.Добавить("Профиль");
	Имена.Добавить("Решение");
	Имена.Добавить("Знание");

	Возврат Имена;

КонецФункции

// Отображает ссылку перечисления в имя категории (строкой — для таблиц формы
// и журнала; клиент перечисления не видит).
//
// Параметры:
//   Категория - ПеречислениеСсылка.KimiКатегорииПамяти - отображаемая категория.
//
// Возвращаемое значение:
//   Строка - «Профиль» / «Решение» / «Знание»; пустая ссылка — пустая строка.
//
Функция ИмяКатегории(Категория) Экспорт

	Если Категория = Перечисления.KimiКатегорииПамяти.Решение Тогда
		Возврат "Решение";
	ИначеЕсли Категория = Перечисления.KimiКатегорииПамяти.Знание Тогда
		Возврат "Знание";
	ИначеЕсли Категория = Перечисления.KimiКатегорииПамяти.Профиль Тогда
		Возврат "Профиль";
	КонецЕсли;

	Возврат "";

КонецФункции

// Преобразует имя категории в ссылку перечисления; неизвестное или пустое
// имя трактуется как «Профиль» — безопасное умолчание (профиль всегда
// допустим в запросе и ничего не ломает).
//
// Параметры:
//   Имя - Строка - имя категории (см. ИменаКатегорий).
//
// Возвращаемое значение:
//   ПеречислениеСсылка.KimiКатегорииПамяти - категория.
//
Функция КатегорияПоИмени(Имя) Экспорт

	Если Имя = "Решение" Тогда
		Возврат Перечисления.KimiКатегорииПамяти.Решение;
	ИначеЕсли Имя = "Знание" Тогда
		Возврат Перечисления.KimiКатегорииПамяти.Знание;
	Иначе
		Возврат Перечисления.KimiКатегорииПамяти.Профиль;
	КонецЕсли;

КонецФункции

// Возвращает пустую таблицу заметок рабочей памяти: колонки Ключ и Значение.
// Формат совпадает с таблицей фактов (KimiКонтекстСервер.ТаблицаФактов) —
// единый «ключ-значение» всех слоёв памяти, конструктор переиспользуется.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Ключ - Строка(100) - короткое имя заметки;
//     * Значение - Строка - содержание заметки.
//
Функция ТаблицаЗаметок() Экспорт

	Возврат KimiКонтекстСервер.ТаблицаФактов();

КонецФункции

// Возвращает учебный сценарий заполнения слоёв памяти (кнопка «Демо: заполнить
// слои»): серия сообщений, каждое из которых порождает данные конкретного слоя.
// Демо-прогон сохраняет извлечённые факты в заявленный слой автоматически
// (явный выбор зафиксирован в сценарии и виден в журнале); в свободной игре
// слой выбирается кнопками «Сохранить в долговременную / в рабочую».
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Текст - Строка - сообщение пользователя;
//     * Слой - Строка - идентификатор слоя (см. СлойКраткосрочная/Рабочая/Долговременная);
//     * Категория - Строка - имя категории (только для долговременной памяти,
//       см. ИменаКатегорий; для прочих слоёв — пусто).
//
Функция СценарийЗаполненияПамяти() Экспорт

	Сценарий = Новый Массив;

	ДобавитьШагСценария(Сценарий,
		НСтр("ru = 'Меня зовут Анна Ветрова, я руководитель проекта ""Северный ветер"" — небольшой сети кофеен. Давай знакомиться: запомни, кто я и какой у меня проект.'"),
		СлойДолговременная(), "Профиль");
	ДобавитьШагСценария(Сценарий,
		НСтр("ru = 'По проекту приняли два важных решения: СУБД берём PostgreSQL 16, и облако использовать нельзя — только on-premise. Запомни эти решения.'"),
		СлойДолговременная(), "Решение");
	ДобавитьШагСценария(Сценарий,
		НСтр("ru = 'Справочно для проекта зафиксированы учебные курсы валют: доллар — 85 рублей, евро — 95 рублей. Запомни их как знания.'"),
		СлойДолговременная(), "Знание");
	ДобавитьШагСценария(Сценарий,
		НСтр("ru = 'Текущая задача: подготовить демонстрацию системы к 15 декабря 2026 года, ставка разработчика — 4 500 рублей в час, аванс — 30 процентов. Зафиксируй это как данные текущей задачи.'"),
		СлойРабочая(), "");
	ДобавитьШагСценария(Сценарий,
		НСтр("ru = 'По текущей задаче договорились: статус-встреча — каждый вторник в 10:00. Добавь это в заметки задачи.'"),
		СлойРабочая(), "");
	ДобавитьШагСценария(Сценарий,
		НСтр("ru = 'И по сегодняшнему дню: завтра в 11:30 у нас планёрка с заказчиком, встречаемся в офисе на Пушкинской, 10. Просто имей в виду.'"),
		СлойКраткосрочная(), "");

	Возврат Сценарий;

КонецФункции

// Возвращает реестр контрольных вопросов проверки памяти: по два вопроса на слой,
// каждый — про данные, порождённые сценарием заполнения соответствующего слоя.
// Ответ «помнит/не помнит» сверяется с эталоном простой моделью (по образцу
// автоматической оценки Дня 10) и фиксируется по колонкам этапов очистки.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Слой - Строка - идентификатор слоя (см. Слой…);
//     * Вопрос - Строка - контрольный вопрос (без ответа в тексте);
//     * Эталон - Строка - эталонное значение для сверки ответа агента.
//
Функция РеестрВопросовПамяти() Экспорт

	Реестр = Новый ТаблицаЗначений;
	Реестр.Колонки.Добавить("Слой", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Реестр.Колонки.Добавить("Вопрос", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	Реестр.Колонки.Добавить("Эталон", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));

	ДобавитьВопрос(Реестр, СлойДолговременная(),
		НСтр("ru = 'Как зовут пользователя и какой у него проект?'"),
		НСтр("ru = 'Анна Ветрова, «Северный ветер»'"));
	ДобавитьВопрос(Реестр, СлойДолговременная(),
		НСтр("ru = 'Какие решения приняты по СУБД и размещению системы?'"),
		НСтр("ru = 'PostgreSQL 16, только on-premise, облако запрещено'"));
	ДобавитьВопрос(Реестр, СлойРабочая(),
		НСтр("ru = 'До какого срока и по какой ставке готовим демонстрацию?'"),
		НСтр("ru = '15 декабря 2026 года, 4 500 рублей в час'"));
	ДобавитьВопрос(Реестр, СлойРабочая(),
		НСтр("ru = 'Когда статус-встреча по текущей задаче?'"),
		НСтр("ru = 'каждый вторник в 10:00'"));
	ДобавитьВопрос(Реестр, СлойКраткосрочная(),
		НСтр("ru = 'Во сколько завтра планёрка и где она проходит?'"),
		НСтр("ru = '11:30, офис на Пушкинской, 10'"));
	ДобавитьВопрос(Реестр, СлойКраткосрочная(),
		НСтр("ru = 'С кем завтра планёрка?'"),
		НСтр("ru = 'с заказчиком'"));

	Возврат Реестр;

КонецФункции

// Возвращает полный список фактов долговременной памяти (без отбора) —
// для таблицы «Долговременная память» формы агента.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Ключ - Строка(100) - ключ факта (наименование элемента справочника);
//     * Значение - Строка - содержание факта;
//     * Категория - Строка - имя категории (см. ИмяКатегории).
//
Функция ФактыПамяти() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Факты.Наименование КАК Ключ,
	|	Факты.Значение КАК Значение,
	|	Факты.Категория КАК Категория
	|ИЗ
	|	Справочник.KimiФактыПамяти КАК Факты
	|ГДЕ
	|	НЕ Факты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Факты.ДатаЗаписи";

	Факты = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаФакта Из Факты Цикл
		СтрокаФакта.Категория = ИмяКатегории(СтрокаФакта.Категория);
	КонецЦикла;

	Возврат Факты;

КонецФункции

// Отбирает факты долговременной памяти для включения в запрос — правило дня
// «что именно из слоя попадает в промпт»:
//   — категория «Профиль» попадает всегда;
//   — факты прочих разрешённых категорий («Решение», «Знание») попадают,
//     только если релевантны словам вопроса (совпадение слова в ключе или
//     значении, регистронезависимо);
//   — всего не более ЛимитФактовВЗапросе фактов (сначала профиль, далее
//     по убыванию релевантности).
// Релевантность — простое пересечение слов, без векторного поиска:
// для учебного дня важен сам принцип «не всё, а отобранное».
//
// Параметры:
//   Вопрос - Строка - текущий вопрос пользователя (последнее user-сообщение);
//   Категории - Массив из ПеречислениеСсылка.KimiКатегорииПамяти, Неопределено -
//     разрешённые категории (Неопределено или пустой массив — все три).
//
// Возвращаемое значение:
//   ТаблицаЗначений - см. ТаблицаЗаметок (Ключ/Значение): отобранные факты.
//
Функция ФактыДляЗапроса(Вопрос, Категории = Неопределено) Экспорт

	Отобранные = ТаблицаЗаметок();

	ВсеФакты = ВсеФактыПамяти();
	Если ВсеФакты.Количество() = 0 Тогда
		Возврат Отобранные;
	КонецЕсли;

	Разрешённые = НормализоватьКатегории(Категории);
	Слова = СловаВопроса(Вопрос);
	Профиль = Перечисления.KimiКатегорииПамяти.Профиль;

	Кандидаты = ВсеФакты.СкопироватьКолонки();
	Кандидаты.Колонки.Добавить("Релевантность", Новый ОписаниеТипов("Число"));
	Кандидаты.Колонки.Добавить("ЭтоПрофиль", Новый ОписаниеТипов("Булево"));

	Для Каждого Факт Из ВсеФакты Цикл
		Если Разрешённые.Найти(Факт.КатегорияСсылка) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЭтоПрофиль = (Факт.КатегорияСсылка = Профиль);
		Релевантность = РелевантностьФакта(Факт, Слова);
		Если Не ЭтоПрофиль И Релевантность = 0 Тогда
			Продолжить; // непрофильные факты без пересечения со словами вопроса не идут в запрос
		КонецЕсли;

		Строка = Кандидаты.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Факт);
		Строка.Релевантность = Релевантность;
		Строка.ЭтоПрофиль = ЭтоПрофиль;
	КонецЦикла;

	Кандидаты.Сортировать("Релевантность УБЫВ");

	// Лимит распространяется только на релевантные факты: профиль (правило
	// «всегда в запросе») вне конкурса и попадает в запрос целиком.
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Не Кандидат.ЭтоПрофиль И Отобранные.Количество() >= ЛимитФактовВЗапросе() Тогда
			Продолжить;
		КонецЕсли;
		Строка = Отобранные.Добавить();
		Строка.Ключ = Кандидат.Ключ;
		Строка.Значение = Кандидат.Значение;
	КонецЦикла;

	Возврат Отобранные;

КонецФункции

// Оборачивает отобранные факты долговременной памяти в служебное user-сообщение:
// так слой памяти попадает в запрос в терминах протокола — перед проекцией
// истории диалога.
//
// Параметры:
//   Факты - ТаблицаЗначений - см. ФактыДляЗапроса.
//
// Возвращаемое значение:
//   Строка - текст сообщения для API.
//
Функция ТекстДолговременнойПамятиДляЗапроса(Факты) Экспорт

	Возврат СтрШаблон(НСтр("ru = 'Долговременная память (факты о пользователе, принятых решениях и знаниях, ключ-значение):
		|%1
		|
		|Учитывай эти факты при ответах. Если факт противоречит последним сообщениям — последние важнее.'"),
		ЗаписиВТекст(Факты));

КонецФункции

// Оборачивает заметки рабочей памяти в служебное user-сообщение. Правило слоя:
// весь блок целиком, пока задача активна (объём ограничен разумным — порядка
// пары тысяч токенов; панель «Токены по слоям» показывает оценку).
//
// Параметры:
//   Заметки - ТаблицаЗначений - см. ТаблицаЗаметок.
//
// Возвращаемое значение:
//   Строка - текст сообщения для API.
//
Функция ТекстРабочейПамятиДляЗапроса(Заметки) Экспорт

	Возврат СтрШаблон(НСтр("ru = 'Заметки по текущей задаче (рабочая память, ключ-значение):
		|%1
		|
		|Это актуальные данные текущей задачи — опирайся на них в ответах.'"),
		ЗаписиВТекст(Заметки));

КонецФункции

// Оценивает токены записей «ключ-значение» (фактов или заметок) — локальная
// оценка KimiТокеныСервер.ОценитьТокеныТекста, точных значений до вызова API нет
// (endpoint подсчёта у Kimi отсутствует, День 8).
//
// Параметры:
//   Записи - ТаблицаЗначений - см. ТаблицаЗаметок.
//
// Возвращаемое значение:
//   Число - оценка токенов блока.
//
Функция ОценитьТокеныЗаписей(Записи) Экспорт

	Если Записи.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат KimiТокеныСервер.ОценитьТокеныТекста(ЗаписиВТекст(Записи));

КонецФункции

// Переносит факты диалога в долговременную память — явное действие пользователя
// (кнопка «Сохранить в долговременную», автосохранение демо-сценариев): элемент
// справочника создаётся или обновляется по совпадению ключа (наименования).
// Факты становятся основой долговременной памяти (механизм извлечения — День 10).
// День 15 — разрешение конфликтов по типу факта: противоречащее значение ЗАМЕНЯЕТ
// сохранённое (не добавляется рядом), приоритет у факта с более поздней датой
// записи, каждая замена/дополнение фиксируется в ТЧ «История» (было → стало).
//
// Параметры:
//   Факты - ТаблицаЗначений - см. ТаблицаЗаметок (переносимые записи); если
//     у таблицы есть колонка «Тип», её значения применяются к строкам;
//   Категория - ПеречислениеСсылка.KimiКатегорииПамяти - категория сохраняемых
//     фактов (не заполнена — «Профиль»);
//   Источник - ДокументСсылка.KimiДиалог, Неопределено - диалог-источник;
//   ТипВсех - ПеречислениеСсылка.KimiТипыФактов, Неопределено - тип для записей
//     без собственного типа (не заполнен — нормализация по категории).
//
// Возвращаемое значение:
//   Структура:
//     * Всего - Число - сколько записей обработано;
//     * Создано - Число - новых фактов;
//     * Заменено - Число - перезаписано противоречащих значений;
//     * Дополнено - Число - пунктов, добавленных в накапливаемые списки;
//     * Пропущено - Число - записей без изменений (совпало значение, дубликат
//       пункта, устаревшая дата записи);
//     * Замены - Массив из Структура - журнал замен (Ключ, Действие, Было, Стало).
//
Функция СохранитьФактыВДолговременнуюПамять(Факты, Категория, Источник = Неопределено, ТипВсех = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Категория) Тогда
		Категория = Перечисления.KimiКатегорииПамяти.Профиль;
	КонецЕсли;

	Результат = Новый Структура("Всего, Создано, Заменено, Дополнено, Пропущено, Замены",
		0, 0, 0, 0, 0, Новый Массив);

	ДатаВходящих = ТекущаяДатаСеанса(); // единая дата пакета: приоритет у более поздней записи
	ЕстьКолонкаТип = (Факты.Колонки.Найти("Тип") <> Неопределено);

	Для Каждого СтрокаФакта Из Факты Цикл
		Ключ = Лев(СокрЛП(СтрокаФакта.Ключ), 100); // ограничение наименования справочника
		Если Не ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Всего = Результат.Всего + 1;

		ТипЗаписи = ТипВсех;
		Если ЕстьКолонкаТип И ЗначениеЗаполнено(СтрокаФакта.Тип) Тогда
			ТипЗаписи = СтрокаФакта.Тип;
		КонецЕсли;

		Найденный = Справочники.KimiФактыПамяти.НайтиПоНаименованию(Ключ, Истина);
		Если Не ЗначениеЗаполнено(Найденный) Тогда
			// Неопределено или пустая ссылка — платформа возвращает то и другое
			// (пустая ссылка на ПолучитьОбъект падает «Элемент не выбран!»).
			Элемент = Справочники.KimiФактыПамяти.СоздатьЭлемент();
			Элемент.Наименование = Ключ;
			Элемент.Тип = НормализоватьТип(ТипЗаписи, Категория);
			Элемент.Значение = СтрокаФакта.Значение;
			Элемент.Категория = Категория;
			Если Источник <> Неопределено Тогда
				Элемент.Источник = Источник;
			КонецЕсли;
			Элемент.ДатаЗаписи = ДатаВходящих;
			Элемент.Записать();
			Результат.Создано = Результат.Создано + 1;
			Продолжить;
		КонецЕсли;

		Элемент = Найденный.ПолучитьОбъект();
		Если Элемент.ПометкаУдаления Тогда
			Элемент.УстановитьПометкуУдаления(Ложь);
		КонецЕсли;
		Если ЗначениеЗаполнено(ТипЗаписи) Тогда
			Элемент.Тип = ТипЗаписи; // явная смена типа из формы сохранения
		КонецЕсли;
		Элемент.Категория = Категория;
		Если Источник <> Неопределено Тогда
			Элемент.Источник = Источник;
		КонецЕсли;

		ТипФакта = НормализоватьТип(Элемент.Тип, Элемент.Категория);
		НовоеЗначение = СокрЛП(СтрокаФакта.Значение);

		Если ТипФакта = Перечисления.KimiТипыФактов.Накапливаемый Тогда
			Если ДополнитьНакапливаемый(Элемент, НовоеЗначение, ДатаВходящих) Тогда
				Результат.Дополнено = Результат.Дополнено + 1;
			Иначе
				Результат.Пропущено = Результат.Пропущено + 1;
			КонецЕсли;
		Иначе
			// Перезаписываемый и временный: одно актуальное значение.
			Если СокрЛП(Элемент.Значение) = НовоеЗначение Тогда
				Результат.Пропущено = Результат.Пропущено + 1; // подтверждение без изменений
			ИначеЕсли Элемент.ДатаЗаписи > ДатаВходящих Тогда
				// Сохранённый факт новее входящего — приоритет у более поздней
				// даты записи (устаревший вход не затирает свежую память).
				Результат.Пропущено = Результат.Пропущено + 1;
				Результат.Замены.Добавить(Новый Структура("Ключ, Действие, Было, Стало",
					Ключ, "отклонено (устаревшая дата)", Элемент.Значение, НовоеЗначение));
			Иначе
				БылоЗначение = Элемент.Значение;
				ЗафиксироватьЗамену(Элемент, НовоеЗначение, ДатаВходящих);
				Результат.Заменено = Результат.Заменено + 1;
				Результат.Замены.Добавить(Новый Структура("Ключ, Действие, Было, Стало",
					Ключ, "замена", БылоЗначение, НовоеЗначение));
			КонецЕсли;
		КонецЕсли;

		Элемент.Записать();
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Очищает долговременную память (кнопка «Очистить долговременную память»
// с подтверждением): все факты получают пометку удаления — по идиоме проекта
// удаление обратимо, выборки памяти помеченные не видят.
//
// Возвращаемое значение:
//   Число - сколько фактов помечено на удаление.
//
Функция ОчиститьДолговременнуюПамять() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Факты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.KimiФактыПамяти КАК Факты
	|ГДЕ
	|	НЕ Факты.ПометкаУдаления";

	Очищено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Выборка.Ссылка.ПолучитьОбъект();
		Элемент.УстановитьПометкуУдаления(Истина);
		Очищено = Очищено + 1;
	КонецЦикла;

	Возврат Очищено;

КонецФункции

// Возвращает имена типов фактов долговременной памяти (в терминах перечисления
// KimiТипыФактов) — для списков выбора формы и журнала. Точка синхронизации
// значений — имена значений перечисления.
//
// Возвращаемое значение:
//   Массив из Строка - «Перезаписываемый», «Накапливаемый», «Временный».
//
Функция ИменаТиповФактов() Экспорт

	Имена = Новый Массив;
	Имена.Добавить("Перезаписываемый");
	Имена.Добавить("Накапливаемый");
	Имена.Добавить("Временный");

	Возврат Имена;

КонецФункции

// Отображает ссылку перечисления в имя типа факта (строкой — для таблиц формы
// и журнала; клиент перечисления не видит).
//
// Параметры:
//   Тип - ПеречислениеСсылка.KimiТипыФактов - отображаемый тип.
//
// Возвращаемое значение:
//   Строка - имя типа; пустая ссылка — пустая строка.
//
Функция ИмяТипаФакта(Тип) Экспорт

	Если Тип = Перечисления.KimiТипыФактов.Перезаписываемый Тогда
		Возврат "Перезаписываемый";
	ИначеЕсли Тип = Перечисления.KimiТипыФактов.Накапливаемый Тогда
		Возврат "Накапливаемый";
	ИначеЕсли Тип = Перечисления.KimiТипыФактов.Временный Тогда
		Возврат "Временный";
	КонецЕсли;

	Возврат "";

КонецФункции

// Преобразует имя типа в ссылку перечисления; неизвестное или пустое имя —
// Неопределено (нормализация в ТипПоУмолчанию).
//
// Параметры:
//   Имя - Строка - имя типа (см. ИменаТиповФактов).
//
// Возвращаемое значение:
//   ПеречислениеСсылка.KimiТипыФактов, Неопределено - тип факта.
//
Функция ТипФактаПоИмени(Имя) Экспорт

	Если Имя = "Перезаписываемый" Тогда
		Возврат Перечисления.KimiТипыФактов.Перезаписываемый;
	ИначеЕсли Имя = "Накапливаемый" Тогда
		Возврат Перечисления.KimiТипыФактов.Накапливаемый;
	ИначеЕсли Имя = "Временный" Тогда
		Возврат Перечисления.KimiТипыФактов.Временный;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает тип факта по умолчанию для категории (правило Дня 15): принятые
// решения копятся списком, профиль и знания живут одним актуальным значением.
//
// Параметры:
//   Категория - ПеречислениеСсылка.KimiКатегорииПамяти - категория факта.
//
// Возвращаемое значение:
//   ПеречислениеСсылка.KimiТипыФактов - тип по умолчанию.
//
Функция ТипПоУмолчанию(Категория) Экспорт

	Если Категория = Перечисления.KimiКатегорииПамяти.Решение Тогда
		Возврат Перечисления.KimiТипыФактов.Накапливаемый;
	КонецЕсли;

	Возврат Перечисления.KimiТипыФактов.Перезаписываемый;

КонецФункции

// Возвращает учебный сценарий дня «факты меняются по ходу диалога» (кнопка
// «Демо: изменение фактов»): серия сообщений, каждое из которых порождает факт
// или меняет его; после каждого изменения — контрольный вопрос в НОВОМ чате
// (честная проверка памяти: агент знает факт только из инъекции, прецедент
// Дня 11). Типы фактов заявлены шагами явно (сценарий — точка синхронизации
// ключей с ПодготовитьДемоУстаревания). Контрольные вопросы сформулированы
// без ответа в тексте (прецедент реестра Дня 9).
//
// Возвращаемое значение:
//   Массив из Структура (все ключи заполнены):
//     * ТипШага - Строка - «изменение» / «контроль» / «рабочая»;
//     * Текст - Строка - сообщение пользователя (для «контроль» — пусто);
//     * ФактКлюч - Строка - ключ факта (для «контроль» — ключ проверяемого факта);
//     * ФактЗначение - Строка - новое значение (для «рабочая» — текст заметки);
//     * ФактТип - Строка - имя типа (см. ИменаТиповФактов; пусто для «контроль»);
//     * ФактКатегория - Строка - имя категории (пусто для «рабочая»/«контроль»);
//     * Вопрос - Строка - контрольный вопрос (только для «контроль»);
//     * Эталон - Строка - эталонное актуальное значение (пункты через «;»);
//     * Было - Строка - значение до изменения (для проверки промпта; пусто, если создаётся).
//
Функция СценарийИзмененияФактов() Экспорт

	Сценарий = Новый Массив;

	ДобавитьШагИзмененияФакта(Сценарий,
		НСтр("ru = 'Проект ""Северный ветер"": текущий срок сдачи по договору — 15.12.2026. Зафиксируй срок в долговременной памяти как актуальный.'"),
		"Срок сдачи", "15.12.2026", "Перезаписываемый", "Знание", "");
	ДобавитьШагИзмененияФакта(Сценарий,
		НСтр("ru = 'Срок сдачи сдвинулся: заказчик перенёс приёмку, новый срок — 22.12.2026. Старое значение в памяти больше не актуально — обнови.'"),
		"Срок сдачи", "22.12.2026", "Перезаписываемый", "Знание", "15.12.2026");
	ДобавитьШагКонтроляУстаревания(Сценарий,
		НСтр("ru = 'Назови текущий срок сдачи проекта ""Северный ветер"".'"),
		"22.12.2026", "Срок сдачи", "15.12.2026");

	ДобавитьШагРабочейЗаметки(Сценарий,
		НСтр("ru = 'Заметка по текущей задаче (в рабочую память): параметры прогона — стенд test-01, окно 20:00–22:00.'"),
		"Параметры прогона", "стенд test-01, окно 20:00–22:00");

	ДобавитьШагИзмененияФакта(Сценарий,
		НСтр("ru = 'Требование заказчика: все данные храним только в облаке. Статус требования — актуально. Зафиксируй в долговременной памяти.'"),
		"Требование облачного хранения", "актуально", "Перезаписываемый", "Знание", "");
	ДобавитьШагИзмененияФакта(Сценарий,
		НСтр("ru = 'Требование облачного хранения отменено: заказчик передумал и купил собственный сервер. Статус требования — отменено. Обнови в памяти.'"),
		"Требование облачного хранения", "отменено", "Перезаписываемый", "Знание", "актуально");
	ДобавитьШагКонтроляУстаревания(Сценарий,
		НСтр("ru = 'Какой сейчас статус у требования облачного хранения данных?'"),
		"отменено", "Требование облачного хранения", "актуально");

	ДобавитьШагИзмененияФакта(Сценарий,
		НСтр("ru = 'По отчётности выбран подход: все отчёты строим на СКД. Зафиксируй как актуальный.'"),
		"Подход к отчётам", "отчёты на СКД", "Перезаписываемый", "Знание", "");
	ДобавитьШагИзмененияФакта(Сценарий,
		НСтр("ru = 'Подход к отчётности изменился: СКД не прошла согласование, переходим на печатные формы на табличном документе. Обнови в памяти.'"),
		"Подход к отчётам", "печатные формы на табличном документе", "Перезаписываемый", "Знание", "отчёты на СКД");
	ДобавитьШагКонтроляУстаревания(Сценарий,
		НСтр("ru = 'Какой подход к отчётам выбран в проекте сейчас?'"),
		"печатные формы на табличном документе", "Подход к отчётам", "отчёты на СКД");

	ДобавитьШагИзмененияФакта(Сценарий,
		НСтр("ru = 'Принято архитектурное решение: СУБД проекта — PostgreSQL 16. Зафиксируй в памяти принятых решений.'"),
		"Принятые решения", "СУБД — PostgreSQL 16", "Накапливаемый", "Решение", "");
	ДобавитьШагИзмененияФакта(Сценарий,
		НСтр("ru = 'Ещё одно принятое решение: клиент — тонкий, без модальных окон. Дополни память принятых решений.'"),
		"Принятые решения", "тонкий клиент без модальных окон", "Накапливаемый", "Решение", "");
	ДобавитьШагКонтроляУстаревания(Сценарий,
		НСтр("ru = 'Перечисли принятые архитектурные решения проекта.'"),
		"PostgreSQL 16; тонкий клиент без модальных окон", "Принятые решения", "");

	ДобавитьШагИзмененияФакта(Сценарий,
		НСтр("ru = 'На время приёмки назначен ответственный — Иван Петров. Зафиксируй как временную запись проекта (после завершения задачи она не нужна).'"),
		"Ответственный за прогон приёмки", "Иван Петров", "Временный", "Знание", "");
	ДобавитьШагКонтроляУстаревания(Сценарий,
		НСтр("ru = 'Кто ответственный за прогон приёмки?'"),
		"Иван Петров", "Ответственный за прогон приёмки", "");

	Возврат Сценарий;

КонецФункции

// Завершает задачу (кнопка «Завершить задачу» Дня 15): очищает рабочую память
// текущего диалога (заметки задачи) и помечает на удаление временные факты
// долговременной памяти; перезаписываемые и накапливаемые факты сохраняются.
//
// Параметры:
//   ДиалогСсылка - ДокументСсылка.KimiДиалог - текущий диалог (может быть пустой —
//     чат ещё не сохранялся; тогда очищается только память формы, документ не нужен).
//
// Возвращаемое значение:
//   Структура:
//     * ОчищеноЗаметок - Число - сколько заметок рабочей памяти удалено;
//     * УдаленоВременных - Число - сколько временных фактов помечено на удаление;
//     * СохраненоФактов - Число - сколько фактов долговременной памяти осталось.
//
Функция ЗавершитьЗадачу(ДиалогСсылка) Экспорт

	Результат = Новый Структура("ОчищеноЗаметок, УдаленоВременных, СохраненоФактов", 0, 0, 0);

	Если ЗначениеЗаполнено(ДиалогСсылка) Тогда
		Диалог = ДиалогСсылка.ПолучитьОбъект();
		Результат.ОчищеноЗаметок = Диалог.РабочаяПамять.Количество();
		Диалог.РабочаяПамять.Очистить();
		Диалог.Записать();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Факты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.KimiФактыПамяти КАК Факты
	|ГДЕ
	|	НЕ Факты.ПометкаУдаления
	|	И Факты.Тип = &Временный";
	Запрос.УстановитьПараметр("Временный", Перечисления.KimiТипыФактов.Временный);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Выборка.Ссылка.ПолучитьОбъект();
		Элемент.УстановитьПометкуУдаления(Истина);
		Результат.УдаленоВременных = Результат.УдаленоВременных + 1;
	КонецЦикла;

	ЗапросСохранившихся = Новый Запрос;
	ЗапросСохранившихся.Текст = "ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Факты.Ссылка) КАК Сохранено
	|ИЗ
	|	Справочник.KimiФактыПамяти КАК Факты
	|ГДЕ
	|	НЕ Факты.ПометкаУдаления";
	ВыборкаСохранившихся = ЗапросСохранившихся.Выполнить().Выбрать();
	Если ВыборкаСохранившихся.Следующий() Тогда
		Результат.СохраненоФактов = ВыборкаСохранившихся.Сохранено;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Помечает на удаление факты с ключами демо-сценария Дня 15 — прогон всегда
// стартует с чистых ключей, повторения демо детерминированы (прецедент кнопки
// «Восстановить задачи» Дней 3–4 и «Демо-инварианты» Дня 14). Ключи — те же,
// что в СценарийИзмененияФактов (точка синхронизации).
//
// Возвращаемое значение:
//   Число - сколько фактов помечено на удаление.
//
Функция ПодготовитьДемоУстаревания() Экспорт

	Удалено = 0;
	Для Каждого Ключ Из КлючиДемоУстаревания() Цикл
		Найденный = Справочники.KimiФактыПамяти.НайтиПоНаименованию(Ключ, Истина);
		Если ЗначениеЗаполнено(Найденный) И Не Найденный.ПометкаУдаления Тогда
			Элемент = Найденный.ПолучитьОбъект();
			Элемент.УстановитьПометкуУдаления(Истина);
			Удалено = Удалено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Удалено;

КонецФункции

// Возвращает таблицу фактов долговременной памяти с типами и историей замен
// (таблица группы «Устаревание памяти»): эффективный тип (нормализация по
// категории, если тип не задан), дата записи строкой, число записей истории.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Ключ - Строка(100) - наименование факта;
//     * Тип - Строка - имя типа (см. ИменаТиповФактов);
//     * Значение - Строка - актуальное значение;
//     * ДатаЗаписи - Строка - дата/время последней записи (ДЛФ=DT), пусто — не записана;
//     * Замен - Число - сколько изменений зафиксировано в истории.
//
Функция ФактыСИсторией() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Ключ", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	Таблица.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Таблица.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ДатаЗаписи", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(25)));
	Таблица.Колонки.Добавить("Замен", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный)));

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Факты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.KimiФактыПамяти КАК Факты
	|ГДЕ
	|	НЕ Факты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Факты.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл // объекты читаем ради ТЧ «История»: масштаб — десятки фактов
		Элемент = Выборка.Ссылка.ПолучитьОбъект();
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Ключ = Элемент.Наименование;
		НоваяСтрока.Тип = ИмяТипаФакта(НормализоватьТип(Элемент.Тип, Элемент.Категория));
		НоваяСтрока.Значение = Элемент.Значение;
		НоваяСтрока.ДатаЗаписи = ?(ЗначениеЗаполнено(Элемент.ДатаЗаписи),
			Формат(Элемент.ДатаЗаписи, "ДЛФ=DT"), "");
		НоваяСтрока.Замен = Элемент.История.Количество();
	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Возвращает историю замен факта по его ключу (таблица группы «Устаревание
// памяти» при активации строки): каждая замена/дополнение — «было → стало».
//
// Параметры:
//   Ключ - Строка - наименование факта (см. ФактыСИсторией).
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * ДатаИзменения - Строка - дата/время изменения (ДЛФ=DT);
//     * Действие - Строка - «замена» / «дополнение»;
//     * БылоЗначение - Строка - значение до изменения (пусто при создании списка);
//     * СталоЗначение - Строка - значение после изменения.
//
Функция ИсторияФакта(Ключ) Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ДатаИзменения", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(25)));
	Таблица.Колонки.Добавить("Действие", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Таблица.Колонки.Добавить("БылоЗначение", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("СталоЗначение", Новый ОписаниеТипов("Строка"));

	Найденный = Справочники.KimiФактыПамяти.НайтиПоНаименованию(Лев(СокрЛП(Ключ), 100), Истина);
	Если Не ЗначениеЗаполнено(Найденный) Тогда
		Возврат Таблица;
	КонецЕсли;

	Элемент = Найденный.ПолучитьОбъект();
	Для Каждого ЗаписьИстории Из Элемент.История Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.ДатаИзменения = Формат(ЗаписьИстории.ДатаИзменения, "ДЛФ=DT");
		НоваяСтрока.Действие = ЗаписьИстории.Действие;
		НоваяСтрока.БылоЗначение = ЗаписьИстории.БылоЗначение;
		НоваяСтрока.СталоЗначение = ЗаписьИстории.СталоЗначение;
	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Сверяет ответы контрольных вопросов с эталонами простой моделью (Google AI
// Studio — прецедент Дней 10–14) и проставляет отметку «Актуальное»: назвал ли
// агент актуальное значение (эталон может содержать несколько пунктов через «;»
// — тогда нужны все). Строки без ответа и ошибки вызова пропускаются.
//
// Параметры:
//   Реестр - ТаблицаЗначений - колонки Вопрос, Эталон, Ответ, Актуальное (Булево);
//     отметки Актуальное проставляются в переданной таблице.
//
// Возвращаемое значение:
//   Структура:
//     * Оценено - Число - сколько ответов оценено;
//     * Пропущено - Число - сколько пропущено (пустой ответ или ошибка вызова).
//
Функция ОценитьАктуальностьОтветов(Реестр) Экспорт

	Результат = Новый Структура("Оценено, Пропущено", 0, 0);

	Для Каждого СтрокаРеестра Из Реестр Цикл
		Если Не ЗначениеЗаполнено(СтрокаРеестра.Ответ) Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Оценка = ОценитьАктуальностьОтвета(СтрокаРеестра.Вопрос, СтрокаРеестра.Эталон, СтрокаРеестра.Ответ);
		Если Оценка = Неопределено Тогда
			Результат.Пропущено = Результат.Пропущено + 1; // ошибка вызова — отметку не трогаем
		Иначе
			СтрокаРеестра.Актуальное = Оценка;
			Результат.Оценено = Результат.Оценено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Детерминированно проверяет, что в текст инъекции долговременной памяти
// не попали устаревшие значения и попали актуальные (требование Дня 15
// «проверьте, что старые значения не попадают в промпт»): устаревшие ищутся
// подстрокой, актуальные — пункты эталона через «;».
//
// Параметры:
//   Вопрос - Строка - контрольный вопрос (правило отбора ФактыДляЗапроса — как
//     в реальном запросе);
//   Категории - Массив из ПеречислениеСсылка.KimiКатегорииПамяти - разрешённые
//     категории (Неопределено — все);
//   Эталон - Строка - актуальное значение (несколько пунктов через «;»);
//   СтарыеЗначения - Массив из Строка - значения, которые должны отсутствовать.
//
// Возвращаемое значение:
//   Структура:
//     * Чист - Булево - Истина: устаревших нет и все пункты эталона на месте;
//     * Детали - Строка - что именно найдено/не найдено (для журнала).
//
Функция ПромптЧист(Вопрос, Категории, Эталон, СтарыеЗначения) Экспорт

	Факты = ФактыДляЗапроса(Вопрос, Категории);
	ТекстПромпта = ТекстДолговременнойПамятиДляЗапроса(Факты);

	Утечки = Новый Массив;
	Для Каждого СтароеЗначение Из СтарыеЗначения Цикл
		Старое = СокрЛП(СтароеЗначение);
		Если ЗначениеЗаполнено(Старое) И СтрНайти(ТекстПромпта, Старое) > 0 Тогда
			Утечки.Добавить(Старое);
		КонецЕсли;
	КонецЦикла;

	Отсутствуют = Новый Массив;
	Для Каждого ПунктЭталона Из СтрРазделить(Эталон, ";") Цикл
		Пункт = СокрЛП(ПунктЭталона);
		Если ЗначениеЗаполнено(Пункт) И СтрНайти(ТекстПромпта, Пункт) = 0 Тогда
			Отсутствуют.Добавить(Пункт);
		КонецЕсли;
	КонецЦикла;

	Части = Новый Массив;
	Если Утечки.Количество() > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'в промпте устаревшие значения: %1'"),
			СтрСоединить(Утечки, "; ")));
	КонецЕсли;
	Если Отсутствуют.Количество() > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'в промпте не найдены актуальные: %1'"),
			СтрСоединить(Отсутствуют, "; ")));
	КонецЕсли;
	Если Части.Количество() = 0 Тогда
		Части.Добавить(НСтр("ru = 'только актуальные значения'"));
	КонецЕсли;

	Возврат Новый Структура("Чист, Детали", Утечки.Количество() = 0 И Отсутствуют.Количество() = 0,
		СтрСоединить(Части, ", "));

КонецФункции

// Извлекает предлагаемые записи «ключ-значение» из последнего обмена
// (user-сообщение + ответ агента) вызовом модели-экстрактора — тот же
// механизм, что обновляет факты стратегии «Факты» Дня 10: факты Дня 10
// являются основой памяти Дня 11. Используется кнопкой «В память из обмена»
// (предпросмотр перед явным сохранением) и автосохранением слоёв сценария.
// Параметр «ЛегкаяМодель» (режим Google-only Дня 11) переводит вызов на лёгкую
// модель Google AI Studio — чтобы приёмка дня шла без обращений к Kimi.
//
// Параметры:
//   ТекстПользователя - Строка - последнее сообщение пользователя;
//   ТекстАссистента - Строка - ответ агента (может быть пустым);
//   ЛегкаяМодель - Булево - Истина: вызов через Google AI Studio (умолчание Ложь).
//
// Возвращаемое значение:
//   Структура - см. KimiКонтекстСервер.ОбновитьФакты (Факты, Токены…, Ошибка).
//
Функция ФактыПоследнегоОбмена(ТекстПользователя, ТекстАссистента, ЛегкаяМодель = Ложь) Экспорт

	Возврат KimiКонтекстСервер.ОбновитьФакты(ТаблицаЗаметок(), ТекстПользователя, ТекстАссистента, ЛегкаяМодель);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает лимит фактов долговременной памяти в одном запросе: защита
// контекстного окна от разрастания слоя.
//
Функция ЛимитФактовВЗапросе()

	Возврат 20;

КонецФункции

// Возвращает все факты долговременной памяти ссылками категорий
// (для отбора ФактыДляЗапроса).
//
Функция ВсеФактыПамяти()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Факты.Наименование КАК Ключ,
	|	Факты.Значение КАК Значение,
	|	Факты.Категория КАК КатегорияСсылка
	|ИЗ
	|	Справочник.KimiФактыПамяти КАК Факты
	|ГДЕ
	|	НЕ Факты.ПометкаУдаления";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Приводит список разрешённых категорий к корректному виду: пустой или
// незаполненный список — все три категории.
//
Функция НормализоватьКатегории(Категории)

	Все = Новый Массив;
	Все.Добавить(Перечисления.KimiКатегорииПамяти.Профиль);
	Все.Добавить(Перечисления.KimiКатегорииПамяти.Решение);
	Все.Добавить(Перечисления.KimiКатегорииПамяти.Знание);

	Если Категории = Неопределено Или Категории.Количество() = 0 Тогда
		Возврат Все;
	КонецЕсли;

	Разрешённые = Новый Массив;
	Для Каждого Категория Из Категории Цикл
		Если ЗначениеЗаполнено(Категория) И Разрешённые.Найти(Категория) = Неопределено Тогда
			Разрешённые.Добавить(Категория);
		КонецЕсли;
	КонецЦикла;

	Возврат ?(Разрешённые.Количество() = 0, Все, Разрешённые);

КонецФункции

// Разбирает вопрос на слова-кандидаты релевантности: нижний регистр, знаки
// препинания — в пробелы, слова короче трёх символов отброшены (предлоги,
// союзы, частицы не различают факты).
//
Функция СловаВопроса(Вопрос)

	Нормализованный = НРег(СтрЗаменить(СокрЛП(Вопрос), Символы.ПС, " "));
	Замены = СтрРазделить("? ! , . : ; ( ) « » "" №", " ");
	Для Каждого Знак Из Замены Цикл
		Нормализованный = СтрЗаменить(Нормализованный, Знак, " ");
	КонецЦикла;

	Слова = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Нормализованный, " ", Ложь) Цикл
		Если СтрДлина(Часть) >= 3 Тогда
			Слова.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;

	Возврат Слова;

КонецФункции

// Считает пересечение слов вопроса с текстом факта (ключ + значение):
// сколько слов вопроса встречаются в факте.
//
Функция РелевантностьФакта(Факт, Слова)

	ТекстФакта = НРег(Факт.Ключ + " " + Факт.Значение);

	Релевантность = 0;
	Для Каждого Слово Из Слова Цикл
		Если СтрНайти(ТекстФакта, Слово) > 0 Тогда
			Релевантность = Релевантность + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Релевантность;

КонецФункции

// Линеаризует записи «ключ-значение» в текст для промпта: «- ключ: значение»
// по строке (по образцу ФактыВТекст KimiКонтекстСервер — единый формат слоёв).
//
Функция ЗаписиВТекст(Записи)

	Если Записи.Количество() = 0 Тогда
		Возврат НСтр("ru = '— (пусто)'");
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Строки.Добавить(СтрШаблон(НСтр("ru = '- %1: %2'"), Запись.Ключ, Запись.Значение));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Добавляет шаг в сценарий заполнения памяти.
//
Процедура ДобавитьШагСценария(Сценарий, Текст, Слой, ИмяКатегории)

	Сценарий.Добавить(Новый Структура("Текст, Слой, Категория", Текст, Слой, ИмяКатегории));

КонецПроцедуры

// Добавляет вопрос в реестр контрольных вопросов проверки памяти.
//
Процедура ДобавитьВопрос(Реестр, Слой, Вопрос, Эталон)

	Строка = Реестр.Добавить();
	Строка.Слой = Слой;
	Строка.Вопрос = Вопрос;
	Строка.Эталон = Эталон;

КонецПроцедуры

// Нормализует тип факта (День 15): пустая ссылка — тип по умолчанию категории.
//
Функция НормализоватьТип(Тип, Категория)

	Если ЗначениеЗаполнено(Тип) Тогда
		Возврат Тип;
	КонецЕсли;

	Возврат ТипПоУмолчанию(Категория);

КонецФункции

// Заменяет значение перезаписываемого/временного факта с фиксацией замены
// в ТЧ «История» (что было, что стало) и обновлением даты записи.
//
Процедура ЗафиксироватьЗамену(Элемент, НовоеЗначение, ДатаИзменения)

	ЗаписьИстории = Элемент.История.Добавить();
	ЗаписьИстории.ДатаИзменения = ДатаИзменения;
	ЗаписьИстории.Действие = "замена";
	ЗаписьИстории.БылоЗначение = Элемент.Значение;
	ЗаписьИстории.СталоЗначение = НовоеЗначение;

	Элемент.Значение = НовоеЗначение;
	Элемент.ДатаЗаписи = ДатаИзменения;

КонецПроцедуры

// Дополняет накапливаемый факт новым пунктом списка «пункт (дата)» с фиксацией
// дополнения в ТЧ «История». Пункт, уже присутствующий в списке (по тексту до
// маркера даты), не дублируется — повторное сохранение идемпотентно.
//
// Возвращаемое значение:
//   Булево - Истина: пункт добавлен; Ложь: пустой пункт или дубликат.
//
Функция ДополнитьНакапливаемый(Элемент, Пункт, ДатаИзменения)

	Если Не ЗначениеЗаполнено(Пункт) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого СтрокаСписка Из СтрРазделить(Элемент.Значение, Символы.ПС) Цикл
		Если ТекстПункта(СтрокаСписка) = Пункт Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	БылоЗначение = Элемент.Значение;
	НоваяСтрока = Пункт + " (" + Формат(ДатаИзменения, "ДЛФ=D") + ")";
	Элемент.Значение = ?(ЗначениеЗаполнено(БылоЗначение), БылоЗначение + Символы.ПС, "") + НоваяСтрока;

	ЗаписьИстории = Элемент.История.Добавить();
	ЗаписьИстории.ДатаИзменения = ДатаИзменения;
	ЗаписьИстории.Действие = "дополнение";
	ЗаписьИстории.БылоЗначение = БылоЗначение;
	ЗаписьИстории.СталоЗначение = Элемент.Значение;

	Элемент.ДатаЗаписи = ДатаИзменения;

	Возврат Истина;

КонецФункции

// Отрезает от строки списка накапливаемого факта маркер даты « (дд.мм.гггг)» —
// чистый текст пункта для сравнения дубликатов.
//
Функция ТекстПункта(СтрокаСписка)

	Строка = СокрЛП(СтрокаСписка);
	ПозицияМаркера = СтрНайти(Строка, " (");
	Если ПозицияМаркера > 0 Тогда
		Возврат СокрЛП(Лев(Строка, ПозицияМаркера - 1));
	КонецЕсли;

	Возврат Строка;

КонецФункции

// Ключи фактов демо-сценария Дня 15 (точка синхронизации с
// СценарийИзмененияФактов): перед прогоном помечаются на удаление, чтобы
// повторы демо были детерминированы.
//
// Возвращаемое значение:
//   Массив из Строка - ключи фактов сценария.
//
Функция КлючиДемоУстаревания()

	Ключи = Новый Массив;
	Ключи.Добавить("Срок сдачи");
	Ключи.Добавить("Требование облачного хранения");
	Ключи.Добавить("Подход к отчётам");
	Ключи.Добавить("Принятые решения");
	Ключи.Добавить("Ответственный за прогон приёмки");

	Возврат Ключи;

КонецФункции

// Добавляет шаг-«изменение» в сценарий Дня 15: сообщение в рабочий чат + факт,
// который прогон сохранит в долговременную память с заявленным типом.
//
Процедура ДобавитьШагИзмененияФакта(Сценарий, Текст, ФактКлюч, ФактЗначение, ФактТип, ФактКатегория, Было)

	Сценарий.Добавить(Новый Структура("ТипШага, Текст, ФактКлюч, ФактЗначение, ФактТип, ФактКатегория, Вопрос, Эталон, Было",
		"изменение", Текст, ФактКлюч, ФактЗначение, ФактТип, ФактКатегория, "", "", Было));

КонецПроцедуры

// Добавляет шаг-«контроль» в сценарий Дня 15: контрольный вопрос в новом чате
// (проверка того, что память отдаёт актуальное значение).
//
Процедура ДобавитьШагКонтроляУстаревания(Сценарий, Вопрос, Эталон, ФактКлюч, Было)

	Сценарий.Добавить(Новый Структура("ТипШага, Текст, ФактКлюч, ФактЗначение, ФактТип, ФактКатегория, Вопрос, Эталон, Было",
		"контроль", "", ФактКлюч, "", "", "", Вопрос, Эталон, Было));

КонецПроцедуры

// Добавляет шаг-«рабочая» в сценарий Дня 15: заметка в рабочую память текущей
// задачи (используется проверкой очистки после завершения задачи).
//
Процедура ДобавитьШагРабочейЗаметки(Сценарий, Текст, ЗаметкаКлюч, ЗаметкаЗначение)

	Сценарий.Добавить(Новый Структура("ТипШага, Текст, ФактКлюч, ФактЗначение, ФактТип, ФактКатегория, Вопрос, Эталон, Было",
		"рабочая", Текст, ЗаметкаКлюч, ЗаметкаЗначение, "", "", "", "", ""));

КонецПроцедуры

// Сверяет один ответ с эталоном простой моделью (Google AI Studio — общая
// точка смены имени ЛегкаяМодельGoogle, прецедент судей Дней 10–14): ответ
// засчитывается, только если содержит актуальное эталонное значение (все
// пункты, если их несколько через «;»); устаревшее значение — отказ.
//
Функция ОценитьАктуальностьОтвета(Вопрос, Эталон, Ответ)

	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("Роль, Текст", "user",
		ТекстЗапросаОценкиАктуальности(Вопрос, Эталон, Ответ)));

	Параметры = Новый Структура;
	Параметры.Вставить("Модель", KimiКонтекстСервер.ЛегкаяМодельGoogle());
	Параметры.Вставить("АдресСервера", "generativelanguage.googleapis.com");
	Параметры.Вставить("БазовыйПуть", "/v1beta/openai");
	Параметры.Вставить("КлючAPI", Константы.GeminiApiKey.Получить());
	Параметры.Вставить("МаксимумТокенов", 10);

	Вызов = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, Параметры);

	ТекстОтвета = НРег(СокрЛП(?(Вызов.Текст = Неопределено, "", Вызов.Текст)));
	Если СтрНачинаетсяС(ТекстОтвета, "да") Тогда
		Возврат Истина;
	ИначеЕсли СтрНачинаетсяС(ТекстОтвета, "нет") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Собирает текст запроса к модели-сверяющей актуальность: вопрос, эталон
// (может быть много пунктов через «;») и ответ агента; инструкция ответить
// строго одним словом «да» или «нет».
//
Функция ТекстЗапросаОценкиАктуальности(Вопрос, Эталон, Ответ)

	Возврат СтрШаблон(НСтр("ru = 'Ты — строгий проверяющий учебного теста на актуальность памяти ИИ-агента.
		|Вопрос: %1
		|Эталонное актуальное значение: %2
		|Ответ агента: %3
		|
		|Эталон может содержать несколько пунктов, разделённых «;» — тогда ответ засчитывается, только если содержит ВСЕ пункты (допустимы перефраз и другой порядок слов, не допустимы подмена факта и противоречие). Если агент назвал устаревшее значение вместо эталонного или вместе с ним — ответь «нет». Ответь строго одним словом: да или нет.'"),
		Вопрос, Эталон, Ответ);

КонецФункции

#КонецОбласти
