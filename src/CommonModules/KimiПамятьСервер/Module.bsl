#Область ПрограммныйИнтерфейс

// Возвращает идентификатор слоя «краткосрочная память» — текущий диалог:
// в запрос попадает проекция истории по стратегии управления контекстом
// (Дни 9–10): полная история / хвост N / факты диалога + хвост / сводка + хвост.
//
Функция СлойКраткосрочная() Экспорт

	Возврат "Краткосрочная";

КонецФункции

// Возвращает идентификатор слоя «рабочая память» — заметки текущей задачи:
// табличная часть РабочаяПамять документа KimiДиалог; в запрос попадает
// весь блок целиком, пока задача активна.
//
Функция СлойРабочая() Экспорт

	Возврат "Рабочая";

КонецФункции

// Возвращает идентификатор слоя «долговременная память» — факты справочника
// KimiФактыПамяти (профиль, решения, знания); в запрос попадают по правилу
// отбора ФактыДляЗапроса (профиль всегда + релевантные вопросу).
//
Функция СлойДолговременная() Экспорт

	Возврат "Долговременная";

КонецФункции

// Возвращает имена категорий долговременной памяти (в терминах перечисления
// KimiКатегорииПамяти) — для подписей и списков выбора формы. Точка синхронизации
// значений — имена значений перечисления.
//
// Возвращаемое значение:
//   Массив из Строка - «Профиль», «Решение», «Знание».
//
Функция ИменаКатегорий() Экспорт

	Имена = Новый Массив;
	Имена.Добавить("Профиль");
	Имена.Добавить("Решение");
	Имена.Добавить("Знание");

	Возврат Имена;

КонецФункции

// Отображает ссылку перечисления в имя категории (строкой — для таблиц формы
// и журнала; клиент перечисления не видит).
//
// Параметры:
//   Категория - ПеречислениеСсылка.KimiКатегорииПамяти - отображаемая категория.
//
// Возвращаемое значение:
//   Строка - «Профиль» / «Решение» / «Знание»; пустая ссылка — пустая строка.
//
Функция ИмяКатегории(Категория) Экспорт

	Если Категория = Перечисления.KimiКатегорииПамяти.Решение Тогда
		Возврат "Решение";
	ИначеЕсли Категория = Перечисления.KimiКатегорииПамяти.Знание Тогда
		Возврат "Знание";
	ИначеЕсли Категория = Перечисления.KimiКатегорииПамяти.Профиль Тогда
		Возврат "Профиль";
	КонецЕсли;

	Возврат "";

КонецФункции

// Преобразует имя категории в ссылку перечисления; неизвестное или пустое
// имя трактуется как «Профиль» — безопасное умолчание (профиль всегда
// допустим в запросе и ничего не ломает).
//
// Параметры:
//   Имя - Строка - имя категории (см. ИменаКатегорий).
//
// Возвращаемое значение:
//   ПеречислениеСсылка.KimiКатегорииПамяти - категория.
//
Функция КатегорияПоИмени(Имя) Экспорт

	Если Имя = "Решение" Тогда
		Возврат Перечисления.KimiКатегорииПамяти.Решение;
	ИначеЕсли Имя = "Знание" Тогда
		Возврат Перечисления.KimiКатегорииПамяти.Знание;
	Иначе
		Возврат Перечисления.KimiКатегорииПамяти.Профиль;
	КонецЕсли;

КонецФункции

// Возвращает пустую таблицу заметок рабочей памяти: колонки Ключ и Значение.
// Формат совпадает с таблицей фактов (KimiКонтекстСервер.ТаблицаФактов) —
// единый «ключ-значение» всех слоёв памяти, конструктор переиспользуется.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Ключ - Строка(100) - короткое имя заметки;
//     * Значение - Строка - содержание заметки.
//
Функция ТаблицаЗаметок() Экспорт

	Возврат KimiКонтекстСервер.ТаблицаФактов();

КонецФункции

// Возвращает учебный сценарий заполнения слоёв памяти (кнопка «Демо: заполнить
// слои»): серия сообщений, каждое из которых порождает данные конкретного слоя.
// Демо-прогон сохраняет извлечённые факты в заявленный слой автоматически
// (явный выбор зафиксирован в сценарии и виден в журнале); в свободной игре
// слой выбирается кнопками «Сохранить в долговременную / в рабочую».
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Текст - Строка - сообщение пользователя;
//     * Слой - Строка - идентификатор слоя (см. СлойКраткосрочная/Рабочая/Долговременная);
//     * Категория - Строка - имя категории (только для долговременной памяти,
//       см. ИменаКатегорий; для прочих слоёв — пусто).
//
Функция СценарийЗаполненияПамяти() Экспорт

	Сценарий = Новый Массив;

	ДобавитьШагСценария(Сценарий,
		НСтр("ru = 'Меня зовут Анна Ветрова, я руководитель проекта ""Северный ветер"" — небольшой сети кофеен. Давай знакомиться: запомни, кто я и какой у меня проект.'"),
		СлойДолговременная(), "Профиль");
	ДобавитьШагСценария(Сценарий,
		НСтр("ru = 'По проекту приняли два важных решения: СУБД берём PostgreSQL 16, и облако использовать нельзя — только on-premise. Запомни эти решения.'"),
		СлойДолговременная(), "Решение");
	ДобавитьШагСценария(Сценарий,
		НСтр("ru = 'Справочно для проекта зафиксированы учебные курсы валют: доллар — 85 рублей, евро — 95 рублей. Запомни их как знания.'"),
		СлойДолговременная(), "Знание");
	ДобавитьШагСценария(Сценарий,
		НСтр("ru = 'Текущая задача: подготовить демонстрацию системы к 15 декабря 2026 года, ставка разработчика — 4 500 рублей в час, аванс — 30 процентов. Зафиксируй это как данные текущей задачи.'"),
		СлойРабочая(), "");
	ДобавитьШагСценария(Сценарий,
		НСтр("ru = 'По текущей задаче договорились: статус-встреча — каждый вторник в 10:00. Добавь это в заметки задачи.'"),
		СлойРабочая(), "");
	ДобавитьШагСценария(Сценарий,
		НСтр("ru = 'И по сегодняшнему дню: завтра в 11:30 у нас планёрка с заказчиком, встречаемся в офисе на Пушкинской, 10. Просто имей в виду.'"),
		СлойКраткосрочная(), "");

	Возврат Сценарий;

КонецФункции

// Возвращает реестр контрольных вопросов проверки памяти: по два вопроса на слой,
// каждый — про данные, порождённые сценарием заполнения соответствующего слоя.
// Ответ «помнит/не помнит» сверяется с эталоном простой моделью (по образцу
// автоматической оценки Дня 10) и фиксируется по колонкам этапов очистки.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Слой - Строка - идентификатор слоя (см. Слой…);
//     * Вопрос - Строка - контрольный вопрос (без ответа в тексте);
//     * Эталон - Строка - эталонное значение для сверки ответа агента.
//
Функция РеестрВопросовПамяти() Экспорт

	Реестр = Новый ТаблицаЗначений;
	Реестр.Колонки.Добавить("Слой", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Реестр.Колонки.Добавить("Вопрос", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));
	Реестр.Колонки.Добавить("Эталон", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));

	ДобавитьВопрос(Реестр, СлойДолговременная(),
		НСтр("ru = 'Как зовут пользователя и какой у него проект?'"),
		НСтр("ru = 'Анна Ветрова, «Северный ветер»'"));
	ДобавитьВопрос(Реестр, СлойДолговременная(),
		НСтр("ru = 'Какие решения приняты по СУБД и размещению системы?'"),
		НСтр("ru = 'PostgreSQL 16, только on-premise, облако запрещено'"));
	ДобавитьВопрос(Реестр, СлойРабочая(),
		НСтр("ru = 'До какого срока и по какой ставке готовим демонстрацию?'"),
		НСтр("ru = '15 декабря 2026 года, 4 500 рублей в час'"));
	ДобавитьВопрос(Реестр, СлойРабочая(),
		НСтр("ru = 'Когда статус-встреча по текущей задаче?'"),
		НСтр("ru = 'каждый вторник в 10:00'"));
	ДобавитьВопрос(Реестр, СлойКраткосрочная(),
		НСтр("ru = 'Во сколько завтра планёрка и где она проходит?'"),
		НСтр("ru = '11:30, офис на Пушкинской, 10'"));
	ДобавитьВопрос(Реестр, СлойКраткосрочная(),
		НСтр("ru = 'С кем завтра планёрка?'"),
		НСтр("ru = 'с заказчиком'"));

	Возврат Реестр;

КонецФункции

// Возвращает полный список фактов долговременной памяти (без отбора) —
// для таблицы «Долговременная память» формы агента.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Ключ - Строка(100) - ключ факта (наименование элемента справочника);
//     * Значение - Строка - содержание факта;
//     * Категория - Строка - имя категории (см. ИмяКатегории).
//
Функция ФактыПамяти() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Факты.Наименование КАК Ключ,
	|	Факты.Значение КАК Значение,
	|	Факты.Категория КАК Категория
	|ИЗ
	|	Справочник.KimiФактыПамяти КАК Факты
	|ГДЕ
	|	НЕ Факты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Факты.ДатаЗаписи";

	Факты = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаФакта Из Факты Цикл
		СтрокаФакта.Категория = ИмяКатегории(СтрокаФакта.Категория);
	КонецЦикла;

	Возврат Факты;

КонецФункции

// Отбирает факты долговременной памяти для включения в запрос — правило дня
// «что именно из слоя попадает в промпт»:
//   — категория «Профиль» попадает всегда;
//   — факты прочих разрешённых категорий («Решение», «Знание») попадают,
//     только если релевантны словам вопроса (совпадение слова в ключе или
//     значении, регистронезависимо);
//   — всего не более ЛимитФактовВЗапросе фактов (сначала профиль, далее
//     по убыванию релевантности).
// Релевантность — простое пересечение слов, без векторного поиска:
// для учебного дня важен сам принцип «не всё, а отобранное».
//
// Параметры:
//   Вопрос - Строка - текущий вопрос пользователя (последнее user-сообщение);
//   Категории - Массив из ПеречислениеСсылка.KimiКатегорииПамяти, Неопределено -
//     разрешённые категории (Неопределено или пустой массив — все три).
//
// Возвращаемое значение:
//   ТаблицаЗначений - см. ТаблицаЗаметок (Ключ/Значение): отобранные факты.
//
Функция ФактыДляЗапроса(Вопрос, Категории = Неопределено) Экспорт

	Отобранные = ТаблицаЗаметок();

	ВсеФакты = ВсеФактыПамяти();
	Если ВсеФакты.Количество() = 0 Тогда
		Возврат Отобранные;
	КонецЕсли;

	Разрешённые = НормализоватьКатегории(Категории);
	Слова = СловаВопроса(Вопрос);
	Профиль = Перечисления.KimiКатегорииПамяти.Профиль;

	Кандидаты = ВсеФакты.СкопироватьКолонки();
	Кандидаты.Колонки.Добавить("Релевантность", Новый ОписаниеТипов("Число"));
	Кандидаты.Колонки.Добавить("ЭтоПрофиль", Новый ОписаниеТипов("Булево"));

	Для Каждого Факт Из ВсеФакты Цикл
		Если Разрешённые.Найти(Факт.КатегорияСсылка) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЭтоПрофиль = (Факт.КатегорияСсылка = Профиль);
		Релевантность = РелевантностьФакта(Факт, Слова);
		Если Не ЭтоПрофиль И Релевантность = 0 Тогда
			Продолжить; // непрофильные факты без пересечения со словами вопроса не идут в запрос
		КонецЕсли;

		Строка = Кандидаты.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Факт);
		Строка.Релевантность = Релевантность;
		Строка.ЭтоПрофиль = ЭтоПрофиль;
	КонецЦикла;

	Кандидаты.Сортировать("Релевантность УБЫВ");

	// Лимит распространяется только на релевантные факты: профиль (правило
	// «всегда в запросе») вне конкурса и попадает в запрос целиком.
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Не Кандидат.ЭтоПрофиль И Отобранные.Количество() >= ЛимитФактовВЗапросе() Тогда
			Продолжить;
		КонецЕсли;
		Строка = Отобранные.Добавить();
		Строка.Ключ = Кандидат.Ключ;
		Строка.Значение = Кандидат.Значение;
	КонецЦикла;

	Возврат Отобранные;

КонецФункции

// Оборачивает отобранные факты долговременной памяти в служебное user-сообщение:
// так слой памяти попадает в запрос в терминах протокола — перед проекцией
// истории диалога.
//
// Параметры:
//   Факты - ТаблицаЗначений - см. ФактыДляЗапроса.
//
// Возвращаемое значение:
//   Строка - текст сообщения для API.
//
Функция ТекстДолговременнойПамятиДляЗапроса(Факты) Экспорт

	Возврат СтрШаблон(НСтр("ru = 'Долговременная память (факты о пользователе, принятых решениях и знаниях, ключ-значение):
		|%1
		|
		|Учитывай эти факты при ответах. Если факт противоречит последним сообщениям — последние важнее.'"),
		ЗаписиВТекст(Факты));

КонецФункции

// Оборачивает заметки рабочей памяти в служебное user-сообщение. Правило слоя:
// весь блок целиком, пока задача активна (объём ограничен разумным — порядка
// пары тысяч токенов; панель «Токены по слоям» показывает оценку).
//
// Параметры:
//   Заметки - ТаблицаЗначений - см. ТаблицаЗаметок.
//
// Возвращаемое значение:
//   Строка - текст сообщения для API.
//
Функция ТекстРабочейПамятиДляЗапроса(Заметки) Экспорт

	Возврат СтрШаблон(НСтр("ru = 'Заметки по текущей задаче (рабочая память, ключ-значение):
		|%1
		|
		|Это актуальные данные текущей задачи — опирайся на них в ответах.'"),
		ЗаписиВТекст(Заметки));

КонецФункции

// Оценивает токены записей «ключ-значение» (фактов или заметок) — локальная
// оценка KimiТокеныСервер.ОценитьТокеныТекста, точных значений до вызова API нет
// (endpoint подсчёта у Kimi отсутствует, День 8).
//
// Параметры:
//   Записи - ТаблицаЗначений - см. ТаблицаЗаметок.
//
// Возвращаемое значение:
//   Число - оценка токенов блока.
//
Функция ОценитьТокеныЗаписей(Записи) Экспорт

	Если Записи.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат KimiТокеныСервер.ОценитьТокеныТекста(ЗаписиВТекст(Записи));

КонецФункции

// Переносит факты диалога в долговременную память — явное действие пользователя
// (кнопка «Сохранить в долговременную»): элемент справочника создаётся или
// обновляется по совпадению ключа (наименования). Факты становятся основой
// долговременной памяти (механизм извлечения — День 10).
//
// Параметры:
//   Факты - ТаблицаЗначений - см. ТаблицаЗаметок (переносимые записи);
//   Категория - ПеречислениеСсылка.KimiКатегорииПамяти - категория сохраняемых
//     фактов (не заполнена — «Профиль»);
//   Источник - ДокументСсылка.KimiДиалог, Неопределено - диалог-источник.
//
// Возвращаемое значение:
//   Число - сколько фактов сохранено (создано или обновлено).
//
Функция СохранитьФактыВДолговременнуюПамять(Факты, Категория, Источник = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Категория) Тогда
		Категория = Перечисления.KimiКатегорииПамяти.Профиль;
	КонецЕсли;

	Сохранено = 0;
	Для Каждого СтрокаФакта Из Факты Цикл
		Ключ = Лев(СокрЛП(СтрокаФакта.Ключ), 100); // ограничение наименования справочника
		Если Не ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;

		Найденный = Справочники.KimiФактыПамяти.НайтиПоНаименованию(Ключ, Истина);
		Если Не ЗначениеЗаполнено(Найденный) Тогда
			// Неопределено или пустая ссылка — платформа возвращает то и другое
			// (пустая ссылка на ПолучитьОбъект падает «Элемент не выбран!»).
			Элемент = Справочники.KimiФактыПамяти.СоздатьЭлемент();
			Элемент.Наименование = Ключ;
			Элемент.ДатаЗаписи = ТекущаяДатаСеанса();
		Иначе
			Элемент = Найденный.ПолучитьОбъект();
			Если Элемент.ПометкаУдаления Тогда
				Элемент.УстановитьПометкуУдаления(Ложь);
			КонецЕсли;
		КонецЕсли;

		Элемент.Значение = СтрокаФакта.Значение;
		Элемент.Категория = Категория;
		Если Источник <> Неопределено Тогда
			Элемент.Источник = Источник;
		КонецЕсли;
		Элемент.Записать();
		Сохранено = Сохранено + 1;
	КонецЦикла;

	Возврат Сохранено;

КонецФункции

// Очищает долговременную память (кнопка «Очистить долговременную память»
// с подтверждением): все факты получают пометку удаления — по идиоме проекта
// удаление обратимо, выборки памяти помеченные не видят.
//
// Возвращаемое значение:
//   Число - сколько фактов помечено на удаление.
//
Функция ОчиститьДолговременнуюПамять() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Факты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.KimiФактыПамяти КАК Факты
	|ГДЕ
	|	НЕ Факты.ПометкаУдаления";

	Очищено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Выборка.Ссылка.ПолучитьОбъект();
		Элемент.УстановитьПометкуУдаления(Истина);
		Очищено = Очищено + 1;
	КонецЦикла;

	Возврат Очищено;

КонецФункции

// Извлекает предлагаемые записи «ключ-значение» из последнего обмена
// (user-сообщение + ответ агента) вызовом модели-экстрактора — тот же
// механизм, что обновляет факты стратегии «Факты» Дня 10: факты Дня 10
// являются основой памяти Дня 11. Используется кнопкой «В память из обмена»
// (предпросмотр перед явным сохранением) и автосохранением слоёв сценария.
// Параметр «ЛегкаяМодель» (режим Google-only Дня 11) переводит вызов на лёгкую
// модель Google AI Studio — чтобы приёмка дня шла без обращений к Kimi.
//
// Параметры:
//   ТекстПользователя - Строка - последнее сообщение пользователя;
//   ТекстАссистента - Строка - ответ агента (может быть пустым);
//   ЛегкаяМодель - Булево - Истина: вызов через Google AI Studio (умолчание Ложь).
//
// Возвращаемое значение:
//   Структура - см. KimiКонтекстСервер.ОбновитьФакты (Факты, Токены…, Ошибка).
//
Функция ФактыПоследнегоОбмена(ТекстПользователя, ТекстАссистента, ЛегкаяМодель = Ложь) Экспорт

	Возврат KimiКонтекстСервер.ОбновитьФакты(ТаблицаЗаметок(), ТекстПользователя, ТекстАссистента, ЛегкаяМодель);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает лимит фактов долговременной памяти в одном запросе: защита
// контекстного окна от разрастания слоя.
//
Функция ЛимитФактовВЗапросе()

	Возврат 20;

КонецФункции

// Возвращает все факты долговременной памяти ссылками категорий
// (для отбора ФактыДляЗапроса).
//
Функция ВсеФактыПамяти()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Факты.Наименование КАК Ключ,
	|	Факты.Значение КАК Значение,
	|	Факты.Категория КАК КатегорияСсылка
	|ИЗ
	|	Справочник.KimiФактыПамяти КАК Факты
	|ГДЕ
	|	НЕ Факты.ПометкаУдаления";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Приводит список разрешённых категорий к корректному виду: пустой или
// незаполненный список — все три категории.
//
Функция НормализоватьКатегории(Категории)

	Все = Новый Массив;
	Все.Добавить(Перечисления.KimiКатегорииПамяти.Профиль);
	Все.Добавить(Перечисления.KimiКатегорииПамяти.Решение);
	Все.Добавить(Перечисления.KimiКатегорииПамяти.Знание);

	Если Категории = Неопределено Или Категории.Количество() = 0 Тогда
		Возврат Все;
	КонецЕсли;

	Разрешённые = Новый Массив;
	Для Каждого Категория Из Категории Цикл
		Если ЗначениеЗаполнено(Категория) И Разрешённые.Найти(Категория) = Неопределено Тогда
			Разрешённые.Добавить(Категория);
		КонецЕсли;
	КонецЦикла;

	Возврат ?(Разрешённые.Количество() = 0, Все, Разрешённые);

КонецФункции

// Разбирает вопрос на слова-кандидаты релевантности: нижний регистр, знаки
// препинания — в пробелы, слова короче трёх символов отброшены (предлоги,
// союзы, частицы не различают факты).
//
Функция СловаВопроса(Вопрос)

	Нормализованный = НРег(СтрЗаменить(СокрЛП(Вопрос), Символы.ПС, " "));
	Замены = СтрРазделить("? ! , . : ; ( ) « » "" №", " ");
	Для Каждого Знак Из Замены Цикл
		Нормализованный = СтрЗаменить(Нормализованный, Знак, " ");
	КонецЦикла;

	Слова = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Нормализованный, " ", Ложь) Цикл
		Если СтрДлина(Часть) >= 3 Тогда
			Слова.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;

	Возврат Слова;

КонецФункции

// Считает пересечение слов вопроса с текстом факта (ключ + значение):
// сколько слов вопроса встречаются в факте.
//
Функция РелевантностьФакта(Факт, Слова)

	ТекстФакта = НРег(Факт.Ключ + " " + Факт.Значение);

	Релевантность = 0;
	Для Каждого Слово Из Слова Цикл
		Если СтрНайти(ТекстФакта, Слово) > 0 Тогда
			Релевантность = Релевантность + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Релевантность;

КонецФункции

// Линеаризует записи «ключ-значение» в текст для промпта: «- ключ: значение»
// по строке (по образцу ФактыВТекст KimiКонтекстСервер — единый формат слоёв).
//
Функция ЗаписиВТекст(Записи)

	Если Записи.Количество() = 0 Тогда
		Возврат НСтр("ru = '— (пусто)'");
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Строки.Добавить(СтрШаблон(НСтр("ru = '- %1: %2'"), Запись.Ключ, Запись.Значение));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Добавляет шаг в сценарий заполнения памяти.
//
Процедура ДобавитьШагСценария(Сценарий, Текст, Слой, ИмяКатегории)

	Сценарий.Добавить(Новый Структура("Текст, Слой, Категория", Текст, Слой, ИмяКатегории));

КонецПроцедуры

// Добавляет вопрос в реестр контрольных вопросов проверки памяти.
//
Процедура ДобавитьВопрос(Реестр, Слой, Вопрос, Эталон)

	Строка = Реестр.Добавить();
	Строка.Слой = Слой;
	Строка.Вопрос = Вопрос;
	Строка.Эталон = Эталон;

КонецПроцедуры

#КонецОбласти
