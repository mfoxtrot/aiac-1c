#Область ПрограммныйИнтерфейс

// Запрашивает текст вопроса у пользователя, отправляет его модели Kimi
// и показывает ответ в окне служебных сообщений.
//
Процедура ЗадатьВопросKimi() Экспорт

	Оповещение = Новый ОписаниеОповещения("ЗадатьВопросKimiПослеВвода", ЭтотОбъект);
	ПоказатьВводСтроки(Оповещение, "", НСтр("ru = 'Введите вопрос для Kimi'"), 0, Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик завершения ввода вопроса. Отправляет введенный текст модели Kimi.
//
// Параметры:
//   ТекстВопроса - Строка, Неопределено - введенный текст; Неопределено, если пользователь отказался от ввода.
//   ДополнительныеПараметры - Произвольный - значение, заданное при создании оповещения.
//
Процедура ЗадатьВопросKimiПослеВвода(ТекстВопроса, ДополнительныеПараметры) Экспорт

	Если ТекстВопроса = Неопределено Или Не ЗначениеЗаполнено(ТекстВопроса) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Ответ = KimiAPIСервер.ОтправитьПростойЗапрос(ТекстВопроса);
		Сообщить(Ответ);
	Исключение
		Сообщить(ОписаниеОшибки(), СтатусСообщения.Важное);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
