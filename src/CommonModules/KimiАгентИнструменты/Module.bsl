#Область ПрограммныйИнтерфейс

// Возвращает схемы инструментов агента в формате параметра tools запроса к API
// (function calling). Набор инструментов и их описание для модели — точка расширения агента:
// чтобы дать агенту новый инструмент, добавьте схему здесь, ветку в Выполнить и функцию инструмента.
//
// Возвращаемое значение:
//   Массив из Соответствие - схемы инструментов:
//     * "type" - Строка - всегда "function";
//     * "function" - Соответствие:
//       ** "name" - Строка - имя инструмента;
//       ** "description" - Строка - назначение инструмента для модели;
//       ** "parameters" - Соответствие - JSON Schema параметров вызова.
//
Функция СхемыИнструментов() Экспорт

	Схемы = Новый Массив;

	Схемы.Добавить(СхемаИнструмента("current_time",
		НСтр("ru = 'Получить текущие дату и время сервера приложения. Используй только для вопросов про текущее время, дату или день недели.'"),
		Неопределено));

	ПараметрыКалькулятора = ПараметрыИнструмента();
	ДобавитьПараметр(ПараметрыКалькулятора, "выражение", "string",
		НСтр("ru = 'Арифметическое выражение, например ""(135 * 12 + 4800) / 15"". Допустимы цифры, скобки и операции +, -, *, /.'"),
		Истина);
	Схемы.Добавить(СхемаИнструмента("calculator",
		НСтр("ru = 'Вычислить арифметическое выражение. Используй для любых расчётов — не считай самостоятельно.'"),
		ПараметрыКалькулятора));

	КодыВалют = СтрРазделить("RUB,EUR,USD,CNY,JPY", ",");
	ПараметрыКонвертера = ПараметрыИнструмента();
	ДобавитьПараметр(ПараметрыКонвертера, "сумма", "number",
		НСтр("ru = 'Сумма в исходной валюте.'"), Истина);
	ДобавитьПараметр(ПараметрыКонвертера, "из_валюты", "string",
		НСтр("ru = 'Код исходной валюты.'"), Истина, КодыВалют);
	ДобавитьПараметр(ПараметрыКонвертера, "в_валюту", "string",
		НСтр("ru = 'Код целевой валюты.'"), Истина, КодыВалют);
	Схемы.Добавить(СхемаИнструмента("currency_convert",
		НСтр("ru = 'Конвертировать сумму из одной валюты в другую по фиксированному учебному курсу. Используй для вопросов про стоимость в другой валюте.'"),
		ПараметрыКонвертера));

	Возврат Схемы;

КонецФункции

// Выполняет вызов инструмента агента и возвращает результат в виде строки
// для сообщения с ролью "tool" обратно в модель.
//
// Параметры:
//   Имя - Строка - имя инструмента (function.name из запроса модели);
//   Аргументы - Строка - аргументы вызова в виде JSON-строки (function.arguments).
//
// Возвращаемое значение:
//   Строка - результат выполнения инструмента; в случае ошибки — текст "ОШИБКА: ...",
//   который возвращается модели для самостоятельной обработки.
//
Функция ВыполнитьИнструмент(Имя, Аргументы) Экспорт

	Попытка
		Если Имя = "current_time" Тогда
			Возврат ТекущееВремяСервера();
		ИначеЕсли Имя = "calculator" Тогда
			Возврат ВычислитьВыражение(ЗначениеАргумента(Аргументы, "выражение"));
		ИначеЕсли Имя = "currency_convert" Тогда
			Возврат КонвертироватьВалюту(
				ЧислоИзАргумента(ЗначениеАргумента(Аргументы, "сумма")),
				ЗначениеАргумента(Аргументы, "из_валюты"),
				ЗначениеАргумента(Аргументы, "в_валюту"));
		КонецЕсли;

		Возврат СтрШаблон(НСтр("ru = 'ОШИБКА: инструмент ""%1"" не найден.'"), Имя);
	Исключение
		Возврат СтрШаблон(НСтр("ru = 'ОШИБКА выполнения инструмента ""%1"": %2'"), Имя, ОписаниеОшибки());
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает текущие дату и время сервера (инструмент current_time).
//
// Возвращаемое значение:
//   Строка - текущие дата и время сервера приложения.
//
Функция ТекущееВремяСервера()

	Возврат СтрШаблон(НСтр("ru = 'Сейчас %1 (время сервера приложения).'"),
		Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"));

КонецФункции

// Вычисляет арифметическое выражение после жёсткой фильтрации символов (инструмент calculator).
// Остаются только цифры, скобки, операции +, -, *, / и десятичный разделитель —
// выполняется только то, что вычислимо, посторонний текст игнорируется.
//
// Параметры:
//   Выражение - Строка, Число - арифметическое выражение.
//
// Возвращаемое значение:
//   Строка - "выражение = результат" или текст "ОШИБКА: ...".
//
Функция ВычислитьВыражение(Выражение)

	Выражение = Строка(Выражение);
	Выражение = СтрЗаменить(Выражение, "×", "*");
	Выражение = СтрЗаменить(Выражение, "÷", "/");
	Выражение = СтрЗаменить(Выражение, "х", "*");
	Выражение = СтрЗаменить(Выражение, "Х", "*");

	ОчищенноеВыражение = ОчиститьВыражение(Строка(Выражение));
	Если Не ЗначениеЗаполнено(ОчищенноеВыражение) Тогда
		Возврат НСтр("ru = 'ОШИБКА: в выражении нет ни одной цифры или допустимой операции.'");
	КонецЕсли;

	Попытка
		Результат = Вычислить(ОчищенноеВыражение);
	Исключение
		Возврат СтрШаблон(НСтр("ru = 'ОШИБКА: не удалось вычислить выражение ""%1"" (%2).'"),
			ОчищенноеВыражение, ОписаниеОшибки());
	КонецПопытки;

	Возврат СтрШаблон(НСтр("ru = '%1 = %2'"), ОчищенноеВыражение, Формат(Результат, "ЧГ="));

КонецФункции

// Удаляет из строки всё, кроме цифр, скобок, операций +, -, *, /, точки, запятой и пробелов.
//
// Параметры:
//   Выражение - Строка - исходная строка.
//
// Возвращаемое значение:
//   Строка - очищенное выражение (запятые заменены точками).
//
Функция ОчиститьВыражение(Выражение)

	ДопустимыеСимволы = "0123456789+-*/()., " + Символ(9);
	ОчищенноеВыражение = "";
	Для Позиция = 1 По СтрДлина(Выражение) Цикл
		СимволВыражения = Сред(Выражение, Позиция, 1);
		Если СтрНайти(ДопустимыеСимволы, СимволВыражения) > 0 Тогда
			ОчищенноеВыражение = ОчищенноеВыражение + СимволВыражения;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрЗаменить(ОчищенноеВыражение, ",", ".");

КонецФункции

// Конвертирует сумму между валютами по фиксированному учебному курсу (инструмент currency_convert).
//
// Параметры:
//   Сумма - Число - сумма в исходной валюте;
//   ИзВалюты - Строка - код исходной валюты (RUB, EUR, USD, CNY, JPY);
//   ВВалюту - Строка - код целевой валюты.
//
// Возвращаемое значение:
//   Строка - результат конвертации или текст "ОШИБКА: ...".
//
Функция КонвертироватьВалюту(Сумма, ИзВалюты, ВВалюту)

	Курсы = КурсыКРублю();

	КодИз = ВРег(СокрЛП(Строка(ИзВалюты)));
	КодВ = ВРег(СокрЛП(Строка(ВВалюту)));

	Если Курсы[КодИз] = Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'ОШИБКА: валюта ""%1"" не найдена. Доступные валюты: %2.'"),
			КодИз, СписокВалют());
	КонецЕсли;
	Если Курсы[КодВ] = Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'ОШИБКА: валюта ""%1"" не найдена. Доступные валюты: %2.'"),
			КодВ, СписокВалют());
	КонецЕсли;

	Результат = Сумма * Курсы[КодИз] / Курсы[КодВ];

	Возврат СтрШаблон(НСтр("ru = '%1 %2 = %3 %4 (зашитой учебный курс от 09.11.2026: 1 %2 = %5 RUB, 1 %4 = %6 RUB).'"),
		Формат(Сумма, "ЧГ="), КодИз,
		Формат(Окр(Результат, 2), "ЧГ=0.00"), КодВ,
		Формат(Курсы[КодИз], "ЧГ=0.00"), Формат(Курсы[КодВ], "ЧГ=0.00"));

КонецФункции

// Возвращает защитной учебный курс валют к рублю (инструмент currency_convert).
// Значения фиксированы в коде на 09.11.2026 — учебный пример, не рыночный курс.
//
// Возвращаемое значение:
//   Соответствие из КлючИЗначение - курсы: ключ — код валюты (Строка), значение — курс к RUB (Число).
//
Функция КурсыКРублю()

	Курсы = Новый Соответствие;
	Курсы.Вставить("RUB", 1);
	Курсы.Вставить("EUR", 95);
	Курсы.Вставить("USD", 85);
	Курсы.Вставить("CNY", 12);
	Курсы.Вставить("JPY", 0.6);

	Возврат Курсы;

КонецФункции

// Возвращает перечень доступных валют для сообщений об ошибках.
//
// Возвращаемое значение:
//   Строка - коды валют через запятую.
//
Функция СписокВалют()

	Возврат "RUB, EUR, USD, CNY, JPY";

КонецФункции

// Собирает схему одного инструмента для параметра tools запроса к API.
//
// Параметры:
//   Имя - Строка - имя инструмента;
//   Описание - Строка - назначение инструмента для модели;
//   Параметры - Соответствие, Неопределено - JSON Schema параметров (см. ПараметрыИнструмента).
//
// Возвращаемое значение:
//   Соответствие - схема инструмента.
//
Функция СхемаИнструмента(Имя, Описание, Параметры)

	ФункцияИнструмента = Новый Соответствие;
	ФункцияИнструмента.Вставить("name", Имя);
	ФункцияИнструмента.Вставить("description", Описание);
	Если Параметры <> Неопределено Тогда
		ФункцияИнструмента.Вставить("parameters", Параметры);
	КонецЕсли;

	Схема = Новый Соответствие;
	Схема.Вставить("type", "function");
	Схема.Вставить("function", ФункцияИнструмента);

	Возврат Схема;

КонецФункции

// Возвращает базовую JSON Schema параметров инструмента: объект без дополнительных свойств.
//
// Возвращаемое значение:
//   Соответствие - JSON Schema параметров.
//
Функция ПараметрыИнструмента()

	Параметры = Новый Соответствие;
	Параметры.Вставить("type", "object");
	Параметры.Вставить("properties", Новый Соответствие);
	Параметры.Вставить("required", Новый Массив);
	Параметры.Вставить("additionalProperties", Ложь);

	Возврат Параметры;

КонецФункции

// Добавляет описание параметра в JSON Schema инструмента.
//
// Параметры:
//   ПараметрыИнструмента - Соответствие - схема, дополняется описанием (см. ПараметрыИнструмента);
//   Имя - Строка - имя параметра;
//   Тип - Строка - тип JSON Schema ("string", "number" и пр.);
//   Описание - Строка - назначение параметра для модели;
//   Обязательный - Булево - Истина, если параметр включается в список required;
//   Значения - Массив из Строка, Неопределено - допустимые значения (enum JSON Schema).
//
Процедура ДобавитьПараметр(ПараметрыИнструмента, Имя, Тип, Описание, Обязательный, Значения = Неопределено)

	ОписаниеПараметра = Новый Соответствие;
	ОписаниеПараметра.Вставить("type", Тип);
	ОписаниеПараметра.Вставить("description", Описание);
	Если Значения <> Неопределено Тогда
		ОписаниеПараметра.Вставить("enum", Значения);
	КонецЕсли;

	ПараметрыИнструмента["properties"].Вставить(Имя, ОписаниеПараметра);
	Если Обязательный Тогда
		ПараметрыИнструмента["required"].Добавить(Имя);
	КонецЕсли;

КонецПроцедуры

// Разбирает JSON-строку аргументов вызова и возвращает значение одного параметра.
//
// Параметры:
//   АргументыJSON - Строка - аргументы вызова (function.arguments);
//   Имя - Строка - имя параметра.
//
// Возвращаемое значение:
//   Произвольный - значение параметра.
//
Функция ЗначениеАргумента(АргументыJSON, Имя)

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(АргументыJSON);
		Аргументы = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		ВызватьИсключение СтрШаблон(НСтр("ru = 'аргументы ""%1"" не являются корректным JSON'"), АргументыJSON);
	КонецПопытки;

	Значение = Аргументы[Имя];
	Если Значение = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'в аргументах вызова нет параметра ""%1""'"), Имя);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Приводит значение аргумента к числу: пропускает числа, преобразует строки
// (десятичная точка или запятая).
//
// Параметры:
//   Значение - Число, Строка - значение аргумента.
//
// Возвращаемое значение:
//   Число - приведённое значение.
//
Функция ЧислоИзАргумента(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Попытка
		Возврат Число(СокрЛП(СтрЗаменить(Строка(Значение), ",", ".")));
	Исключение
		ВызватьИсключение СтрШаблон(НСтр("ru = 'значение ""%1"" не является числом'"), Значение);
	КонецПопытки;

КонецФункции

#КонецОбласти
