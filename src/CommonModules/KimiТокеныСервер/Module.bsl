#Область ПрограммныйИнтерфейс

// Оценивает число токенов текста локально, без обращения к API. У Kimi нет endpoint
// подсчёта токенов, поэтому до отправки запроса доступна только оценка: по выборке
// из начала текста определяется доля кириллицы, затем длина делится на взвешенный
// коэффициент (кириллица ≈ 3 символа на токен, прочие символы ≈ 4). Погрешность —
// порядка ±20–30%; фактические значения доступны только после вызова — в блоке usage
// ответа API (см. KimiAPIСервер.ВыполнитьЗапрос).
//
// Параметры:
//   Текст - Строка - оцениваемый текст.
//
// Возвращаемое значение:
//   Число - оценка числа токенов; 0 для пустого текста.
//
Функция ОценитьТокеныТекста(Текст) Экспорт

	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат 0;
	КонецЕсли;

	ДоляКириллицы = ДоляКириллицы(Текст);
	СимволовНаТокен = 1 / (ДоляКириллицы / 3 + (1 - ДоляКириллицы) / 4);

	Возврат Макс(1, Окр(СтрДлина(Текст) / СимволовНаТокен, 0));

КонецФункции

// Оценивает суммарное число токенов сообщений диалога: сумма оценок текстов
// и аргументов вызовов инструментов плюс небольшая служебная надбавка
// на оформление каждого сообщения (роль, разметка JSON).
//
// Параметры:
//   Сообщения - Массив из Структура - сообщения (см. KimiAPIСервер.ВыполнитьЗапрос).
//
// Возвращаемое значение:
//   Число - оценка числа токенов сообщений.
//
Функция ОценитьТокеныСообщений(Сообщения) Экспорт

	Итого = 0;
	Для Каждого Сообщение Из Сообщения Цикл
		Итого = Итого + ОценитьТокеныТекста(Сообщение.Текст) + 4; // роль и служебное оформление

		ВызовыИнструментов = Неопределено;
		Если Сообщение.Свойство("ВызовыИнструментов", ВызовыИнструментов)
			И ВызовыИнструментов <> Неопределено Тогда
			Для Каждого Вызов Из ВызовыИнструментов Цикл
				Итого = Итого + ОценитьТокеныТекста(Вызов.Аргументы);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Возврат Итого;

КонецФункции

// Возвращает размер контекстного окна модели в токенах. Зафиксировано по документации
// Kimi (https://platform.kimi.ai/docs/api/models-overview, раздел "Model Parameter Differences"),
// проверено 2026-11-11: семейство K3 (kimi-k3, kimi-k3.1-pro, kimi-k3.1-pro-highspeed) —
// 1M токенов; k2.6 и k2.7-code (включая highspeed) — 256K.
//
// Параметры:
//   ИмяМодели - Строка - имя модели.
//
// Возвращаемое значение:
//   Число, Неопределено - лимит контекста; Неопределено, если лимит модели не зафиксирован.
//
Функция ЛимитКонтекста(ИмяМодели) Экспорт

	Если ИмяМодели = "kimi-k3"
		Или ИмяМодели = "kimi-k3.1-pro"
		Или ИмяМодели = "kimi-k3.1-pro-highspeed" Тогда
		Возврат 1048576;
	ИначеЕсли ИмяМодели = "kimi-k2.6"
		Или ИмяМодели = "kimi-k2.7-code"
		Или ИмяМодели = "kimi-k2.7-code-highspeed" Тогда
		Возврат 262144;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Формирует учебные сообщения-«балласт» суммарной оценкой около 75 000 токенов —
// сценарий «длинный диалог» задания Дня 8. Следующий запрос агента уходит с историей
// такого веса: видно, как дорожает и замедляется каждый обмен.
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Роль - Строка - "user";
//     * Текст - Строка - учебный текст-фрагмент;
//     * Токены - Число - оценка токенов фрагмента (колонка истории и итог документа).
//
Функция СообщенияДемоДлинногоКонтекста() Экспорт

	Возврат СообщенияДемо(75000);

КонецФункции

// Формирует учебные сообщения суммарной оценкой заведомо больше контекстного окна,
// чтобы следующий запрос агента был честно отклонён API с ошибкой 400 о превышении
// лимита контекста — сценарий «переполнение» задания Дня 8.
//
// Параметры:
//   Лимит - Число - размер контекстного окна модели.
//
// Возвращаемое значение:
//   Массив из Структура - см. СообщенияДемоДлинногоКонтекста.
//
Функция СообщенияДемоПереполнения(Лимит) Экспорт

	Возврат СообщенияДемо(Окр(Лимит * 1.15, 0));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Определяет долю кириллических символов в выборке из начала текста (до 2000 символов)
// — достаточно для выбора коэффициента пересчёта «символы → токены».
//
// Параметры:
//   Текст - Строка - анализируемый текст.
//
// Возвращаемое значение:
//   Число - доля кириллицы от 0 до 1.
//
Функция ДоляКириллицы(Текст)

	ДлинаВыборки = Мин(СтрДлина(Текст), 2000);
	Кириллица = 0;
	Для Позиция = 1 По ДлинаВыборки Цикл
		Код = КодСимвола(Текст, Позиция);
		Если (Код >= 1040 И Код <= 1103) Или Код = 1025 Или Код = 1105 Тогда
			Кириллица = Кириллица + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Кириллица / ДлинаВыборки;

КонецФункции

// Генерирует учебные сообщения с суммарной оценкой не меньше ЦелевыеТокены: фрагменты
// шаблонного русского текста со сквозной нумерацией. Сквозные номера делают фрагменты
// уникальными — повторяющийся текст токенизаторы схлопывают, и оценка веса стала бы
// заниженной. Тексты осмысленные, но несущественные: их роль — дать истории вес.
//
// Параметры:
//   ЦелевыеТокены - Число - минимальная суммарная оценка токенов набора.
//
// Возвращаемое значение:
//   Массив из Структура - см. СообщенияДемоДлинногоКонтекста.
//
Функция СообщенияДемо(ЦелевыеТокены)

	Сообщения = Новый Массив;
	ИтогоТокенов = 0;
	Номер = 0;

	Пока ИтогоТокенов < ЦелевыеТокены Цикл
		Номер = Номер + 1;
		Текст = СтрШаблон(НСтр("ru = 'Учебный фрагмент контекста №%1 (служебное сообщение демонстрации, можно не читать):
			|%2'"), Номер, ТекстФрагмента(Номер));
		Токены = ОценитьТокеныТекста(Текст);
		ИтогоТокенов = ИтогоТокенов + Токены;
		Сообщения.Добавить(Новый Структура("Роль, Текст, Токены", "user", Текст, Токены));
	КонецЦикла;

	Возврат Сообщения;

КонецФункции

// Собирает один фрагмент демо-текста (около 10 000 символов ≈ 3 000 токенов):
// сорок абзацев-шаблонов с уникальными номерами.
//
// Параметры:
//   Номер - Число - сквозной номер фрагмента.
//
// Возвращаемое значение:
//   Строка - текст фрагмента.
//
Функция ТекстФрагмента(Номер)

	Шаблоны = ШаблоныАбзацев();
	Части = Новый Массив;
	Для Индекс = 0 По 39 Цикл
		Шаблон = Шаблоны[Индекс % Шаблоны.Количество()];
		Части.Добавить(СтрШаблон(Шаблон, Номер, Номер * 1000 + Индекс));
	КонецЦикла;

	Возврат СтрСоединить(Части, " ");

КонецФункции

// Возвращает пул шаблонов абзацев демо-текста: несвязанные энциклопедические
// заметки, в каждую подставляются сквозной номер фрагмента (%1) и уникальный
// номер абзаца (%2).
//
// Возвращаемое значение:
//   Массив из Строка - шаблоны для СтрШаблон.
//
Функция ШаблоныАбзацев()

	Шаблоны = Новый Массив;
	Шаблоны.Добавить(НСтр("ru = 'Конвейерная линия участка %1 в течение смены перерабатывает порядка %2 деталей; каждая партия проходит пост входного контроля, где фиксируются отклонения размеров и маркировки в журнале качества, а брак отправляется на разбор с указанием причины и номера операции.'"));
	Шаблоны.Добавить(НСтр("ru = 'В логистическом узле площадки %1 грузовые потоки распределяются по зонам хранения; система учёта отслеживает перемещение каждой единицы, сверяет фактические остатки с данными регистра в конце смены и формирует лист расхождений для инвентаризации.'"));
	Шаблоны.Добавить(НСтр("ru = 'Курс лекции %1 учебного плана посвящён основам термодинамики; студенты рассчитывают циклы, строят диаграммы состояния рабочего тела и сравнивают КПД реальных установок с идеализированными моделями, поясняя расхождения потерями на трение и теплотдачей.'"));
	Шаблоны.Добавить(НСтр("ru = 'В ботаническом описании участка %1 перечислены виды травянистых растений; экологи отмечают число встречаемости каждого вида в квадратах учёта, сводят наблюдения в помесячные таблицы и сопоставляют динамику с погодными архивами региона за %2 сезон.'"));
	Шаблоны.Добавить(НСтр("ru = 'Архив фонда %1 содержит переписку, датированную концом девятнадцатого века; каталогизаторы восстанавливают хронологию событий по штемпелям, пометкам курьеров и сопроводительным запискам, а обнаруженные дубли объединяют в общие дела с проставленными ссылками.'"));
	Шаблоны.Добавить(НСтр("ru = 'Маршрут обхода контролёра %1 включает двенадцать постов; на каждом посту снимаются показания датчиков, сверяются с допусками технологической карты, а результат фиксируется в сменном рапорте с подписью ответственного и печатью участка.'"));
	Шаблоны.Добавить(НСтр("ru = 'В кулинарной книге раздела %1 описан рецепт с пошаговой технологической картой; повар отмечает температуру жарочного шкафа, время выдержки готового блюда и порядок внесения специй в соус, а критические точки контролирует по термометру с записью %2 в журнале.'"));
	Шаблоны.Добавить(НСтр("ru = 'Статистика перевозок месяца %1 показывает рост пассажиропотока; аналитики сопоставляют загрузку рейсов с тарифами, погодными условиями и календарём праздничных дней региона, выделяя часы пик и рекомендуя резерв подвижного состава на вечерние интервалы.'"));

	Возврат Шаблоны;

КонецФункции

#КонецОбласти
