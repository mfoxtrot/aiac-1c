#Область ПрограммныйИнтерфейс

// Выполняет обращение к агенту: цикл "запрос → вызов инструмента → результат → ответ"
// повторяется, пока модель не перестанет запрашивать инструменты или не будет исчерпан
// лимит итераций. Вся логика агента (цикл, инструменты, журнал) инкапсулирована в модуле.
//
// Параметры:
//   ИсторияДиалога - ТаблицаЗначений:
//     * Роль - Строка - роль отправителя в терминах API: "user", "assistant" или "tool";
//     * Текст - Строка - текст сообщения (у assistant с вызовами инструментов может быть пустым);
//     * Отправлено - Дата - момент сообщения (для отображения);
//     * ВызовыИнструментов - Строка - JSON-массив вызовов инструментов {"id", "name", "arguments"}
//       (у assistant, запросившего инструменты);
//     * ИдВызова - Строка - идентификатор вызова (tool_call_id, у сообщения с ролью "tool");
//   ИнструментыОтключены - Булево - Истина: схемы инструментов не передаются,
//     их выбор запрещён (tool_choice = "none") — чистое сравнение с обычным чатом.
//
// Возвращаемое значение:
//   Структура:
//     * Ответ - Строка - финальный ответ агента пользователю;
//     * НовыеСообщения - Массив из Структура - сообщения, добавленные этим обращением (assistant
//       с вызовами инструментов и tool с результатами; см. формат сообщений в KimiAPIСервер.ВыполнитьЗапрос);
//       материал для сохранения истории диалога (вызывающая сторона сама добавляет вопрос пользователя);
//     * Журнал - Массив из Структура - трассировка работы агента:
//       ** Итерация - Число - номер итерации цикла (вызова API);
//       ** Действие - Строка - "ВызовAPI" или "Инструмент";
//       ** Инструмент - Строка - имя инструмента (только для Инструмент);
//       ** Аргументы - Строка - аргументы вызова в виде JSON (только для Инструмент);
//       ** Результат - Строка - текст ответа API / результат инструмента;
//     * ЧислоИтераций - Число - сколько раз вызывался API;
//     * ЧислоВызововИнструментов - Число - сколько вызовов инструментов выполнено;
//     * ТокеныВсего - Число - суммарные total_tokens всех вызовов;
//     * ТокеныЗапроса - Число - prompt_tokens последней итерации (сколько токенов
//       увидела модель на финальном шаге: системный промпт + вся история);
//     * ТокеныОтвета - Число - completion_tokens последней итерации (ответ модели);
//     * ТокеныРассуждения - Число - суммарные токены рассуждения всех итераций;
//     * ТокеныЗапросаВсего - Число - суммарные prompt_tokens всех итераций (честный
//       расход на обращение: каждая итерация перечитывает историю);
//     * ТокеныОтветаВсего - Число - суммарные completion_tokens всех итераций;
//     * Стоимость - Число - расчётная стоимость обращения, USD (тарифы — День 5);
//     * Модель - Строка - имя модели фактических вызовов;
//     * ЛимитКонтекста - Число, Неопределено - размер контекстного окна модели;
//     * ВремяМиллисекунд - Число - суммарная длительность всех вызовов;
//     * ЛимитИтерацийИсчерпан - Булево - Истина, если цикл прерван по лимиту.
//
Функция ВыполнитьЗапросАгента(ИсторияДиалога, ИнструментыОтключены = Ложь) Экспорт

	Сообщения = СообщенияДиалога(ИсторияДиалога);
	ЧислоИсходныхСообщений = Сообщения.Количество();

	Журнал = Новый Массив;
	ТокеныВсего = 0;
	ТокеныЗапросаВсего = 0;
	ТокеныОтветаВсего = 0;
	ТокеныРассужденияВсего = 0;
	СтоимостьВсего = 0;
	ТокеныЗапросаПоследнегоВызова = 0;
	ТокеныОтветаПоследнегоВызова = 0;
	МодельВызова = "";
	ВремяМиллисекунд = 0;
	ЧислоВызововИнструментов = 0;
	ЛимитИтерацийИсчерпан = Ложь;

	Итерация = 0;
	Ответ = "";
	Пока Истина Цикл
		Итерация = Итерация + 1;

		ПараметрыЗапроса = Новый Структура;
		Если ИнструментыОтключены Тогда
			ПараметрыЗапроса.Вставить("ВыборИнструмента", "none");
		Иначе
			ПараметрыЗапроса.Вставить("Инструменты", KimiАгентИнструменты.СхемыИнструментов());
		КонецЕсли;

		РезультатВызова = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, ПараметрыЗапроса);

		ТокеныВсего = ТокеныВсего + РезультатВызова.ТокеныВсего;
		ТокеныЗапросаВсего = ТокеныЗапросаВсего + РезультатВызова.ТокеныЗапроса;
		ТокеныОтветаВсего = ТокеныОтветаВсего + РезультатВызова.ТокеныОтвета;
		ТокеныРассужденияВсего = ТокеныРассужденияВсего + РезультатВызова.ТокеныРассуждения;
		ТокеныЗапросаПоследнегоВызова = РезультатВызова.ТокеныЗапроса;
		ТокеныОтветаПоследнегоВызова = РезультатВызова.ТокеныОтвета;
		МодельВызова = РезультатВызова.Модель;
		СтоимостьВсего = СтоимостьВсего + KimiМоделиСервер.СтоимостьВызова(РезультатВызова.Модель,
			РезультатВызова.ТокеныЗапроса, РезультатВызова.ТокеныОтвета);
		ВремяМиллисекунд = ВремяМиллисекунд + РезультатВызова.ВремяМиллисекунд;

		ЗаписьЖурнала = НовыйЗаписьЖурнала(Итерация, "ВызовAPI");
		ЗаписьЖурнала.Результат = ?(РезультатВызова.Текст = Неопределено, "", РезультатВызова.Текст);
		ЗаписьЖурнала.ТокеныЗапроса = РезультатВызова.ТокеныЗапроса;
		ЗаписьЖурнала.ТокеныОтвета = РезультатВызова.ТокеныОтвета;
		Журнал.Добавить(ЗаписьЖурнала);

		ДописатьСообщениеАссистента(Сообщения, РезультатВызова);

		Если РезультатВызова.ВызовыИнструментов.Количество() = 0 Тогда
			Ответ = ЗаписьЖурнала.Результат;
			Прервать;
		КонецЕсли;

		Для Каждого Вызов Из РезультатВызова.ВызовыИнструментов Цикл
			РезультатИнструмента = KimiАгентИнструменты.ВыполнитьИнструмент(Вызов.Имя, Вызов.Аргументы);
			ЧислоВызововИнструментов = ЧислоВызововИнструментов + 1;

			ЗаписьЖурнала = НовыйЗаписьЖурнала(Итерация, "Инструмент");
			ЗаписьЖурнала.Инструмент = Вызов.Имя;
			ЗаписьЖурнала.Аргументы = Вызов.Аргументы;
			ЗаписьЖурнала.Результат = РезультатИнструмента;
			Журнал.Добавить(ЗаписьЖурнала);

			Сообщения.Добавить(Новый Структура("Роль, Текст, ИдВызова", "tool", РезультатИнструмента, Вызов.Ид));
		КонецЦикла;

		Если Итерация >= ЛимитИтераций() Тогда
			ЛимитИтерацийИсчерпан = Истина;
			Ответ = НСтр("ru = 'Агент не уложился в лимит итераций и был остановлен (модель, похоже, зациклилась на вызовах инструментов).'");
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Ответ", Ответ);
	Результат.Вставить("НовыеСообщения", НовыеСообщения(Сообщения, ЧислоИсходныхСообщений));
	Результат.Вставить("Журнал", Журнал);
	Результат.Вставить("ЧислоИтераций", Итерация);
	Результат.Вставить("ЧислоВызововИнструментов", ЧислоВызововИнструментов);
	Результат.Вставить("ТокеныВсего", ТокеныВсего);
	Результат.Вставить("ТокеныЗапроса", ТокеныЗапросаПоследнегоВызова);
	Результат.Вставить("ТокеныОтвета", ТокеныОтветаПоследнегоВызова);
	Результат.Вставить("ТокеныРассуждения", ТокеныРассужденияВсего);
	Результат.Вставить("ТокеныЗапросаВсего", ТокеныЗапросаВсего);
	Результат.Вставить("ТокеныОтветаВсего", ТокеныОтветаВсего);
	Результат.Вставить("Стоимость", СтоимостьВсего);
	Результат.Вставить("Модель", МодельВызова);
	Результат.Вставить("ЛимитКонтекста", KimiТокеныСервер.ЛимитКонтекста(МодельВызова));
	Результат.Вставить("ВремяМиллисекунд", ВремяМиллисекунд);
	Результат.Вставить("ЛимитИтерацийИсчерпан", ЛимитИтерацийИсчерпан);

	Возврат Результат;

КонецФункции

// Оценивает число токенов исходящего запроса агента до отправки: системный промпт
// агента + текущая история диалога (с вызовами инструментов). Локальная оценка
// (см. KimiТокеныСервер.ОценитьТокеныТекста) — точных значений до вызова API нет;
// используется для предупреждения о превышении контекстного окна (День 8).
//
// Параметры:
//   ИсторияДиалога - ТаблицаЗначений - см. ВыполнитьЗапросАгента.
//
// Возвращаемое значение:
//   Число - оценка токенов исходящего запроса.
//
Функция ОценитьИсходящийЗапрос(ИсторияДиалога) Экспорт

	Возврат KimiТокеныСервер.ОценитьТокеныСообщений(СообщенияДиалога(ИсторияДиалога));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Собирает массив сообщений API из истории диалога формы: system-промпт агента + все сообщения.
// История хранится в API-терминах: роль "user"/"assistant"/"tool", у assistant с вызовами
// инструментов — JSON в колонке "ВызовыИнструментов", у tool — идентификатор вызова "ИдВызова".
// Так история без потерь восстанавливается из сохранённого диалога (см. KimiЧатыАгентаСервер).
//
// Параметры:
//   ИсторияДиалога - ТаблицаЗначений - см. ВыполнитьЗапросАгента.
//
// Возвращаемое значение:
//   Массив из Структура - сообщения API (см. KimiAPIСервер.ВыполнитьЗапрос).
//
Функция СообщенияДиалога(ИсторияДиалога)

	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("Роль, Текст", "system", СистемныйПромпт()));

	Для Каждого СтрокаИстории Из ИсторияДиалога Цикл
		Сообщение = Новый Структура("Роль, Текст", СтрокаИстории.Роль, СтрокаИстории.Текст);

		Если ЗначениеЗаполнено(СтрокаИстории.ВызовыИнструментов) Тогда
			Сообщение.Вставить("ВызовыИнструментов", ВызовыИнструментовИзJSON(СтрокаИстории.ВызовыИнструментов));
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаИстории.ИдВызова) Тогда
			Сообщение.Вставить("ИдВызова", СтрокаИстории.ИдВызова);
		КонецЕсли;

		Сообщения.Добавить(Сообщение);
	КонецЦикла;

	Возврат Сообщения;

КонецФункции

// Возвращает копию сообщений, добавленных циклом агента после исходной истории:
// ответы ассистента (включая промежуточные с вызовами инструментов) и tool-сообщения с результатами.
//
// Параметры:
//   Сообщения - Массив из Структура - полный массив сообщений цикла (с system в начале);
//   ЧислоИсходныхСообщений - Число - длина массива до начала цикла агента.
//
// Возвращаемое значение:
//   Массив из Структура - новые сообщения.
//
Функция НовыеСообщения(Сообщения, ЧислоИсходныхСообщений)

	Новые = Новый Массив;
	Для Индекс = ЧислоИсходныхСообщений По Сообщения.ВГраница() Цикл
		Новые.Добавить(Сообщения[Индекс]);
	КонецЦикла;

	Возврат Новые;

КонецФункции

// Разбирает JSON-массив вызовов инструментов из сохранённого сообщения ассистента.
//
// Параметры:
//   СтрокаJSON - Строка - JSON вида [{"id": "...", "name": "...", "arguments": "..."}].
//
// Возвращаемое значение:
//   Массив из Структура - вызовы с реквизитами Ид, Имя, Аргументы (см. KimiAPIСервер.ВыполнитьЗапрос);
//     пустой массив, если разобрать не удалось.
//
Функция ВызовыИнструментовИзJSON(СтрокаJSON)

	Вызовы = Новый Массив;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		ДанныеВызовов = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат Вызовы;
	КонецПопытки;

	Если ТипЗнч(ДанныеВызовов) <> Тип("Массив") Тогда
		Возврат Вызовы;
	КонецЕсли;

	Для Каждого ДанныеВызова Из ДанныеВызовов Цикл
		Вызов = Новый Структура;
		Вызов.Вставить("Ид", ДанныеВызова["id"]);
		Вызов.Вставить("Имя", ДанныеВызова["name"]);
		Вызов.Вставить("Аргументы", ДанныеВызова["arguments"]);
		Вызовы.Добавить(Вызов);
	КонецЦикла;

	Возврат Вызовы;

КонецФункции

// Возвращает системный промпт агента: роль и перечень инструментов для модели.
//
// Возвращаемое значение:
//   Строка - текст system-сообщения.
//
Функция СистемныйПромпт()

	Возврат НСтр("ru = 'Ты — агент-помощник в учебной конфигурации 1С. У тебя есть инструменты:
		|current_time — текущие дата и время сервера;
		|calculator — вычисление арифметического выражения;
		|currency_convert — конвертация валют по зашитому учебному курсу.
		|Если вопрос касается текущего времени, арифметики или стоимости в другой валюте — обязательно вызывай нужный инструмент и отвечай на основе его результата. Если инструмент не нужен — отвечай сам. Отвечай по-русски, кратко и по делу.'");

КонецФункции

// Дописывает в историю сообщений ответ ассистента: текст и (если модель запросила) вызовы инструментов.
//
// Параметры:
//   Сообщения - Массив из Структура - история сообщений API (дополняется);
//   РезультатВызова - Структура - результат KimiAPIСервер.ВыполнитьЗапрос.
//
Процедура ДописатьСообщениеАссистента(Сообщения, РезультатВызова)

	Сообщение = Новый Структура("Роль, Текст");
	Сообщение.Роль = "assistant";
	Сообщение.Текст = ?(РезультатВызова.Текст = Неопределено, "", РезультатВызова.Текст);
	Сообщение.Вставить("ТокеныОтвета", РезультатВызова.ТокеныОтвета); // факт completion — в историю формы и документ

	Если РезультатВызова.ВызовыИнструментов.Количество() > 0 Тогда
		Сообщение.Вставить("ВызовыИнструментов", РезультатВызова.ВызовыИнструментов);
	КонецЕсли;

	Сообщения.Добавить(Сообщение);

КонецПроцедуры

// Возвращает запись журнала трассировки с пустыми полями подстановки.
//
// Параметры:
//   Итерация - Число - номер итерации цикла;
//   Действие - Строка - "ВызовAPI" или "Инструмент".
//
// Возвращаемое значение:
//   Структура - см. Журнал в возвращаемом значении ВыполнитьЗапросАгента;
//     поля ТокеныЗапроса/ТокеныОтвета заполняются только у записей "ВызовAPI".
//
Функция НовыйЗаписьЖурнала(Итерация, Действие)

	ЗаписьЖурнала = Новый Структура;
	ЗаписьЖурнала.Вставить("Итерация", Итерация);
	ЗаписьЖурнала.Вставить("Действие", Действие);
	ЗаписьЖурнала.Вставить("Инструмент", "");
	ЗаписьЖурнала.Вставить("Аргументы", "");
	ЗаписьЖурнала.Вставить("Результат", "");
	ЗаписьЖурнала.Вставить("ТокеныЗапроса", 0);
	ЗаписьЖурнала.Вставить("ТокеныОтвета", 0);

	Возврат ЗаписьЖурнала;

КонецФункции

// Возвращает максимальное число итераций цикла агента — страховка от зацикливания.
//
// Возвращаемое значение:
//   Число - лимит итераций.
//
Функция ЛимитИтераций()

	Возврат 10;

КонецФункции

#КонецОбласти
