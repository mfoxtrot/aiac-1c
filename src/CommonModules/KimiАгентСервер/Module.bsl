#Область ПрограммныйИнтерфейс

// Выполняет обращение к агенту: цикл "запрос → вызов инструмента → результат → ответ"
// повторяется, пока модель не перестанет запрашивать инструменты или не будет исчерпан
// лимит итераций. Вся логика агента (цикл, инструменты, журнал) инкапсулирована в модуле.
//
// Параметры:
//   ИсторияДиалога - ТаблицаЗначений:
//     * Роль - Строка - "Вы" (пользователь) или "Kimi" (агент);
//     * Текст - Строка - текст сообщения;
//   ИнструментыОтключены - Булево - Истина: схемы инструментов не передаются,
//     их выбор запрещён (tool_choice = "none") — чистое сравнение с обычным чатом.
//
// Возвращаемое значение:
//   Структура:
//     * Ответ - Строка - финальный ответ агента пользователю;
//     * Журнал - Массив из Структура - трассировка работы агента:
//       ** Итерация - Число - номер итерации цикла (вызова API);
//       ** Действие - Строка - "ВызовAPI" или "Инструмент";
//       ** Инструмент - Строка - имя инструмента (только для Инструмент);
//       ** Аргументы - Строка - аргументы вызова в виде JSON (только для Инструмент);
//       ** Результат - Строка - текст ответа API / результат инструмента;
//     * ЧислоИтераций - Число - сколько раз вызывался API;
//     * ЧислоВызововИнструментов - Число - сколько вызовов инструментов выполнено;
//     * ТокеныВсего - Число - суммарные total_tokens всех вызовов;
//     * ВремяМиллисекунд - Число - суммарная длительность всех вызовов;
//     * ЛимитИтерацийИсчерпан - Булево - Истина, если цикл прерван по лимиту.
//
Функция ВыполнитьЗапросАгента(ИсторияДиалога, ИнструментыОтключены = Ложь) Экспорт

	Сообщения = СообщенияДиалога(ИсторияДиалога);

	Журнал = Новый Массив;
	ТокеныВсего = 0;
	ВремяМиллисекунд = 0;
	ЧислоВызововИнструментов = 0;
	ЛимитИтерацийИсчерпан = Ложь;

	Итерация = 0;
	Ответ = "";
	Пока Истина Цикл
		Итерация = Итерация + 1;

		ПараметрыЗапроса = Новый Структура;
		Если ИнструментыОтключены Тогда
			ПараметрыЗапроса.Вставить("ВыборИнструмента", "none");
		Иначе
			ПараметрыЗапроса.Вставить("Инструменты", KimiАгентИнструменты.СхемыИнструментов());
		КонецЕсли;

		РезультатВызова = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, ПараметрыЗапроса);

		ТокеныВсего = ТокеныВсего + РезультатВызова.ТокеныВсего;
		ВремяМиллисекунд = ВремяМиллисекунд + РезультатВызова.ВремяМиллисекунд;

		ЗаписьЖурнала = НовыйЗаписьЖурнала(Итерация, "ВызовAPI");
		ЗаписьЖурнала.Результат = ?(РезультатВызова.Текст = Неопределено, "", РезультатВызова.Текст);
		Журнал.Добавить(ЗаписьЖурнала);

		ДописатьСообщениеАссистента(Сообщения, РезультатВызова);

		Если РезультатВызова.ВызовыИнструментов.Количество() = 0 Тогда
			Ответ = ЗаписьЖурнала.Результат;
			Прервать;
		КонецЕсли;

		Для Каждого Вызов Из РезультатВызова.ВызовыИнструментов Цикл
			РезультатИнструмента = KimiАгентИнструменты.Выполнить(Вызов.Имя, Вызов.Аргументы);
			ЧислоВызововИнструментов = ЧислоВызововИнструментов + 1;

			ЗаписьЖурнала = НовыйЗаписьЖурнала(Итерация, "Инструмент");
			ЗаписьЖурнала.Инструмент = Вызов.Имя;
			ЗаписьЖурнала.Аргументы = Вызов.Аргументы;
			ЗаписьЖурнала.Результат = РезультатИнструмента;
			Журнал.Добавить(ЗаписьЖурнала);

			Сообщения.Добавить(Новый Структура("Роль, Текст, ИдВызова", "tool", РезультатИнструмента, Вызов.Ид));
		КонецЦикла;

		Если Итерация >= ЛимитИтераций() Тогда
			ЛимитИтерацийИсчерпан = Истина;
			Ответ = НСтр("ru = 'Агент не уложился в лимит итераций и был остановлен (модель, похоже, зациклилась на вызовах инструментов).'");
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Ответ", Ответ);
	Результат.Вставить("Журнал", Журнал);
	Результат.Вставить("ЧислоИтераций", Итерация);
	Результат.Вставить("ЧислоВызововИнструментов", ЧислоВызововИнструментов);
	Результат.Вставить("ТокеныВсего", ТокеныВсего);
	Результат.Вставить("ВремяМиллисекунд", ВремяМиллисекунд);
	Результат.Вставить("ЛимитИтерацийИсчерпан", ЛимитИтерацийИсчерпан);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Собирает массив сообщений API из истории диалога формы: system-промпт агента + все сообщения.
//
// Параметры:
//   ИсторияДиалога - ТаблицаЗначений - см. ВыполнитьЗапросАгента.
//
// Возвращаемое значение:
//   Массив из Структура - сообщения API (см. KimiAPIСервер.ВыполнитьЗапрос).
//
Функция СообщенияДиалога(ИсторияДиалога)

	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("Роль, Текст", "system", СистемныйПромпт()));

	Для Каждого СтрокаИстории Из ИсторияДиалога Цикл
		РольAPI = ?(СтрокаИстории.Роль = "Вы", "user", "assistant");
		Сообщения.Добавить(Новый Структура("Роль, Текст", РольAPI, СтрокаИстории.Текст));
	КонецЦикла;

	Возврат Сообщения;

КонецФункции

// Возвращает системный промпт агента: роль и перечень инструментов для модели.
//
// Возвращаемое значение:
//   Строка - текст system-сообщения.
//
Функция СистемныйПромпт()

	Возврат НСтр("ru = 'Ты — агент-помощник в учебной конфигурации 1С. У тебя есть инструменты:
		|current_time — текущие дата и время сервера;
		|calculator — вычисление арифметического выражения;
		|currency_convert — конвертация валют по зашитому учебному курсу.
		|Если вопрос касается текущего времени, арифметики или стоимости в другой валюте — обязательно вызывай нужный инструмент и отвечай на основе его результата. Если инструмент не нужен — отвечай сам. Отвечай по-русски, кратко и по делу.'");

КонецФункции

// Дописывает в историю сообщений ответ ассистента: текст и (если модель запросила) вызовы инструментов.
//
// Параметры:
//   Сообщения - Массив из Структура - история сообщений API (дополняется);
//   РезультатВызова - Структура - результат KimiAPIСервер.ВыполнитьЗапрос.
//
Процедура ДописатьСообщениеАссистента(Сообщения, РезультатВызова)

	Сообщение = Новый Структура("Роль, Текст");
	Сообщение.Роль = "assistant";
	Сообщение.Текст = ?(РезультатВызова.Текст = Неопределено, "", РезультатВызова.Текст);

	Если РезультатВызова.ВызовыИнструментов.Количество() > 0 Тогда
		Сообщение.Вставить("ВызовыИнструментов", РезультатВызова.ВызовыИнструментов);
	КонецЕсли;

	Сообщения.Добавить(Сообщение);

КонецПроцедуры

// Возвращает запись журнала трассировки с пустыми полями подстановки.
//
// Параметры:
//   Итерация - Число - номер итерации цикла;
//   Действие - Строка - "ВызовAPI" или "Инструмент".
//
// Возвращаемое значение:
//   Структура - см. Журнал в возвращаемом значении ВыполнитьЗапросАгента.
//
Функция НовыйЗаписьЖурнала(Итерация, Действие)

	ЗаписьЖурнала = Новый Структура;
	ЗаписьЖурнала.Вставить("Итерация", Итерация);
	ЗаписьЖурнала.Вставить("Действие", Действие);
	ЗаписьЖурнала.Вставить("Инструмент", "");
	ЗаписьЖурнала.Вставить("Аргументы", "");
	ЗаписьЖурнала.Вставить("Результат", "");

	Возврат ЗаписьЖурнала;

КонецФункции

// Возвращает максимальное число итераций цикла агента — страховка от зацикливания.
//
// Возвращаемое значение:
//   Число - лимит итераций.
//
Функция ЛимитИтераций()

	Возврат 10;

КонецФункции

#КонецОбласти
