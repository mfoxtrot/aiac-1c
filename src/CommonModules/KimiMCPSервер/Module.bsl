#Область ПрограммныйИнтерфейс

// Проверяет соединение с MCP-сервером: выполняет initialize и tools/list,
// возвращает сведения о сервере и список доступных инструментов. Кнопка
// «Проверить соединение» формы агента (День 16) — первый проверочный сценарий
// задания: соединение устанавливается, список инструментов корректно возвращается.
//
// Возвращаемое значение:
//   Структура:
//     * Ошибка - Булево - Истина, если соединение не установлено или список не получен;
//     * ТекстОшибки - Строка - описание ошибки (пусто при успехе);
//     * ИмяСервера - Строка - serverInfo.name из ответа initialize (пусто при ошибке);
//     * ВерсияСервера - Строка - serverInfo.version из ответа initialize;
//     * ВерсияПротокола - Строка - согласованная версия протокола;
//     * Инструменты - ТаблицаЗначений - колонки Имя (Строка 100) и Описание (Строка),
//       инструменты сервера (пусто при ошибке);
//     * ЧислоИнструментов - Число - сколько инструментов вернул сервер.
//
Функция ПроверитьСоединение() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Ошибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ИмяСервера", "");
	Результат.Вставить("ВерсияСервера", "");
	Результат.Вставить("ВерсияПротокола", "");
	Результат.Вставить("Инструменты", ТаблицаИнструментов());
	Результат.Вставить("ЧислоИнструментов", 0);

	Попытка
		Сессия = ОткрытьСессию();

		Результат.ИмяСервера = Сессия.ИнформацияОСервере["name"];
		ИнфоВерсии = Сессия.ИнформацияОСервере["version"];
		Результат.ВерсияСервера = ?(ИнфоВерсии = Неопределено, "", ИнфоВерсии);
		Результат.ВерсияПротокола = Сессия.ВерсияПротокола;

		Инструменты = СписокИнструментов(Сессия);
		Для Каждого Инструмент Из Инструменты Цикл
			СтрокаИнструмента = Результат.Инструменты.Добавить();
			СтрокаИнструмента.Имя = Инструмент["name"];
			Описание = Инструмент["description"];
			СтрокаИнструмента.Описание = ?(Описание = Неопределено, "", Описание);
		КонецЦикла;
		Результат.ЧислоИнструментов = Результат.Инструменты.Количество();

		ЗакрытьСессию(Сессия);
	Исключение
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = ОписаниеОшибки();
		Результат.Инструменты = ТаблицаИнструментов();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает схемы инструментов MCP-сервера в формате параметра tools запроса
// к модели (function calling). Имена инструментов получают префикс mcp__ —
// по нему диспетчер KimiАгентИнструменты.ВыполнитьИнструмент отличает внешние
// вызовы от локальных инструментов Дня 6. Схемы MCP (inputSchema) — это JSON Schema,
// тот же формат, что у параметров инструментов OpenAI/Kimi, поэтому маппинг
// почти 1:1. Список инструментов запрашивается у сервера при каждом обращении
// (сессия MCP не переживает серверный вызов 1С — минимальный код, см. документацию).
//
// Возвращаемое значение:
//   Массив из Соответствие - схемы инструментов (см. KimiАгентИнструменты.СхемыИнструментов).
//
Функция СхемыИнструментов() Экспорт

	Сессия = ОткрытьСессию();
	Попытка
		Инструменты = СписокИнструментов(Сессия);
	Исключение
		ЗакрытьСессию(Сессия);
		ВызватьИсключение;
	КонецПопытки;
	ЗакрытьСессию(Сессия);

	Схемы = Новый Массив;
	Для Каждого Инструмент Из Инструменты Цикл
		Схемы.Добавить(СхемаИнструмента(Инструмент));
	КонецЦикла;

	Возврат Схемы;

КонецФункции

// Выполняет вызов инструмента MCP-сервера (JSON-RPC tools/call) и возвращает
// результат в виде строки для сообщения с ролью "tool" обратно в модель.
// Разбор результата минимальный: текстовые части content склеиваются; части
// типа resource раскрываются по resource.text (EmbeddedResource — так GitHub MCP
// отдаёт содержимое файлов); пустой content со structuredContent — сериализация
// structuredContent в JSON.
//
// Параметры:
//   Имя - Строка - имя инструмента с префиксом mcp__ (function.name из запроса модели);
//   АргументыJSON - Строка - аргументы вызова в виде JSON-строки (function.arguments).
//
// Возвращаемое значение:
//   Строка - результат выполнения инструмента; при isError ответа — текст "ОШИБКА: ...",
//   который возвращается модели для самостоятельной обработки (идиома Дня 6).
//
Функция ВыполнитьИнструмент(Имя, АргументыJSON) Экспорт

	ИмяИнструмента = Сред(Имя, СтрДлина(ПрефиксИнструмента()) + 1);

	Аргументы = Новый Соответствие;
	Если ЗначениеЗаполнено(АргументыJSON) Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(АргументыJSON);
		Аргументы = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	КонецЕсли;

	Сессия = ОткрытьСессию();
	Попытка
		РезультатВызова = ВызватьМетод(Сессия, "tools/call",
			Новый Структура("name, arguments", ИмяИнструмента, Аргументы));
	Исключение
		ЗакрытьСессию(Сессия);
		ВызватьИсключение;
	КонецПопытки;
	ЗакрытьСессию(Сессия);

	// ВызватьМетод возвращает обёртку (Структура с полем «Ответ» — полный
	// JSON-RPC-ответ); результат tools/call — внутри неё: Ответ["result"]
	// (isError/content/structuredContent). Прямое обращение обёртки по имени
	// результата падало бы «Поле объекта не обнаружено» (hotfix при приёмке Дня 16).
	РезультатИнструмента = РезультатВызова.Ответ["result"];

	ЭтоОшибка = РезультатИнструмента["isError"] = Истина;

	ТекстРезультата = "";
	ЧастиОтвета = РезультатИнструмента["content"];
	Если ЧастиОтвета <> Неопределено Тогда
		ТекстовыеЧасти = Новый Массив;
		Для Каждого Часть Из ЧастиОтвета Цикл
			ТипЧасти = Часть["type"];
			Если ТипЧасти = "text" Тогда
				ТекстовыеЧасти.Добавить(Часть["text"]);
			ИначеЕсли ТипЧасти = "resource" Тогда
				// Вложенный ресурс (EmbeddedResource): текст лежит глубже — в resource.text
				// (именно так GitHub MCP отдаёт содержимое файлов из get_file_contents);
				// бинарные ресурсы (blob) намеренно не раскодируем — только пометка.
				Ресурс = Часть["resource"];
				ТекстРесурса = Неопределено;
				АдресРесурса = "";
				Если Ресурс <> Неопределено Тогда
					ТекстРесурса = Ресурс["text"];
					АдресРесурса = Ресурс["uri"];
				КонецЕсли;
				Если ТекстРесурса <> Неопределено Тогда
					ТекстовыеЧасти.Добавить(ТекстРесурса);
				Иначе
					ТекстовыеЧасти.Добавить(СтрШаблон(НСтр("ru = '<вложенный ресурс %1 — бинарное содержимое (blob), текстовое представление недоступно>'"), АдресРесурса));
				КонецЕсли;
			Иначе
				ТекстовыеЧасти.Добавить(СтрШаблон(НСтр("ru = '<часть результата типа ""%1"" — текстовое представление недоступно>'"), ТипЧасти));
			КонецЕсли;
		КонецЦикла;
		ТекстРезультата = СтрСоединить(ТекстовыеЧасти, Символы.ПС);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекстРезультата) Тогда
		СтруктурированноеСодержимое = РезультатИнструмента["structuredContent"];
		Если СтруктурированноеСодержимое <> Неопределено Тогда
			ТекстРезультата = JSONСтрокой(СтруктурированноеСодержимое);
		КонецЕсли;
	КонецЕсли;

	Если ЭтоОшибка Тогда
		Возврат СтрШаблон(НСтр("ru = 'ОШИБКА: инструмент MCP ""%1"" вернул ошибку: %2'"), ИмяИнструмента, ТекстРезультата);
	КонецЕсли;

	Возврат ТекстРезультата;

КонецФункции

// Возвращает префикс имён инструментов MCP. Точка синхронизации клиента,
// диспетчера инструментов (KimiАгентИнструменты) и формы агента: модель
// различает локальные и внешние инструменты только по этому префиксу в имени.
//
// Возвращаемое значение:
//   Строка - префикс имени инструмента MCP.
//
Функция ПрефиксИнструмента() Экспорт

	Возврат "mcp__";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Открывает сессию MCP: выполняет initialize, отправляет notifications/initialized
// и возвращает состояние сессии (идентификатор из заголовка Mcp-Session-Id и
// сведения о сервере). Согласно спецификации Streamable HTTP сервер МОЖЕТ не
// назначать сессию — тогда ИдСессии пуст и заголовок не передаётся.
//
// Возвращаемое значение:
//   Структура:
//     * ИдСообщения - Число - счётчик JSON-RPC id сессии;
//     * ИдСессии - Строка - значение заголовка Mcp-Session-Id (пусто, если сервер
//       сессию не назначил);
//     * ВерсияПротокола - Строка - версия протокола из ответа initialize;
//     * ИнформацияОСервере - Соответствие - serverInfo ответа initialize.
//
Функция ОткрытьСессию()

	РезультатИнициализации = ВызватьМетод(Неопределено, "initialize",
		Новый Структура("protocolVersion, capabilities, clientInfo",
			ВерсияПротокола(), Новый Соответствие,
			Новый Структура("name, version", "aitest-1c-agent", "1.0")), Истина);

	Сессия = Новый Структура;
	Сессия.Вставить("ИдСообщения", 1);
	Сессия.Вставить("ИдСессии", РезультатИнициализации.ИдСессии);
	Сессия.Вставить("ВерсияПротокола", РезультатИнициализации.ВерсияПротокола);
	Сессия.Вставить("ИнформацияОСервере", РезультатИнициализации.Ответ["result"]["serverInfo"]);

	// Уведомление initialized — по протоколу обязательно после initialize;
	// сервер отвечает 202 Accepted без тела, ответ не разбираем.
	ВызватьМетод(Сессия, "notifications/initialized", Новый Соответствие);

	Возврат Сессия;

КонецФункции

// Завершает сессию MCP (HTTP DELETE с заголовком Mcp-Session-Id) — по спецификации
// клиенту СЛЕДУЕТ явно закрывать сессию, когда она больше не нужна. Ошибки закрытия
// игнорируются: сервер МОЖЕТ не поддерживать DELETE (405), сессия и так истечёт.
//
// Параметры:
//   Сессия - Структура - см. ОткрытьСессию.
//
Процедура ЗакрытьСессию(Сессия)

	Если Не ЗначениеЗаполнено(Сессия.ИдСессии) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		СоединениеHTTP = НовыйHTTPСоединение();
		ЗапросHTTP = НовыйHTTPЗапрос(ПутьСервера(), ЗаголовкиЗапроса(Сессия));
		СоединениеHTTP.ВызватьHTTPМетод("DELETE", ЗапросHTTP);
	Исключение
		// Закрытие сессии — косметика, обмен уже выполнен; не прерываем сценарий.
	КонецПопытки;

КонецПроцедуры

// Возвращает список инструментов MCP-сервера (tools/list). Пагинация по
// nextCursor обрабатывается циклом — серверы с большим каталогом (GitHub)
// отдают инструменты частями.
//
// Параметры:
//   Сессия - Структура - см. ОткрытьСессию.
//
// Возвращаемое значение:
//   Массив из Соответствие - инструменты сервера (name/description/inputSchema).
//
Функция СписокИнструментов(Сессия)

	Инструменты = Новый Массив;
	Курсор = Неопределено;

	Пока Истина Цикл
		ПараметрыМетода = Новый Соответствие;
		Если ЗначениеЗаполнено(Курсор) Тогда
			ПараметрыМетода.Вставить("cursor", Курсор);
		КонецЕсли;

		РезультатВызова = ВызватьМетод(Сессия, "tools/list", ПараметрыМетода);
		Результат = РезультатВызова.Ответ["result"];

		ПорцияИнструментов = Результат["tools"];
		Если ПорцияИнструментов <> Неопределено Тогда
			Для Каждого Инструмент Из ПорцияИнструментов Цикл
				Инструменты.Добавить(Инструмент);
			КонецЦикла;
		КонецЕсли;

		Курсор = Результат["nextCursor"];
		Если Не ЗначениеЗаполнено(Курсор) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Инструменты;

КонецФункции

// Выполняет JSON-RPC вызов метода MCP по транспорту Streamable HTTP: один HTTP POST
// на endpoint с телом запроса, ответ сервера — application/json либо SSE-поток
// (text/event-stream), оба варианта спецификации обрабатываются. Уведомления
// (без id) возвращают Неопределено после 202 Accepted.
//
// Параметры:
//   Сессия - Структура, Неопределено - состояние сессии (см. ОткрытьСессию);
//     Неопределено только для initialize — сессия ещё не открыта;
//   Метод - Строка - имя метода MCP (initialize, tools/list, tools/call и пр.);
//   ПараметрыМетода - Соответствие, Структура - значение поля params запроса;
//   ЭтоИнициализация - Булево - вызов initialize: идентификатор сессии из ответа
//     фиксируется в возвращаемой структуре.
//
// Возвращаемое значение:
//   Структура, Неопределено - для уведомлений Неопределено, иначе структура:
//     * Ответ - Соответствие - полный JSON-RPC-ответ (поле "result" — внутри);
//     * ИдСессии - Строка - идентификатор сессии из заголовка ответа (только
//       при ЭтоИнициализация);
//     * ВерсияПротокола - Строка - согласованная версия протокола (только при
//       ЭтоИнициализация: из ответа, если сервер вернул свою, иначе наша).
//
Функция ВызватьМетод(Сессия, Метод, ПараметрыМетода, ЭтоИнициализация = Ложь)

	ИдСообщения = 1; // initialize выполняется без сессии — его id = 1
	Если Сессия <> Неопределено Тогда
		Сессия.ИдСообщения = Сессия.ИдСообщения + 1;
		ИдСообщения = Сессия.ИдСообщения;
	КонецЕсли;
	Если СтрНачинаетсяС(Метод, "notifications/") Тогда
		ИдСообщения = 0; // уведомления по спецификации JSON-RPC id не несут
	КонецЕсли;

	Сообщение = Новый Соответствие;
	Сообщение.Вставить("jsonrpc", "2.0");
	Если ИдСообщения > 0 Тогда
		Сообщение.Вставить("id", ИдСообщения);
	КонецЕсли;
	Сообщение.Вставить("method", Метод);
	Сообщение.Вставить("params", ПараметрыМетода);

	СоединениеHTTP = НовыйHTTPСоединение();
	ЗапросHTTP = НовыйHTTPЗапрос(ПутьСервера(), ЗаголовкиЗапроса(Сессия));
	ЗапросHTTP.УстановитьТелоИзСтроки(JSONСтрокой(Сообщение), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Попытка
		ОтветHTTP = СоединениеHTTP.ВызватьHTTPМетод("POST", ЗапросHTTP);
	Исключение
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось соединиться с сервером MCP (%1) по причине:'")
			+ " " + ОписаниеОшибки(), АдресСервера());
	КонецПопытки;

	Если ОтветHTTP.КодСостояния = 202 Тогда
		// Уведомление принято (202 Accepted, тела нет) — разбирать нечего.
		Возврат Неопределено;
	КонецЕсли;

	ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если ОтветHTTP.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Сервер MCP (%1) вернул код состояния %2. Тело ответа: %3'"),
			АдресСервера(), ОтветHTTP.КодСостояния, ТелоОтвета);
	КонецЕсли;

	ТипСодержимого = ТипСодержимогоОтвета(ОтветHTTP);
	Если СтрНайти(ТипСодержимого, "text/event-stream") > 0 Тогда
		СообщенияОтвета = СообщенияИзSSE(ТелоОтвета);
	Иначе
		СообщенияОтвета = Новый Массив;
		СообщенияОтвета.Добавить(ПрочитатьJSONСтроку(ТелоОтвета));
	КонецЕсли;

	Для Каждого СообщениеОтвета Из СообщенияОтвета Цикл
		Если ИдСообщения > 0 И СообщениеОтвета["id"] <> ИдСообщения Тогда
			Продолжить; // чужое сообщение (сервер мог прислать запрос/уведомление в потоке)
		КонецЕсли;

		ОшибкаВызова = СообщениеОтвета["error"];
		Если ОшибкаВызова <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Сервер MCP (%1) вернул ошибку JSON-RPC %2 (%3): %4'"),
				АдресСервера(), ОшибкаВызова["code"], ОшибкаВызова["message"],
				JSONСтрокой(ОшибкаВызова["data"]));
		КонецЕсли;

		Результат = Новый Структура;
		Результат.Вставить("Ответ", СообщениеОтвета);
		Если ЭтоИнициализация Тогда
			Результат.Вставить("ИдСессии", ЗаголовокОтвета(ОтветHTTP, "Mcp-Session-Id"));
			Результат.Вставить("ВерсияПротокола", ВерсияПротоколаОтвета(СообщениеОтвета));
		КонецЕсли;

		Возврат Результат;
	КонецЦикла;

	ВызватьИсключение СтрШаблон(НСтр("ru = 'Сервер MCP (%1) не вернул ответ на метод ""%2"".'"),
		АдресСервера(), Метод);

КонецФункции

// Разбирает тело SSE-потока (text/event-stream) на массив JSON-RPC-сообщений:
// каждая непустая строка «data:» — один JSON-документ; служебная строка [DONE]
// игнорируется.
//
// Параметры:
//   ТелоПотока - Строка - тело ответа сервера.
//
// Возвращаемое значение:
//   Массив из Соответствие - разобранные сообщения JSON-RPC.
//
Функция СообщенияИзSSE(ТелоПотока)

	Сообщения = Новый Массив;
	Для Каждого СтрокаПотока Из СтрРазделить(ТелоПотока, Символы.ПС) Цикл
		СтрокаПотока = СокрЛП(СтрокаПотока);
		Если Не СтрНачинаетсяС(СтрокаПотока, "data:") Тогда
			Продолжить;
		КонецЕсли;

		Данные = СокрЛП(Сред(СтрокаПотока, 6));
		Если Не ЗначениеЗаполнено(Данные) Или Данные = "[DONE]" Тогда
			Продолжить;
		КонецЕсли;

		Сообщения.Добавить(ПрочитатьJSONСтроку(Данные));
	КонецЦикла;

	Возврат Сообщения;

КонецФункции

// Преобразует описание инструмента MCP (tools/list) в схему параметра tools
// запроса к модели: имя с префиксом mcp__, описание, inputSchema как parameters.
// Если сервер не вернул inputSchema — параметры минимальные (пустой объект).
//
// Параметры:
//   Инструмент - Соответствие - описание инструмента MCP.
//
// Возвращаемое значение:
//   Соответствие - схема инструмента для запроса к модели.
//
Функция СхемаИнструмента(Инструмент)

	Параметры = Инструмент["inputSchema"];
	Если Параметры = Неопределено Тогда
		Параметры = Новый Соответствие;
		Параметры.Вставить("type", "object");
	КонецЕсли;

	Описание = Инструмент["description"];
	Если Описание = Неопределено Тогда
		Описание = "";
	КонецЕсли;

	ФункцияИнструмента = Новый Соответствие;
	ФункцияИнструмента.Вставить("name", ПрефиксИнструмента() + Инструмент["name"]);
	ФункцияИнструмента.Вставить("description", Описание);
	ФункцияИнструмента.Вставить("parameters", Параметры);

	Схема = Новый Соответствие;
	Схема.Вставить("type", "function");
	Схема.Вставить("function", ФункцияИнструмента);

	Возврат Схема;

КонецФункции

// Возвращает таблицу инструментов с колонками Имя/Описание (список для формы
// и пустой результат ошибочного соединения).
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки Имя (Строка 100), Описание (Строка без ограничения).
//
Функция ТаблицаИнструментов()

	Инструменты = Новый ТаблицаЗначений;
	Инструменты.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	Инструменты.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));

	Возврат Инструменты;

КонецФункции

// Сериализует значение в строку JSON.
//
// Параметры:
//   Значение - Произвольный - сериализуемое значение (структуры, соответствия, массивы).
//
// Возвращаемое значение:
//   Строка - JSON-документ.
//
Функция JSONСтрокой(Значение)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Разбирает строку JSON в соответствие. Ошибка разбора всплывает вызывающему
// коду с контекстом сервера MCP.
//
// Параметры:
//   СтрокаJSON - Строка - JSON-документ.
//
// Возвращаемое значение:
//   Соответствие - разобранные данные.
//
Функция ПрочитатьJSONСтроку(СтрокаJSON)

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Сервер MCP (%1) вернул некорректный JSON: %2'"),
			АдресСервера(), ОписаниеОшибки());
	КонецПопытки;

	Возврат Данные;

КонецФункции

// Возвращает согласованную версию протокола: сервер вправе вернуть свою версию
// в initialize (protocolVersion) — дальше работаем с ней.
//
// Параметры:
//   СообщениеОтвета - Соответствие - ответ initialize.
//
// Возвращаемое значение:
//   Строка - версия протокола.
//
Функция ВерсияПротоколаОтвета(СообщениеОтвета)

	ВерсияСервера = СообщениеОтвета["result"]["protocolVersion"];
	Если ЗначениеЗаполнено(ВерсияСервера) Тогда
		Возврат ВерсияСервера;
	КонецЕсли;

	Возврат ВерсияПротокола();

КонецФункции

// Возвращает значение заголовка ответа HTTP (поиск регистронезависимый —
// серверы по-разному задают регистр имён заголовков).
//
// Параметры:
//   ОтветHTTP - HTTPОтвет - ответ сервера;
//   ИмяЗаголовка - Строка - искомый заголовок.
//
// Возвращаемое значение:
//   Строка - значение заголовка (пусто, если заголовка нет).
//
Функция ЗаголовокОтвета(ОтветHTTP, ИмяЗаголовка)

	Для Каждого КлючИЗначение Из ОтветHTTP.Заголовки Цикл
		Если НРег(КлючИЗначение.Ключ) = НРег(ИмяЗаголовка) Тогда
			Возврат КлючИЗначение.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Возвращает Content-Type ответа HTTP (регистронезависимо).
//
// Параметры:
//   ОтветHTTP - HTTPОтвет - ответ сервера.
//
// Возвращаемое значение:
//   Строка - значение заголовка Content-Type.
//
Функция ТипСодержимогоОтвета(ОтветHTTP)

	Возврат НРег(ЗаголовокОтвета(ОтветHTTP, "Content-Type"));

КонецФункции

// Собирает заголовки JSON-RPC-запроса к MCP-серверу: Accept обязан объявлять
// оба типа ответа (application/json и text/event-stream), токен — если задан,
// после инициализации — идентификатор сессии и версия протокола.
//
// Параметры:
//   Сессия - Структура, Неопределено - см. ОткрытьСессию.
//
// Возвращаемое значение:
//   Соответствие - заголовки HTTP-запроса.
//
Функция ЗаголовкиЗапроса(Сессия)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Accept", "application/json, text/event-stream");

	Токен = Константы.McpТокен.Получить();
	Если ЗначениеЗаполнено(Токен) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
	КонецЕсли;

	Если Сессия <> Неопределено И ЗначениеЗаполнено(Сессия.ИдСессии) Тогда
		Заголовки.Вставить("Mcp-Session-Id", Сессия.ИдСессии);
		Заголовки.Вставить("MCP-Protocol-Version", Сессия.ВерсияПротокола);
	КонецЕсли;

	Возврат Заголовки;

КонецФункции

// Возвращает защищённое HTTP-соединение с MCP-сервером (HTTPS, 443).
//
// Возвращаемое значение:
//   HTTPСоединение - соединение с сервером MCP.
//
Функция НовыйHTTPСоединение()

	Возврат Новый HTTPСоединение(АдресСервера(), 443,
		Неопределено, Неопределено, Неопределено, ТаймаутСоединения(), Новый ЗащищенноеСоединениеOpenSSL);

КонецФункции

// Возвращает HTTP-запрос к endpoint MCP-сервера с заданными заголовками.
//
// Параметры:
//   Путь - Строка - путь endpoint на сервере;
//   Заголовки - Соответствие - заголовки запроса.
//
// Возвращаемое значение:
//   HTTPЗапрос - запрос к серверу MCP.
//
Функция НовыйHTTPЗапрос(Путь, Заголовки)

	Возврат Новый HTTPЗапрос(Путь, Заголовки);

КонецФункции

// Возвращает адрес MCP-сервера (часть URL до пути): константа McpСерверАдрес
// задаёт полный endpoint вида https://host/path — здесь он разбирается на адрес
// и путь. Поддерживается только HTTPS (все реальные MCP-серверы работают по нему).
//
// Возвращаемое значение:
//   Строка - адрес сервера без протокола и пути.
//
Функция АдресСервера()

	Адрес = СокрЛП(Константы.McpСерверАдрес.Получить());
	Если Не ЗначениеЗаполнено(Адрес) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан адрес MCP-сервера. Заполните константу ""Адрес MCP-сервера"" (например, https://api.githubcopilot.com/mcp/readonly).'");
	КонецЕсли;

	БезПротокола = СтрЗаменить(Адрес, "https://", "");
	Если СтрНайти(БезПротокола, "/") = 0 Тогда
		Возврат БезПротокола;
	КонецЕсли;

	Возврат СтрРазделить(БезПротокола, "/")[0];

КонецФункции

// Возвращает путь endpoint MCP-сервера (часть URL после адреса, с ведущим слэшем).
//
// Возвращаемое значение:
//   Строка - путь endpoint (например, /mcp/readonly).
//
Функция ПутьСервера()

	Адрес = СокрЛП(Константы.McpСерверАдрес.Получить());
	БезПротокола = СтрЗаменить(Адрес, "https://", "");

	ПозицияСлэша = СтрНайти(БезПротокола, "/");
	Если ПозицияСлэша = 0 Тогда
		Возврат "/";
	КонецЕсли;

	Возврат Сред(БезПротокола, ПозицияСлэша);

КонецФункции

// Возвращает версию протокола MCP, с которой работает клиент (спецификация
