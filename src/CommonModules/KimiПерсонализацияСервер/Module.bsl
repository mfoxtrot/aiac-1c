#Область ПрограммныйИнтерфейс

// Возвращает список аспектов предпочтений — для подписей и списков выбора формы.
// Точка синхронизации значений — эта функция (клиент серверный модуль не видит,
// поэтому список выбора заполняется на сервере при создании формы).
//
// Возвращаемое значение:
//   Массив из Строка - «Стиль», «Детализация», «Формат», «Ограничение».
//
Функция Аспекты() Экспорт

	Аспекты = Новый Массив;
	Аспекты.Добавить("Стиль");
	Аспекты.Добавить("Детализация");
	Аспекты.Добавить("Формат");
	Аспекты.Добавить("Ограничение");

	Возврат Аспекты;

КонецФункции

// Возвращает пустую таблицу предпочтений профиля: колонки Аспект и Текст.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Аспект - Строка(50) - аспект предпочтения (см. Аспекты);
//     * Текст - Строка - формулировка предпочтения для модели.
//
Функция ТаблицаПредпочтений() Экспорт

	Предпочтения = Новый ТаблицаЗначений;
	Предпочтения.Колонки.Добавить("Аспект", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Предпочтения.Колонки.Добавить("Текст", Новый ОписаниеТипов("Строка"));

	Возврат Предпочтения;

КонецФункции

// Возвращает список профилей для селектора формы и прогона «задать всем»:
// не помеченные на удаление, в порядке наименования.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Ссылка - СправочникСсылка.KimiПрофилиПользователей - профиль;
//     * Наименование - Строка - имя профиля.
//
Функция СписокПрофилей() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Профили.Ссылка КАК Ссылка,
	|	Профили.Наименование КАК Наименование
	|ИЗ
	|	Справочник.KimiПрофилиПользователей КАК Профили
	|ГДЕ
	|	НЕ Профили.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Профили.Наименование";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Возвращает предпочтения профиля из табличной части справочника. Пустая ссылка
// или помеченный на удаление профиль дают пустую таблицу (в запрос не пойдёт ничего).
//
// Параметры:
//   Профиль - СправочникСсылка.KimiПрофилиПользователей - выбранный профиль.
//
// Возвращаемое значение:
//   ТаблицаЗначений - см. ТаблицаПредпочтений.
//
Функция ПредпочтенияПрофиля(Профиль) Экспорт

	Предпочтения = ТаблицаПредпочтений();
	Если Не ЗначениеЗаполнено(Профиль) Или Профиль.ПометкаУдаления Тогда
		Возврат Предпочтения;
	КонецЕсли;

	Для Каждого СтрокаТабличнойЧасти Из Профиль.Предпочтения Цикл
		НоваяСтрока = Предпочтения.Добавить();
		НоваяСтрока.Аспект = СтрокаТабличнойЧасти.Аспект;
		НоваяСтрока.Текст = СтрокаТабличнойЧасти.Текст;
	КонецЦикла;

	Возврат Предпочтения;

КонецФункции

// Собирает текст профиля для подстановки в системный промпт агента (День 12):
// блок «Предпочтения пользователя» с нумерованным списком аспектов. Пустой профиль
// или профиль без предпочтений даёт пустую строку — инъекции не будет (профиль
// по умолчанию пуст, прогоны Дней 6–11 не меняются).
//
// Параметры:
//   Профиль - СправочникСсылка.KimiПрофилиПользователей - активный профиль.
//
// Возвращаемое значение:
//   Строка - текст блока; "" - профиль не задан или не содержит предпочтений.
//
Функция ТекстПрофиляДляЗапроса(Профиль) Экспорт

	Предпочтения = ПредпочтенияПрофиля(Профиль);
	Если Предпочтения.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Предпочтения пользователя (профиль «%1»):
		|%2
		|
		|Это предпочтения текущего пользователя — соблюдай их в КАЖДОМ ответе. Они важнее общих привычек и стиля по умолчанию.'"),
		Профиль.Наименование, ПредпочтенияСписком(Предпочтения));

КонецФункции

// Создаёт пустой профиль (кнопка «Новый» группы «Персонализация»): элемент
// справочника с заданным именем и пустой табличной частью; предпочтения
// пользователь дописывает в таблице формы и фиксирует кнопкой «Сохранить профиль».
//
// Параметры:
//   ИмяПрофиля - Строка - наименование нового профиля.
//
// Возвращаемое значение:
//   СправочникСсылка.KimiПрофилиПользователей - созданный профиль.
//
Функция СоздатьПрофиль(ИмяПрофиля) Экспорт

	Элемент = Справочники.KimiПрофилиПользователей.СоздатьЭлемент();
	Элемент.Наименование = Лев(СокрЛП(ИмяПрофиля), 100);
	Элемент.Записать();

	Возврат Элемент.Ссылка;

КонецФункции

// Сохраняет профиль целиком из таблицы формы (кнопка «Сохранить профиль»):
// имя и табличная часть предпочтений перезаписываются отредактированными
// значениями. Точка ручного задания профиля (задание: «не только вручную» —
// ручное задание здесь, пополнение из диалога — см. ДополнитьПрофильПредпочтениями).
//
// Параметры:
//   Профиль - СправочникСсылка.KimiПрофилиПользователей - сохраняемый профиль;
//   ИмяПрофиля - Строка - новое наименование;
//   Предпочтения - ТаблицаЗначений - см. ТаблицаПредпочтений (новое содержимое ТЧ).
//
// Возвращаемое значение:
//   Число - сколько предпочтений сохранено.
//
Функция СохранитьПредпочтенияВПрофиль(Профиль, ИмяПрофиля, Предпочтения) Экспорт

	Элемент = Профиль.ПолучитьОбъект();
	Элемент.Наименование = Лев(СокрЛП(ИмяПрофиля), 100);
	Элемент.Предпочтения.Очистить();

	Сохранено = 0;
	Для Каждого СтрокаПредпочтения Из Предпочтения Цикл
		Аспект = Лев(СокрЛП(СтрокаПредпочтения.Аспект), 50);
		Если Не ЗначениеЗаполнено(Аспект) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Элемент.Предпочтения.Добавить();
		НоваяСтрока.Аспект = Аспект;
		НоваяСтрока.Текст = СтрокаПредпочтения.Текст;
		Сохранено = Сохранено + 1;
	КонецЦикла;

	Элемент.Записать();

	Возврат Сохранено;

КонецФункции

// Дополняет профиль предложенными из диалога предпочтениями (кнопка «В профиль»):
// запись с совпавшим аспектом обновляет текст, новый аспект дописывается строкой.
// Явное полуавтоматическое пополнение профиля из диалога (решение заказчика:
// экстрактор предлагает, пользователь отмечает и сохраняет).
//
// Параметры:
//   Профиль - СправочникСсылка.KimiПрофилиПользователей - дополняемый профиль;
//   Предпочтения - ТаблицаЗначений - см. ТаблицаПредпочтений (отмеченные предложения).
//
// Возвращаемое значение:
//   Число - сколько предпочтений добавлено или обновлено.
//
Функция ДополнитьПрофильПредпочтениями(Профиль, Предпочтения) Экспорт

	Элемент = Профиль.ПолучитьОбъект();
	Сохранено = 0;
	Для Каждого СтрокаПредпочтения Из Предпочтения Цикл
		Аспект = Лев(СокрЛП(СтрокаПредпочтения.Аспект), 50);
		Если Не ЗначениеЗаполнено(Аспект) Тогда
			Продолжить;
		КонецЕсли;

		Найденная = Неопределено;
		Для Каждого СтрокаТабличнойЧасти Из Элемент.Предпочтения Цикл
			Если СтрокаТабличнойЧасти.Аспект = Аспект Тогда
				Найденная = СтрокаТабличнойЧасти;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Найденная = Неопределено Тогда
			Найденная = Элемент.Предпочтения.Добавить();
			Найденная.Аспект = Аспект;
		КонецЕсли;
		Найденная.Текст = СтрокаПредпочтения.Текст;
		Сохранено = Сохранено + 1;
	КонецЦикла;

	Если Сохранено > 0 Тогда
		Элемент.Записать();
	КонецЕсли;

	Возврат Сохранено;

КонецФункции

// Извлекает предлагаемые предпочтения из последнего обмена вызовом модели-
// экстрактора (по образцу извлечения фактов Дня 10): передаёт текущие предпочтения
// профиля и обмен, модель возвращает строгий JSON списка НОВЫХ/УТОЧНЁННЫХ
// предпочтений. Параметр «ЛегкаяМодель» (режим Google-only Дня 11) переводит
// вызов на лёгкую модель Google AI Studio — приёмка дня без обращений к Kimi.
//
// Параметры:
//   ТекстПользователя - Строка - последнее сообщение пользователя;
//   ТекстАссистента - Строка - ответ агента (может быть пустым);
//   ТекущиеПредпочтения - ТаблицаЗначений - см. ТаблицаПредпочтений (чтобы не
//     предлагать уже заданные аспекты повторно);
//   ЛегкаяМодель - Булево - Истина: вызов через Google AI Studio (умолчание Ложь).
//
// Возвращаемое значение:
//   Структура:
//     * Предпочтения - ТаблицаЗначений - см. ТаблицаПредпочтений (предложения);
//     * ТокеныЗапроса - Число - prompt_tokens вызова экстрактора;
//     * ТокеныОтвета - Число - completion_tokens вызова экстрактора;
//     * Стоимость - Число - расчётная стоимость вызова, USD (тарифы Дня 5);
//     * ВремяМиллисекунд - Число - длительность вызова;
//     * Ошибка - Строка - пусто, если извлечение выполнено; иначе причина отказа.
//
Функция ПредпочтенияИзОбмена(ТекстПользователя, ТекстАссистента, ТекущиеПредпочтения, ЛегкаяМодель = Ложь) Экспорт

	Результат = Новый Структура("Предпочтения, ТокеныЗапроса, ТокеныОтвета, Стоимость, ВремяМиллисекунд, Ошибка",
		ТаблицаПредпочтений(), 0, 0, 0, 0, "");

	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("Роль, Текст", "user",
		ТекстЗапросаЭкстрактора(ТекущиеПредпочтения, ТекстПользователя, ТекстАссистента)));

	Параметры = Новый Структура;
	Параметры.Вставить("Модель", KimiAPIСервер.МодельПоУмолчанию());
	Параметры.Вставить("УсилиеРассуждения", "low");
	Параметры.Вставить("МаксимумТокенов", 1500);
	Если ЛегкаяМодель Тогда
		Параметры.Вставить("Модель", KimiКонтекстСервер.ЛегкаяМодельGoogle());
		Параметры.Удалить("УсилиеРассуждения"); // Kimi-специфичное поле внешнему провайдеру не передаём (День 5)
		Параметры.Вставить("АдресСервера", "generativelanguage.googleapis.com");
		Параметры.Вставить("БазовыйПуть", "/v1beta/openai");
		Параметры.Вставить("КлючAPI", Константы.GeminiApiKey.Получить());
	КонецЕсли;

	Попытка
		Вызов = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, Параметры);
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Результат.ТокеныЗапроса = Вызов.ТокеныЗапроса;
	Результат.ТокеныОтвета = Вызов.ТокеныОтвета;
	Результат.Стоимость = KimiМоделиСервер.СтоимостьВызова(Вызов.Модель, Вызов.ТокеныЗапроса, Вызов.ТокеныОтвета);
	Результат.ВремяМиллисекунд = Вызов.ВремяМиллисекунд;

	Предложенные = ПредпочтенияИзJSON(?(Вызов.Текст = Неопределено, "", Вызов.Текст));
	Если Предложенные = Неопределено Тогда
		Результат.Ошибка = НСтр("ru = 'модель вернула некорректный JSON списка предпочтений'");
		Возврат Результат;
	КонецЕсли;

	Результат.Предпочтения = Предложенные;

	Возврат Результат;

КонецФункции

// Возвращает эталонный вопрос проверки «один вопрос — всем профилям»:
// формат ответа на него наблюдаем по всем трём осям демо-профилей
// (кратко/подробно, с кодом/без, формально/неформально).
//
// Возвращаемое значение:
//   Строка - вопрос сравнения (по умолчанию; редактируется на форме).
//
Функция ВопросДляСравненияПрофилей() Экспорт

	Возврат НСтр("ru = 'Объясни, что такое контекстное окно у языковой модели.'");

КонецФункции

// Возвращает реестр 10 вопросов проверки устойчивости: объясняющие вопросы
// общей тематики, на которых предпочтения профиля наблюдаемы (длина, код,
// тон). Прогон в одном чате с активным профилем: на каком по счёту ответе
// ассистент начнёт игнорировать предпочтения.
//
// Возвращаемое значение:
//   Массив из Строка - 10 вопросов.
//
Функция РеестрВопросовУстойчивости() Экспорт

	Вопросы = Новый Массив;
	Вопросы.Добавить(НСтр("ru = 'Объясни, что такое рекурсия.'"));
	Вопросы.Добавить(НСтр("ru = 'Чем массив отличается от структуры во встроенном языке 1С?'"));
	Вопросы.Добавить(НСтр("ru = 'Что такое токен в языковой модели?'"));
	Вопросы.Добавить(НСтр("ru = 'Зачем базе данных нужен индекс?'"));
	Вопросы.Добавить(НСтр("ru = 'Что такое API?'"));
	Вопросы.Добавить(НСтр("ru = 'Чем интерпретатор отличается от компилятора?'"));
	Вопросы.Добавить(НСтр("ru = 'Что такое рефакторинг кода?'"));
	Вопросы.Добавить(НСтр("ru = 'Что такое JSON и где его применяют?'"));
	Вопросы.Добавить(НСтр("ru = 'Зачем HTTP-запросу нужен таймаут?'"));
	Вопросы.Добавить(НСтр("ru = 'Что такое кэш и зачем он нужен?'"));

	Возврат Вопросы;

КонецФункции

// Оценивает соответствие ответа агента предпочтениям профиля вызовом простой
// модели (прецедент автооценки Дней 10–11: та же линейка gemini-3.5-flash-lite,
// бесплатный тариф; судья не зависит от модели агента). Модель отвечает строго
// «да» или «нет» — соблюдены ли перечисленные предпочтения в данном ответе.
//
// Параметры:
//   Предпочтения - ТаблицаЗначений - см. ТаблицаПредпочтений (проверяемый набор);
//   Вопрос - Строка - вопрос пользователя;
//   Ответ - Строка - ответ агента.
//
// Возвращаемое значение:
//   Структура:
//     * Соблюдено - Булево, Неопределено - Истина/Ложь по итогу сверки;
//       Неопределено - модель ответила не «да»/«нет» (отметку не меняем);
//     * Ошибка - Строка - пусто, если вызов выполнен; иначе причина отказа.
//
Функция ОценитьСоответствиеПрофилю(Предпочтения, Вопрос, Ответ) Экспорт

	Результат = Новый Структура("Соблюдено, Ошибка", Неопределено, "");

	Если Предпочтения.Количество() = 0 Тогда
		Результат.Ошибка = НСтр("ru = 'у профиля нет предпочтений — оценивать нечего'");
		Возврат Результат;
	КонецЕсли;

	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("Роль, Текст", "user",
		ТекстЗапросаОценки(Предпочтения, Вопрос, Ответ)));

	Параметры = Новый Структура;
	Параметры.Вставить("Модель", KimiКонтекстСервер.ЛегкаяМодельGoogle());
	Параметры.Вставить("АдресСервера", "generativelanguage.googleapis.com");
	Параметры.Вставить("БазовыйПуть", "/v1beta/openai");
	Параметры.Вставить("КлючAPI", Константы.GeminiApiKey.Получить());
	Параметры.Вставить("МаксимумТокенов", 10);

	Попытка
		Вызов = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, Параметры);
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	ТекстОтвета = НРег(СокрЛП(?(Вызов.Текст = Неопределено, "", Вызов.Текст)));
	Если СтрНачинаетсяС(ТекстОтвета, "да") Тогда
		Результат.Соблюдено = Истина;
	ИначеЕсли СтрНачинаетсяС(ТекстОтвета, "нет") Тогда
		Результат.Соблюдено = Ложь;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Восстанавливает демо-профили проверки (кнопка «Демо-профили»): три профиля
// с противоположными предпочтениями — кратко/официально/без кода,
// подробно/с кодом, неформально/простыми словами. Существующие профили с теми
// же именами получают исходные предпочтения (восстановление эталона), прочие
// профили не трогаются.
//
// Возвращаемое значение:
//   Структура:
//     * Создано - Число - сколько профилей создано;
//     * Обновлено - Число - сколько существующих профилей восстановлено.
//
Функция ВосстановитьДемоПрофили() Экспорт

	Результат = Новый Структура("Создано, Обновлено", 0, 0);

	Для Каждого ОписаниеПрофиля Из ОписанияДемоПрофилей() Цикл
		Найденный = Справочники.KimiПрофилиПользователей.НайтиПоНаименованию(ОписаниеПрофиля.Имя, Истина);
		// Неопределено или пустая ссылка — платформа возвращает то и другое;
		// пустая ссылка на ПолучитьОбъект падает «Элемент не выбран!» (урок Дня 11).
		Если Не ЗначениеЗаполнено(Найденный) Тогда
			Элемент = Справочники.KimiПрофилиПользователей.СоздатьЭлемент();
			Элемент.Наименование = ОписаниеПрофиля.Имя;
			Результат.Создано = Результат.Создано + 1;
		Иначе
			Элемент = Найденный.ПолучитьОбъект();
			Если Элемент.ПометкаУдаления Тогда
				Элемент.УстановитьПометкуУдаления(Ложь);
			КонецЕсли;
			Элемент.Предпочтения.Очистить();
			Результат.Обновлено = Результат.Обновлено + 1;
		КонецЕсли;

		Для Каждого СтрокаПредпочтения Из ОписаниеПрофиля.Предпочтения Цикл
			НоваяСтрока = Элемент.Предпочтения.Добавить();
			НоваяСтрока.Аспект = СтрокаПредпочтения.Аспект;
			НоваяСтрока.Текст = СтрокаПредпочтения.Текст;
		КонецЦикла;
		Элемент.Записать();
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Линеаризует предпочтения в текст для промпта: «- Аспект: текст» по строке
// (по образцу ЗаписиВТекст KimiПамятьСервер — единый формат блоков слоёв).
//
Функция ПредпочтенияСписком(Предпочтения)

	Строки = Новый Массив;
	Для Каждого СтрокаПредпочтения Из Предпочтения Цикл
		Строки.Добавить(СтрШаблон(НСтр("ru = '- %1: %2'"), СтрокаПредпочтения.Аспект, СтрокаПредпочтения.Текст));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Собирает текст запроса к модели-экстрактору предпочтений: текущие предпочтения
// профиля + последний обмен + инструкция предложить только новые/уточнённые
// предпочтения строгим JSON-массивом (снимаемое markdown-ограждение — в парсере).
//
Функция ТекстЗапросаЭкстрактора(ТекущиеПредпочтения, ТекстПользователя, ТекстАссистента)

	Возврат СтрШаблон(НСтр("ru = 'Последний обмен пользователя с ИИ-ассистентом:
		|user: %1
		|assistant: %2
		|
		|Текущие предпочтения пользователя (профиль):
		|%3
		|
		|Извлеки из обмена предпочтения пользователя касательно СТИЛЯ, ДЕТАЛИЗАЦИИ, ФОРМАТА и ОГРАНИЧЕНИЙ ответов (как он хочет получать ответы: кратко/подробно, с кодом/без, формально/неформально и т.п.).
		|Правила:
		|- предлагай только то, что прямо следует из обмена (пользователь сам сформулировал или однозначно потребовал);
		|- не выдумывай и не додумывай предпочтения;
		|- если предпочтение уточняет уже существующий аспект — верни его с уточнённым текстом;
		|- если предпочтений в обмене нет — верни пустой массив.
		|
		|Ответь строго JSON-массивом без оформления, каждый элемент — объект с полями «аспект» (одно из: Стиль, Детализация, Формат, Ограничение) и «текст» (формулировка предпочтения для ассистента). Пример: [{"аспект":"Стиль","текст":"Отвечай неформально"}]'"),
		ТекстПользователя, ТекстАссистента, ПредпочтенияСписком(ТекущиеПредпочтения));

КонецФункции

// Собирает текст запроса к модели-сверяющей: предпочтения, вопрос и ответ,
// инструкция ответить строго одним словом «да» или «нет» — соблюдены ли
// предпочтения в данном ответе (по образцу сверки деталей Дня 10).
//
Функция ТекстЗапросаОценки(Предпочтения, Вопрос, Ответ)

	Возврат СтрШаблон(НСтр("ru = 'Ты — строгий проверяющий персонализации ИИ-ассистента.
		|Предпочтения пользователя:
		|%1
		|
		|Вопрос пользователя: %2
		|Ответ ассистента: %3
		|
		|Соблюдены ли ВСЕ перечисленные предпочтения в этом ответе ассистента? Оцени длину, наличие/отсутствие кода, тон и прочие заявленные аспекты. Ответь строго одним словом: да или нет.'"),
		ПредпочтенияСписком(Предпочтения), Вопрос, Ответ);

КонецФункции

// Разбирает JSON-массив предпочтений, возвращённый моделью-экстрактором.
// Перед разбором снимается markdown-ограждение (модели оборачивают JSON в
// ```json — урок Дня 10). Ожидается массив объектов с строковыми полями
// «аспект» и «текст»; элементы не по схеме пропускаются.
//
// Параметры:
//   ТекстJSON - Строка - ответ модели.
//
// Возвращаемое значение:
//   ТаблицаЗначений, Неопределено - см. ТаблицаПредпочтений; Неопределено -
//   разобрать не удалось (невалидный JSON или не массив).
//
Функция ПредпочтенияИзJSON(ТекстJSON)

	Текст = СокрЛП(ТекстJSON);

	// Снятие markdown-ограждения: отрезаем открывающий fence первой строки
	// и хвост от последнего вхождения закрывающего (урок Дня 10).
	Если СтрНачинаетсяС(Текст, "```") Тогда
		ПозицияПереноса = СтрНайти(Текст, Символы.ПС);
		Если ПозицияПереноса > 0 Тогда
			Текст = СокрЛП(Сред(Текст, ПозицияПереноса + 1));
		КонецЕсли;
	КонецЕсли;
	ПозицияFence = СтрНайти(Текст, "```");
	Если ПозицияFence > 0 Тогда
		Текст = СокрЛП(Лев(Текст, ПозицияFence - 1));
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Текст);
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Предпочтения = ТаблицаПредпочтений();
	Для Каждого ЭлементМассива Из Данные Цикл
		Если ТипЗнч(ЭлементМассива) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		Аспект = ЭлементМассива["аспект"];
		ТекстПредпочтения = ЭлементМассива["текст"];
		Если ТипЗнч(Аспект) <> Тип("Строка") Или ТипЗнч(ТекстПредпочтения) <> Тип("Строка")
			Или Не ЗначениеЗаполнено(Аспект) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Предпочтения.Добавить();
		НоваяСтрока.Аспект = Лев(СокрЛП(Аспект), 50);
		НоваяСтрока.Текст = ТекстПредпочтения;
	КонецЦикла;

	Возврат Предпочтения;

КонецФункции

// Возвращает описания трёх демо-профилей с противоположными предпочтениями
// (проверка задания: кратко/подробно, с кодом/без кода, формально/неформально).
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Имя - Строка - наименование профиля;
//     * Предпочтения - ТаблицаЗначений - см. ТаблицаПредпочтений.
//
Функция ОписанияДемоПрофилей()

	Описания = Новый Массив;

	Предпочтения = ТаблицаПредпочтений();
	ДобавитьПредпочтение(Предпочтения, "Детализация",
		НСтр("ru = 'Отвечай предельно кратко: суть в 2–4 предложениях, без вступлений, повторов и итоговых резюме.'"));
	ДобавитьПредпочтение(Предпочтения, "Стиль",
		НСтр("ru = 'Официально-деловой тон: без сленга, эмодзи и восклицаний.'"));
	ДобавитьПредпочтение(Предпочтения, "Формат",
		НСтр("ru = 'Без примеров кода и технических листингов — только суть словами.'"));
	Описания.Добавить(Новый Структура("Имя, Предпочтения",
		НСтр("ru = 'Руководитель: кратко и официально'"), Предпочтения));

	Предпочтения = ТаблицаПредпочтений();
	ДобавитьПредпочтение(Предпочтения, "Детализация",
		НСтр("ru = 'Развёрнутые ответы: пошагово, со структурой (нумерованные шаги, списки), объясняй «почему», а не только «как».'"));
	ДобавитьПредпочтение(Предпочтения, "Формат",
		НСтр("ru = 'Всегда приводи примеры кода (встроенный язык 1С, если уместно); без кода ответ считается неполным.'"));
	ДобавитьПредпочтение(Предпочтения, "Стиль",
		НСтр("ru = 'Технический тон, допустимо обращение на «ты».'"));
	Описания.Добавить(Новый Структура("Имя, Предпочтения",
		НСтр("ru = 'Разработчик: подробно с кодом'"), Предпочтения));

	Предпочтения = ТаблицаПредпочтений();
	ДобавитьПредпочтение(Предпочтения, "Стиль",
		НСтр("ru = 'Неформально и дружелюбно, простыми словами, без канцелярита; уместен лёгкий юмор.'"));
	ДобавитьПредпочтение(Предпочтения, "Детализация",
		НСтр("ru = 'Средняя длина: объясняй бытовыми аналогиями, без лишней воды.'"));
	ДобавитьПредпочтение(Предпочтения, "Формат",
		НСтр("ru = 'Без кода — объясняй на пальцах.'"));
	Описания.Добавить(Новый Структура("Имя, Предпочтения",
		НСтр("ru = 'Новичок: просто и тепло'"), Предпочтения));

	Возврат Описания;

КонецФункции

// Добавляет предпочтение в таблицу описания демо-профиля.
//
Процедура ДобавитьПредпочтение(Предпочтения, Аспект, Текст)

	НоваяСтрока = Предпочтения.Добавить();
	НоваяСтрока.Аспект = Аспект;
	НоваяСтрока.Текст = Текст;

КонецПроцедуры

#КонецОбласти
