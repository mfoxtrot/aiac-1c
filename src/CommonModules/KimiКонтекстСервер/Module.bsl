КонецФункции

// Возвращает реестр контрольных деталей сценария: каждая деталь названа в одном
// из сообщений брифа, по ней задаётся контрольный вопрос после сжатия истории.
// Ответ «помнит/не помнит» фиксирует заказчик вручную (по образцу отметки
// «Верно» Дня 3) — автопоиск ответа в тексте не ловит перефразы.
//
// Возвращаемое значение:
//   ТаблицаЗначений:
//     * Деталь - Строка - что именно должна помнить модель;
//     * Вопрос - Строка - контрольный вопрос (без ответа в тексте).
//
Функция РеестрДеталей() Экспорт

	Реестр = Новый ТаблицаЗначений;
	Реестр.Колонки.Добавить("Деталь", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Реестр.Колонки.Добавить("Вопрос", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200)));

	ДобавитьДеталь(Реестр, НСтр("ru = 'Имя заказчицы — Анна Ветрова'"), НСтр("ru = 'Как зовут заказчицу проекта?'"));
	ДобавитьДеталь(Реестр, НСтр("ru = 'Название проекта — «Северный ветер»'"), НСтр("ru = 'Как называется наш проект?'"));
	ДобавитьДеталь(Реестр, НСтр("ru = 'Бюджет — 250 000 рублей'"), НСтр("ru = 'Какой у проекта бюджет?'"));
	ДобавитьДеталь(Реестр, НСтр("ru = 'Срок сдачи — 15 декабря 2026 года'"), НСтр("ru = 'До какого срока нужно всё сдать?'"));
	ДобавитьДеталь(Реестр, НСтр("ru = 'Ограничение — только on-premise, облако запрещено'"), НСтр("ru = 'Какое у нас ограничение по размещению системы?'"));
	ДобавитьДеталь(Реестр, НСтр("ru = 'Ставка разработчика — 4 500 руб./час'"), НСтр("ru = 'По какой ставке считаем часы разработки?'"));
	ДобавитьДеталь(Реестр, НСтр("ru = 'Решение по СУБД — PostgreSQL 16'"), НСтр("ru = 'Какую СУБД мы выбрали?'"));
	ДобавитьДеталь(Реестр, НСтр("ru = 'Оплата — аванс 30 %, остаток после приёмки'"), НСтр("ru = 'Какие условия оплаты мы договорились?'"));

	Возврат Реестр;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает имя модели, генерирующей сводку. Точка смены — здесь; по умолчанию
// та же модель, что у агента: сжатие той же линейкой делает эксперимент дня честным
// (потери деталей — заслуга самого сжатия, а не более слабой модели).
//
Функция МодельСводки()

	Возврат KimiAPIСервер.МодельПоУмолчанию();

КонецФункции

// Собирает текст запроса к модели-сжимателю: текущая сводка + линеаризованные
// новые сообщения + инструкция сохранять конкретные детали.
//
Функция ТекстЗапросаСводки(ИсторияДиалога, СжатоДо, Сжимаемых, ТекущаяСводка)

	Части = Новый Массив;

	Если ЗначениеЗаполнено(ТекущаяСводка) Тогда
		Части.Добавить(НСтр("ru = 'Текущая сводка ранней части диалога:'"));
		Части.Добавить(ТекущаяСводка);
		Части.Добавить("");
	КонецЕсли;

	Части.Добавить(НСтр("ru = 'Новые сообщения диалога (в хронологическом порядке):'"));
	Части.Добавить(ТекстСообщенийБлока(ИсторияДиалога, СжатоДо, Сжимаемых));
	Части.Добавить("");

	Части.Добавить(НСтр("ru = 'Объедини текущую сводку и новые сообщения в единую сводку ранней части диалога. Требования:
		|- сохрани все конкретные детали: имена, названия, даты и сроки, суммы и бюджеты, числа, договорённости, принятые решения, ограничения;
		|- каждый вызов инструмента опиши одной строкой: имя, аргументы и результат;
		|- отброси вежливые формулировки, повторы и служебные реплики;
		|- объём — не более 15 строк, маркированный список.
		|Ответь только текстом сводки.'"));

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// Линеаризует блок сообщений истории [СжатоДо, СжатоДо + Сжимаемых) в текст:
// роли user/assistant и вызовы инструментов с результатами. Результат вызова ищется
// по всей истории (tool-ответ может стоять на границе блока); tool-ответы, уже
// вписанные за своим вызовом, повторно не выводятся.
//
Функция ТекстСообщенийБлока(ИсторияДиалога, СжатоДо, Сжимаемых)

	Строки = Новый Массив;
	УчтённыеВызовы = Новый Соответствие;

	Граница = Мин(СжатоДо + Сжимаемых, ИсторияДиалога.Количество());
	Для Индекс = СжатоДо По Граница - 1 Цикл
		Строка = ИсторияДиалога[Индекс];

		Если Строка.Роль = "user" Тогда
			Строки.Добавить("user: " + Строка.Текст);

		ИначеЕсли Строка.Роль = "assistant" Тогда
			Если ЗначениеЗаполнено(Строка.Текст) Тогда
				Строки.Добавить("assistant: " + Строка.Текст);
			КонецЕсли;
			Для Каждого Вызов Из ВызовыИнструментовИзJSON(Строка.ВызовыИнструментов) Цикл
				УчтённыеВызовы.Вставить(Вызов.Ид, Истина);
				Строки.Добавить(СтрШаблон(НСтр("ru = 'assistant вызвал инструмент %1 с аргументами %2 → результат: %3'"),
					Вызов.Имя, Вызов.Аргументы, РезультатВызова(ИсторияДиалога, Вызов.Ид)));
			КонецЦикла;

		ИначеЕсли Строка.Роль = "tool" И УчтённыеВызовы[Строка.ИдВызова] <> Истина Тогда
			Строки.Добавить("tool: " + Строка.Текст);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Ищет tool-ответ с заданным идентификатором вызова по всей истории.
//
Функция РезультатВызова(ИсторияДиалога, ИдВызова)

	Для Каждого Строка Из ИсторияДиалога Цикл
		Если Строка.Роль = "tool" И Строка.ИдВызова = ИдВызова Тогда
			Возврат Строка.Текст;
		КонецЕсли;
	КонецЦикла;

	Возврат НСтр("ru = '(не приведён)'");

КонецФункции

// Разбирает JSON-массив вызовов инструментов из колонки истории.
//
Функция ВызовыИнструментовИзJSON(СтрокаJSON)

	Вызовы = Новый Массив;
	Если Не ЗначениеЗаполнено(СтрокаJSON) Тогда
		Возврат Вызовы;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		ДанныеВызовов = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат Вызовы;
	КонецПопытки;

	Если ТипЗнч(ДанныеВызовов) <> Тип("Массив") Тогда
		Возврат Вызовы;
	КонецЕсли;

	Для Каждого ДанныеВызова Из ДанныеВызовов Цикл
		Вызов = Новый Структура;
		Вызов.Вставить("Ид", ДанныеВызова["id"]);
		Вызов.Вставить("Имя", ДанныеВызова["name"]);
		Вызов.Вставить("Аргументы", ДанныеВызова["arguments"]);
		Вызовы.Добавить(Вызов);
	КонецЦикла;

	Возврат Вызовы;

КонецФункции

// Добавляет строку в реестр контрольных деталей.
//
Процедура ДобавитьДеталь(Реестр, Деталь, Вопрос)

	Строка = Реестр.Добавить();
	Строка.Деталь = Деталь;
	Строка.Вопрос = Вопрос;

КонецПроцедуры

