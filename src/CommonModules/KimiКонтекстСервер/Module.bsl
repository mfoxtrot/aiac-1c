#Область ПрограммныйИнтерфейс

// Возвращает умолчательный размер не-сжатого хвоста истории: сколько последних
// сообщений передаются в запрос как есть (параметр N задания «сжатие истории»).
//
// Возвращаемое значение:
//   Число - число сообщений хвоста (умолчание 15).
//
Функция ХвостПоУмолчанию() Экспорт

	Возврат 15;

КонецФункции

// Возвращает умолчательный размер блока сжатия: история старше хвоста переносится
// в сводку блоками по K сообщений (пример задания — «каждые 10 сообщений»).
//
// Возвращаемое значение:
//   Число - размер блока сжатия, сообщений (умолчание 10).
//
Функция БлокСжатияПоУмолчанию() Экспорт

	Возврат 10;

КонецФункции

// Определяет, требуется ли сжатие истории, и сколько сообщений переносить в сводку.
// Сжатие выполняется блоками по "Блок": пока не-сжатая зона (сообщения после СжатоДо)
// длиннее Хвост + Блок, старейший блок уходит в сводку. Граница блока корректируется
// назад, чтобы не разрывать цепочку function calling: первое несжатое сообщение не
// должно оказаться tool-ответом без своего assistant (его вызов уже ушёл бы в сводку).
//
// Параметры:
//   ИсторияДиалога - ТаблицаЗначений - см. KimiАгентСервер.ВыполнитьЗапросАгента;
//   СжатоДо - Число - сколько первых сообщений уже заменены сводкой;
//   Хвост - Число - сколько последних сообщений хранить как есть;
//   Блок - Число - размер блока сжатия, сообщений.
//
// Возвращаемое значение:
//   Число - сколько сообщений переносить в сводку (кратно Блок); 0 - сжатие не требуется.
//
Функция ТребуетсяСжатие(ИсторияДиалога, СжатоДо, Хвост, Блок) Экспорт

	Если Блок <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	НеСжатых = ИсторияДиалога.Количество() - СжатоДо;
	Если НеСжатых <= Хвост + Блок Тогда
		Возврат 0;
	КонецЕсли;

	Сжимаемых = Цел((НеСжатых - Хвост) / Блок) * Блок;

	// Граница сжатия не должна оставлять tool-ответ первым в несжатой зоне:
	// уводим такие tool-ответы в сводку вместе со своим assistant.
	Пока Сжимаемых > 0
		И СжатоДо + Сжимаемых < ИсторияДиалога.Количество()
		И ИсторияДиалога[СжатоДо + Сжимаемых].Роль = "tool" Цикл
		Сжимаемых = Сжимаемых - 1;
	КонецЦикла;

	Возврат Сжимаемых;

КонецФункции

// Возвращает индекс первого сообщения не-сжатого хвоста истории для передачи в API.
// Хвост — последние Хвост сообщений истории (но не раньше границы СжатоДо);
// начало хвоста корректируется назад, чтобы первым не оказался tool-ответ
// без своего assistant: иначе API отклонит запрос (незавершённая цепочка tool_calls).
//
// Параметры:
//   ИсторияДиалога - ТаблицаЗначений - см. KimiАгентСервер.ВыполнитьЗапросАгента;
//   СжатоДо - Число - сколько первых сообщений заменены сводкой;
//   Хвост - Число - желаемый размер хвоста, сообщений.
//
// Возвращаемое значение:
//   Число - индекс (с нуля) первого сообщения хвоста.
//
Функция ГраницаХвоста(ИсторияДиалога, СжатоДо, Хвост) Экспорт

	Старт = Макс(СжатоДо, ИсторияДиалога.Количество() - Хвост);
	Пока Старт > СжатоДо И ИсторияДиалога[Старт].Роль = "tool" Цикл
		Старт = Старт - 1;
	КонецЦикла;

	Возврат Старт;

КонецФункции

// Оборачивает текст сводки в служебное user-сообщение: так сводка попадает в запрос
// в терминах протокола — одним сообщением перед не-сжатым хвостом истории.
//
// Параметры:
//   Сводка - Строка - текст сводки сжатой части диалога.
//
// Возвращаемое значение:
//   Строка - текст сообщения для API.
//
Функция ТекстСводкиДляЗапроса(Сводка) Экспорт

	Возврат СтрШаблон(НСтр("ru = 'Ранее в этом диалоге (сводка ранней части истории):
		|%1'"), Сводка);

КонецФункции

// Переносит блок сообщений истории в сводку: вызывает модель-сжиматель
// (та же линейка модели агента, усилие рассуждения low — как судья Дня 4),
// передаёт текущую сводку и новые сообщения текстом и получает обновлённую
// сводку (инкрементальное сжатие). Вызовы инструментов в блоке описываются
// строкой с их результатами — протокольные JSON-цепочки в сводку не попадают.
//
// Параметры:
//   ИсторияДиалога - ТаблицаЗначений - полная история (сжимаемый блок читается по индексам);
//   СжатоДо - Число - начало сжимаемого блока (индекс);
//   Сжимаемых - Число - размер блока (см. ТребуетсяСжатие);
//   ТекущаяСводка - Строка - сводка уже сжатой части (пусто — первое сжатие).
//
// Возвращаемое значение:
//   Структура:
//     * Сводка - Строка - обновлённая сводка;
//     * ТокеныЗапроса - Число - prompt_tokens вызова сводки;
//     * ТокеныОтвета - Число - completion_tokens вызова сводки;
//     * Стоимость - Число - расчётная стоимость вызова сводки, USD (тарифы Дня 5);
//     * ВремяМиллисекунд - Число - длительность вызова;
//     * Ошибка - Строка - пусто, если сжатие выполнено; иначе причина отказа.
//
Функция СжатьИсторию(ИсторияДиалога, СжатоДо, Сжимаемых, ТекущаяСводка) Экспорт

	Результат = Новый Структура("Сводка, ТокеныЗапроса, ТокеныОтвета, Стоимость, ВремяМиллисекунд, Ошибка",
		"", 0, 0, 0, 0, "");

	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("Роль, Текст", "user",
		ТекстЗапросаСводки(ИсторияДиалога, СжатоДо, Сжимаемых, ТекущаяСводка)));

	Параметры = Новый Структура;
	Параметры.Вставить("Модель", МодельСводки());
	Параметры.Вставить("УсилиеРассуждения", "low");
	Параметры.Вставить("МаксимумТокенов", 2000);

	Попытка
		Вызов = KimiAPIСервер.ВыполнитьЗапрос(Сообщения, Параметры);
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Результат.Сводка = ?(Вызов.Текст = Неопределено, "", Вызов.Текст);
	Результат.ТокеныЗапроса = Вызов.ТокеныЗапроса;
	Результат.ТокеныОтвета = Вызов.ТокеныОтвета;
	Результат.Стоимость = KimiМоделиСервер.СтоимостьВызова(Вызов.Модель, Вызов.ТокеныЗапроса, Вызов.ТокеныОтвета);
	Результат.ВремяМиллисекунд = Вызов.ВремяМиллисекунд;

	Если Не ЗначениеЗаполнено(Результат.Сводка) Тогда
		Результат.Ошибка = НСтр("ru = 'модель вернула пустую сводку'");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает учебный сценарий проверки потерь деталей (День 9): серия сообщений
// «бриф проекта», по ходу которых называются конкретные детали (имя, название,
// бюджет, срок, ограничение, ставка, решение по СУБД, условия оплаты). Сценарий
// отправляется агенту по очереди — после сжатия по каждой детали задаётся
// контрольный вопрос (см. РеестрДеталей).
//
// Возвращаемое значение:
//   Массив из Строка - тексты сообщений пользователя (14 штук).
//
Функция СценарийПроверкиДеталей() Экспорт

	Сценарий = Новый Массив;

	Сценарий.Добавить(НСтр("ru = 'Здравствуй! Меня зовут Анна Ветрова, я заказчица проекта. Проект называется ""Северный ветер"" — автоматизация небольшой сети кофеен. Будем работать вместе, запомни моё имя и название проекта.'"));
	Сценарий.Добавить(НСтр("ru = 'Бюджет проекта — 250 000 рублей, больше не выделят ни при каких обстоятельствах.'"));
	Сценарий.Добавить(НСтр("ru = 'Сдавать всё нужно не позже 15 декабря 2026 года — к новогодней распродаже. Это жёсткий срок.'"));
	Сценарий.Добавить(НСтр("ru = 'Важное ограничение: облако использовать нельзя — политика безопасности компании. Всё только на нашем сервере, on-premise.'"));
	Сценарий.Добавить(НСтр("ru = 'Для расчёта трудозатрат договорились о ставке 4 500 рублей за час разработчика.'"));
	Сценарий.Добавить(НСтр("ru = 'Прикинь: 40 задач по 2 часа каждая, команда из двух разработчиков. Сколько суммарно рабочих дней займёт, если день — 8 часов на разработчика?'"));
	Сценарий.Добавить(НСтр("ru = 'По СУБД приняли решение: берём PostgreSQL 16. Бесплатная, и наша команда её хорошо знает.'"));
	Сценарий.Добавить(НСтр("ru = 'Интерфейс нужен только на русском языке, другие языки не требуются.'"));
	Сценарий.Добавить(НСтр("ru = 'Отчёты для бухгалтерии выгружаем в PDF, Excel не нужен.'"));
	Сценарий.Добавить(НСтр("ru = 'В системе будет работать около 20 пользователей — менеджеры и бариста.'"));
	Сценарий.Добавить(НСтр("ru = 'Обучение сотрудников заложи один раз на 2 часа, в офисе на Пушкинской, 10.'"));
	Сценарий.Добавить(НСтр("ru = 'Связь держим в Telegram-канале проекта: @sever_wind.'"));
	Сценарий.Добавить(НСтр("ru = 'Напомни, пожалуйста, какие договорённости у нас по оплате: аванс 30 процентов, остаток — после приёмки.'"));
	Сценарий.Добавить(НСтр("ru = 'На этом, пожалуй, всё по брифу. Скоро вернусь с уточнениями.'"));

