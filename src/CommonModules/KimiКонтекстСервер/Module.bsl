// Собирает текст запроса к модели-экстрактору фактов: текущие факты + последний
// обмен + инструкция категорий задания (цель, ограничения, предпочтения, решения,
// договорённости и конкретика) и строгий формат ответа JSON-массивом.
//
Функция ТекстЗапросаФактов(ТекущиеФакты, ТекстПользователя, ТекстАссистента)

	ЧастиОбмена = Новый Массив;
	ЧастиОбмена.Добавить("user: " + ТекстПользователя);
	Если ЗначениеЗаполнено(ТекстАссистента) Тогда
		ЧастиОбмена.Добавить("assistant: " + ТекстАссистента);
	КонецЕсли;

	Возврат СтрШаблон(НСтр("ru = 'Ты — долговременная память агента. Ниже — текущие факты диалога и последний обмен сообщениями.
		|Обнови список фактов: добавь новые важные данные (цель, ограничения, предпочтения, принятые решения, договорённости, а также конкретику: имена, названия, даты и сроки, суммы, числа, ставки, адреса, контакты), удали ставшие неактуальными, прочие сохрани без изменений.
		|Требования: не более 20 фактов; ключ — короткое существительное или короткая фраза; значение — одна строка с сутью.
		|Ответь строго JSON-массивом вида [{""ключ"": ""..."", ""значение"": ""...""}] — без пояснений и markdown-оформления.
		|
		|Текущие факты:
		|%1
		|
		|Последний обмен:
		|%2'"),
		ФактыВТекст(ТекущиеФакты), СтрСоединить(ЧастиОбмена, Символы.ПС));

КонецФункции

// Линеаризует таблицу фактов в текст для промпта: «- ключ: значение» по строке.
//
Функция ФактыВТекст(Факты)

	Если Факты.Количество() = 0 Тогда
		Возврат НСтр("ru = '— (пусто)'");
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого СтрокаФакта Из Факты Цикл
		Строки.Добавить(СтрШаблон(НСтр("ru = '- %1: %2'"), СтрокаФакта.Ключ, СтрокаФакта.Значение));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Разбирает ответ модели-экстрактора в таблицу фактов. Перед разбором снимается
// markdown-ограждение (модели часто оборачивают JSON в ```json … ```) — иначе
// ПрочитатьJSON падает на первом символе fenced block'а. Некорректный JSON,
// не-массив или элементы без пар «ключ/значение» — отказ (Неопределено).
//
// Параметры:
//   ТекстJSON - Строка - ответ модели.
//
// Возвращаемое значение:
//   ТаблицаЗначений, Неопределено - см. ТаблицаФактов; Неопределено — разобрать не удалось.
//
Функция ФактыИзJSON(ТекстJSON)

	Текст = СокрЛП(ТекстJSON);
	Если СтрНачинаетсяС(Текст, "```") Тогда
		ПозицияПервойСтроки = СтрНайти(Текст, Символы.ПС);
		Если ПозицияПервойСтроки > 0 Тогда
			Текст = Сред(Текст, ПозицияПервойСтроки + 1);
			ПозицияОграждения = СтрНайти(Текст, "```", НаправлениеПоиска.СКонца);
			Если ПозицияОграждения > 0 Тогда
				Текст = Лев(Текст, ПозицияОграждения - 1);
			КонецЕсли;
			Текст = СокрЛП(Текст);
		КонецЕсли;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Текст);
		ДанныеФактов = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(ДанныеФактов) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Факты = ТаблицаФактов();
	Для Каждого ДанныеФакта Из ДанныеФактов Цикл
		Если Факты.Количество() >= 20 Тогда // лимит промпта экстрактора
			Прервать;
		КонецЕсли;
		Если ТипЗнч(ДанныеФакта) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		Ключ = ДанныеФакта["ключ"];
		Значение = ДанныеФакта["значение"];
		Если ТипЗнч(Ключ) <> Тип("Строка") Или ТипЗнч(Значение) <> Тип("Строка")
			Или Не ЗначениеЗаполнено(СокрЛП(Ключ)) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаФакта = Факты.Добавить();
		СтрокаФакта.Ключ = Лев(СокрЛП(Ключ), 100); // ограничение колонки документа
		СтрокаФакта.Значение = Значение;
	КонецЦикла;

	Возврат Факты;

КонецФункции

// Собирает текст запроса к модели-аналитику сравнения стратегий: строки сравнения
// (зафиксированные прогоны) + ответы на контрольные вопросы + инструкция выводов
// и рекомендаций. Цифры — только из переданных таблиц.
//
Функция ТекстЗапросаАналитика(СравнениеСтратегий, ПроверкаДеталей)

	СтрокиСравнения = Новый Массив;
	Для Каждого СтрокаСравнения Из СравнениеСтратегий Цикл
		СтрокиСравнения.Добавить(СтрШаблон(НСтр("ru = '— %1: помнит %2 из %3 деталей; токены запроса за прогон %4; вызовов модели на поддержку %5; стоимость поддержки $%6; строк кода механизма %7'"),
			СтрокаСравнения.Стратегия, Формат(СтрокаСравнения.ДеталейПомнит, "ЧГ="),
			Формат(СтрокаСравнения.ВсегоДеталей, "ЧГ="), Формат(СтрокаСравнения.ТокеныЗапроса, "ЧГ="),
			Формат(СтрокаСравнения.ВызововПоддержки, "ЧГ="),
			Формат(СтрокаСравнения.СтоимостьПоддержки, "ЧДЦ=4; ЧГ=; ЧН=0"),
			Формат(СтрокаСравнения.СтрокКода, "ЧГ=")));
	КонецЦикла;

	СтрокиПроверки = Новый Массив;
	Для Каждого СтрокаПроверки Из ПроверкаДеталей Цикл
		СтрокиПроверки.Добавить(СтрШаблон(НСтр("ru = '— %1 Ответ: %2 Помнит: %3'"),
			СтрокаПроверки.Вопрос, ?(ЗначениеЗаполнено(СтрокаПроверки.Ответ), СтрокаПроверки.Ответ, "—"),
			?(СтрокаПроверки.Помнит, НСтр("ru = 'да'"), НСтр("ru = 'нет'"))));
	КонецЦикла;

	Возврат СтрШаблон(НСтр("ru = 'Ты — аналитик эксперимента по управлению контекстом ИИ-агента. Сравниваются стратегии:
		|— Полный: в запрос уходит вся история (контрольная группа, управление контекстом отсутствует);
		|— Окно: в запрос уходят только последние N сообщений, старше — отброшены;
		|— Факты: в запрос уходят блок важных фактов (ключ-значение, обновляется моделью после каждого обмена) + последние N сообщений;
		|— Сводка: в запрос уходят резюме старой части истории + последние N сообщений.
		|
		|Один и тот же сценарий (бриф из 14 сообщений с 8 контрольными деталями) прогнан на каждой стратегии, после прогона заданы контрольные вопросы. Зафиксированные результаты:
		|%1
		|
		|Ответы агента на контрольные вопросы (последняя проверка):
		|%2
		|
		|Сформулируй выводы:
		|1) какая стратегия сколько деталей сохранила и почему (характер потерь каждой стратегии);
		|2) расход токенов и стоимость поддержки каждой стратегии;
		|3) главное — для каких сценариев применения какую стратегию рекомендуешь (короткие диалоги, длинные сессии, критичные факты, экономия бюджета, простота реализации).
		|Не выдумывай цифры — опирайся только на приведённые данные. Ответь по-русски, структурированно, не более 20 строк.'"),
		СтрСоединить(СтрокиСравнения, Символы.ПС), СтрСоединить(СтрокиПроверки, Символы.ПС));

КонецФункции

// Собирает текст запроса к модели-сжимателю: текущая сводка + линеаризованные
// новые сообщения + инструкция сохранять конкретные детали.
//
Функция ТекстЗапросаСводки(ИсторияДиалога, СжатоДо, Сжимаемых, ТекущаяСводка)

	Части = Новый Массив;

	Если ЗначениеЗаполнено(ТекущаяСводка) Тогда
		Части.Добавить(НСтр("ru = 'Текущая сводка ранней части диалога:'"));
		Части.Добавить(ТекущаяСводка);
		Части.Добавить("");
	КонецЕсли;

	Части.Добавить(НСтр("ru = 'Новые сообщения диалога (в хронологическом порядке):'"));
	Части.Добавить(ТекстСообщенийБлока(ИсторияДиалога, СжатоДо, Сжимаемых));
	Части.Добавить("");

	Части.Добавить(НСтр("ru = 'Объедини текущую сводку и новые сообщения в единую сводку ранней части диалога. Требования:
		|- сохрани все конкретные детали: имена, названия, даты и сроки, суммы и бюджеты, числа, договорённости, принятые решения, ограничения;
		|- каждый вызов инструмента опиши одной строкой: имя, аргументы и результат;
		|- отброси вежливые формулировки, повторы и служебные реплики;
		|- объём — не более 15 строк, маркированный список.
		|Ответь только текстом сводки.'"));

	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// Линеаризует блок сообщений истории [СжатоДо, СжатоДо + Сжимаемых) в текст:
// роли user/assistant и вызовы инструментов с результатами. Результат вызова ищется
// по всей истории (tool-ответ может стоять на границе блока); tool-ответы, уже
// вписанные за своим вызовом, повторно не выводятся.
//
Функция ТекстСообщенийБлока(ИсторияДиалога, СжатоДо, Сжимаемых)

	Строки = Новый Массив;
	УчтённыеВызовы = Новый Соответствие;

	Граница = Мин(СжатоДо + Сжимаемых, ИсторияДиалога.Количество());
	Для Индекс = СжатоДо По Граница - 1 Цикл
		Строка = ИсторияДиалога[Индекс];

		Если Строка.Роль = "user" Тогда
			Строки.Добавить("user: " + Строка.Текст);

		ИначеЕсли Строка.Роль = "assistant" Тогда
			Если ЗначениеЗаполнено(Строка.Текст) Тогда
				Строки.Добавить("assistant: " + Строка.Текст);
			КонецЕсли;
			Для Каждого Вызов Из ВызовыИнструментовИзJSON(Строка.ВызовыИнструментов) Цикл
				УчтённыеВызовы.Вставить(Вызов.Ид, Истина);
				Строки.Добавить(СтрШаблон(НСтр("ru = 'assistant вызвал инструмент %1 с аргументами %2 → результат: %3'"),
					Вызов.Имя, Вызов.Аргументы, РезультатВызова(ИсторияДиалога, Вызов.Ид)));
			КонецЦикла;

		ИначеЕсли Строка.Роль = "tool" И УчтённыеВызовы[Строка.ИдВызова] <> Истина Тогда
			Строки.Добавить("tool: " + Строка.Текст);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Ищет tool-ответ с заданным идентификатором вызова по всей истории.
//
Функция РезультатВызова(ИсторияДиалога, ИдВызова)

	Для Каждого Строка Из ИсторияДиалога Цикл
		Если Строка.Роль = "tool" И Строка.ИдВызова = ИдВызова Тогда
			Возврат Строка.Текст;
		КонецЕсли;
	КонецЦикла;

	Возврат НСтр("ru = '(не приведён)'");

КонецФункции

// Разбирает JSON-массив вызовов инструментов из колонки истории.
//
Функция ВызовыИнструментовИзJSON(СтрокаJSON)

	Вызовы = Новый Массив;
	Если Не ЗначениеЗаполнено(СтрокаJSON) Тогда
		Возврат Вызовы;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		ДанныеВызовов = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат Вызовы;
	КонецПопытки;

	Если ТипЗнч(ДанныеВызовов) <> Тип("Массив") Тогда
		Возврат Вызовы;
	КонецЕсли;

	Для Каждого ДанныеВызова Из ДанныеВызовов Цикл
		Вызов = Новый Структура;
		Вызов.Вставить("Ид", ДанныеВызова["id"]);
		Вызов.Вставить("Имя", ДанныеВызова["name"]);
		Вызов.Вставить("Аргументы", ДанныеВызова["arguments"]);
		Вызовы.Добавить(Вызов);
	КонецЦикла;

	Возврат Вызовы;

КонецФункции

// Добавляет строку в реестр контрольных деталей.
